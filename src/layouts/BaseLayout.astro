---
import '../styles/global.css';
import { ROOM_NAMES } from '../data/page-names.js';
const {
  title = 'Statlogia｜数字の背景を、別の数字で読み解く研究都市',
  description = '都道府県・市区町村の統計を引き、くらべ、読み解く研究都市 Statlogia（スタットロギア）。政府統計 e-Stat の数字を、良し悪しを言わずに並べます。',
  backHref = '',
  backLabel = '',
  ogImage = null,
  preload = [],
} = Astro.props;
const here = Astro.url.pathname;
const cur = (href) => (href === '/' ? here === '/' : here.startsWith(href)) ? 'page' : undefined;
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={new URL(Astro.url.pathname, 'https://statlogia.com')} />
  <meta property="og:image" content={ogImage ? `https://statlogia.com${ogImage}` : 'https://statlogia.com/images/ogp.png'} />
  <meta property="og:site_name" content="Statlogia" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={new URL(Astro.url.pathname, 'https://statlogia.com')} />
  <link rel="preload" as="image" href="/images/concrete-tile.webp" />
  {preload.map((h) => <link rel="preload" as="image" href={h} fetchpriority="high" />)}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@600;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site">
    <div class="nav">
      <a class="logo" href="/">
        <span class="mark"><b>STAT</b>LOGIA</span>
        <span class="sub">数字の研究都市<span class="tagline">｜引いて、くらべて、読み解く</span></span>
      </a>
      <nav aria-label="主要メニュー">
        <ul>
          <li><a href="/" aria-current={cur('/')}>玄関</a></li>
          <li><a href="/dashboard/" aria-current={cur('/dashboard/')}>情報棟</a></li>
          <li><a href="/analysis/" aria-current={cur('/analysis/') || cur('/compare/')}>研究棟</a></li>
          <li class="nav-ex"><a href="/verify/" aria-current={cur('/verify/')}>検証室</a></li>
          <li><a href="/how-to-read/" aria-current={cur('/how-to-read/')}>講義棟</a></li>
          <li><a href="/search/" aria-current={cur('/search/')}>案内所</a></li>
          <li><a href="/guide/" aria-current={cur('/guide/')}>研究員</a></li>
        </ul>
      </nav>
    </div>
  </header>
  {backHref && (
    <div class="backbar">
      <a href={backHref}>← {backLabel}へ戻る</a>
    </div>
  )}
  <div class="paper">
    <slot />
  </div>
  {here !== '/terms/' && (
    <p class="disclaimer-line">掲載している数値は正確を期していますが、内容を保証するものではありません。くわしくは<a href="/terms/#disclaimer">「利用規約・免責」</a>をご覧ください。</p>
  )}
  <footer class="site">
    <div class="foot">
      <div class="foot-brand">
        <span class="mono">STATLOGIA</span>
        <span class="since">since 2026.10</span>
        <p class="tag">Japan in Numbers — 数字の研究都市、スタットロギア</p>
        <p class="foot-desc">都道府県・市区町村の統計を引き、くらべ、読み解く研究都市。数字は政府統計の総合窓口（e-Stat）から取り、月に2回、更新しています。</p>
      </div>

      <nav class="foot-links" aria-label="三つの棟">
        <span class="foot-heading">三つの棟</span>
        <a class="foot-link" href="/dashboard/">情報棟 ─ 引く</a>
        <a class="foot-link" href="/analysis/">研究棟 ─ 考える</a>
        <a class="foot-link" href="/verify/">検証室 ─ 確かめる</a>
        <a class="foot-link" href="/how-to-read/">講義棟 ─ 学ぶ</a>
        <a class="foot-link" href="/search/">案内所</a>
      </nav>

      <nav class="foot-links" aria-label="サイト情報">
        <span class="foot-heading">この都市について</span>
        <a class="foot-link" href="/editor/">運営者</a>
        <a class="foot-link" href="/guide/">研究員</a>
        <a class="foot-link" href="/gallery/">イラスト集</a>
        <a class="foot-link" href="/news/">掲示板</a>
      </nav>

      <nav class="foot-links" aria-label="規約">
        <span class="foot-heading">きまりごと</span>
        <a class="foot-link" href="/privacy/">プライバシーポリシー</a>
        <a class="foot-link" href="/terms/">利用規約・お問い合わせ</a>
      </nav>

      <a class="foot-sister" href="https://countopia.com/" rel="noopener">
        <span class="fs-label">SISTER SITE</span>
        <span class="fs-body">
          <span class="fs-title">Countopia Stats</span>
          <span class="fs-note">気楽に数字を楽しむ国。展示はこちらに。</span>
        </span>
        <span class="fs-arrow">→</span>
      </a>

      <a class="foot-source" href="/sources/">
        <span class="fs-label">SOURCES</span>
        <span class="fs-body">
          <span class="fs-title">出典一覧</span>
          <span class="fs-note">社会生活基本調査、住宅・土地統計調査、国勢調査ほか。どの数字がどの統計表から来ているか、表番号とe-Statへのリンクをまとめています。</span>
        </span>
        <span class="fs-arrow">→</span>
      </a>

      <div class="foot-credit">
        <p>本サイトの図表は政府統計（e-Stat等）を加工して作成しています。</p>
        <p>このサービスは、政府統計総合窓口(e-Stat)のAPI機能を使用していますが、サービスの内容は国によって保証されたものではありません。</p>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© 2026 Statlogia</span>
    </div>
  </footer>
  <style>
    .backbar { max-width: 860px; margin: 0 auto; padding: 14px 16px 0; }
    .backbar a {
      display: inline-block; font-size: 0.82rem; color: #2d6a4f;
      border: 1px solid #2d6a4f; border-radius: 999px; padding: 5px 14px;
      text-decoration: none; background: #fff8;
    }
    .backbar a:hover { background: #2d6a4f; color: #fff; }

    /* ロゴをトップへのリンクに。色はリンク色に引っ張られないよう継承させる */
    a.logo{display:flex;flex-direction:column;text-decoration:none;color:inherit}
    a.logo:hover .mark b { opacity: .8; }

    .mark .stats {
      font-size: 0.9em; opacity: .85; letter-spacing: .05em;
      margin-left: 2px; font-weight: 700;
    }
    .sub .tagline {
      opacity: .8;
    }
    @media (max-width: 1024px) {
      .sub .tagline { display: none; }
    }

    .foot {
      max-width: 1280px; margin: 0 auto; padding: 40px 16px 24px;
      display: grid;
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
      gap: 32px 40px;
      align-items: start;
    }
    .foot-brand .mono {
      display: inline-block; font-weight: 700; letter-spacing: .06em;
      font-size: 1rem; margin: 0 14px 10px 0;
    }
    .foot-brand .since {
      display: inline-block; font-size: .72rem; letter-spacing: .12em; opacity: .55;
      font-family: "IBM Plex Mono", monospace; margin: 0 0 10px;
    }
    .foot-desc { font-size: .78rem; line-height: 1.8; opacity: .6; margin: 8px 0 0; max-width: 30em; }
    .foot-brand .tag {
      font-size: .82rem; line-height: 1.9; opacity: .75; margin: 0;
      font-family: "Shippori Mincho", serif;
    }

    .foot-links { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
    .foot-heading {
      font-size: .72rem; letter-spacing: .2em; opacity: .6;
      margin-bottom: 2px; font-family: "IBM Plex Mono", monospace;
    }
    .foot-links .foot-link { font-size: .84rem; }
    .foot-note { font-size: .76rem; opacity: .75; line-height: 1.6; }
    .foot-link {
      color: #f4f1e6; text-decoration: underline;
      text-underline-offset: 3px; text-decoration-color: #f4f1e650;
    }
    .foot-link:hover { color: #f0b78a; text-decoration-color: #f0b78a; }

    /* 免責の一文：フッターの直上 */
    .disclaimer-line { max-width: 860px; margin: 28px auto 20px; padding: 0 16px; text-align: center; font-size: .75rem; line-height: 1.8; color: var(--ink-soft); }
    .disclaimer-line a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }

    /* 下段の二枚：出典一覧（左半分）と姉妹サイト（右半分） */
    .foot-source, .foot-sister {
      justify-self: stretch;
      width: 100%;
      display: flex; align-items: center; gap: 18px;
      padding: 14px 20px;
      border: 1px solid #f4f1e644; border-radius: 10px;
      background: #ffffff0a; text-decoration: none; color: #f4f1e6;
      transition: background .15s, border-color .15s;
    }
    .foot-source:hover, .foot-sister:hover { background: #ffffff14; border-color: #f0b78a88; }
    .foot-source { grid-column: 1 / 3; grid-row: 2; }
    .foot-sister { grid-column: 3 / -1; grid-row: 2; }
    .foot-source, .foot-sister { align-self: stretch; margin-top: 8px; }
    /* 姉妹サイトの札：右端に京と橙子。札の上辺から少し頭を出す */
    .fs-label {
      flex-shrink: 0; font-family: "IBM Plex Mono", monospace;
      font-size: .62rem; letter-spacing: .24em; opacity: .6;
    }
    .fs-body { flex: 1; min-width: 0; }
    .fs-title {
      display: block; font-family: "Shippori Mincho", serif;
      font-weight: 800; font-size: .95rem;
    }
    .fs-note { display: block; font-size: .75rem; opacity: .6; margin-top: 3px; line-height: 1.6; }
    .fs-arrow { flex-shrink: 0; color: #f0b78a; font-size: 1.1rem; }

    .foot-credit {
      grid-column: 1 / -1;
      padding-top: 24px; border-top: 1px solid #f4f1e622;
    }
    .foot-credit p {
      font-size: .78rem; line-height: 1.9; opacity: .65; margin: 0 0 6px;
      max-width: 68em;
    }

    .foot-bottom {
      max-width: 1280px; margin: 0 auto; padding: 0 16px 28px;
      font-size: .74rem; opacity: .55;
      font-family: "IBM Plex Mono", monospace; letter-spacing: .06em;
    }

    @media (max-width: 860px) {
      .foot { grid-template-columns: 1fr 1fr; }
      .foot-brand { grid-column: 1 / -1; }
      .foot-source, .foot-sister { grid-column: 1 / -1; grid-row: auto; }
    }
    @media (max-width: 560px) {
      .foot { grid-template-columns: 1fr; gap: 28px; padding: 32px 16px 20px; }
      .foot-source, .foot-sister { flex-direction: column; align-items: flex-start; gap: 8px; }
      .fs-arrow { align-self: flex-end; margin-top: -2px; }
    }
  </style>
  <!-- Cloudflare Web Analytics は自動注入（Automatic setup）。ここには貼らない -->
</body>
</html>