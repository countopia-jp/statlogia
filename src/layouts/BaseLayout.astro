---
import '../styles/global.css';
import { ROOM_NAMES } from '../data/page-names.js';
const {
  title = 'Countopia Stats｜都道府県・市区町村で引ける、暮らしの統計',
  description = '都道府県・市区町村で引ける、暮らしの統計。日本の公的統計を「へぇ」と眺めて遊ぶ国、Countopia Stats。',
  backHref = '',
  backLabel = '',
  ogImage = null,
} = Astro.props;
const here = Astro.url.pathname;
const isAnnex = here.startsWith('/annex') || (ROOM_NAMES[here] || '').startsWith('別館');
const cur = (href) => (href === '/' ? here === '/' : here.startsWith(href)) ? 'page' : undefined;
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={new URL(Astro.url.pathname, 'https://countopia.com')} />
  <meta property="og:image" content={ogImage ? `https://countopia.com${ogImage}` : 'https://countopia.com/images/ogp.png'} />
  <meta property="og:site_name" content="Countopia Stats" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={new URL(Astro.url.pathname, 'https://countopia.com')} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@600;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet" />
</head>
<body class={isAnnex ? 'annex' : undefined}>
  <header class="site">
    <div class="nav">
      <a class="logo" href="/">
        <span class="mark"><b>COUNT</b>OPIA <small class="stats">STATS</small><small class="kaiso">改装中</small><small class="xf">site transformation</small></span>
        <span class="sub">数字の国<span class="tagline">｜都道府県・市区町村で引ける、暮らしの統計</span></span>
      </a>
      <nav aria-label="主要メニュー">
        <ul>
          <li><a href="/" aria-current={cur('/')}>玄関</a></li>
          <li><a href="/exhibits/" aria-current={cur('/exhibits/')}>展示</a></li>
          <li><a href="/tower/" aria-current={cur('/tower/')}>展望塔</a></li>
          <li><a href="/dashboard/" aria-current={cur('/dashboard/')}>閲覧室</a></li>
          <li><a href="/compare/" aria-current={cur('/compare/')}>見くらべ</a></li>
          <li><a href="/analysis/" aria-current={cur('/analysis/')}>読み解き</a></li>
          <li><a href="/how-to-read/" aria-current={cur('/how-to-read/')}>歩き方</a></li>
          <li><a href="/guide/" aria-current={cur('/guide/')}>案内人</a></li>
        </ul>
      </nav>
    </div>
  </header>
  {backHref && (
    <div class="backbar">
      <a href={backHref}>← {backLabel}へ戻る</a>
    </div>
  )}
  <slot />
  {here === '/' && (
    <div class="annex-banner-wrap">
      <a class="annex-banner" href="/annex/">
        <img class="ab-icon" src="/images/icon/annex-building.webp" alt="" aria-hidden="true" width="240" height="240" loading="lazy" />
        <span class="ab-body">
          <span class="ab-label">ANNEX</span>
          <span class="ab-title">別館　暮らしの台帳</span>
          <span class="ab-note"><span class="ab-ph">財政や家計、給与や働き方、人の出入りや災害など、</span><span class="ab-ph">暮らしの内側の数字を綴じています。</span></span>
        </span>
        <span class="ab-arrow">→</span>
      </a>
    </div>
  )}
  {here !== '/terms/' && (
    <p class="disclaimer-line">掲載している数値は正確を期していますが、内容を保証するものではありません。くわしくは<a href="/terms/#disclaimer">「利用規約・免責」</a>をご覧ください。</p>
  )}
  <footer class="site">
    <div class="foot">
      <div class="foot-brand">
        <span class="mono">COUNTOPIA STATS</span> <span class="xf xf--foot">site transformation</span>
        <span class="since">since 2026.7</span>
        <p class="tag">Japan in Numbers — 数字の国、カウントピア</p>
      </div>

      <nav class="foot-links" aria-label="サイト情報">
        <span class="foot-heading">この国について</span>
        <a class="foot-link" href="/about/">入国審査場</a>
        <a class="foot-link" href="/editor/">編集室</a>
      </nav>

      <nav class="foot-links" aria-label="規約">
        <span class="foot-heading">きまりごと</span>
        <a class="foot-link" href="/privacy/">プライバシーポリシー</a>
        <a class="foot-link" href="/terms/">利用規約・お問い合わせ</a>
      </nav>

      <a class="foot-source" href="/sources/">
        <span class="fs-label">SOURCES</span>
        <span class="fs-body">
          <span class="fs-title">出典一覧</span>
          <span class="fs-note">社会生活基本調査、住宅・土地統計調査、国勢調査ほか。どの数字がどの統計表から来ているか、表番号とe-Statへのリンクをまとめています。</span>
        </span>
        <span class="fs-arrow">→</span>
      </a>

      <div class="foot-credit">
        <p>本サイトの図表は政府統計（e-Stat等）を加工して作成しています。</p>
        <p>このサービスは、政府統計総合窓口(e-Stat)のAPI機能を使用していますが、サービスの内容は国によって保証されたものではありません。</p>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© 2026 Countopia Stats</span>
    </div>
  </footer>
  <style>
    .backbar { max-width: 860px; margin: 0 auto; padding: 14px 16px 0; }
    .backbar a {
      display: inline-block; font-size: 0.82rem; color: #2d6a4f;
      border: 1px solid #2d6a4f; border-radius: 999px; padding: 5px 14px;
      text-decoration: none; background: #fff8;
    }
    .backbar a:hover { background: #2d6a4f; color: #fff; }

    /* ロゴをトップへのリンクに。色はリンク色に引っ張られないよう継承させる */
    a.logo{display:flex;flex-direction:column;text-decoration:none;color:inherit}
    a.logo:hover .mark b { opacity: .8; }

    .mark .stats {
      font-size: 0.9em; opacity: .85; letter-spacing: .05em;
      margin-left: 2px; font-weight: 700;
    }
    .sub .tagline {
      opacity: .8;
    }
    @media (max-width: 1024px) {
      .sub .tagline { display: none; }
    }

    .foot {
      max-width: 1280px; margin: 0 auto; padding: 40px 16px 24px;
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 32px 40px;
      align-items: start;
    }
    .foot-brand .mono {
      display: inline-block; font-weight: 700; letter-spacing: .06em;
      font-size: 1rem; margin: 0 14px 10px 0;
    }
    .foot-brand .since {
      display: inline-block; font-size: .72rem; letter-spacing: .12em; opacity: .55;
      font-family: "IBM Plex Mono", monospace; margin: 0 0 10px;
    }
    .foot-brand .tag {
      font-size: .82rem; line-height: 1.9; opacity: .75; margin: 0;
      font-family: "Shippori Mincho", serif;
    }

    .foot-links { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
    .foot-heading {
      font-size: .72rem; letter-spacing: .2em; opacity: .6;
      margin-bottom: 2px; font-family: "IBM Plex Mono", monospace;
    }
    .foot-links .foot-link { font-size: .84rem; }
    .foot-link {
      color: #f4f1e6; text-decoration: underline;
      text-underline-offset: 3px; text-decoration-color: #f4f1e650;
    }
    .foot-link:hover { color: #f0b78a; text-decoration-color: #f0b78a; }

    /* 別館への案内：フッターの直上、紙の地に置く（玄関＝トップページだけ） */
    .disclaimer-line { max-width: 860px; margin: 28px auto 20px; padding: 0 16px; text-align: center; font-size: .75rem; line-height: 1.8; color: var(--ink-soft); }
    .disclaimer-line a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
    .annex-banner-wrap { max-width: 1280px; margin: 32px auto 36px; padding: 0 16px; display: flex; justify-content: center; align-items: stretch; gap: 18px; flex-wrap: wrap; }
    .annex-banner-wrap .annex-banner { margin: 0; }
    @media (max-width: 1100px) { .annex-banner-wrap { flex-direction: column; align-items: center; } .annex-banner-wrap .annex-banner { width: 100%; max-width: 640px; box-sizing: border-box; } }
    .annex-banner {
      display: flex; align-items: center; gap: 18px;
      width: fit-content; max-width: 720px; margin: 0 auto;
      padding: 12px 22px 12px 12px;
      border: 1px solid #cdb48e; border-left: 4px solid #5a3e26; border-radius: 10px;
      /* 10-19 別館の板張り（annex-wood）に、薄いクリームの紙を重ねた木目調 */
      background: linear-gradient(rgba(251,246,236,.5), rgba(251,246,236,.5)), #efe3cf url("/images/icon/annex-wood.webp") center / 600px auto;
      text-decoration: none; color: #3b2a1a;
      box-shadow: 0 2px 8px rgba(90,62,38,.10);
      transition: background .15s, transform .15s, box-shadow .15s;
    }
    .annex-banner:hover, .annex-banner:focus-visible { background: linear-gradient(rgba(251,246,236,.68), rgba(251,246,236,.68)), #efe3cf url("/images/icon/annex-wood.webp") center / 600px auto; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(90,62,38,.16); }
    /* 10-18 館の絵を大きく */
    .ab-icon { flex-shrink: 0; width: 104px; height: 104px; border-radius: 8px; display: block; }
    .ab-body { flex: 1; min-width: 0; }
    .ab-label { display: block; font-family: "IBM Plex Mono", monospace; font-size: .62rem; letter-spacing: .24em; color: #5a3e26; }
    .ab-title { display: block; font-family: "Shippori Mincho", serif; font-weight: 800; font-size: 1rem; margin-top: 2px; }
    .ab-note { display: block; font-size: .78rem; color: #5a4a3a; margin-top: 3px; line-height: 1.6; }
    .ab-ph { display: block; }
    @media (max-width: 600px) { .ab-ph { display: inline; } }
    .ab-arrow { flex-shrink: 0; color: #b23a2f; font-size: 1.1rem; margin-left: 6px; }
    @media (max-width: 560px) {
      .annex-banner { gap: 12px; padding: 12px 14px 12px 12px; }
      .ab-icon { width: 84px; height: 84px; }
      .annex-banner-wrap { flex-direction: column; align-items: stretch; gap: 12px; }
      .annex-banner-wrap .annex-banner { width: auto; max-width: none; }
      .ab-arrow { display: none; }
    }

    /* 出典一覧：3カラムをまたいで横いっぱいに置く */
    .foot-source {
      grid-column: 1 / -1;
      justify-self: stretch;
      width: 100%;
      display: flex; align-items: center; gap: 18px;
      padding: 14px 20px;
      border: 1px solid #f4f1e644; border-radius: 10px;
      background: #ffffff0a; text-decoration: none; color: #f4f1e6;
      transition: background .15s, border-color .15s;
    }
    .foot-source:hover { background: #ffffff14; border-color: #f0b78a88; }
    .fs-label {
      flex-shrink: 0; font-family: "IBM Plex Mono", monospace;
      font-size: .62rem; letter-spacing: .24em; opacity: .6;
    }
    .fs-body { flex: 1; min-width: 0; }
    .fs-title {
      display: block; font-family: "Shippori Mincho", serif;
      font-weight: 800; font-size: .95rem;
    }
    .fs-note { display: block; font-size: .75rem; opacity: .6; margin-top: 3px; line-height: 1.6; }
    .fs-arrow { flex-shrink: 0; color: #f0b78a; font-size: 1.1rem; }

    .foot-credit {
      grid-column: 1 / -1;
      padding-top: 24px; border-top: 1px solid #f4f1e622;
    }
    .foot-credit p {
      font-size: .78rem; line-height: 1.9; opacity: .65; margin: 0 0 6px;
      max-width: 68em;
    }

    .foot-bottom {
      max-width: 1280px; margin: 0 auto; padding: 0 16px 28px;
      font-size: .74rem; opacity: .55;
      font-family: "IBM Plex Mono", monospace; letter-spacing: .06em;
    }

    @media (max-width: 860px) {
      .foot { grid-template-columns: 1fr 1fr; }
      .foot-brand { grid-column: 1 / -1; }
    }
    @media (max-width: 560px) {
      .foot { grid-template-columns: 1fr; gap: 28px; padding: 32px 16px 20px; }
      .foot-source { flex-direction: column; align-items: flex-start; gap: 8px; }
      .fs-arrow { align-self: flex-end; margin-top: -24px; }
    }
  </style>
  <!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "1929c443f3004e709b99ca6023f0f912"}'></script><!-- End Cloudflare Web Analytics -->
</body>
</html>