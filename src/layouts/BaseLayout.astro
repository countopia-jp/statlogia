---
import '../styles/global.css';
const {
  title = 'Countopia Stats｜都道府県・市区町村で引ける、暮らしの統計',
  description = '都道府県・市区町村で引ける、暮らしの統計。日本の公的統計を「へぇ」と眺めて遊ぶ国、Countopia Stats。',
  backHref = '',
  backLabel = '',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={new URL(Astro.url.pathname, 'https://countopia.com')} />
  <meta property="og:image" content="https://countopia.com/images/ogp.png" />
  <meta property="og:site_name" content="Countopia Stats" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={new URL(Astro.url.pathname, 'https://countopia.com')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@600;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site">
    <div class="nav">
      <div class="logo">
        <span class="mark"><b>COUNT</b>OPIA <small class="stats">STATS</small></span>
        <span class="sub">数字の国<span class="tagline">｜都道府県・市区町村で引ける、暮らしの統計</span></span>
      </div>
      <nav aria-label="主要メニュー">
        <ul>
          <li><a href="/">玄関</a></li>
          <li><a href="/exhibits/">展示</a></li>
          <li><a href="/tower/">展望塔</a></li>
          <li><a href="/dashboard/">閲覧室</a></li>
          <li><a href="/how-to-read/">歩き方</a></li>
          <li><a href="/guide/">案内人</a></li>
        </ul>
      </nav>
    </div>
  </header>
  {backHref && (
    <div class="backbar">
      <a href={backHref}>← {backLabel}へ戻る</a>
    </div>
  )}
  <slot />
  <footer class="site">
    <div class="foot">
      <div class="foot-main">
        <span class="mono">COUNTOPIA STATS — Japan in Numbers</span>
        <p class="credit">本サイトの図表は政府統計（e-Stat等）を加工して作成しています。</p>
        <p class="credit">このサービスは、政府統計総合窓口(e-Stat)のAPI機能を使用していますが、サービスの内容は国によって保証されたものではありません。</p>
       </div>
      <div class="foot-links-wrap">
        <a class="foot-qr-link" href="/" title="countopia.com">
          <img class="foot-qr" src="/images/icon/qr-countopia.webp" alt="Countopia Stats（countopia.com）へのQRコード" width="290" height="290" loading="lazy" />
        </a>
        <nav class="foot-links" aria-label="サイト情報">
          <a class="foot-link" href="/about/">入国審査場</a>
          <a class="foot-link" href="/privacy/">プライバシーポリシー</a>
          <a class="foot-link" href="/terms/">利用規約・お問い合わせ</a>
        </nav>
      </div>
    </div>
  </footer>
  <style>
    .backbar { max-width: 860px; margin: 0 auto; padding: 14px 16px 0; }
    .backbar a {
      display: inline-block; font-size: 0.82rem; color: #2d6a4f;
      border: 1px solid #2d6a4f; border-radius: 999px; padding: 5px 14px;
      text-decoration: none; background: #fff8;
    }
    .backbar a:hover { background: #2d6a4f; color: #fff; }
    .mark .stats {
      font-size: 0.9em; opacity: .85; letter-spacing: .05em;
      margin-left: 2px; font-weight: 700;
    }
    .sub .tagline {
      opacity: .8;
    }
    @media (max-width: 1024px) {
      .sub .tagline { display: none; }
    }

    .foot {
      max-width: 980px; margin: 0 auto; padding: 8px 4px;
      display: flex; justify-content: space-between;
      gap: 12px; align-items: start; flex-wrap: wrap;
    }
    .foot-main { flex: 1 1 420px; }
    .foot-main .mono { display: block; font-weight: 700; letter-spacing: .04em; margin-bottom: 14px; font-size: .9rem; }
    .foot-main .credit { font-size: .82rem; line-height: 2; opacity: .82; margin: 0 0 12px; white-space: nowrap; }

    .foot-links-wrap { display: flex; align-items: center; gap: 16px; flex: 0 0 auto; }
    .foot-qr-link { display: block; line-height: 0; flex: 0 0 auto; }
    .foot-qr {
      width: 64px; height: 64px;
      border-radius: 4px; background: #fdfdf8; padding: 3px;
    }

    .foot-links {
      display: flex; flex-direction: column; gap: 12px;
      flex: 0 0 auto; align-items: flex-start;
    }
    .foot-links .foot-link { font-size: .84rem; }
    .foot-link {
      color: #f4f1e6; text-decoration: underline;
      text-underline-offset: 3px; text-decoration-color: #f4f1e680;
    }
    .foot-link:hover { color: #f0b78a; text-decoration-color: #f0b78a; }

    @media (max-width: 640px) {
      .foot { padding: 8px 16px; }
      .foot-main .credit { white-space: normal; }
      .foot-links {
        flex-direction: row; flex-wrap: wrap; gap: 8px 16px;
        align-items: flex-start;
      }
    }

    @media (min-width: 641px) {
      .foot { gap: 40px; }
    }
  </style>
  <!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "1929c443f3004e709b99ca6023f0f912"}'></script><!-- End Cloudflare Web Analytics -->
</body>
</html>