---
// 掛け合い用コンポーネント
// 使い方: <Talk speaker="chiaki">セリフ</Talk> / <Talk speaker="hitoha">セリフ</Talk>
// img を差し替えれば全記事のアイコンが一斉に更新される(原画完成時はここだけ変更)
const { speaker = 'chiaki' } = Astro.props;
// Statlogia の二人：知秋（教授・左・紺。chiaki＝通常、chiaki-work＝仕事モードの顔）と一葉（研究員・右・灰）
const CHIAKI = { name: '知秋（教授）', img: '/images/chara/chiaki-face.webp', side: 'left',  tone: 'chiaki' };
const CHIAKI_WORK = { name: '知秋（教授）', img: '/images/chara/chiaki-work-face.webp', side: 'left',  tone: 'chiaki' };
const HITOHA = { name: '一葉（研究員）', img: '/images/chara/hitoha-face.webp', side: 'right', tone: 'hitoha' };
const profiles = {
  chiaki: CHIAKI,
  'chiaki-work': CHIAKI_WORK,
  hitoha: HITOHA,
};
const p = profiles[speaker] ?? profiles.chiaki;
---
<div class={`say ${p.side === 'right' ? 'right' : ''} ${p.tone}`}>
  <img class="face" src={p.img} alt={p.name} width="52" height="52" loading="lazy" />
  <div>
    <span class="name">{p.name}</span>
    <div class="bubble"><slot /></div>
  </div>
</div>
<style>
.say{display:flex;gap:14px;align-items:flex-start;max-width:760px;margin:14px 0}
.say.right{margin-left:auto;flex-direction:row-reverse}
.face{width:52px;height:52px;border-radius:50%;flex-shrink:0;background:var(--paper)}
/* セリフは枠線なしの色面。白地に枠線のカード（最多・最少など）と見分けがつくように */
.bubble{position:relative;background:#fff;border-radius:12px;padding:12px 16px;font-size:.95rem;font-weight:400;line-height:1.8}
.bubble::before{content:"";position:absolute;top:14px;left:-7px;border:7px solid transparent;border-left:0;border-right-color:var(--bubble-bg)}
.say.right .bubble::before{left:auto;right:-7px;border-right:0;border-left:7px solid var(--bubble-bg)}
.name{font-family:"IBM Plex Mono",monospace;font-size:.62rem;letter-spacing:.12em;color:var(--ink-soft);display:block;margin-bottom:4px}
/* 話者ごとの色分け（地の色・名前・セリフ文字） */
.say.chiaki{--bubble-bg:#e3e7f0}
.say.hitoha{--bubble-bg:#ecebe6}
.say.chiaki .bubble{color:#222}
.say.chiaki .name{color:#1f2a44}
.say.hitoha .bubble{color:#222}
.say.hitoha .name{color:#4a4a4a}
.say.kei{--bubble-bg:#e4eee7}
.say.touko{--bubble-bg:#f8e5df}
.say .bubble{background:var(--bubble-bg)}
.say.kei .bubble{color:#222}
.say.kei .name{color:#4B5570}
.say.touko .bubble{color:#222}
.say.touko .name{color:#a33227}
.say.shiori{--bubble-bg:#e3eef7}
.say.shiori .bubble{color:#222}
.say.shiori .name{color:#2c4a7a}
/* スマホでは顔を大きく（表情が見えるように） */
@media(max-width:600px){
  .say{gap:10px}
  .face{width:64px;height:64px}
}
</style>
