---
// =====================================================
// Statlogia - 人口の形（人口ピラミッド）
// src/components/PyramidTool.astro
// ページの県／市区町村のセレクタ（selectId）で選ばれた地域の、5歳ごと・男女別の人口の割合を
// ピラミッドで描き、全国（町なら県も）の形を線で重ねる。データは lib/pyramid.js（令和2年国勢調査）。
//   <PyramidTool level="pref" selectId="prefSelect" />   県の値は '01000' でも '01' でもよい
//   <PyramidTool level="town" selectId="townSelect" />
// =====================================================
interface Props { level: 'pref' | 'town'; selectId: string; }
const { level, selectId } = Astro.props;
const isTown = level === 'town';
---
<section class="pyr" hidden data-level={level} data-select={selectId} aria-label="人口の形">
  <h2>人口の形（年齢と男女）</h2>
  <p class="pyr-note">5歳ごとの人口が、その{isTown ? '町' : '県'}の人口全体のどれだけを占めるかを、左に男性、右に女性で並べました。線は{isTown ? '全国（または県）' : '全国'}の形です。</p>
  {isTown && <div class="pyr-mode" role="group" aria-label="重ねる形"><button type="button" data-cmp="nat" class="is-on">全国と重ねる</button><button type="button" data-cmp="pref">県と重ねる</button></div>}
  <div class="pyr-fig"></div>
  <div class="pyr-tiles"></div>
  <p class="pyr-read"></p>
  <p class="pyr-src"></p>
  <p class="pyr-src pyr-how" hidden>読み方：<a href="/how-to-read/pyramid/">人口の形を読む</a></p>
</section>

<script is:inline>
(function () {
  const PREFS = {};
  const TOWN = {};
  const load = async (url, store, key) => { if (!(key in store)) { try { store[key] = await (await fetch(url)).json(); } catch (e) { store[key] = null; } } return store[key]; };
  const sum = (a) => a.reduce((s, x) => s + x, 0);
  const shares = (o) => { const T = sum(o.m) + sum(o.f); return T > 0 ? { m: o.m.map((x) => (x / T) * 100), f: o.f.map((x) => (x / T) * 100), T } : null; };
  const band = (o, i0, i1) => { const T = sum(o.m) + sum(o.f); let s = 0; for (let i = i0; i <= i1; i++) s += o.m[i] + o.f[i]; return T > 0 ? (s / T) * 100 : null; };
  const f1 = (v) => v.toFixed(1);
  const sg = (v) => `${v >= 0 ? '+' : '−'}${Math.abs(v).toFixed(1)}`;
  function svg(groups, me, cmp, cmpLabel) {
    const R = groups.length, RH = 15, TOP = 18, W = 640, MID = 320, GAP = 34, LAB = 62;
    const max = Math.max(...me.m, ...me.f, ...(cmp ? [...cmp.m, ...cmp.f] : [])) * 1.08;
    const half = MID - GAP - 8;
    const sx = (v) => (v / max) * half;
    const y = (i) => TOP + (R - 1 - i) * RH;
    let b = '';
    for (let i = 0; i < R; i++) {
      const yy = y(i);
      b += `<rect x="${(MID - GAP - sx(me.m[i])).toFixed(1)}" y="${yy + 1.5}" width="${sx(me.m[i]).toFixed(1)}" height="${RH - 3}" fill="#4a6fa5" fill-opacity=".75"><title>${groups[i]} 男 ${f1(me.m[i])}％</title></rect>`;
      b += `<rect x="${MID + GAP}" y="${yy + 1.5}" width="${sx(me.f[i]).toFixed(1)}" height="${RH - 3}" fill="#B3402A" fill-opacity=".7"><title>${groups[i]} 女 ${f1(me.f[i])}％</title></rect>`;
      if (i % 2 === 0) b += `<text x="${MID}" y="${yy + RH - 4}" text-anchor="middle" font-size="10" fill="#555">${groups[i].replace('〜', '-').replace('歳', '').replace('以上', '+')}</text>`;
    }
    if (cmp) {
      const ptsL = [], ptsR = [];
      for (let i = 0; i < R; i++) {
        const y0 = y(i), y1 = y0 + RH;
        ptsL.push(`${(MID - GAP - sx(cmp.m[i])).toFixed(1)},${y1}`, `${(MID - GAP - sx(cmp.m[i])).toFixed(1)},${y0}`);
        ptsR.push(`${(MID + GAP + sx(cmp.f[i])).toFixed(1)},${y1}`, `${(MID + GAP + sx(cmp.f[i])).toFixed(1)},${y0}`);
      }
      b += `<polyline points="${ptsL.join(' ')}" fill="none" stroke="#1F2A44" stroke-width="1.6"/><polyline points="${ptsR.join(' ')}" fill="none" stroke="#1F2A44" stroke-width="1.6"/>`;
    }
    const H = TOP + R * RH + 26;
    b += `<text x="${MID - GAP - 4}" y="12" text-anchor="end" font-size="11" fill="#4a6fa5" font-weight="700">男</text><text x="${MID + GAP + 4}" y="12" font-size="11" fill="#B3402A" font-weight="700">女</text>`;
    b += `<text x="${MID}" y="12" text-anchor="middle" font-size="10" fill="#555">年齢</text>`;
    const tk = max >= 6 ? 2 : max >= 3 ? 1 : 0.5;
    for (let v = tk; v < max; v += tk) {
      for (const xx of [MID - GAP - sx(v), MID + GAP + sx(v)]) b += `<line x1="${xx.toFixed(1)}" y1="${TOP}" x2="${xx.toFixed(1)}" y2="${TOP + R * RH}" stroke="#1F2A44" stroke-opacity=".08"/><text x="${xx.toFixed(1)}" y="${TOP + R * RH + 13}" text-anchor="middle" font-size="9.5" fill="#777">${v}％</text>`;
    }
    if (cmp) b += `<line x1="${W - 150}" y1="${H - 6}" x2="${W - 128}" y2="${H - 6}" stroke="#1F2A44" stroke-width="1.6"/><text x="${W - 124}" y="${H - 2}" font-size="10.5" fill="#333">${cmpLabel}の形</text>`;
    return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="5歳ごとの男女別人口の割合を示す人口ピラミッド。線は${cmpLabel}">${b}</svg>`;
  }
  async function draw(sec) {
    const level = sec.dataset.level;
    const sel = document.getElementById(sec.dataset.select);
    if (!sel) return;
    let code = sel.value;
    if (!code) { sec.hidden = true; return; }
    if (level === 'pref' && code.length === 2) code += '000';
    let groups, me, nat, pref, src, year;
    if (level === 'pref') {
      const D = await load('/data/pyramid.json', PREFS, 'all');
      if (!D) return;
      groups = D.groups; src = D.source; year = D.year;
      me = D.areas.find((a) => a.c === code); nat = D.areas.find((a) => a.c === '00000');
    } else {
      const p = code.slice(0, 2) + '000';
      const D = await load(`/data/pyramid-town/${p}.json`, TOWN, p);
      if (!D) return;
      groups = D.groups; src = D.source; year = D.year;
      me = D.towns.find((a) => a.c === code); nat = D.nat; pref = D.pref;
    }
    if (!me) { sec.hidden = true; return; }
    const which = sec.dataset.cmp === 'pref' && pref ? 'pref' : 'nat';
    const C = which === 'pref' ? pref : nat;
    const S = shares(me), SC = shares(C);
    if (!S) { sec.hidden = true; return; }
    sec.hidden = false;
    const cLabel = which === 'pref' ? pref.n : '全国';
    sec.querySelector('.pyr-fig').innerHTML = svg(groups, S, SC, cLabel);
    const bands = [['15歳未満', 0, 2], ['15〜64歳', 3, 12], ['65歳以上', 13, 20]];
    sec.querySelector('.pyr-tiles').innerHTML = bands.map(([lab, a, b]) => { const v = Number(f1(band(me, a, b))), c = Number(f1(band(C, a, b))); return `<div><span>${lab}</span><b>${f1(v)}％</b><span>${cLabel} ${f1(c)}％（${sg(v - c)}ポイント）</span></div>`; }).join('');
    const diffs = groups.map((g, i) => ({ g, d: S.m[i] + S.f[i] - (SC.m[i] + SC.f[i]) }));
    const hi = [...diffs].sort((x, y) => y.d - x.d).filter((x) => x.d > 0.05).slice(0, 2);
    const lo = [...diffs].sort((x, y) => x.d - y.d).filter((x) => x.d < -0.05).slice(0, 2);
    const nm = me.n;
    const txt = [];
    if (hi.length) txt.push(`${cLabel}の形とくらべて、割合が大きいのは${hi.map((x) => `${x.g}（${sg(x.d)}ポイント）`).join('、')}`);
    if (lo.length) txt.push(`小さいのは${lo.map((x) => `${x.g}（${sg(x.d)}ポイント）`).join('、')}`);
    sec.querySelector('.pyr-read').textContent = txt.length ? `${nm}は、${txt.join('、')}です。` : `${nm}の形は、${cLabel}とほぼ同じです。`;
    sec.querySelector('.pyr-src').textContent = `出典：${src}（${year}）。年齢の分からない人は除き、年齢の分かる人口に対する割合です。100歳以上はまとめて1段にしています。`;
    sec.querySelector('.pyr-how').hidden = false;
  }
  for (const sec of document.querySelectorAll('.pyr')) {
    const sel = document.getElementById(sec.dataset.select);
    if (!sel) continue;
    sel.addEventListener('change', () => draw(sec));
    sec.querySelectorAll('.pyr-mode button').forEach((btn) => btn.addEventListener('click', () => {
      sec.dataset.cmp = btn.dataset.cmp;
      sec.querySelectorAll('.pyr-mode button').forEach((x) => x.classList.toggle('is-on', x === btn));
      draw(sec);
    }));
    // ページの側が値を入れてから change を出さない場合（?pref= で開いたときなど）に備えて、少しあとにも描く
    setTimeout(() => draw(sec), 1200);
  }
})();
</script>

<style is:global>
  .pyr { margin: 36px 0 24px; padding: 18px 18px 14px; border: 1px solid #ddd6c4; border-radius: 12px; background: #fffdf7; }
  .pyr h2 { font-family: "Shippori Mincho", serif; font-size: 1.15rem; margin: 0 0 6px; text-align: center; }
  .pyr-note, .pyr-src { font-size: .78rem; color: #666; line-height: 1.8; margin: 4px 0; }
  .pyr-mode { display: flex; gap: 8px; justify-content: center; margin: 8px 0 4px; }
  .pyr-mode button { padding: 5px 12px; border: 1px solid #1F2A44; border-radius: 999px; background: #fff; color: #1F2A44; font-size: .82rem; cursor: pointer; }
  .pyr-mode button.is-on { background: #1F2A44; color: #fff; }
  .pyr-fig svg { display: block; width: 100%; max-width: 640px; height: auto; margin: 8px auto; }
  .pyr-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 8px 0; }
  .pyr-tiles > div { background: #fff; border: 1px solid #ddd6c4; border-radius: 10px; padding: 8px 10px; display: flex; flex-direction: column; gap: 2px; }
  .pyr-tiles span { font-size: .74rem; color: #555; }
  .pyr-tiles b { font-size: 1.15rem; color: #1F2A44; }
  .pyr-read { font-size: .9rem; line-height: 1.9; margin: 8px 0 4px; }
  @media (max-width: 600px) { .pyr-tiles { gap: 6px; } .pyr-tiles > div { padding: 6px 8px; } .pyr-tiles b { font-size: 1rem; } .pyr-tiles span { font-size: .68rem; } .pyr { padding: 14px 10px 10px; } }
</style>
