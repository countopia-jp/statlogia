---
// =====================================================
// 2つの数字をくらべる展示の共通部品（カラオケと楽器・牛肉と豚肉と同じ型）
// src/components/PairExhibit.astro
//
// data = { year, national, rows, second: { national, rows }, share?: { national, rows }, source, cityCount? }
//   rows は {c, n, minutes} を多い順に並べたもの（minutes は値。名前は他の展示に合わせている）
// unit = 'pct'（行動者率など、小数第1位の％）／'yen'（1世帯の年間支出額、円）
// area = '県'（47都道府県）／'市'（県庁所在市と政令指定都市）
// a / b = { label: '映画館で映画を見る人', short: '映画館' }
// intro = [[話者, 文]…]。文の中の {A_NAT} {B_NAT} {N} {YEAR} は数字に置きかわる
// セリフの文はすべてここで組み立て、テンプレートでは {変数} だけを使う（入れ子のテンプレート文字列は
// Astro のコンパイラが読み違えるため）
// =====================================================
import ExhibitHero from './ExhibitHero.astro';
import { splitTitle } from '../lib/split-title.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import Talk from './Talk.astro';

const { data, unit, area, no, slug, title, sub, pageTitle, description, a, b, genre, intro, secondAsk, shareLabel, notes, cross } = Astro.props;

const isYen = unit === 'yen';
const fmt = (v) => (isYen ? Math.round(v).toLocaleString() + '円' : v.toFixed(1) + '％');
const same = (x, y) => (isYen ? Math.round(x) === Math.round(y) : x.toFixed(1) === y.toFixed(1));
const diffText = (x, y) => (isYen ? Math.round(Math.abs(x - y)).toLocaleString() + '円' : Math.abs(Number(x.toFixed(1)) - Number(y.toFixed(1))).toFixed(1) + 'ポイント');
const pct = (v) => v.toFixed(1) + '％';
const samePct = (x, y) => x.toFixed(1) === y.toFixed(1);
const areaAll = area === '県' ? '47都道府県' : `${data.cityCount}市`;
const areaWord = area === '県' ? '県' : '市';

// 5番目と同じ値は表にいっしょに載せる（同率を切らない）
const topCut = (list, eq) => { const v = list[4].minutes; return list.filter((r) => r.minutes > v || eq(r.minutes, v)); };
const lowCut = (list, eq) => { const v = list[list.length - 5].minutes; return list.filter((r) => r.minutes < v || eq(r.minutes, v)).reverse(); };
const rankIn = (list, eq) => (v) => list.findIndex((r) => eq(r.minutes, v)) + 1;
const namesAt = (list, eq, v) => list.filter((r) => eq(r.minutes, v)).map((r) => r.n);
const rankOfName = (list, name) => {
  const v = list.find((r) => r.n === name)?.minutes;
  return v === undefined ? 0 : list.findIndex((r) => same(r.minutes, v)) + 1;
};

const A = data.rows;
const B = data.second.rows;
const aMost = topCut(A, same), aLeast = lowCut(A, same);
const bMost = topCut(B, same), bLeast = lowCut(B, same);
const aRank = rankIn(A, same), aLowRank = rankIn(aLeast, same);
const bRank = rankIn(B, same), bLowRank = rankIn(bLeast, same);
const aMax = A[0].minutes, bMax = B[0].minutes;
const aTopNames = namesAt(A, same, A[0].minutes);
const aBottomNames = namesAt(aLeast, same, A[A.length - 1].minutes);
const bTopNames = namesAt(B, same, B[0].minutes);
const sameTop = aTopNames.length === 1 && bTopNames.length === 1 && aTopNames[0] === bTopNames[0];
const bothTop = aMost.map((r) => r.n).filter((n) => bMost.map((r) => r.n).includes(n));
const twist = !sameTop && bothTop.length <= 2;

// 片方の下位5に入るのに、もう片方では上位10に入る（無ければ逆）
const bTop10 = B.slice(0, 10).map((r) => r.n), aTop10 = A.slice(0, 10).map((r) => r.n);
const swapA = aLeast.map((r) => r.n).filter((n) => bTop10.includes(n));
const swapB = bLeast.map((r) => r.n).filter((n) => aTop10.includes(n));
const hasSwap = swapA.length > 0 || swapB.length > 0;
const swapName = swapA[0] || swapB[0] || '';

const fill = (s) => s
  .replaceAll('{A_NAT}', data.national === null ? '' : fmt(data.national))
  .replaceAll('{B_NAT}', data.second.national === null ? '' : fmt(data.second.national))
  .replaceAll('{N}', String(data.cityCount ?? 47))
  .replaceAll('{YEAR}', data.year || '');
const introLines = intro.map(([who, s]) => [who, fill(s)]);

const nat = data.national, natB = data.second.national;
const natLine = nat !== null && natB !== null
  ? '全国で' + fmt(natB) + '。' + a.short + 'より' + diffText(natB, nat) + (natB > nat ? '多い' : natB < nat ? '少ない' : '') + '数字です。'
  : '';
const secondLine = natLine + (sameTop ? 'いちばん多い' + areaWord + 'は、同じでした。' : 'いちばん多い' + areaWord + 'が入れかわります。');
const topAskLine = a.short + 'で一番だった' + aTopNames.join('と') + 'は、' + b.short + 'では何番目なの。';
const topAnsLine = aTopNames.map((n) => n + 'は' + rankOfName(B, n) + '番目').join('、') + 'です。かわりに' + b.short + 'で一番なのは' + bTopNames.join('と') + 'で、' + a.short + 'では' + bTopNames.map((n) => n + 'は' + rankOfName(A, n) + '番目').join('、') + 'でした。';
const swapLine = swapA.length
  ? 'あら、' + swapName + 'は' + a.short + 'では' + rankOfName(A, swapName) + '番目なのに、' + b.short + 'では' + rankOfName(B, swapName) + '番目なのね。'
  : 'あら、' + swapName + 'は' + b.short + 'では' + rankOfName(B, swapName) + '番目なのに、' + a.short + 'では' + rankOfName(A, swapName) + '番目なのね。';
const swapAns = 'はい。同じ' + genre + 'でも、' + areaWord + 'ごとの並びは別ものです。';

// 金額の展示だけ：2つを足したうち、a の占める割合
const share = data.share;
const sMost = share ? topCut(share.rows, samePct) : [];
const sLeast = share ? lowCut(share.rows, samePct) : [];
const sRank = share ? rankIn(share.rows, samePct) : () => 0;
const sLowRank = share ? rankIn(sLeast, samePct) : () => 0;
const shareIntro = share ? a.short + 'と' + b.short + 'に使ったお金を足して、そのうち' + a.short + 'がどれだけを占めるかも出しました。全国では' + pct(share.national) + 'です。' : '';
const over = share ? share.rows.filter((r) => r.minutes > 50) : [];
const shareTouko = share ? (over.length ? a.short + 'のほうに多く使っている' + areaWord + 'は、' + over.length + areaWord + 'あるのね。' : a.short + 'のほうに多く使っている' + areaWord + 'は、ひとつもないのね。') : '';
---
<BaseLayout title={pageTitle} description={description} backHref="/exhibits/" backLabel="展示一覧">
  <main>
    <section class="exhibit">
      <ExhibitHero slug={slug}>
        <span class="no">EXHIBIT {no}</span>
        <h1>{splitTitle(title)[1] ? <><span class="h1a">{splitTitle(title)[0]}</span><span class="h1b">{splitTitle(title)[1]}</span></> : title}</h1>
        <p class="sub">{sub}（{data.year}）</p>
      </ExhibitHero>

      {introLines.map(([who, s]) => <Talk speaker={who}>{s}</Talk>)}

      <div class="highlight">
        <div class="card card--hot">
          <span class="seal" aria-hidden="true"><b>最多</b></span>
          <span class="label">{a.label}がいちばん多い</span>
          <strong>{aTopNames.join('・')}</strong>
          <span class="num">{fmt(A[0].minutes)}</span>
        </div>
        <div class="card card--cool">
          <span class="seal" aria-hidden="true"><b>最少</b></span>
          <span class="label">{a.label}がいちばん少ない</span>
          <strong>{aBottomNames.join('・')}</strong>
          <span class="num">{fmt(A[A.length - 1].minutes)}</span>
        </div>
      </div>

      <h2>{a.label}が多い{areaWord} TOP5</h2>
      <ol class="rank">
        {aMost.map((r) => (
          <li><span class="pos">{aRank(r.minutes)}</span><span class="pref">{r.n}</span><span class="bar" style={`--w:${(r.minutes / aMax) * 100}%`}></span><span class="min">{fmt(r.minutes)}</span></li>
        ))}
      </ol>
      <h2>{a.label}が少ない{areaWord} TOP5</h2>
      <ol class="rank low">
        {aLeast.map((r) => (
          <li><span class="pos">{aLowRank(r.minutes)}</span><span class="pref">{r.n}</span><span class="bar" style={`--w:${(r.minutes / aMax) * 100}%`}></span><span class="min">{fmt(r.minutes)}</span></li>
        ))}
      </ol>
      <details class="all">
        <summary>{areaAll}すべてを見る（多い順）</summary>
        <ol>{A.map((r) => <li>{r.n}　{fmt(r.minutes)}</li>)}</ol>
      </details>

      <h2>{twist ? 'ところが' : 'こんどは'}、{b.short}を数えると</h2>
      <Talk speaker="touko">{secondAsk}</Talk>
      <Talk speaker="kei">{secondLine}</Talk>

      <h2>{b.label}が多い{areaWord} TOP5</h2>
      <ol class="rank second">
        {bMost.map((r) => (
          <li><span class="pos">{bRank(r.minutes)}</span><span class="pref">{r.n}</span><span class="bar" style={`--w:${(r.minutes / bMax) * 100}%`}></span><span class="min">{fmt(r.minutes)}</span></li>
        ))}
      </ol>
      <h2>{b.label}が少ない{areaWord} TOP5</h2>
      <ol class="rank low">
        {bLeast.map((r) => (
          <li><span class="pos">{bLowRank(r.minutes)}</span><span class="pref">{r.n}</span><span class="bar" style={`--w:${(r.minutes / bMax) * 100}%`}></span><span class="min">{fmt(r.minutes)}</span></li>
        ))}
      </ol>

      {!sameTop && <Talk speaker="touko">{topAskLine}</Talk>}
      {!sameTop && <Talk speaker="kei">{topAnsLine}</Talk>}
      {hasSwap && <Talk speaker="touko">{swapLine}</Talk>}
      {hasSwap && <Talk speaker="kei">{swapAns}</Talk>}

      <details class="all">
        <summary>{b.short}も{areaAll}すべてを見る（多い順）</summary>
        <ol>{B.map((r) => <li>{r.n}　{fmt(r.minutes)}</li>)}</ol>
      </details>

      {share && <h2>{shareLabel}</h2>}
      {share && <Talk speaker="kei">{shareIntro}</Talk>}
      {share && <Talk speaker="touko">{shareTouko}</Talk>}
      {share && <h2>{a.short}の割合が高い{areaWord} TOP5</h2>}
      {share && (
        <ol class="rank share">
          {sMost.map((r) => (
            <li><span class="pos">{sRank(r.minutes)}</span><span class="pref">{r.n}</span><span class="bar" style={`--w:${r.minutes}%`}></span><span class="min">{pct(r.minutes)}</span></li>
          ))}
        </ol>
      )}
      {share && <h2>{a.short}の割合が低い{areaWord} TOP5</h2>}
      {share && (
        <ol class="rank low">
          {sLeast.map((r) => (
            <li><span class="pos">{sLowRank(r.minutes)}</span><span class="pref">{r.n}</span><span class="bar" style={`--w:${r.minutes}%`}></span><span class="min">{pct(r.minutes)}</span></li>
          ))}
        </ol>
      )}

      <p class="note">{notes}</p>
      <p class="cross">あわせて読む：{cross.map(([href, label], i) => <>{i > 0 && '｜'}<a href={href}>{label}</a></>)}</p>
      <div class="source">
        <p>出典：{data.source}</p>
        <p>このサービスは、政府統計総合窓口(e-Stat)のAPI機能を使用していますが、サービスの内容は国によって保証されたものではありません。</p>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
.exhibit{padding:56px 0 80px;max-width:720px;margin:0 auto}
.sec-head .no{font-family:"IBM Plex Mono",monospace;font-size:.72rem;letter-spacing:.3em;color:var(--stamp)}
h1{font-family:"Shippori Mincho",serif;font-weight:800;font-size:clamp(1.5rem,4vw,2.2rem);margin-top:8px}
.sub{color:var(--ink-soft);font-size:.85rem;margin-top:6px;margin-bottom:28px}
h2{font-family:"Shippori Mincho",serif;font-size:1.15rem;margin:40px 0 16px;border-left:4px solid var(--stamp);padding-left:12px}
.highlight{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:28px 0}
@media(max-width:560px){.highlight{grid-template-columns:1fr}}
.card{position:relative;border:1px solid var(--line);border-radius:12px;padding:20px;background:#fff;display:flex;flex-direction:column;gap:4px;align-items:flex-start}
.card .label{font-size:.72rem;letter-spacing:.2em;color:var(--ink-soft)}
.card strong{font-family:"Shippori Mincho",serif;font-size:1.9rem;line-height:1.2}
.card .num{font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:1.1rem}
.card--hot .num{color:#b23a2f}
.card--cool .num{color:#2d6a4f}
.seal{position:absolute;top:12px;right:14px;width:48px;height:48px;border:2px solid currentColor;border-radius:50%;display:flex;align-items:center;justify-content:center;transform:rotate(-12deg);opacity:.55;font-family:"Shippori Mincho",serif}
.seal b{font-size:.8rem;line-height:1;letter-spacing:.06em}
.card--hot .seal{color:#b23a2f}
.card--cool .seal{color:#2d6a4f}
.rank{list-style:none;padding:0;display:flex;flex-direction:column;gap:10px}
.rank li{display:grid;grid-template-columns:2em 6.5em 1fr auto;align-items:center;gap:10px}
.rank .pos{font-family:"IBM Plex Mono",monospace;color:var(--stamp);font-weight:600}
.rank .bar{height:10px;border-radius:99px;background:var(--stamp);width:var(--w);opacity:.85;min-width:8px}
.rank.low .bar{background:#3a6b52}
.rank.second .bar{background:#5f8f87}
.rank.share .bar{background:#8a5a7a}
.rank .min{font-family:"IBM Plex Mono",monospace;font-size:.85rem;color:var(--ink-soft)}
.all{margin:32px 0}
.all summary{cursor:pointer;color:var(--stamp);font-size:.9rem}
.all ol{columns:2;margin-top:14px;font-size:.9rem;color:var(--ink-soft)}
@media(max-width:560px){.all ol{columns:1}}
.note{margin-top:28px;font-size:.85rem;color:var(--ink-soft);line-height:1.9}
.cross{margin-top:36px;font-size:.9rem}
.cross a{color:var(--stamp)}
.source{margin-top:48px;padding-top:20px;border-top:1px solid var(--line);font-size:.75rem;color:var(--ink-soft);line-height:1.8}
</style>
