---
// Chart.js グラフコンポーネント
// dataUrl: /public 配下のJSONパス（例: /data/sleep.json）
// JSON形式: { "title": "...", "labels": [...], "values": [...], "unit": "分" }
const { dataUrl, height = 320 } = Astro.props;
const chartId = `chart-${Math.random().toString(36).slice(2, 9)}`;
---
<div class="chart-wrap">
  <canvas id={chartId} height={height} data-src={dataUrl}></canvas>
</div>

<script>
  import Chart from 'https://cdn.jsdelivr.net/npm/chart.js@4/auto/+esm';

  document.querySelectorAll('canvas[data-src]').forEach(async (canvas) => {
    if (canvas.dataset.rendered) return;
    canvas.dataset.rendered = '1';
    try {
      const res = await fetch(canvas.dataset.src);
      const d = await res.json();
      new Chart(canvas, {
        type: 'bar',
        data: {
          labels: d.labels,
          datasets: [{
            label: d.title,
            data: d.values,
            backgroundColor: d.values.map((v, i) =>
              i === d.values.indexOf(Math.max(...d.values)) ? '#B3402A' : '#7FA8A0'
            ),
            borderRadius: 3,
          }],
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false }, title: { display: true, text: d.title, font: { size: 14 } } },
          scales: { y: { title: { display: !!d.unit, text: d.unit } } },
        },
      });
    } catch (e) {
      canvas.replaceWith(Object.assign(document.createElement('p'), { textContent: 'グラフを読み込めませんでした。' }));
    }
  });
</script>
