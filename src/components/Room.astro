    const svg = stripSvg(ind, a);
    if (svg) h += `<div class="rm-card-dist">${svg}<div class="rm-card-pos">${ind.perCap && POP ? '人口あたりで ' : ''}${pos}</div></div>`;
    return h;
  }
  // 標本調査の誤差の目安（95％）：その年の値にだけ。％の項目はポイントで
  function seOf(ind, a, lk) {
    if (!ind.se || !lk || (ind.se.y && ind.years[lk.i] !== ind.se.y)) return '';
    const r = ind.se.r[a.c];
    if (typeof r !== 'number' || typeof lk.v !== 'number') return '';
    const h = (1.96 * r * lk.v) / 100;
    const dec = ind.decimals ?? 1;
    return `<div class="rm-card-meta rm-card-meta--soft rm-card-se">誤差の目安 <span>±${h.toLocaleString('ja-JP', { minimumFractionDigits: dec, maximumFractionDigits: dec })}${ind.unit === '％' ? 'ポイント' : (ind.unit || '')}</span></div>`;
  }
  function render(a) {
    current = a;
    if (!isPref && document.getElementById('rmSpread')) setTimeout(() => showRank(), 0);
    compare = compare.filter((b) => b.c !== a.c);
    document.getElementById('rmResult').hidden = false;
    document.getElementById('rmTitle').textContent = `${a.n}の帳面`;
    const cards = document.getElementById('rmCards');
    cards.innerHTML = '';
    const ranks = [];
    for (const ind of IND) {
      const lk = lastKnown(a, ind);
      const isLatest = lk && lk.i === L(ind);
      let meta = '';
      if (!lk) {
        meta = '<div class="rm-card-meta rm-card-meta--soft">この' + (isPref ? '県' : '町') + 'の値はありません</div>';
      } else if (a.x) {
        meta = '<div class="rm-card-meta rm-card-meta--soft">政令市の区のため順位は出しません</div>';
      } else if (isLatest && NO_RANK) {
        const nat = isPref ? D.national[ind.key][L(ind)] : null;
        meta = nat === null ? '' : `<div class="rm-card-meta rm-card-meta--soft">${D.nationalIsAvg && D.nationalIsAvg[ind.key] ? '47都道府県の平均' : '全国'} <span>${fmtText(ind, nat)}</span></div>`;
      } else if (isLatest) {
        const all = poolOf(ind);
        const rk = rankIn(ind, a, all);
        ranks.push({ ind, rk, n: all.length });
        if (isPref) {
          const nat = D.national[ind.key][L(ind)];
          meta = `<div class="rm-card-meta">47都道府県中 ${rk}位<span>（${ind.rankWord}）</span></div>` +
            (nat === null ? '' : D.nationalIsTotal && D.nationalIsTotal[ind.key]
              ? `<div class="rm-card-meta rm-card-meta--soft">全国の合計 <span>${fmtText(ind, nat)}</span></div><div class="rm-card-meta rm-card-meta--soft">47都道府県の平均 <span>${fmtText(ind, D.prefAverage[ind.key][L(ind)])}</span></div>`
              : `<div class="rm-card-meta rm-card-meta--soft">${D.nationalIsAvg[ind.key] ? '47都道府県の平均' : '全国'} <span>${fmtText(ind, nat)}</span></div>`);
        } else {
          const pp = poolOf(ind, prefOf(a));
          meta = `<div class="rm-card-meta">全国 ${rk}位／${all.length}<span>（${ind.rankWord}）</span></div>` +
            `<div class="rm-card-meta rm-card-meta--soft">${PREF_NAMES[prefOf(a)]}内 ${rankIn(ind, a, pp)}位／${pp.length}</div>`;
        }
      } else {
        meta = '<div class="rm-card-meta rm-card-meta--soft">最新の年の値がないため順位は出しません</div>';
      }
      const d = document.createElement('div');
      d.className = 'rm-card';
      d.innerHTML =
        `<div class="rm-card-label">${ind.label}</div>` +
        `<div class="rm-card-num">${lk ? fmt(ind, lk.v) : '—'}</div>` +
        `<div class="rm-card-year">${lk ? ind.yearLabels[lk.i] : ''}</div>` + meta + seOf(ind, a, lk) + extraOf(ind, a, isLatest) +
        (ind.note ? `<div class="rm-card-note">${ind.note}</div>` : '');
      cards.appendChild(d);
    }
    // カードの列数：最後の段の空きがいちばん少ない列数（2〜4、同じなら3）
    const n = IND.length;
    const empty = (c) => (c - (n % c)) % c;
    const cols = [3, 4, 2].reduce((best, c) => (empty(c) < empty(best) ? c : best), 3);
    cards.style.setProperty('--cols', cols);
    lines(a, ranks);
    renderCmp();
    drawLine();
  }


  // 10-18 似た地域：県は人口の規模だけ、市区町村は総務省の類似団体にならい「人口＋産業の構成（第2次＋第3次の割合、第3次の割合）」で近い順に4つ
  let SIM_IND = null;
  if (!isPref) fetch('/data/room-town-work.json').then((r) => r.json()).then((W) => {
    const k2 = W.indicators.findIndex((i) => i.key === 'secondary'), k3 = W.indicators.findIndex((i) => i.key === 'tertiary');
    if (k2 < 0 || k3 < 0) return;
    const last = (arr) => { if (!arr) return null; for (let i = arr.length - 1; i >= 0; i--) if (typeof arr[i] === 'number') return arr[i]; return null; };
    SIM_IND = {};
    for (const a of W.areas) { const s2 = last(a.v.secondary), s3 = last(a.v.tertiary); if (s2 !== null && s3 !== null) SIM_IND[a.c] = { s23: s2 + s3, s3 }; }
    SIM_IND.__year = W.indicators[k3].yearLabels.at(-1);
    SIM_HOOK();
  }).catch(() => {});
  function simNear(cur, pool, pop) {
    const p0 = pop && pop[cur.c];
    if (!p0) return null;
    const cand = pool.filter((b) => !b.x && b.c !== cur.c && pop[b.c] > 0);
    const me = SIM_IND && SIM_IND[cur.c];
    if (isPref || !me) return { list: cand.map((b) => ({ b, d: Math.abs(Math.log(pop[b.c] / p0)) })).sort((x, y) => x.d - y.d).slice(0, 4).map((x) => x.b), withInd: false };
    // それぞれの物差しを市区町村全体の標準偏差でそろえてから距離をとる
    const rows = cand.filter((b) => SIM_IND[b.c]).map((b) => ({ b, lp: Math.log(pop[b.c]), s23: SIM_IND[b.c].s23, s3: SIM_IND[b.c].s3 }));
    const sd = (k) => { const v = rows.map((r) => r[k]); const m = v.reduce((s, x) => s + x, 0) / v.length; return Math.sqrt(v.reduce((s, x) => s + (x - m) ** 2, 0) / v.length) || 1; };
    const S = { lp: sd('lp'), s23: sd('s23'), s3: sd('s3') };
    const lp0 = Math.log(p0);
    const list = rows.map((r) => ({ b: r.b, d: Math.hypot((r.lp - lp0) / S.lp, (r.s23 - me.s23) / S.s23, (r.s3 - me.s3) / S.s3) })).sort((x, y) => x.d - y.d).slice(0, 4).map((x) => x.b);
    return { list, withInd: true };
  }
  function simHtml(near, full, compare, nameOf, pop) {
    const head = near.withInd ? '人口と産業の構成が近い市区町村' : `人口の規模が近い${isPref ? '県' : '市区町村'}`;
    return `<span>${head}：</span>` + near.list.map((b) => {
      const sub = near.withInd ? `${Math.round(pop[b.c]).toLocaleString('ja-JP')}人・第3次${SIM_IND[b.c].s3.toFixed(0)}％` : `${Math.round(pop[b.c]).toLocaleString('ja-JP')}人`;
      return `<button type="button" data-c="${b.c}"${full || compare.some((x) => x.c === b.c) ? ' disabled' : ''}>${nameOf(b)}<small>${sub}</small></button>`;
    }).join('');
  }
  const SIM_HOOK = () => { if (current) renderCmp(); };
  // ---- ほかの地域とならべる ----
  const cmpPref = document.getElementById('rmCmpPref');
  const cmpTown = document.getElementById('rmCmpTown');
  const nameOf = (a) => (isPref ? a.n : `${shortName(a)}（${PREF_NAMES[prefOf(a)]}）`);
  if (isPref) {
    for (const a of AREAS) { const o = document.createElement('option'); o.value = a.c; o.textContent = a.n; cmpPref.appendChild(o); }
    cmpPref.addEventListener('change', () => { addCmp(cmpPref.value); cmpPref.value = ''; });
  } else {
    const prefs = [...new Set(AREAS.map(prefOf))].sort();
    for (const p of prefs) { const o = document.createElement('option'); o.value = p; o.textContent = PREF_NAMES[p] || p; cmpPref.appendChild(o); }
    cmpPref.addEventListener('change', () => {
      cmpTown.innerHTML = '<option value="">足す市区町村を選ぶ</option>';
      const list = AREAS.filter((a) => prefOf(a) === cmpPref.value);
      for (const a of list) { const o = document.createElement('option'); o.value = a.c; o.textContent = shortName(a); cmpTown.appendChild(o); }
      cmpTown.disabled = list.length === 0;
    });
    cmpTown.addEventListener('change', () => { addCmp(cmpTown.value); cmpTown.value = ''; });
  }
  function addCmp(code) {
    const a = AREAS.find((x) => x.c === code);
    if (!a || !current || a.c === current.c || compare.some((b) => b.c === a.c)) return;
    if (compare.length >= MAXCMP) return;
    compare.push(a);
    renderCmp();
    drawLine();
  }
  function renderCmp() {
    const sec = document.getElementById('rmCmpSec');
    if (!current) return;
    sec.hidden = false;
    const full = compare.length >= MAXCMP;
    cmpPref.disabled = full;
    if (cmpTown) cmpTown.disabled = full || !cmpPref.value;
    // 10-18 人口の規模が近い地域（比べる相手の目安。総務省の類似団体の考え方のうち、人口だけを使った簡易版）
    const simBox = document.getElementById('rmSim');
    if (simBox) {
      const near = simNear(current, AREAS, POP);
      if (!near || !near.list.length) { simBox.hidden = true; } else {
        simBox.hidden = false;
        simBox.innerHTML = simHtml(near, full, compare, nameOf, POP);
        simBox.querySelectorAll('button').forEach((bt) => bt.addEventListener('click', () => addCmp(bt.dataset.c)));
      }
    }
    const chips = document.getElementById('rmChips');
    chips.innerHTML = '';
    const all = [current, ...compare];
    all.forEach((a, k) => {
      const li = document.createElement('li');
      li.className = 'rm-chip';
      li.innerHTML = `<i style="background:${COLORS[k]}"></i>${nameOf(a)}`;
      if (k > 0) {
        const b = document.createElement('button');
        b.type = 'button'; b.setAttribute('aria-label', `${nameOf(a)}を外す`); b.textContent = '×';
        b.addEventListener('click', () => { compare = compare.filter((x) => x.c !== a.c); renderCmp(); drawLine(); });
        li.appendChild(b);
      }
      chips.appendChild(li);
    });
    const wrap = document.getElementById('rmCmpWrap');
    const note = document.getElementById('rmCmpNote');
    wrap.hidden = note.hidden = compare.length === 0;
    if (compare.length === 0) return;
    const th = all.map((a, k) => `<th scope="col"><i style="background:${COLORS[k]}"></i>${isPref ? a.n : shortName(a)}${isPref ? '' : `<small>${PREF_NAMES[prefOf(a)]}</small>`}</th>`).join('');
    const rows = IND.map((ind) => {
      const pool = poolOf(ind);
      const tds = all.map((a) => {
        const lk = lastKnown(a, ind);
        if (!lk) return '<td>—</td>';
        const old = lk.i !== L(ind);
        const rk = !old && !a.x && !NO_RANK ? rankIn(ind, a, pool) : null;
        return `<td><b>${fmtText(ind, lk.v)}</b>${old ? `<small>${ind.yearLabels[lk.i]}</small>` : ''}${rk ? `<small>${rk}位</small>` : ''}</td>`;
      }).join('');
      return `<tr><th scope="row">${ind.label}<small>${ind.yearLabels[L(ind)]}</small></th>${tds}</tr>`;
    }).join('');
    document.getElementById('rmCmpTable').innerHTML = `<thead><tr><th scope="col">項目</th>${th}</tr></thead><tbody>${rows}</tbody>`;
  }

  // 一葉の一言は順位を言い直さず、その窓口の数字への気づきや問いを言う（地域を選ぶたびに入れ替わる）
  const TOUKO_COMMON = ['ここまで細かく数えてあるんですね。', '隣の項目と並べると、見え方が変わりそうです。', '順位より先に、値そのものを見たほうがいいですか。'];
  const toukoLine = (a) => { const pool = HITOHA.length ? HITOHA : TOUKO_COMMON; return pool[(parseInt(a.c, 10) || 0) % pool.length]; };
  function lines(a, ranks) {
    const kei = document.getElementById('rmKei');
    const touko = document.getElementById('rmTouko');
    const name = isPref ? a.n : shortName(a);
    if (NO_RANK) {
      kei.textContent = `${name}の数字だ。この窓口では順位をつけない。全国の値と、年ごとの移りかわりで見てほしい。`;
      touko.textContent = '順位ではなく、推移で読むんですね。';
      return;
    }
    if (ranks.length === 0) {
      kei.textContent = a.x ? `${name}は政令指定都市の区なので、数字だけを出して、順位はつけていない。` : `${name}は、最新の年の値がそろっていない。`;
      touko.textContent = a.x ? '区ごとの数字も、見られるんですね。' : '値のない欄もあるんですね。';
      return;
    }
    if (ranks.length === 1) {
      const x = ranks[0];
      kei.textContent = `${name}の「${x.ind.label}」は、${x.n}${isPref ? '都道府県' : 'の市区町村'}のなかで${x.rk}番目（${x.ind.rankWord}）だ。`;
      touko.textContent = toukoLine(a);
      return;
    }
    // 比べやすいよう、順位を「上からの割合」にそろえる
    const pos = ranks.map((x) => ({ ...x, p: (x.rk - 1) / Math.max(1, x.n - 1) }));
    const top = [...pos].sort((x, y) => x.p - y.p)[0];
    const bot = [...pos].sort((x, y) => y.p - x.p)[0];
    const unitWord = isPref ? '都道府県' : 'の市区町村';
    const minRk = Math.min(...pos.map((x) => x.rk));
    const maxRk = Math.max(...pos.map((x) => x.rk));
    const sameN = pos.every((x) => x.n === pos[0].n);
    const rkRange = minRk === maxRk ? `${minRk}` : `${minRk}〜${maxRk}`; // どれも同じ順位なら「13〜13番目」とせず「13番目」
    const among = sameN ? `${pos[0].n}${unitWord}` : (isPref ? '47都道府県' : '全国の市区町村');
    const sameWord = pos.every((x) => x.ind.rankWord === pos[0].ind.rankWord) ? `（${pos[0].ind.rankWord}）` : '';
    const allMiddle = pos.every((x) => x.p >= 0.2 && x.p <= 0.8);
    const allTop = pos.every((x) => x.p <= 0.15);
    const allBottom = pos.every((x) => x.p >= 0.85);
    if (allTop) {
      kei.textContent = `${name}は、どの項目も${among}のなかで上のほうにあり、${rkRange}番目${sameWord}だ。`;
    } else if (allBottom) {
      kei.textContent = `${name}は、どの項目も${among}のなかで下のほうにあり、${rkRange}番目${sameWord}だ。`;
    } else if (allMiddle) {
      kei.textContent = `${name}は、どの項目も${among}のなかで、まんなかあたりの${rkRange}番目${sameWord}にある。`;
    } else if (pos.every((x) => x.p >= 0.5)) {
      kei.textContent = `${name}は、どの項目も${among}のなかで下半分、${rkRange}番目${sameWord}にある。`;
    } else if (pos.every((x) => x.p <= 0.5)) {
      kei.textContent = `${name}は、どの項目も${among}のなかで上半分、${rkRange}番目${sameWord}にある。`;
    } else kei.textContent = `${name}の項目のうち、順位がいちばん上なのは「${top.ind.label}」で、${top.n}${unitWord}中${top.rk}番目（${top.ind.rankWord}）。いちばん下なのは「${bot.ind.label}」で、${bot.n}${unitWord}中${bot.rk}番目（${bot.ind.rankWord}）だ。`;
    touko.textContent = toukoLine(a);
  }

  // ---- 移りかわり ----
  let lineKey = IND[0] ? IND[0].key : null;
  let userPicked = false; // タブを押すまでは、その土地で動きのある項目を最初に見せる
  let chart = null;
  const tabs = document.getElementById('rmLineTabs');
  for (const ind of IND) {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'rm-tab' + (ind.key === lineKey ? ' is-active' : '');
    b.textContent = ind.label;
    b.setAttribute('role', 'tab');
    b.addEventListener('click', () => {
      lineKey = ind.key;
      userPicked = true;
      tabs.querySelectorAll('.rm-tab').forEach((x) => x.classList.remove('is-active'));
      b.classList.add('is-active');
      drawLine();
    });
    tabs.appendChild(b);
  }
  // ---- 10-18 ファンネルプロットと経験ベイズ推定（市区町村の、数の項目） ----
  const funSec = document.getElementById('rmFunSec');
  const funSel = document.getElementById('rmFunInd');
  const FUN_IND = funSec && POP ? IND.filter((i) => i.perCap === 'p100k') : [];
  let funChart = null;
  if (funSel) {
    for (const ind of FUN_IND) { const o = document.createElement('option'); o.value = ind.key; o.textContent = ind.label; funSel.appendChild(o); }
    funSel.addEventListener('change', () => drawFunnel());
  }
  const FUNC = {};
  function funnelStats(ind) {
    if (FUNC[ind.key]) return FUNC[ind.key];
    const pts = AREAS.filter((a) => !a.x && POP[a.c] > 0 && at(a, ind) !== null).map((a) => ({ a, n: POP[a.c], y: at(a, ind) }));
    const k = pts.length;
    const N = pts.reduce((s, p) => s + p.n, 0);
    const Y = pts.reduce((s, p) => s + p.y, 0);
    const m = Y / N; // 全国の率（1人あたり）
    // Marshall の大域的な経験ベイズ推定：ばらつきのうち、偶然では説明できない分 A を見積もり、町ごとに寄せる強さを決める
    const s2 = pts.reduce((s, p) => s + p.n * (p.y / p.n - m) ** 2, 0) / N;
    const A = Math.max(0, s2 - m / (N / k));
    const eb = (p) => { const C = A + m / p.n > 0 ? A / (A + m / p.n) : 0; return m + C * (p.y / p.n - m); };
    const out = { pts, m, A, eb, byCode: Object.fromEntries(pts.map((p) => [p.a.c, p])) };
    FUNC[ind.key] = out;
    return out;
  }
  function drawFunnel() {
    if (!funSec || !current || FUN_IND.length === 0) return;
    if (current.x || !POP[current.c]) { funSec.hidden = true; return; }
    funSec.hidden = false;
    const ind = FUN_IND.find((i) => i.key === funSel.value) || FUN_IND[0];
    const F = funnelStats(ind);
    const per = 1e5;
    const ns = F.pts.map((p) => p.n);
    const nMin = Math.max(1, Math.min(...ns)), nMax = Math.max(...ns);
    const grid = Array.from({ length: 60 }, (_, i) => Math.exp(Math.log(nMin) + ((Math.log(nMax) - Math.log(nMin)) * i) / 59));
    const lim = (z, sgn) => grid.map((n) => ({ x: n, y: Math.max(0, (F.m + sgn * z * Math.sqrt(F.m / n)) * per) }));
    const rates = F.pts.map((p) => (p.y / p.n) * per).sort((x, y) => x - y);
    const yRaw = Math.max(rates[Math.floor(rates.length * 0.995)] * 1.15, F.m * per * 2);
    const step = Math.pow(10, Math.floor(Math.log10(yRaw)));
    const yMax = Math.ceil(yRaw / step) * step;
    const clampY = (v) => Math.min(v, yMax);
    const sel = [current, ...compare].filter((b) => F.byCode[b.c]);
    const sets = [
      { type: 'scatter', label: '市区町村', data: F.pts.map((p) => ({ x: p.n, y: clampY((p.y / p.n) * per) })), backgroundColor: 'rgba(27,67,50,.16)', pointRadius: 2, pointHoverRadius: 3 },
      { type: 'line', label: '全国の率', data: [{ x: nMin, y: F.m * per }, { x: nMax, y: F.m * per }], borderColor: '#1F2A44', borderWidth: 1.5, pointRadius: 0 },
      { type: 'line', label: '95％', data: lim(1.96, 1), borderColor: '#c99a2e', borderDash: [5, 4], borderWidth: 1.2, pointRadius: 0 },
      { type: 'line', label: '95％下', data: lim(1.96, -1), borderColor: '#c99a2e', borderDash: [5, 4], borderWidth: 1.2, pointRadius: 0 },
      { type: 'line', label: '99.8％', data: lim(3.09, 1), borderColor: '#B3402A', borderDash: [2, 3], borderWidth: 1.2, pointRadius: 0 },
      { type: 'line', label: '99.8％下', data: lim(3.09, -1), borderColor: '#B3402A', borderDash: [2, 3], borderWidth: 1.2, pointRadius: 0 },
      ...sel.map((b, k) => { const p = F.byCode[b.c]; return { type: 'scatter', label: isPref ? b.n : shortName(b), data: [{ x: p.n, y: clampY((p.y / p.n) * per) }], backgroundColor: COLORS[k], borderColor: '#fff', borderWidth: 1.5, pointRadius: 6, pointHoverRadius: 7 }; }),
    ];
    if (funChart) funChart.destroy();
    funChart = new Chart(document.getElementById('rmFun'), {
      type: 'scatter',
      data: { datasets: sets },
      options: {
        responsive: true,
        aspectRatio: window.innerWidth < 600 ? 1.05 : 1.9,
        parsing: false,
        plugins: {
          legend: { display: false },
          tooltip: { filter: (it) => it.dataset.type === 'scatter' && it.datasetIndex >= 6, callbacks: { label: (c) => `${c.dataset.label}：人口${Math.round(c.raw.x).toLocaleString('ja-JP')}人、10万人あたり${c.raw.y.toFixed(1)}` } },
        },
        scales: {
          x: { type: 'logarithmic', title: { display: true, text: '人口（対数の目盛り）' }, ticks: { callback: (v) => { const l = Math.log10(v); return Number.isInteger(Math.round(l * 1e6) / 1e6) ? Number(v).toLocaleString('ja-JP') : ''; } } },
          y: { min: 0, max: yMax, title: { display: true, text: `人口10万人あたり（${ind.unit}）` } },
        },
      },
    });
    const lines = sel.map((b) => {
      const p = F.byCode[b.c];
      const E = F.m * p.n;
      const r = (p.y / p.n) * per;
      const se = Math.sqrt(F.m / p.n) * per;
      const z = se > 0 ? (r - F.m * per) / se : 0;
      const band = Math.abs(z) <= 1.96 ? '95％の線の内側' : Math.abs(z) <= 3.09 ? `95％の線の${z > 0 ? '上' : '下'}、99.8％の線の内側` : `99.8％の線の${z > 0 ? '上' : '下'}（外側）`;
      const nm = isPref ? b.n : shortName(b);
      return `${nm}（人口${p.n.toLocaleString('ja-JP')}人）：実際 ${fmtText(ind, p.y)}、見込み ${E.toFixed(E < 10 ? 1 : 0)}${ind.unit}（比 ${E > 0 ? Math.round((p.y / E) * 100) : '—'}）。${band}です。ならした値は人口10万人あたり ${(F.eb(p) * per).toFixed(1)}${ind.unit}（そのままの値は ${r.toFixed(1)}）。`;
    });
    document.getElementById('rmFunRead').innerHTML = lines.map((t) => `<span>${t}</span>`).join('');
  }

  let lineMode = 'value';
  document.querySelectorAll('#rmLineMode button').forEach((b) => b.addEventListener('click', () => {
    lineMode = b.dataset.mode;
    document.querySelectorAll('#rmLineMode button').forEach((x) => { x.classList.toggle('is-active', x === b); x.setAttribute('aria-pressed', String(x === b)); });
    drawLine();
  }));
  function drawLine() {
    if (!current) return;
    drawFunnel();
    const a = current;
    if (!userPicked) {
      const moves = (i) => {
        const vs = (a.v[i.key] || []).filter((v) => v !== null && v !== undefined);
        return vs.length >= 3 && vs.some((v) => v !== vs[0]);
      };
      const first = IND.find(moves) || IND[0];
      lineKey = first.key;
      tabs.querySelectorAll('.rm-tab').forEach((x, k) => x.classList.toggle('is-active', IND[k].key === lineKey));
    }
    const ind = IND.find((i) => i.key === lineKey);
    const sec = document.getElementById('rmLineSec');
    sec.hidden = false;
    const name = isPref ? a.n : shortName(a);
    const canvas = document.getElementById('rmLine');
    const empty = document.getElementById('rmLineEmpty');
    const series = a.v[ind.key] || [];
    const pts = series.filter((v) => v !== null && v !== undefined).length;
    document.getElementById('rmLineTitle').textContent = compare.length ? `「${ind.label}」の移りかわり` : `${name}の「${ind.label}」の移りかわり`;
    if (chart) { chart.destroy(); chart = null; }
    if (pts < 3) {
      canvas.hidden = true;
      empty.hidden = false;
      empty.textContent = `この項目は、移りかわりを描けるほどの年の数がありません（${ind.years.length}時点）。`;
      return;
    }
    canvas.hidden = false;
    empty.hidden = true;
    // 毎年の統計は、欠けた年も目盛りに残す（詰めると年の間隔がずれて見えるため）。欠けた年は線を切る
    const ys = ind.years.map(Number);
    const steps = ys.slice(1).map((y, i) => y - ys[i]);
    const yearly = steps.length > 0 && steps.filter((d) => d === 1).length >= steps.length * 0.7;
    const labels = yearly ? Array.from({ length: ys[ys.length - 1] - ys[0] + 1 }, (_, i) => String(ys[0] + i)) : ind.years;
    const spread = (arr) => (yearly ? labels.map((y) => { const k = ind.years.indexOf(y); return k < 0 ? null : arr[k]; }) : arr);
    const gaps = yearly && labels.length > ind.years.length;
    const sets = [{ label: name, data: spread(series), borderColor: COLORS[0], backgroundColor: COLORS[0], tension: 0.2, pointRadius: 2, spanGaps: false }];
    compare.forEach((b, k) => sets.push({ label: isPref ? b.n : shortName(b), data: spread(b.v[ind.key] || []), borderColor: COLORS[k + 1], backgroundColor: COLORS[k + 1], tension: 0.2, pointRadius: 2, spanGaps: false }));
    const noteParts = [];
    if (isPref) {
      const useAvg = D.nationalIsAvg[ind.key] || (D.nationalIsTotal && D.nationalIsTotal[ind.key]);
      const natLabel = useAvg ? '47都道府県の平均' : '全国';
      sets.push({ label: natLabel, data: spread(useAvg && D.prefAverage ? D.prefAverage[ind.key] : D.national[ind.key]), borderColor: '#7F97A8', borderDash: [6, 4], borderWidth: 1.5, pointRadius: 0, spanGaps: false });
      noteParts.push(`点線は${natLabel}です。`);
    }
    if (gaps) noteParts.push(isPref ? '線が途切れている年は、どこかの県の値が欠けていて、くらべられない年です。' : '線が途切れている年は、値のそろわない年です。');
    // 10-18 伸び方：割合の項目は「何ポイント動いたか」、それ以外は年平均の伸び率（複利）で並べる
    const isShare = ind.unit === '％' || ind.unit === '‰';
    const growth = sets.map((st) => {
      const pts2 = st.data.map((v, k) => ({ v, y: Number(labels[k]) })).filter((p) => p.v !== null && p.v !== undefined && Number.isFinite(Number(p.v)));
      if (pts2.length < 2) return null;
      const f = pts2[0], l = pts2[pts2.length - 1];
      const yrs = l.y - f.y;
      if (!(yrs > 0)) return null;
      if (isShare) { const d = l.v - f.v; return Math.abs(d) < 0.05 ? `${st.label} ±0.0ポイント` : `${st.label} ${d > 0 ? '+' : '−'}${Math.abs(d).toFixed(1)}ポイント`; }
      if (!(f.v > 0 && l.v > 0)) return null;
      const g = (Math.pow(l.v / f.v, 1 / yrs) - 1) * 100;
      return Math.abs(g) < 0.05 ? `${st.label} ±0.0％` : `${st.label} ${g > 0 ? '+' : '−'}${Math.abs(g).toFixed(1)}％`;
    }).filter(Boolean);
    if (growth.length) {
      const yrsAll = sets[0].data.map((v, k) => (v === null || v === undefined ? null : labels[k])).filter(Boolean);
      const span = yrsAll.length >= 2 ? `${yrsAll[0]}→${yrsAll[yrsAll.length - 1]}年` : '';
      noteParts.push(isShare ? `動いた幅（${span}）：${growth.join('、')}。` : `年平均の伸び（${span}）：${growth.join('、')}。`);
    }
    if (lineMode === 'index') {
      for (const st of sets) {
        const base = st.data.find((v) => v !== null && v !== undefined && Number(v) !== 0);
        st.data = st.data.map((v) => (v === null || v === undefined || !base ? null : (Number(v) / Number(base)) * 100));
      }
      noteParts.push('それぞれの線の最初の年を100にして、伸び方だけをくらべています。');
    }
    const note = document.getElementById('rmLineNote');
    if (note) note.textContent = noteParts.join('');
    chart = new Chart(canvas, {
      type: 'line',
      data: { labels, datasets: sets },
      options: {
        responsive: true,
        plugins: { legend: { display: compare.length > 0, labels: { boxWidth: 14, filter: (it) => !String(it.text).includes('47都道府県の平均') && it.text !== '全国' } }, tooltip: { callbacks: { label: (c) => (lineMode === 'index' ? `${c.dataset.label}：${Number(c.raw).toFixed(1)}` : `${c.dataset.label}：${fmtText(ind, Number(c.raw))}`) } } },
        scales: { y: { ticks: { callback: (v) => Number(v).toLocaleString('ja-JP') } } },
      },
    });
  }

  // ---- 上位と下位 ----
  const indSel = document.getElementById('rmRankInd');
  if (indSel) for (const ind of IND) { const o = document.createElement('option'); o.value = ind.key; o.textContent = ind.label; indSel.appendChild(o); }
  const scopeSel = document.getElementById('rmRankScope');
  function updateScopeOptions() {
    if (!scopeSel) return;
    const p = prefSel.value;
    scopeSel.innerHTML = '<option value="all">全国の市区町村</option>' + (p ? `<option value="${p}">${PREF_NAMES[p]}の市区町村</option>` : '');
    if (p) scopeSel.value = p;
    showRank();
  }
  const CAP = 10; // 同じ値が長く続くときは、ここで切って「ほかN」と添える
  function cut(list, ind, desc) {
    if (list.length === 0) return { shown: [], rest: 0 };
    const v5 = r(ind, at(list[Math.min(4, list.length - 1)], ind));
    const keep = list.filter((b) => { const x = r(ind, at(b, ind)); return desc ? x >= v5 : x <= v5; });
    return keep.length > CAP ? { shown: keep.slice(0, 5), rest: keep.length - 5 } : { shown: keep, rest: 0 };
  }
  function showRank() {
    if (!indSel) return;
    const ind = IND.find((i) => i.key === indSel.value) || IND[0];
    if (!ind) return;
    const pref = scopeSel && scopeSel.value !== 'all' ? scopeSel.value : null;
    const pool = poolOf(ind, pref);
    const desc = [...pool].sort((x, y) => at(y, ind) - at(x, ind));
    const asc = [...desc].reverse();
    const hi = cut(desc, ind, true);
    const lo = cut(asc, ind, false);
    const loRank = (b) => { const v = r(ind, at(b, ind)); return asc.filter((c) => r(ind, at(c, ind)) < v).length + 1; };
    const OPP = { '多い': '少ない', '高い': '低い', '長い': '短い', '深い': '浅い', '広い': '狭い', '大きい': '小さい' };
    const w = ind.rankWord.replace('順', '');
    document.getElementById('rmHiHead').textContent = `${w}ほう TOP5`;
    document.getElementById('rmLoHead').textContent = `${OPP[w] || '反対の'}ほう TOP5`;
    const fill = (el, part, rk) => {
      el.innerHTML = '';
      for (const b of part.shown) {
        const li = document.createElement('li');
        li.innerHTML = `<span class="rm-rank-pos">${rk(b)}</span><span class="rm-rank-name">${isPref ? b.n : `${shortName(b)}<small>（${PREF_NAMES[prefOf(b)]}）</small>`}</span><span class="rm-rank-val">${fmtText(ind, at(b, ind))}</span>`;
        li.addEventListener('click', () => {
          if (isPref) { prefSel.value = b.c; }
          else { prefSel.value = prefOf(b); window.__rmFillTowns(prefOf(b)); townSel.value = b.c; }
          render(b);
          document.getElementById('rmResult').scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        el.appendChild(li);
      }
      if (part.rest > 0) {
        const li = document.createElement('li');
        li.className = 'rm-rank-more';
        li.textContent = `ほかに同じ値が${part.rest}`;
        el.appendChild(li);
      }
    };
    fill(document.getElementById('rmHi'), hi, (b) => rankIn(ind, b, pool));
    fill(document.getElementById('rmLo'), lo, loRank);
    showSpread(ind, pref);
  }

  // ---- 10-20 県の中のばらつき（四分位範囲。人数や件数の項目は人口あたりに直す） ----
  const SPREAD = {};
  function spreadView(ind) {
    if (ind.perCap && POP) {
      const S = distOf(ind);
      const med = S.q(0.5) || 0;
      if (ind.perCap === 'p100k' && ind.unit === '人' && med >= 1000) return { label: '人口に対する割合', unit: '％', k: 1 / 1000, dec: 1 };
      if (ind.perCap === 'p100k' && med >= 100000) { const m = med / 1e5; return { label: '1人あたり', unit: ind.unit, k: 1 / 1e5, dec: m >= 100 ? 0 : m >= 10 ? 1 : 2 }; }
      return { label: pcLabel(ind), unit: pcUnit(ind), k: 1, dec: S.dec };
    }
    return { label: '', unit: ind.unit || '', k: 1, dec: ind.decimals };
  }
  function spreadAll(ind) {
    if (SPREAD[ind.key]) return SPREAD[ind.key];
    const V = spreadView(ind);
    const by = {};
    for (const a of AREAS) {
      if (a.x) continue;
      const m = metricOf(a, ind);
      if (m === null || !Number.isFinite(m)) continue;
      (by[prefOf(a)] ??= []).push({ a, v: m * V.k });
    }
    const prefs = [];
    for (const [p, list] of Object.entries(by)) {
      if (list.length < 5) continue;
      list.sort((x, y) => x.v - y.v);
      const n = list.length;
      const q = (t) => { const h = (n - 1) * t; const lo = Math.floor(h); return list[lo].v + (list[Math.min(lo + 1, n - 1)].v - list[lo].v) * (h - lo); };
      prefs.push({ p, list, n, q25: q(0.25), q50: q(0.5), q75: q(0.75), iqr: q(0.75) - q(0.25) });
    }
    prefs.sort((x, y) => y.iqr - x.iqr);
    return (SPREAD[ind.key] = { V, prefs });
  }
  function showSpread(ind, pref) {
    const box = document.getElementById('rmSpread');
    if (!box) return;
    const { V, prefs } = spreadAll(ind);
    const f = (v) => v.toLocaleString('ja-JP', { minimumFractionDigits: V.dec, maximumFractionDigits: V.dec }) + V.unit;
    const head = `<p class="rm-spread-ind">${ind.label}${V.label ? `（${V.label}）` : ''}</p>`;
    if (prefs.length < 5) { box.innerHTML = head + '<p class="rm-note">県ごとに比べられるだけの数字がありません。</p>'; return; }
    const rankOf = (P) => prefs.filter((x) => x.iqr > P.iqr + 1e-12).length + 1;
    if (!pref) {
      const li = (P) => `<li><button type="button" data-p="${P.p}">${PREF_NAMES[P.p]}</button><b>${f(P.iqr)}</b><small>${f(P.q25)}〜${f(P.q75)}</small></li>`;
      box.innerHTML = head + `<div class="rm-spread-cols"><div><h3>幅が大きい県</h3><ol>${prefs.slice(0, 3).map(li).join('')}</ol></div><div><h3>幅が小さい県</h3><ol>${prefs.slice(-3).reverse().map(li).join('')}</ol></div></div><p class="rm-note">「くらべる範囲」で県を選ぶと、その県の中の並びが出ます。</p>`;
      box.querySelectorAll('button[data-p]').forEach((b) => b.addEventListener('click', () => { if (scopeSel) { scopeSel.innerHTML = '<option value="all">全国の市区町村</option>' + `<option value="${b.dataset.p}">${PREF_NAMES[b.dataset.p]}の市区町村</option>`; scopeSel.value = b.dataset.p; showRank(); } }));
      return;
    }
    const P = prefs.find((x) => x.p === pref);
    if (!P) { box.innerHTML = head + `<p class="rm-note">${PREF_NAMES[pref]}は、値のある市区町村が少ないため出していません。</p>`; return; }
    const lo = P.list[0], hi = P.list[P.n - 1];
    const W = 600, PAD = 10, x0 = lo.v, x1 = hi.v;
    const X = (v) => (x1 > x0 ? PAD + ((v - x0) / (x1 - x0)) * (W - PAD * 2) : W / 2);
    const cur = current && prefOf(current) === pref ? current.c : null;
    const dots = P.list.map((o) => `<circle cx="${X(o.v).toFixed(1)}" cy="22" r="${o.a.c === cur ? 6 : 4}" fill="${o.a.c === cur ? '#B3402A' : '#1F2A44'}" fill-opacity="${o.a.c === cur ? 1 : 0.35}"${o.a.c === cur ? ' stroke="#fff" stroke-width="1.2"' : ''}><title>${shortName(o.a)} ${f(o.v)}</title></circle>`).join('');
    const svg = `<svg class="rm-spread-svg" viewBox="0 0 ${W} 44" role="img" aria-label="${PREF_NAMES[pref]}の市区町村の値を点で並べた図。箱は真ん中の半分の範囲"><rect x="${X(P.q25).toFixed(1)}" y="10" width="${Math.max(1, X(P.q75) - X(P.q25)).toFixed(1)}" height="24" fill="#c99a2e" fill-opacity=".18" stroke="#c99a2e" stroke-opacity=".7"/><line x1="${X(P.q50).toFixed(1)}" y1="6" x2="${X(P.q50).toFixed(1)}" y2="38" stroke="#c99a2e"/>${dots}</svg>`;
    const curO = cur ? P.list.find((o) => o.a.c === cur) : null;
    box.innerHTML = head + `<div class="rm-spread-tiles"><div><span>真ん中の半分の幅</span><b>${f(P.iqr)}</b><span>${f(P.q25)}〜${f(P.q75)}</span></div><div><span>真ん中の町の値（中央値）</span><b>${f(P.q50)}</b><span>${P.n}の市区町村</span></div>${(() => { const rk = rankOf(P), rs = prefs.filter((x) => x.iqr < P.iqr - 1e-12).length + 1; return rk <= rs ? `<div><span>${prefs.length}都道府県で、幅が大きいほうから</span><b>${rk}番目</b><span>いちばん大きいのは${PREF_NAMES[prefs[0].p]}（${f(prefs[0].iqr)}）</span></div>` : `<div><span>${prefs.length}都道府県で、幅が小さいほうから</span><b>${rs}番目</b><span>いちばん小さいのは${PREF_NAMES[prefs[prefs.length - 1].p]}（${f(prefs[prefs.length - 1].iqr)}）</span></div>`; })()}</div>
      ${svg}<p class="rm-spread-ends"><span>${shortName(lo.a)} ${f(lo.v)}</span><span>${shortName(hi.a)} ${f(hi.v)}</span></p>
      <p class="rm-note">点は${PREF_NAMES[pref]}の市区町村、箱は真ん中の半分、縦の線は中央値です。${curO ? `赤い点が${shortName(curO.a)}です。` : ''}人口の少ない町は値が大きく揺れやすいので、両端の町だけで県の散らばりを判断しないでください。幅の大小に良し悪しはありません。</p>`;
  }
  if (indSel) indSel.addEventListener('change', showRank);
  if (scopeSel) scopeSel.addEventListener('change', showRank);
  showRank();

  // ?pref=県名 または ?code=地域コード で開いたら、その地域を出す
  const q = new URLSearchParams(location.search);
  const want = q.get('code') || q.get('pref');
  if (want) {
    const a = AREAS.find((x) => x.c === want || x.n === want);
    if (a) {
      if (isPref) { prefSel.value = a.c; }
      else { prefSel.value = prefOf(a); window.__rmFillTowns(prefOf(a)); townSel.value = a.c; updateScopeOptions(); }
      render(a);
      for (const c of (q.get('cmp') || '').split(',').filter(Boolean)) addCmp(c);
    }
  }
})();
</script>

<style is:global>
  .rm { max-width: 860px; margin: 0 auto; padding: 0 16px 48px; }
  /* サイト全体の section{padding:56px 0} を打ち消す（段の間が空きすぎるため） */
  .rm > section { padding: 0; }
  .rm-hero { text-align: center; padding: 32px 0 8px; }
  .rm-hero-figure { display: block; width: 100%; max-width: 780px; height: auto; border-radius: 4px; margin: 0 auto 20px; }
  .rm-kicker { font-family: "IBM Plex Mono", monospace; font-size: .74rem; letter-spacing: .22em; font-weight: 600; color: var(--stamp); margin: 0; }
  .rm-hero h1 { margin: 4px 0 12px; font-family: "Shippori Mincho", serif; font-weight: 800; }
  .rm-lead { color: #555; line-height: 1.9; }

  .rm-selector { margin: 24px 0; display: flex; gap: 12px 20px; justify-content: center; flex-wrap: wrap; }
  .rm-selector label { display: flex; flex-direction: column; gap: 6px; font-size: .85rem; }
  .rm-selector select { width: 260px; max-width: 100%; padding: 10px 12px; border: 1px solid #1F2A44; border-radius: 6px; background: #fff; font-size: 1rem; }
  .rm-selector select:disabled { background: #f0f0ea; color: #999; }
  .rm-selector--small { margin: 12px 0 20px; }

  .rm-result h2 { text-align: center; margin: 24px 0 16px; font-family: "Shippori Mincho", serif; }
  .rm-cards { display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 720px) { .rm-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .rm-card { display: flex; flex-direction: column; border: 1px solid #DEDFE3; border-radius: 8px; padding: 14px; background: #fff; text-align: center; }
  .rm-card-label { font-size: .78rem; color: #4B5570; letter-spacing: .04em; line-height: 1.5; }
  .rm-card-num { font-family: "IBM Plex Mono", monospace; font-size: 1.4rem; font-weight: 600; margin: 6px 0 0; color: #1F2A44; }
  .rm-card-num small { font-family: "Zen Kaku Gothic New", sans-serif; font-size: .75rem; margin-left: 3px; font-weight: 500; }
  .rm-card-year { font-size: .7rem; color: #999; margin-bottom: 6px; }
  .rm-card-meta { font-size: .74rem; color: #B3402A; font-weight: 700; margin-top: auto; }
  .rm-card-meta span { font-weight: 400; display: inline-block; }
  .rm-card-meta--soft { color: #777; font-weight: 400; margin-top: 2px; }
  .rm-card-note { font-size: .66rem; color: #999; margin-top: 4px; line-height: 1.5; }

  .rm-card-pc { margin-top: 6px; font-size: .74rem; color: #4B5570; }
