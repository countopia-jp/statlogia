---
import fs from 'node:fs';
import path from 'node:path';
// =====================================================
// Statlogia - 閲覧室の共通ページ部品
// src/components/Room.astro
//
// <Room room={設定} /> だけで、県（scope:'pref'）か町（scope:'town'）の窓口ができる。
// 設定は src/data/rooms/*.js。データは /data/room-<id>.json（ビルド時生成）をブラウザが読む。
// 案内人のことばは「数字だけを言う」決まり（理由づけ・良し悪しは言わない）。
// ※スタイルは is:global（JS生成要素にスコープCSSが効かないため）。全セレクタ .rm- 接頭辞。
// =====================================================
import Talk from './Talk.astro';
import { getRoomData, yearSummary } from '../lib/room-engine.js';
import HeroFig from './HeroFig.astro';

const { room } = Astro.props;
const data = await getRoomData(room);
const years = yearSummary(data);
const isPref = room.scope === 'pref';
// 重い数字の窓口（room.noRank）：順位・上位下位を出さず、値と全国との比較と推移だけにする
const noRank = !!room.noRank;
const mergedIntro = room.intro;
// 扉絵：public/images/icon/<窓口id>-large.webp を置けば出る（無いあいだは出さない）
const heroImage = room.image ?? `/images/icon/${room.id}-large.webp`;
const hasHero = fs.existsSync(path.join(process.cwd(), 'public', heroImage));
---
<main class="rm">
  <HeroFig src={heroImage} alt={room.imageAlt || ''} width={1400} height={788}>
    <p class="rm-kicker">閲覧室{room.shelf ? `｜${room.shelf}` : ''}</p>
    <h1>{room.title}</h1>
    <p class="rm-lead" set:html={room.lead} />
  </HeroFig>

  {mergedIntro.map(([who, text]) => <Talk speaker={who}>{text}</Talk>)}

  <section class="rm-selector" aria-label="地域の選択">
    {isPref ? (
      <label><span>都道府県</span><select id="rmPref"><option value="">選んでください</option></select></label>
    ) : (
      <>
        <label><span>都道府県</span><select id="rmPref"><option value="">選んでください</option></select></label>
        <label><span>市区町村</span><select id="rmTown" disabled><option value="">まず都道府県を選ぶ</option></select></label>
      </>
    )}
  </section>

  <section id="rmResult" class="rm-result" hidden aria-live="polite">
    <h2 id="rmTitle"></h2>
    <div class="rm-cards" id="rmCards"></div>
    <Talk speaker="chiaki-work"><span id="rmKei"></span></Talk>
    <Talk speaker="hitoha"><span id="rmTouko"></span></Talk>
  </section>

  <section id="rmCmpSec" class="rm-cmp" hidden aria-label="ほかの地域とならべる">
    <h2>ほかの{isPref ? '県' : '市区町村'}とならべる</h2>
    <p class="rm-note">{isPref ? '県' : '市区町村'}を4つまで足して、数字を横に並べます。下の移りかわりのグラフにも、線が足されます。</p>
    <div class="rm-selector rm-selector--small">
      <label><span>都道府県</span><select id="rmCmpPref"><option value="">{isPref ? '足す県を選ぶ' : '選んでください'}</option></select></label>
      {!isPref && <label><span>市区町村</span><select id="rmCmpTown" disabled><option value="">まず都道府県を選ぶ</option></select></label>}
    </div>
    <p class="rm-sim" id="rmSim" hidden></p>
    <ul class="rm-chips" id="rmChips"></ul>
    <div class="rm-cmp-wrap" id="rmCmpWrap" hidden><table class="rm-cmp-table" id="rmCmpTable"></table></div>
    <p class="rm-note" id="rmCmpNote" hidden>{noRank ? 'この窓口では順位を出しません。' : `順位は${isPref ? '47都道府県の中' : '全国の市区町村の中'}での順位です。`}年の書いてある値は、最新の年の値がないため、それより前の年の値です。「近い」地域は比べる相手の目安です。県は総人口の近い順、市区町村は総務省の類似団体の考え方にならい、総人口と産業の構成（国勢調査の第2次＋第3次産業、第3次産業で働く人の割合）の近い順に4つ挙げています。</p>
  </section>

  <section id="rmLineSec" class="rm-line-sec" hidden aria-label="移りかわり">
    <h2 id="rmLineTitle">移りかわり</h2>
    <div class="rm-tabs" id="rmLineTabs" role="tablist"></div>
    <div class="rm-mode" id="rmLineMode" role="group" aria-label="グラフの見せ方">
      <button type="button" data-mode="value" class="is-active" aria-pressed="true">値で見る</button>
      <button type="button" data-mode="index" aria-pressed="false">最初の年を100にそろえる</button>
    </div>
    <div class="rm-line-wrap">
      <canvas id="rmLine" height="140"></canvas>
      <p class="rm-note" id="rmLineEmpty" hidden></p>
    </div>
    <p class="rm-note" id="rmLineNote"></p>
  </section>

  {!isPref && data.pop && data.indicators.some((i) => i.perCap === 'p100k') && (
    <section id="rmFunSec" class="rm-fun" hidden aria-label="人口の大きさを考えに入れて見る">
      <h2>人口の大きさを考えに入れて見る</h2>
      <p class="rm-note rm-fun-lead">人口の少ない町は、数が1つ違うだけで「人口あたり」が大きく動きます。横に人口、縦に人口10万人あたりの値をとり、全国の率のまわりに「偶然のゆらぎでも出る範囲」の線を引きました（ファンネルプロット）。線の外にある町は、偶然だけでは説明しにくい差がある町です。</p>
      <div class="rm-selector rm-selector--small"><label><span>項目</span><select id="rmFunInd"></select></label></div>
      <div class="rm-line-wrap"><canvas id="rmFun" height="170"></canvas></div>
      <p class="rm-fun-read" id="rmFunRead"></p>
      <p class="rm-note">実線は全国の率、内側の点線は95％、外側の点線は99.8％の範囲です（ポアソン分布による近似）。「見込みの数」は、全国の率どおりならその町にあるはずの数、「比」は実際の数÷見込みの数×100です。「ならした値」は、小さな町の揺れを全国の傾向に寄せて安定させた値（経験ベイズ推定）です。横軸は人口を対数の目盛りで並べています。</p>
    </section>
  )}

  {!noRank && (
  <section class="rm-ranking" aria-label="上位と下位">
    <h2>{isPref ? '全国の上位と下位' : '上位と下位'}</h2>
    <div class="rm-selector rm-selector--small">
      <label><span>項目</span><select id="rmRankInd"></select></label>
      {!isPref && <label><span>くらべる範囲</span><select id="rmRankScope"><option value="all">全国の市区町村</option></select></label>}
    </div>
    <div class="rm-rank-cols">
      <div><h3 class="rm-rank-head rm-rank-head--hi" id="rmHiHead">上位</h3><ol class="rm-rank-list" id="rmHi"></ol></div>
      <div><h3 class="rm-rank-head rm-rank-head--lo" id="rmLoHead">下位</h3><ol class="rm-rank-list" id="rmLo"></ol></div>
    </div>
    <p class="rm-note">名前を押すと、その{isPref ? '県' : '町'}の帳面を開きます。同じ値は同じ順位として並べています。</p>
  </section>
  )}

  {!isPref && !noRank && (
    <section class="rm-spread" aria-label="県の中のばらつき">
      <h2>県の中のばらつき</h2>
      <p class="rm-note rm-spread-lead">上の「項目」と「くらべる範囲」に合わせて、同じ県の市区町村どうしで、値がどれだけ散らばっているかを出します。値を小さい順に並べたとき、真ん中の半分の町が入る幅（四分位範囲）で測り、47都道府県で比べます。</p>
      <div id="rmSpread"></div>
    </section>
  )}

  {room.outro && room.outro.map(([who, text]) => <Talk speaker={who}>{text}</Talk>)}

  {room.cross && room.cross.length > 0 && (
    <p class="rm-cross">あわせて見る：{room.cross.map(([href, label], i) => <>{i > 0 && '｜'}<a href={href}>{label}</a></>)}</p>
  )}

  <footer class="rm-source">
    <p>
      出典：{data.source}（{years}）<br />
      {room.notes.map((n) => <>{n}<br /></>)}
      {data.pop && <>「人口10万人あたり」「1人あたり」「人口に対する割合」は、各地域の総人口（{data.popYear}{isPref ? '' : '・国勢調査'}）で割った値です。年のずれがあるため目安としてご覧ください。<br /></>}
      「上位◯％」は、{isPref ? '47都道府県' : '全国の市区町村'}を値の大きい順に並べたときの位置です。偏差値は、分布の偏りが小さい項目にだけ出しています（平均50、標準偏差10に換算）。<br />
      グラフの「年平均の伸び」は、最初の年から最後の年までを複利でならした1年あたりの伸び率です。割合の項目は、動いた幅をポイントで示しています。<br />
      読み方：<a href="/how-to-read/position/">10位は、近いのか遠いのか</a>｜<a href="/how-to-read/growth/">伸び方は、そろえてから比べる</a>{!isPref && data.pop && data.indicators.some((i) => i.perCap === 'p100k') && <>｜<a href="/how-to-read/small-towns/">小さな町の1位は、あてにならない</a></>}{data.indicators.some((i) => i.lq) && <>｜<a href="/how-to-read/specialization/">町の得意を測る物差し</a></>}｜<a href="/how-to-read/similar/">似た町と並べてみる</a>{data.indicators.some((i) => i.se) && <>｜<a href="/how-to-read/sampling-error/">調べ直したら、順位は入れかわるか</a></>}<br />
      このページはe-Stat APIで取得した統計データを独自に加工して作成しています。
    </p>
  </footer>
</main>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script is:inline define:vars={{ ROOM_ID: room.id, HITOHA: room.hitoha || [], NO_RANK: noRank }}>
(async function () {
  const res = await fetch(`/data/room-${ROOM_ID}.json`);
  const D = await res.json();
  const IND = D.indicators;
  const AREAS = D.areas;
  const isPref = D.scope === 'pref';
  const PREF_NAMES = {
    '01':'北海道','02':'青森県','03':'岩手県','04':'宮城県','05':'秋田県','06':'山形県','07':'福島県','08':'茨城県','09':'栃木県','10':'群馬県',
    '11':'埼玉県','12':'千葉県','13':'東京都','14':'神奈川県','15':'新潟県','16':'富山県','17':'石川県','18':'福井県','19':'山梨県','20':'長野県',
    '21':'岐阜県','22':'静岡県','23':'愛知県','24':'三重県','25':'滋賀県','26':'京都府','27':'大阪府','28':'兵庫県','29':'奈良県','30':'和歌山県',
    '31':'鳥取県','32':'島根県','33':'岡山県','34':'広島県','35':'山口県','36':'徳島県','37':'香川県','38':'愛媛県','39':'高知県','40':'福岡県',
    '41':'佐賀県','42':'長崎県','43':'熊本県','44':'大分県','45':'宮崎県','46':'鹿児島県','47':'沖縄県'
  };
  const L = (ind) => ind.years.length - 1;
  const at = (a, ind) => { const s = a.v[ind.key]; return s ? s[L(ind)] : null; };
  const lastKnown = (a, ind) => {
    const s = a.v[ind.key] || [];
    for (let i = s.length - 1; i >= 0; i--) if (s[i] !== null && s[i] !== undefined) return { v: s[i], i };
    return null;
  };
  const r = (ind, v) => Number(v.toFixed(ind.decimals));
  const fmtNum = (ind, v) => {
    if (v === null || v === undefined) return '—';
    const n = r(ind, v);
    return ind.decimals > 0 ? n.toLocaleString('ja-JP', { minimumFractionDigits: ind.decimals, maximumFractionDigits: ind.decimals }) : Math.round(n).toLocaleString('ja-JP');
  };
  const fmt = (ind, v) => (v === null || v === undefined ? '—' : fmtNum(ind, v) + (ind.unit ? `<small>${ind.unit}</small>` : ''));
  const fmtText = (ind, v) => fmtNum(ind, v) + (ind.unit || '');
  const prefOf = (a) => a.c.slice(0, 2);
  const shortName = (a) => { const p = PREF_NAMES[prefOf(a)]; return !isPref && p && a.n.startsWith(p) ? a.n.slice(p.length).trim() : a.n; };

  // 同じ値は同じ順位（表示の桁でそろえる）
  const poolOf = (ind, pref) => AREAS.filter((a) => !a.x && at(a, ind) !== null && (!pref || prefOf(a) === pref));
  const rankIn = (ind, a, pool) => {
    const v = at(a, ind);
    if (v === null || a.x) return null;
    const rv = r(ind, v);
    return pool.filter((b) => r(ind, at(b, ind)) > rv).length + 1;
  };

  // ---- 10-18 散らばりの中の位置（人口あたり・分位・偏差値・ドット帯） ----
  const POP = D.pop || null;
  const pcOf = (a, ind) => {
    const v = at(a, ind);
    if (!ind.perCap || !POP || v === null || !POP[a.c]) return null;
    return ind.perCap === 'man' ? (v * 1e4) / POP[a.c] : (v / POP[a.c]) * 1e5;
  };
  const pcLabel = (ind) => (ind.perCap === 'man' ? '1人あたり' : '人口10万人あたり');
  const pcUnit = (ind) => (ind.perCap === 'man' ? '万円' : ind.unit);
  const pcDec = (ind, vals) => { const med = vals.length ? Math.abs(vals[Math.floor(vals.length / 2)]) : 0; return med >= 100 ? 0 : med >= 10 ? 1 : 2; };
  const metricOf = (a, ind) => (ind.perCap && POP ? pcOf(a, ind) : at(a, ind));
  const DIST = {};
  const distOf = (ind) => {
    if (DIST[ind.key]) return DIST[ind.key];
    const vals = AREAS.filter((a) => !a.x).map((a) => metricOf(a, ind)).filter((v) => v !== null && Number.isFinite(v)).sort((x, y) => x - y);
    const n = vals.length;
    const mean = vals.reduce((s, v) => s + v, 0) / (n || 1);
    const sd = Math.sqrt(vals.reduce((s, v) => s + (v - mean) ** 2, 0) / (n || 1));
    const skew = sd > 0 ? vals.reduce((s, v) => s + ((v - mean) / sd) ** 3, 0) / n : 0;
    const q = (p) => { if (!n) return null; const h = (n - 1) * p; const lo = Math.floor(h); return vals[lo] + (vals[Math.min(lo + 1, n - 1)] - vals[lo]) * (h - lo); };
    const out = { vals, n, mean, sd, skew, q, dec: ind.perCap ? pcDec(ind, vals) : ind.decimals };
    DIST[ind.key] = out;
    return out;
  };
  // 分位（上位◯％）：大きいほうから数えた順位を全体の数で割る。同じ値は同じ順位
  const posText = (ind, a) => {
    const v = metricOf(a, ind);
    if (v === null || a.x) return '';
    const S = distOf(ind);
    if (S.n < 5) return '';
    const above = S.vals.filter((x) => x > v + 1e-12).length;
    const rk = above + 1;
    const pTop = Math.ceil((rk / S.n) * 100);
    const pBot = Math.ceil(((S.n - rk + 1) / S.n) * 100);
    const part = pTop <= 50 ? `上位${pTop}％` : `下位${pBot}％`;
    // 偏差値は、分布が左右に大きく偏っていないときだけ出す（偏りが強いと、極端な値に引っぱられて実感とずれるため）
    const dev = S.sd > 0 && Math.abs(S.skew) < 1 ? Math.round(50 + (10 * (v - S.mean)) / S.sd) : null;
    return part + (dev === null ? '' : `・偏差値${dev}`);
  };
  const stripSvg = (ind, a) => {
    const v = metricOf(a, ind);
    const S = distOf(ind);
    if (v === null || S.n < 5) return '';
    const W = 200, H = 18, PAD = 6;
    let lo, hi;
    if (isPref) { lo = S.vals[0]; hi = S.vals[S.n - 1]; } else { lo = S.q(0.01); hi = S.q(0.99); }
    if (!(hi > lo)) return '';
    const X = (x) => PAD + ((Math.min(Math.max(x, lo), hi) - lo) / (hi - lo)) * (W - PAD * 2);
    let body = '';
    if (isPref) {
      // 10-18 47県は「積み上げた点」で描く：近い値の点は重ねずに上へ積む（重なって滲んで見えないように）
      const R = 2.5, STEP = R * 2 + 0.5;
      const bins = {};
      let selBin = null, selRow = null;
      const placed = S.vals.map((x) => { const b = Math.round((X(x) - PAD) / STEP); const k = (bins[b] = (bins[b] ?? -1) + 1); return { b, k, x }; });
      const maxK = Math.max(...placed.map((p) => p.k));
      const base = 4 + R + maxK * STEP;
      const Hp = base + R + 4;
      const vRounded = v;
      for (const p of placed) if (selBin === null && Math.abs(p.x - vRounded) < 1e-9) { selBin = p.b; selRow = p.k; }
      body = placed.map((p) => (p.b === selBin && p.k === selRow ? '' : `<circle cx="${(PAD + p.b * STEP).toFixed(1)}" cy="${(base - p.k * STEP).toFixed(1)}" r="${R}" fill="#1F2A44" fill-opacity=".38"/>`)).join('');
      const mx = selBin === null ? X(v) : PAD + selBin * STEP;
      const my = selBin === null ? base : base - selRow * STEP;
      const tipP = '47都道府県の値を、近いものは上に積んで点で並べたもの。赤がこの県';
      return `<svg class="rm-dist" viewBox="0 0 ${W} ${Hp.toFixed(1)}" role="img" aria-label="${tipP}"><title>${tipP}</title><line x1="${PAD}" y1="${(base + R + 1.5).toFixed(1)}" x2="${W - PAD}" y2="${(base + R + 1.5).toFixed(1)}" stroke="#1F2A44" stroke-opacity=".2"/>${body}<circle cx="${mx.toFixed(1)}" cy="${my.toFixed(1)}" r="${R + 1.2}" fill="#B3402A" stroke="#fff" stroke-width="1"/></svg>`;
    } else {
      const p5 = X(S.q(0.05)), p25 = X(S.q(0.25)), p50 = X(S.q(0.5)), p75 = X(S.q(0.75)), p95 = X(S.q(0.95));
      body = `<line x1="${p5}" y1="9" x2="${p95}" y2="9" stroke="#1F2A44" stroke-opacity=".35"/>` +
        `<rect x="${p25}" y="4" width="${Math.max(1, p75 - p25)}" height="10" fill="#1F2A44" fill-opacity=".14" stroke="#1F2A44" stroke-opacity=".35"/>` +
        `<line x1="${p50}" y1="3" x2="${p50}" y2="15" stroke="#1F2A44" stroke-opacity=".6"/>`;
    }
    const out = !isPref && (v < lo || v > hi);
    const mark = `<circle cx="${X(v).toFixed(1)}" cy="9" r="4.2" fill="#B3402A" stroke="#fff" stroke-width="1.2"/>`;
    const tip = isPref ? '47都道府県の値を点で並べたもの。赤がこの県' : '真ん中の箱は全国の市区町村の真ん中半分、線は5〜95％の範囲。赤がこの町' + (out ? '（端の外にあるため端に置いています）' : '');
    return `<svg class="rm-dist" viewBox="0 0 ${W} ${H}" role="img" aria-label="${tip}"><title>${tip}</title>${body}${mark}</svg>`;
  };

  // ---- 選択 ----
  const prefSel = document.getElementById('rmPref');
  const townSel = document.getElementById('rmTown');
  if (isPref) {
    for (const a of AREAS) { const o = document.createElement('option'); o.value = a.c; o.textContent = a.n; prefSel.appendChild(o); }
    prefSel.addEventListener('change', () => { const a = AREAS.find((x) => x.c === prefSel.value); if (a) render(a); });
  } else {
    const prefs = [...new Set(AREAS.map(prefOf))].sort();
    for (const p of prefs) { const o = document.createElement('option'); o.value = p; o.textContent = PREF_NAMES[p] || p; prefSel.appendChild(o); }
    const fillTowns = (p) => {
      townSel.innerHTML = '<option value="">選んでください</option>';
      const list = AREAS.filter((a) => prefOf(a) === p);
      for (const a of list) { const o = document.createElement('option'); o.value = a.c; o.textContent = shortName(a); townSel.appendChild(o); }
      townSel.disabled = list.length === 0;
    };
    prefSel.addEventListener('change', () => { fillTowns(prefSel.value); document.getElementById('rmResult').hidden = true; updateScopeOptions(); });
    townSel.addEventListener('change', () => { const a = AREAS.find((x) => x.c === townSel.value); if (a) render(a); });
    window.__rmFillTowns = fillTowns;
  }

  // ---- 帳面 ----
  let current = null;
  let compare = [];
  const COLORS = ['#B3402A', '#4B5570', '#c99a2e', '#4a6fa5', '#7a5c99'];
  const MAXCMP = 4;
  function extraOf(ind, a, isLatest) {
    if (!isLatest || a.x) return '';
    let h = '';
    if (ind.perCap && POP) {
      const pv = pcOf(a, ind);
      if (pv !== null) {
        const S = distOf(ind);
        const rk = S.vals.filter((x) => x > pv + 1e-12).length + 1;
        // 見せ方：人口10万人あたりが大きくなりすぎる項目は、人の数なら「人口に対する割合」、それ以外は「1人あたり」に直す
        const med = S.q(0.5) || 0;
        let label = pcLabel(ind), unit = pcUnit(ind), shown = pv, dec = S.dec;
        if (ind.perCap === 'p100k' && ind.unit === '人' && med >= 1000) { label = '人口に対する割合'; unit = '％'; shown = pv / 1000; dec = 1; }
        else if (ind.perCap === 'p100k' && med >= 100000) { label = '1人あたり'; shown = pv / 1e5; dec = shown >= 100 ? 0 : shown >= 10 ? 1 : 2; }
        h += `<div class="rm-card-pc">${label} <b>${shown.toLocaleString('ja-JP', { minimumFractionDigits: dec, maximumFractionDigits: dec })}</b>${unit}<span>${isPref ? '47都道府県中' : '全国'} ${rk}位${isPref ? '' : `／${S.n}`}</span></div>`;
      }
    }
    if (ind.lq) {
      const nat = isPref ? (D.national && D.national[ind.key] ? D.national[ind.key][L(ind)] : null) : (D.nationalLatest ? D.nationalLatest[ind.key] : null);
      const v = at(a, ind);
      if (nat > 0 && v !== null) {
        const lq = v / nat;
        h += `<div class="rm-card-lq">特化係数 <b>${lq.toFixed(2)}</b><span>全国の割合（${nat.toFixed(1)}％）の${lq.toFixed(2)}倍</span></div>`;
      }
    }
