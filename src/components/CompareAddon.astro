---
// =====================================================
// ほかの県/市区町村とならべる（共通エンジン以前に作った窓口用の後付け部品）
// ・ページの都道府県/市区町村セレクタ（selectId）で選ばれた地域を基準に、
//   ほかの地域を4つまで足して、数字を横に並べた表を出す。
// ・データは src（JSON）から読むか、ページが window[global] に置いたものを使う。
//   形はどちらも { indicators:[{label|key, unit, decimal?}], areas:[{c, n, p?, x?, v:[]}] }。
//   adapter="prices" は消費者物価（v が {code:[年ごとの値]}）を最新年の値に直して使う。
// ・順位は値の大きい順（同じ値は同じ順位）。x のついた地域（政令市の区など）は順位をつけない。
// ・?cmp=コード,コード で、並べる地域を指定して開ける。
// =====================================================
interface Props {
  level: 'pref' | 'town';
  selectId: string;
  src?: string;
  global?: string;
  adapter?: 'std' | 'prices';
}
const { level, selectId, src = '', global = '', adapter = 'std' } = Astro.props;
const isPref = level === 'pref';
const word = isPref ? '県' : '市区町村';
---
<section class="cmpx" hidden aria-label="ほかの地域とならべる" data-level={level} data-select={selectId} data-src={src} data-global={global} data-adapter={adapter}>
  <div class="cmpx-pos" hidden>
    <h2>散らばりの中の位置</h2>
    <p class="cmpx-note">選んだ{word}が、{isPref ? '47都道府県' : '全国の市区町村'}の中のどのあたりにあるかを項目ごとに示します。{isPref ? '点は47都道府県の値（近い値は上に積んでいます）' : '箱は全国の市区町村の真ん中半分、線は5〜95％の範囲'}で、赤がこの{isPref ? '県' : '町'}です。</p>
    <div class="cmpx-pos-list"></div>
    <p class="cmpx-note cmpx-foot2">「上位◯％」は値の大きい順に並べたときの位置です。偏差値は、分布の偏りが小さい項目にだけ出しています。数の項目は、総人口で割った「人口あたり」でも位置を示します。読み方：<a href="/how-to-read/position/">10位は、近いのか遠いのか</a>｜<a href="/how-to-read/per-capita/">数えた数は、割ってから並べる</a></p>
  </div>
  <h2>ほかの{word}とならべる</h2>
  <p class="cmpx-note">{word}を4つまで足して、数字を横に並べます。</p>
  <div class="cmpx-sel">
    <label><span>都道府県</span><select class="cmpx-pref"><option value="">{isPref ? '足す県を選ぶ' : '選んでください'}</option></select></label>
    {!isPref && <label><span>市区町村</span><select class="cmpx-town" disabled><option value="">まず都道府県を選ぶ</option></select></label>}
  </div>
  <p class="cmpx-sim" hidden></p>
  <ul class="cmpx-chips"></ul>
  <div class="cmpx-wrap" hidden><table class="cmpx-table"></table></div>
  <p class="cmpx-note cmpx-foot" hidden>順位は{isPref ? '47都道府県の中' : '全国の市区町村の中'}での、値の大きい順の順位です。</p>
</section>

<script is:inline>
(function () {
  const sec = document.currentScript.previousElementSibling;
  if (!sec || !sec.classList.contains('cmpx')) return;
  const isPref = sec.dataset.level === 'pref';
  const COLORS = ['#B3402A', '#4B5570', '#c99a2e', '#4a6fa5', '#7a5c99'];
  const MAXCMP = 4;
  const PREF_NAMES = {'01':'北海道','02':'青森県','03':'岩手県','04':'宮城県','05':'秋田県','06':'山形県','07':'福島県','08':'茨城県','09':'栃木県','10':'群馬県','11':'埼玉県','12':'千葉県','13':'東京都','14':'神奈川県','15':'新潟県','16':'富山県','17':'石川県','18':'福井県','19':'山梨県','20':'長野県','21':'岐阜県','22':'静岡県','23':'愛知県','24':'三重県','25':'滋賀県','26':'京都府','27':'大阪府','28':'兵庫県','29':'奈良県','30':'和歌山県','31':'鳥取県','32':'島根県','33':'岡山県','34':'広島県','35':'山口県','36':'徳島県','37':'香川県','38':'愛媛県','39':'高知県','40':'福岡県','41':'佐賀県','42':'長崎県','43':'熊本県','44':'大分県','45':'宮崎県','46':'鹿児島県','47':'沖縄県'};
  const prefOf = (a) => a.c.slice(0, 2);
  const shortName = (a) => { const p = PREF_NAMES[prefOf(a)]; return p && a.n.startsWith(p) ? a.n.slice(p.length).trim() : a.n; };
  const nameOf = (a) => (isPref ? a.n : `${shortName(a)}（${PREF_NAMES[prefOf(a)] || ''}）`);

  function normalize(d) {
    if (sec.dataset.adapter === 'prices') {
      const last = d.years.length - 1;
      return {
        indicators: d.categories.map((c) => ({ label: c.label, unit: '', decimal: 1, code: c.code })),
        areas: d.areas.map((a) => ({ c: a.c, n: a.n, v: d.categories.map((c) => { const s = a.v[c.code]; return s && typeof s[last] === 'number' ? s[last] : null; }) })),
        caption: `${d.yearLabel || d.years[last] + '年'}の値。全国平均を100とした物価の水準です。`,
      };
    }
    return { indicators: d.indicators, areas: d.areas };
  }

  function start(raw) {
    const D = normalize(raw);
    const IND = D.indicators.map((ind) => ({ label: ind.label || ind.key || ind.name || '', unit: ind.unit && ind.unit !== '‐' && ind.unit !== '-' ? ind.unit : '', decimal: ind.decimal, year: ind.year || '' }));
    const AREAS = D.areas.filter((a) => a && a.c && Array.isArray(a.v));
    const byCode = Object.fromEntries(AREAS.map((a) => [a.c, a]));
    const decOf = IND.map((ind, i) => {
      if (typeof ind.decimal === 'number') return ind.decimal;
      let d = 0;
      for (const a of AREAS) { const v = a.v[i]; if (typeof v === 'number' && !Number.isInteger(v)) { const s = String(v).split('.')[1] || ''; d = Math.max(d, Math.min(s.length, 2)); } }
      return d;
    });
    const fmt = (i, v) => (typeof v === 'number' ? v.toLocaleString('ja-JP', { minimumFractionDigits: decOf[i], maximumFractionDigits: decOf[i] }) + (IND[i].unit === '‰' || IND[i].unit === '％' ? IND[i].unit : IND[i].unit ? ' ' + IND[i].unit : '') : '—');
    const RANK = IND.map((_, i) => {
      const vals = AREAS.filter((a) => !a.x && typeof a.v[i] === 'number').map((a) => a.v[i]).sort((x, y) => y - x);
      return (v) => (typeof v === 'number' ? vals.indexOf(v) + 1 : null);
    });

    // ---- 10-18 散らばりの中の位置 ----
    const PCU = new Set(['人', 'か所', '所', '施設', '件', '戸', '台', '事業所', '店', '校', '館', '棟', '世帯', '事業体', '人泊', '者', '法人', '講座', '園', '署', '団', '億円', '病院', '診療所', '床']);
    const isCount = (ind) => PCU.has(ind.unit) && !/あたり|当たり|割合|率|平均|倍|1人|１人|1か月|1校|1園|1学級|1住宅|1戸|千人|万人/.test(ind.label);
    let POP = null;
    const popUrl = isPref ? '/data/population.json' : '/data/town-population.json';
    fetch(popUrl).then((r) => r.json()).then((P) => { POP = Object.fromEntries(P.areas.map((a) => [a.c, a.v[0]])); DIST.length = 0; render(); }).catch(() => {});
    const pcOf = (a, i) => { const v = a.v[i]; const n = POP && POP[a.c]; if (typeof v !== 'number' || !n) return null; return IND[i].unit === '億円' ? (v * 1e4) / n : (v / n) * 1e5; };
    const DIST = [];
    const distOf = (i, pc) => {
      const k = i * 2 + (pc ? 1 : 0);
      if (DIST[k]) return DIST[k];
      const vals = AREAS.filter((a) => !a.x).map((a) => (pc ? pcOf(a, i) : a.v[i])).filter((v) => typeof v === 'number' && Number.isFinite(v)).sort((x, y) => x - y);
      const n = vals.length, mean = vals.reduce((t, v) => t + v, 0) / (n || 1);
      const sd = Math.sqrt(vals.reduce((t, v) => t + (v - mean) ** 2, 0) / (n || 1));
      const skew = sd > 0 ? vals.reduce((t, v) => t + ((v - mean) / sd) ** 3, 0) / n : 0;
      const q = (p) => { const h = (n - 1) * p; const lo = Math.floor(h); return vals[lo] + (vals[Math.min(lo + 1, n - 1)] - vals[lo]) * (h - lo); };
      return (DIST[k] = { vals, n, mean, sd, skew, q });
    };
    const posText = (S, v) => {
      const rk = S.vals.filter((x) => x > v + 1e-12).length + 1;
      const pTop = Math.ceil((rk / S.n) * 100), pBot = Math.ceil(((S.n - rk + 1) / S.n) * 100);
      const dev = S.sd > 0 && Math.abs(S.skew) < 1 ? Math.round(50 + (10 * (v - S.mean)) / S.sd) : null;
      return { rk, text: (pTop <= 50 ? `上位${pTop}％` : `下位${pBot}％`) + (dev === null ? '' : `・偏差値${dev}`) };
    };
    const strip = (S, v) => {
      const W = 200, PAD = 6;
      let lo, hi;
      if (isPref) { lo = S.vals[0]; hi = S.vals[S.n - 1]; } else { lo = S.q(0.01); hi = S.q(0.99); }
      if (!(hi > lo)) return '';
      const X = (x) => PAD + ((Math.min(Math.max(x, lo), hi) - lo) / (hi - lo)) * (W - PAD * 2);
      if (isPref) {
        const R = 2.5, STEP = R * 2 + 0.5, bins = {};
        const placed = S.vals.map((x) => { const b = Math.round((X(x) - PAD) / STEP); const k = (bins[b] = (bins[b] ?? -1) + 1); return { b, k, x }; });
        const maxK = Math.max(...placed.map((p) => p.k)), base = 4 + R + maxK * STEP, H = base + R + 4;
        const me = placed.find((p) => Math.abs(p.x - v) < 1e-9);
        const dots = placed.map((p) => (p === me ? '' : `<circle cx="${(PAD + p.b * STEP).toFixed(1)}" cy="${(base - p.k * STEP).toFixed(1)}" r="${R}" fill="#1F2A44" fill-opacity=".38"/>`)).join('');
        const mx = me ? PAD + me.b * STEP : X(v), my = me ? base - me.k * STEP : base;
        return `<svg viewBox="0 0 ${W} ${H.toFixed(1)}" aria-hidden="true"><line x1="${PAD}" y1="${(base + R + 1.5).toFixed(1)}" x2="${W - PAD}" y2="${(base + R + 1.5).toFixed(1)}" stroke="#1F2A44" stroke-opacity=".2"/>${dots}<circle cx="${mx.toFixed(1)}" cy="${my.toFixed(1)}" r="${R + 1.2}" fill="#B3402A" stroke="#fff" stroke-width="1"/></svg>`;
      }
      const p5 = X(S.q(0.05)), p25 = X(S.q(0.25)), p50 = X(S.q(0.5)), p75 = X(S.q(0.75)), p95 = X(S.q(0.95));
      return `<svg viewBox="0 0 ${W} 18" aria-hidden="true"><line x1="${p5}" y1="9" x2="${p95}" y2="9" stroke="#1F2A44" stroke-opacity=".35"/><rect x="${p25}" y="4" width="${Math.max(1, p75 - p25)}" height="10" fill="#1F2A44" fill-opacity=".14" stroke="#1F2A44" stroke-opacity=".35"/><line x1="${p50}" y1="3" x2="${p50}" y2="15" stroke="#1F2A44" stroke-opacity=".6"/><circle cx="${X(v).toFixed(1)}" cy="9" r="4.2" fill="#B3402A" stroke="#fff" stroke-width="1.2"/></svg>`;
    };
    function renderPos() {
      const box = sec.querySelector('.cmpx-pos');
      if (!current) { box.hidden = true; return; }
      box.hidden = false;
      const list = sec.querySelector('.cmpx-pos-list');
      if (current.x) { list.innerHTML = '<p class="cmpx-note">政令指定都市の区は、全国の市区町村の順位や位置には入れていません。</p>'; return; }
      list.innerHTML = IND.map((ind, i) => {
        const v = current.v[i];
        if (typeof v !== 'number') return `<div class="cmpx-pos-row"><div class="cmpx-pos-lab">${ind.label}</div><div class="cmpx-pos-val">—</div><div></div><div></div></div>`;
        const S = distOf(i, false);
        if (S.n < 5) return '';
        const P = posText(S, v);
        let row = `<div class="cmpx-pos-row"><div class="cmpx-pos-lab">${ind.label}${ind.year ? `<small>${ind.year}</small>` : ''}</div><div class="cmpx-pos-val">${fmt(i, v)}<small>${P.rk}位／${S.n}</small></div><div class="cmpx-pos-svg">${strip(S, v)}</div><div class="cmpx-pos-txt">${P.text}</div></div>`;
        if (isCount(ind) && POP && !/人口/.test(ind.label)) {
          const pv = pcOf(current, i);
          if (pv !== null) {
            const S2 = distOf(i, true);
            const P2 = posText(S2, pv);
            const med = S2.q(0.5);
            let lab = IND[i].unit === '億円' ? '1人あたり' : '人口10万人あたり', shown = pv, u = IND[i].unit === '億円' ? '万円' : IND[i].unit;
            if (IND[i].unit === '人' && med >= 1000) { lab = '人口に対する割合'; shown = pv / 1000; u = '％'; }
            else if (IND[i].unit !== '億円' && med >= 100000) { lab = '1人あたり'; shown = pv / 1e5; }
            const d = Math.abs(shown) >= 100 ? 0 : Math.abs(shown) >= 10 ? 1 : 2;
            row += `<div class="cmpx-pos-row cmpx-pos-row--pc"><div class="cmpx-pos-lab">　${lab}</div><div class="cmpx-pos-val">${shown.toLocaleString('ja-JP', { minimumFractionDigits: d, maximumFractionDigits: d })}${u}<small>${P2.rk}位／${S2.n}</small></div><div class="cmpx-pos-svg">${strip(S2, pv)}</div><div class="cmpx-pos-txt">${P2.text}</div></div>`;
          }
        }
        return row;
      }).join('');
    }

    let current = null;
    let compare = [];
    const sel = document.getElementById(sec.dataset.select);
    const cPref = sec.querySelector('.cmpx-pref');
    const cTown = sec.querySelector('.cmpx-town');
    if (isPref) {
      for (const a of AREAS) { const o = document.createElement('option'); o.value = a.c; o.textContent = a.n; cPref.appendChild(o); }
      cPref.addEventListener('change', () => { add(cPref.value); cPref.value = ''; });
    } else {
      const prefs = [...new Set(AREAS.map(prefOf))].sort();
      for (const p of prefs) { const o = document.createElement('option'); o.value = p; o.textContent = PREF_NAMES[p] || p; cPref.appendChild(o); }
      cPref.addEventListener('change', () => {
        cTown.innerHTML = '<option value="">足す市区町村を選ぶ</option>';
        const list = AREAS.filter((a) => prefOf(a) === cPref.value);
        for (const a of list) { const o = document.createElement('option'); o.value = a.c; o.textContent = shortName(a); cTown.appendChild(o); }
        cTown.disabled = list.length === 0;
      });
      cTown.addEventListener('change', () => { add(cTown.value); cTown.value = ''; });
    }
    // 10-18 似た地域：県は人口の規模だけ、市区町村は総務省の類似団体にならい「人口＋産業の構成（第2次＋第3次の割合、第3次の割合）」で近い順に4つ
    let SIM_IND = null;
    if (!isPref) fetch('/data/room-town-work.json').then((r) => r.json()).then((W) => {
      const k2 = W.indicators.findIndex((i) => i.key === 'secondary'), k3 = W.indicators.findIndex((i) => i.key === 'tertiary');
      if (k2 < 0 || k3 < 0) return;
      const last = (arr) => { if (!arr) return null; for (let i = arr.length - 1; i >= 0; i--) if (typeof arr[i] === 'number') return arr[i]; return null; };
      SIM_IND = {};
      for (const a of W.areas) { const s2 = last(a.v.secondary), s3 = last(a.v.tertiary); if (s2 !== null && s3 !== null) SIM_IND[a.c] = { s23: s2 + s3, s3 }; }
      SIM_IND.__year = W.indicators[k3].yearLabels.at(-1);
      SIM_HOOK();
    }).catch(() => {});
    function simNear(cur, pool, pop) {
      const p0 = pop && pop[cur.c];
      if (!p0) return null;
      const cand = pool.filter((b) => !b.x && b.c !== cur.c && pop[b.c] > 0);
      const me = SIM_IND && SIM_IND[cur.c];
      if (isPref || !me) return { list: cand.map((b) => ({ b, d: Math.abs(Math.log(pop[b.c] / p0)) })).sort((x, y) => x.d - y.d).slice(0, 4).map((x) => x.b), withInd: false };
      // それぞれの物差しを市区町村全体の標準偏差でそろえてから距離をとる
      const rows = cand.filter((b) => SIM_IND[b.c]).map((b) => ({ b, lp: Math.log(pop[b.c]), s23: SIM_IND[b.c].s23, s3: SIM_IND[b.c].s3 }));
      const sd = (k) => { const v = rows.map((r) => r[k]); const m = v.reduce((s, x) => s + x, 0) / v.length; return Math.sqrt(v.reduce((s, x) => s + (x - m) ** 2, 0) / v.length) || 1; };
      const S = { lp: sd('lp'), s23: sd('s23'), s3: sd('s3') };
      const lp0 = Math.log(p0);
      const list = rows.map((r) => ({ b: r.b, d: Math.hypot((r.lp - lp0) / S.lp, (r.s23 - me.s23) / S.s23, (r.s3 - me.s3) / S.s3) })).sort((x, y) => x.d - y.d).slice(0, 4).map((x) => x.b);
      return { list, withInd: true };
    }
    function simHtml(near, full, compare, nameOf, pop) {
      const head = near.withInd ? '人口と産業の構成が近い市区町村' : `人口の規模が近い${isPref ? '県' : '市区町村'}`;
      return `<span>${head}：</span>` + near.list.map((b) => {
        const sub = near.withInd ? `${Math.round(pop[b.c]).toLocaleString('ja-JP')}人・第3次${SIM_IND[b.c].s3.toFixed(0)}％` : `${Math.round(pop[b.c]).toLocaleString('ja-JP')}人`;
        return `<button type="button" data-c="${b.c}"${full || compare.some((x) => x.c === b.c) ? ' disabled' : ''}>${nameOf(b)}<small>${sub}</small></button>`;
      }).join('');
    }
    const SIM_HOOK = () => { if (current) render(); };
    function add(code) {
      const a = byCode[code];
      if (!a || !current || a.c === current.c || compare.some((b) => b.c === a.c) || compare.length >= MAXCMP) return;
      compare.push(a);
      render();
      syncUrl();
    }
    function syncUrl() {
      try {
        const u = new URL(location.href);
        if (compare.length) u.searchParams.set('cmp', compare.map((a) => a.c).join(',')); else u.searchParams.delete('cmp');
        history.replaceState(null, '', u);
      } catch (e) {}
    }
    function render() {
      if (!current) { sec.hidden = true; return; }
      sec.hidden = false;
      renderPos();
      const full = compare.length >= MAXCMP;
      cPref.disabled = full;
      if (cTown) cTown.disabled = full || !cPref.value;
      const simBox = sec.querySelector('.cmpx-sim');
      const near = simBox ? simNear(current, AREAS, POP) : null;
      if (simBox && near && near.list.length) {
        simBox.hidden = false;
        simBox.innerHTML = simHtml(near, full, compare, nameOf, POP);
        simBox.querySelectorAll('button').forEach((bt) => bt.addEventListener('click', () => add(bt.dataset.c)));
      } else if (simBox) simBox.hidden = true;
      const chips = sec.querySelector('.cmpx-chips');
      chips.innerHTML = '';
      const all = [current, ...compare];
      all.forEach((a, k) => {
        const li = document.createElement('li');
        li.innerHTML = `<i style="background:${COLORS[k]}"></i>${nameOf(a)}`;
        if (k > 0) {
          const b = document.createElement('button');
          b.type = 'button'; b.setAttribute('aria-label', `${nameOf(a)}を外す`); b.textContent = '×';
          b.addEventListener('click', () => { compare = compare.filter((x) => x.c !== a.c); render(); syncUrl(); });
          li.appendChild(b);
        }
        chips.appendChild(li);
      });
      // 10-24 ページのグラフに、比べている地域を知らせる（engine の窓口は図に線が出るので、手書きもそろえる）
      // 値はページ側が持っているので、ここでは地域のコードと名前、そして札と同じ色だけを渡す
      try {
        document.dispatchEvent(new CustomEvent('cmpx:change', { detail: {
          select: sec.dataset.select, level,
          current: current ? { c: current.c, n: nameOf(current) } : null,
          compare: compare.map((a) => ({ c: a.c, n: nameOf(a) })),
          colors: COLORS,
        } }));
      } catch (e) {}
      const wrap = sec.querySelector('.cmpx-wrap');
      const foot = sec.querySelector('.cmpx-foot');
      wrap.hidden = foot.hidden = compare.length === 0;
      if (compare.length === 0) return;
      const th = all.map((a, k) => `<th scope="col"><i style="background:${COLORS[k]}"></i>${isPref ? a.n : shortName(a)}${isPref ? '' : `<small>${PREF_NAMES[prefOf(a)] || ''}</small>`}</th>`).join('');
      const rows = IND.map((ind, i) => {
        const tds = all.map((a) => {
          const v = a.v[i];
          if (typeof v !== 'number') return '<td>—</td>';
          const rk = a.x ? null : RANK[i](v);
          return `<td><b>${fmt(i, v)}</b>${rk ? `<small>${rk}位</small>` : ''}</td>`;
        }).join('');
        return `<tr><th scope="row">${ind.label}${ind.year ? `<small>${ind.year}</small>` : ''}</th>${tds}</tr>`;
      }).join('');
      const cap = D.caption ? `<caption>${D.caption}</caption>` : '';
      sec.querySelector('.cmpx-table').innerHTML = `${cap}<thead><tr><th scope="col">項目</th>${th}</tr></thead><tbody>${rows}</tbody>`;
    }
    function follow() {
      const code = sel ? sel.value : '';
      const a = byCode[code] || null;
      if ((a && a.c) === (current && current.c)) return;
      current = a;
      compare = compare.filter((b) => !current || b.c !== current.c);
      render();
    }
    if (sel) sel.addEventListener('change', () => setTimeout(follow, 0));
    setInterval(follow, 600);
    const want = new URLSearchParams(location.search).get('cmp');
    const pending = want ? want.split(',').filter((c) => byCode[c]).slice(0, MAXCMP) : [];
    (function waitBase(n) {
      follow();
      if (current) { pending.forEach(add); return; }
      if (n < 20) setTimeout(() => waitBase(n + 1), 300);
    })(0);
  }

  const src = sec.dataset.src;
  const g = sec.dataset.global;
  if (src) {
    fetch(src).then((r) => r.json()).then(start).catch(() => {});
  } else if (g) {
    (function wait(n) { if (window[g]) start(window[g]); else if (n < 50) setTimeout(() => wait(n + 1), 100); })(0);
  }
})();
</script>

