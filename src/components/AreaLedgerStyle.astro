---
// 展望塔の台帳（/tower/）の共通の見た目。町の台帳はスクリプトで表を差し込むので is:global にしている（クラスは al- 接頭辞）
---
<style is:global>
.al{max-width:900px;margin:0 auto;padding:40px 16px 72px}
.al-kicker{font-family:"IBM Plex Mono",monospace;font-size:.75rem;letter-spacing:.3em;color:var(--stamp)}
.al-head h1{font-family:"Shippori Mincho",serif;font-weight:800;font-size:clamp(1.5rem,4vw,2.1rem);margin-top:6px}
.al-lead{color:var(--ink-soft);margin:10px 0 20px;line-height:1.9}
.al-talk{margin:16px 0 8px}
.al-jump{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:18px 0 8px;font-size:.88rem}
.al-jump select{font:inherit;font-size:.9rem;padding:6px 10px;border:1px solid var(--line);border-radius:6px;background:#fff;max-width:100%}
.al-jump a{color:var(--stamp)}
.al-group{margin-top:28px}
.al-bighead{font-family:"Shippori Mincho",serif;font-weight:800;font-size:1.35rem;margin-top:48px;padding-bottom:6px;border-bottom:1px solid var(--line);scroll-margin-top:90px}
.al-group h2{font-family:"Shippori Mincho",serif;font-weight:800;font-size:1.15rem;border-left:4px solid #2d6a4f;padding-left:10px;margin-bottom:8px}
.al-table{width:100%;border-collapse:collapse;background:#fff;border:1px solid var(--line);border-radius:10px;overflow:hidden;font-size:.9rem}
.al-table th,.al-table td{padding:9px 12px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
.al-table thead th{background:#f3f1ea;font-size:.75rem;font-weight:600;color:var(--ink-soft);letter-spacing:.05em}
.al-table tr:last-child td{border-bottom:0}
.al-label a{color:var(--ink);text-decoration:none;border-bottom:1px dotted #aaa}
.al-label a:hover{color:var(--stamp);border-color:var(--stamp)}
.al-room{display:block;font-size:.72rem;color:var(--ink-soft);margin-top:2px}
.al-val{white-space:nowrap;font-weight:700;font-variant-numeric:tabular-nums}
.al-val small{font-weight:400;font-size:.75rem;margin-left:2px}
.al-year,.al-cmp,.al-rank{white-space:nowrap;font-size:.8rem;color:var(--ink-soft);font-variant-numeric:tabular-nums}
.al-rank b{color:var(--ink);font-weight:700}
.al-none{color:#aaa}
.al-note{margin-top:28px;font-size:.8rem;color:var(--ink-soft);line-height:1.9}
.al-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:8px;margin-top:10px}
.al-list a{display:block;padding:8px 10px;background:#fff;border:1px solid var(--line);border-radius:8px;color:var(--ink);text-decoration:none;font-size:.9rem;text-align:center}
.al-list a:hover{border-color:var(--stamp);color:var(--stamp)}
.al-region{margin-top:18px;font-size:.8rem;color:var(--ink-soft);letter-spacing:.1em}
@media(max-width:640px){
  .al-table thead{display:none}
  .al-table,.al-table tbody,.al-table tr,.al-table td{display:block;width:100%}
  .al-table tr{padding:10px 12px;border-bottom:1px solid var(--line)}
  .al-table td{border:0;padding:2px 0}
  .al-table td.al-val{font-size:1.05rem}
  .al-table td[data-h]::before{content:attr(data-h)'：';color:var(--ink-soft);font-size:.75rem}
}
/* 旧展望塔の計器盤（2026-10-13 に台帳へ流用） */
.tw-figure{display:block;width:100%;max-width:900px;height:auto;border-radius:4px;margin:0 auto 28px}
.al .sec-head{flex-direction:column;align-items:flex-start;gap:0;padding-bottom:14px;margin-bottom:20px}
.al .sec-head .no{font-size:.72rem;letter-spacing:.3em}
.al .sec-head h1{font-family:"Shippori Mincho",serif;font-weight:800;font-size:clamp(1.6rem,4vw,2.4rem);margin-top:8px;line-height:1.35}
.al .sec-head .sub{color:var(--ink-soft);font-size:.9rem;margin-top:8px;line-height:1.9}
.tw-picker{margin:20px 0 8px;display:flex;flex-wrap:wrap;gap:12px 20px;padding:16px 18px;background:#fdfcf7;border:2px solid var(--line);border-radius:14px}
.tw-picker label{display:flex;flex-direction:column;gap:6px;font-size:.85rem;flex:1 1 220px}
.tw-picker select{width:100%;padding:10px 12px;border:1px solid #1b4332;border-radius:6px;background:#fff;font-size:1rem;font-family:inherit}
.tw-picker select:disabled{background:#f0f0ea;color:#999}
.board-head{font-family:"Shippori Mincho",serif;font-size:1.05rem;font-weight:800;border-left:4px solid var(--stamp);padding-left:12px;margin:36px 0 14px}
.board{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2px;background:var(--line);border:2px solid var(--line);border-radius:14px;overflow:hidden}
.gauge{background:#fdfcf7;padding:26px 22px 20px;display:flex;flex-direction:column;gap:8px;text-decoration:none;color:inherit;transition:background .15s}
a.gauge:hover{background:#f7f4e9}
.g-label{font-size:.72rem;letter-spacing:.16em;color:var(--ink-soft);border-bottom:1px dashed var(--line);padding-bottom:8px;line-height:1.6}
.g-value{font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:clamp(1.8rem,5vw,2.4rem);color:var(--stamp);line-height:1.1;overflow-wrap:anywhere}
.g-value small{font-family:"Shippori Mincho",serif;font-size:1rem;margin-left:4px;color:var(--ink)}
.g-value.small{font-family:"Shippori Mincho",serif;font-size:1.3rem;color:#aaa}
.g-unit{font-family:"IBM Plex Mono",monospace;font-size:.75rem;color:var(--ink-soft);line-height:1.7}
.g-unit b{color:var(--ink);font-weight:700}
.g-link{font-size:.72rem;color:var(--stamp);margin-top:auto;padding-top:10px}
.board-empty{padding:28px 22px;color:var(--ink-soft);font-size:.9rem;text-align:center;border:2px dashed var(--line);border-radius:14px;margin-top:20px}
@media(max-width:600px){.board{grid-template-columns:1fr}}
</style>
