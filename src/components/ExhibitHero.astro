---
// 展示の扉絵：public/images/exhibits/<slug>-large.webp を置けば出る（無いあいだは出さない）
import fs from 'node:fs';
import path from 'node:path';
// 絵の説明（代替テキスト）。絵を足したらここにも1行足す
const ALTS = {
  sleep: '夜更けの住宅地と、窓の灯りの下で布団に入ろうとする子どもの水彩画',
  commute: '朝の郊外の駅のホームで、到着する電車を待つ学生や勤め人の水彩画',
  housework: '家の断面図のなかで、料理・洗濯・掃除・子どもの身支度をする家族の水彩画',
  hobby: '休日の居間と縁側で、絵を描く・音楽を聴く・模型を作る・盆栽を手入れする人々の水彩画',
  study: '夕暮れの学習室で、参考書やノートパソコンを広げて学ぶ大人たちの水彩画',
  fishing: '港の防波堤で釣り糸を垂れる人々と、沖の灯台・漁船の水彩画',
  food: '夕暮れの飲食店街に灯る提灯と、のれんをくぐる人々の水彩画',
  cars: '田んぼの広がる郊外の一軒家と、庭先に並ぶ家族の車の水彩画',
  vacancy: '落ち葉の積もる空き家と、洗濯物が干された隣家が並ぶ路地の水彩画',
  'day-night-ratio': '線路をはさんで、奥にビルの並ぶ都心、手前に洗濯物の干された住宅地が広がり、電車が走る町の鳥瞰図の水彩画',
  pachinko: '田園の国道沿いに建つ遊技場と、夕暮れの駐車場を歩く人々の水彩画',
  price: '線路をはさんで、左に都会の駅前、右に瓦屋根の町が並び、それぞれの八百屋で野菜を選ぶ人々の水彩画',
  utility: '雪の夕方、こたつ・石油ストーブの居間と湯気の立つ台所・風呂を断面で見せる家の水彩画',
  hiking: '秋の尾根道を登る夫婦や親子連れと、眼下の段々畑の集落を描いた水彩画',
  reading: '雨上がりの路地の本屋で立ち読みする学生と、縁側で本やマンガを読むおばあさんと子どもの水彩画',
  'education-price': '桜の咲く通学路を校門へ向かう小学生や中高生と、文房具屋・学習塾の教室が並ぶ朝の水彩画',
  waste: '朝の住宅街のごみ集積所にごみ袋を運ぶ人々と、近づく収集車の水彩画',
  sunshine: '晴れた空の下、多島の海を見下ろすみかんの段々畑で収穫する人々の水彩画',
  gyoza: '夕方の台所の食卓で、祖母と子どもたちが餃子を包み、父親がフライパンで焼く水彩画',
  'board-games': '秋の公民館の和室で、将棋と囲碁の盤を囲む年配の人や子どもたちの水彩画',
  gardening: '初夏の庭先で花の苗を植える母子と、物置の前で板を切って棚を作る父親の水彩画',
  'japanese-arts': '紅葉の庭に面した座敷で、茶の湯・生け花・書に向かう人々を上から見た水彩画',
  'games-crafts': '雪の夜の居間で、ゲーム機で遊ぶ兄妹と、毛糸の帽子を編む祖母と猫の水彩画',
  'snow-ground': '雪解けの川をはさんで、左にスキー場で滑る家族、右に河川敷でグラウンドゴルフをする年配の人々の水彩画',
  'ball-games': '夕焼けの運動公園で、少年野球の試合とサッカーの練習が並び、間の並木道を人が行き交う水彩画',
  budo: '夕日の差す武道館で、板の間で剣道、畳で柔道の稽古をする子どもたちの水彩画',
  'housing-type': '秋の山あいの町で、木造の家の骨組みに梁を据える大工さんと見上げる人々の水彩画',
  solar: '丘から見下ろす住宅地の屋根に太陽光パネルが並び、縁側で親子がくつろぐ水彩画',
  karaoke: '夏の夜の公民館で、ギターとキーボードの伴奏で歌う男性と、手拍子や三味線・アコーディオンで加わる人々の水彩画',
  'beef-pork': '夕方の商店街の肉屋で、ガラスケースの肉を指さす親子と包丁を握る店主、隣の家の茶の間ですき焼き鍋を囲む三世代の家族を描いた水彩画',
  'coffee-tea': '朝の家で、台所でドリップのコーヒーをいれる人と、茶の間で急須から緑茶を注ぐおばあさん、窓の外の町並みを描いた水彩画',
  'bread-rice': '朝の商店街で、パン屋の店先でパンを選ぶ親子と、米袋が積まれた米屋で精米する店主を描いた水彩画',
  'movies-art': '夕暮れの噴水の広場をはさんで、灯りのともる映画館の切符売り場に並ぶ人々と、美術館の窓越しに絵を眺める人々を描いた水彩画',
  'camp-park': '秋の林のキャンプ場でテントを張る家族と焚き火を囲む人たち、丘の向こうの観覧車とメリーゴーランド、キリンを見上げる親子を描いた鳥瞰の水彩画',
  'cake-manju': '夕方の商店街で、洋菓子店のショーケースのケーキをのぞく子どもたちと、向かいの和菓子屋でせいろのまんじゅうを買うお年寄りを描いた水彩画',
  'tuna-salmon': '港町の魚屋の店先に、氷の上のマグロの柵とサケの切り身が並び、買い物かごを下げたお客さんが集まる様子を描いた水彩画',
  'spectator': '夜の町を見下ろして、照明に照らされた野球場のスタンドと、提灯の明かりがともる芝居小屋に入っていく人たちを描いた水彩画',
  'jogging-walking': '朝の河川敷で、土手の上をジョギングする人たち、遊歩道を歩くお年寄りの夫婦、輪になって体操をする人たちを描いた水彩画',
  'concert': '左に、シャンデリアの下で指揮者とオーケストラが演奏するホールの客席、右に、夜空の下の野外ステージでバンドの演奏に手を上げる観客を描いた水彩画',
  'table-tennis': '夕日の差しこむ体育館で、親子やお年寄りが卓球台を囲み、奥のコートで若い人たちがバドミントンをし、ベンチで見守る人たちを描いた水彩画',
  'soba-ramen': 'アーケードの商店街で、左ののれんのそば屋で食べる人たちと、右の赤い提灯のラーメン屋のカウンターですする人、そのあいだを歩く買い物客を描いた水彩画',
  'natto-tofu': '朝の食卓で父親と子どもが納豆ごはんを食べ、そばでおばあさんが豆腐を切り、台所で母親が支度をする家族を描いた水彩画',
  'golf-bowling': '左に、山あいのゴルフ練習場でクラブを振る男性と女性、右に、ボウリング場のレーンで球を投げる人と、手をたたいて応援する家族や仲間を描いた水彩画',
  'painting-pottery': '秋の窓辺の教室で、イーゼルに向かって絵を描く子どもやお年寄り、木彫りをする人、ろくろで器をつくる人たちと、棚に並ぶ焼きものを描いた水彩画',
  'sake-beer': '夕暮れの町で、杉玉を下げた酒屋で一升瓶を選ぶお年寄りの夫婦と、となりの家の座卓でビールのジョッキを合わせる家族を描いた水彩画',
  'senbei-chocolate': '商店街で、炭火でせんべいを焼く職人を見るおばあさんと子ども、向かいのお菓子屋でチョコレートを選ぶ若い二人と学生を描いた水彩画',
  'swim-cycling': '川沿いの町の鳥瞰図。手前の屋外プールで子どもや大人が泳ぎ、川沿いのサイクリングロードをヘルメットの人たちが自転車で走り、奥に鉄橋と山並みが見える水彩画',
  'apple-mandarin': '雪の残る冬の八百屋の店先で、木箱に山盛りの赤いりんごと橙色のみかんを親子がのぞきこみ、奥の座敷のこたつにはみかんのかごが置かれている水彩画',
  'soy-miso': '大きな木桶が並ぶ蔵元の土間で、前掛けの店の人が樽から味噌を取り分け、かごを提げた女の子が見ている。棚にはしょう油の瓶、戸口の外に瓦屋根の町並みが見える水彩画',
  'odori-dance': '夕暮れの広場で、提灯の下のやぐらを囲んで浴衣の人たちが盆踊りの輪をつくり、隣の公民館のホールでは年配の夫婦たちが組んで社交ダンスを踊っている水彩画',
};
const { slug } = Astro.props;
const alt = Astro.props.alt ?? ALTS[slug] ?? '';
const src = `/images/exhibits/${slug}-large.webp`;
const has = fs.existsSync(path.join(process.cwd(), 'public', src));
---
{has && <img class="exhibit-hero" src={src} alt={alt} width="1400" height="788" loading="lazy" />}
<style>
.exhibit-hero{display:block;width:100%;max-width:780px;height:auto;border-radius:6px;margin:4px auto 28px}
</style>
