---
// =====================================================
// Statlogia - 読み解きの間（目的別の分析の入口）
// src/pages/analysis/index.astro
// =====================================================
import BaseLayout from '../../layouts/BaseLayout.astro';
import Talk from '../../components/Talk.astro';
import { THEMES, PLANNED } from '../../data/analysis.js';
import HeroFig from '../../components/HeroFig.astro';
import fs from 'node:fs';
import path from 'node:path';
// 10-20 テーマの扉絵の縮小版があればカードに出す
const duoBoard = fs.existsSync(path.join(process.cwd(), 'public/images/chara/duo-board-scene.webp')) ? '/images/chara/duo-board-scene.webp' : null;
const thumbOf = (id) => (fs.existsSync(path.join(process.cwd(), 'public/images/icon', `analysis-${id}-thumb.webp`)) ? `/images/icon/analysis-${id}-thumb.webp` : null);
---
<BaseLayout title="読み解きの間｜目的別の分析｜Statlogia" description="教育、暮らしなど、目的を決めて統計を読み解く部屋。国の統計の手引きにならい、問い・計画・データ・分析・結論の順に進めます。" backHref="/" backLabel="玄関">
  <main class="ai">
    <HeroFig src="/images/icon/analysis-large.webp" alt="打ちっぱなしコンクリートの部屋。本棚を背に椅子に座り、帳面を開いたまま指し棒で壁の板に下がる札を指す知秋の水彩画" width={1376} height={768}>
      <p class="ai-kicker">研究棟</p>
      <h1>読み解きの間｜問いから、数字を組む</h1>
      <p class="ai-lead">知りたいことを先に決めて、それに合う数字の組を読み解く部屋です。<br />県を一つ選ぶと、問いから結論までが一枚にそろいます。</p>
    </HeroFig>

    <Talk speaker="chiaki-work">数字を一つずつ眺めるのと、問いを立ててから組で読むのとでは、見えるものがちがう。ここでは、総務省統計局の手引きにある「PPDAC」という進め方にならっている。</Talk>
    <Talk speaker="hitoha">ピーピーディーエーシー。呪文みたいですね。</Talk>

    <section class="ai-ppdac" aria-label="読み解きの進め方">
      <ol>
        <li><b>Problem</b><span>問い</span><em>何を知りたいかを、<br />言葉にする</em></li>
        <li><b>Plan</b><span>計画</span><em>何と比べ、<br />どの数字を使うかを決める</em></li>
        <li><b>Data</b><span>データ</span><em>数字の年・単位・素性を<br />確かめる</em></li>
        <li><b>Analysis</b><span>分析</span><em>位置・関係・伸び方を<br />見る</em></li>
        <li><b>Conclusion</b><span>結論</span><em>言えることと、<br />言えないことを分ける</em></li>
      </ol>
    </section>

    <section class="ai-themes" aria-label="テーマ">
      {THEMES.map((t) => (
        <a class="ai-card" href={`/analysis/${t.id}/`}>
          {thumbOf(t.id) && <img class="ai-card-img" src={thumbOf(t.id)} alt="" aria-hidden="true" width="560" height="313" loading="lazy" />}
          <span class="ai-card-k">{t.kicker}</span>
          <span class="ai-card-t">{t.title}</span>
          <span class="ai-card-q">問い：{t.question}</span>
          <span class="ai-card-l">{t.lead}</span>
          <span class="ai-card-n">{t.indicators.length}項目・関係{t.pairs.length}組{t.trends.length ? `・伸び方${t.trends.length}項目` : ''}{t.lq ? `・特化係数${t.lq.industries.length}業種` : ''}</span>
        </a>
      ))}
      {PLANNED.map((p) => (
        <div class="ai-card ai-card--soon">
          <span class="ai-card-k">PREPARING</span>
          <span class="ai-card-t">{p.title}</span>
          <span class="ai-card-l">{p.note}</span>
        </div>
      ))}
    </section>

    <section class="ai-rule" aria-label="この部屋の決まり">
      <div class="ai-rule-text">
        <p class="ai-rule-k">RULE OF THIS ROOM</p>
        <h2>点数はつけません</h2>
        <ol class="ai-rule-list">
          <li><b>作らないもの</b><span>項目を足しあわせた「総合点」や「暮らしやすさランキング」。</span></li>
          <li><b>理由</b><span>重みの付け方しだいで順位はいくらでも動き、県に点数をつけることになるから。</span></li>
          <li><b>そのかわり</b><span>何を読み取るかは読む人に任せ、各テーマの最後に「この数字からは言えないこと」を書く。</span></li>
        </ol>
      </div>
      {duoBoard && <img class="ai-rule-duo" src={duoBoard} width="1376" height="768" alt="クリップボードの数字を見せる一葉と、それをのぞき込む知秋" loading="lazy" />}
    </section>

    <p class="tab-links">
      <a class="tab-link" href="/verify/">検証室（言い伝えを数字で確かめる）へ</a>
      <a class="tab-link" href="/compare/">見くらべの間へ</a>
    </p>

    <footer class="ai-source"><p>分析の進め方は、総務省統計局 統計データ利活用センター『データ利活用実践ガイドブック EBPMのための』のPPDACサイクルにならっています。数字は各窓口の出典のとおりです。</p></footer>
  </main>
  <style>
    .ai { max-width: 980px; margin: 0 auto; padding: 0 16px 56px; }
    .ai > section { padding: 0; }
    .ai-hero { text-align: center; padding: 32px 0 8px; }
    .ai-hero-figure { display: block; width: 100%; max-width: 860px; height: auto; border-radius: 6px; margin: 0 auto 20px; }
    .ai-kicker { font-family: "IBM Plex Mono", monospace; font-size: .74rem; letter-spacing: .22em; font-weight: 600; color: var(--stamp); margin: 0; }
    .ai-hero h1 { margin: 4px 0 12px; font-family: "Shippori Mincho", serif; font-weight: 800; }
    .ai-lead { color: #555; line-height: 1.9; }
    .ai-ppdac { margin: 28px 0 8px; }
    .ai-ppdac ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; counter-reset: s; }
    .ai-ppdac li { counter-increment: s; border: 1px solid #e0e0d8; border-radius: 8px; background: #fff; padding: 12px 10px; text-align: center; position: relative; }
    .ai-ppdac li::before { content: counter(s); display: grid; place-items: center; width: 22px; height: 22px; margin: 0 auto 6px; border-radius: 50%; background: var(--ink); color: #fff; font-size: .74rem; }
    .ai-ppdac b { display: block; font-family: "IBM Plex Mono", monospace; font-size: .72rem; letter-spacing: .1em; color: #b23a2f; }
    .ai-ppdac span { display: block; font-family: "Shippori Mincho", serif; font-weight: 800; font-size: 1.05rem; margin: 2px 0 4px; }
    .ai-ppdac em { display: block; font-style: normal; font-size: .74rem; color: #666; line-height: 1.6; }
    @media (max-width: 720px) { .ai-ppdac em br { display: none; } }
    @media (max-width: 720px) { .ai-ppdac ol { grid-template-columns: 1fr; } .ai-ppdac li { display: grid; grid-template-columns: 26px auto 1fr; align-items: center; column-gap: 10px; row-gap: 2px; padding: 10px 12px; text-align: left; } .ai-ppdac li::before { margin: 0; } .ai-ppdac span { margin: 0; } .ai-ppdac em { grid-column: 2 / -1; } }
    .ai-themes { display: grid; grid-template-columns: 1fr; gap: 16px; margin: 32px 0 0; }
    .ai-card { display: grid; grid-template-columns: minmax(0, 38%) minmax(0, 1fr); grid-template-rows: auto auto auto 1fr auto; column-gap: 24px; row-gap: 6px; padding: 18px 22px 18px 0; align-items: start; border: 1px solid var(--line); border-left: 5px solid var(--ink); border-radius: 10px; background: #fffdf7; color: inherit; text-decoration: none; transition: transform .15s, box-shadow .15s; }
    .ai-card { overflow: hidden; }
    .ai-card-img { grid-column: 1; grid-row: 1 / -1; display: block; width: 100%; height: 100%; min-height: 210px; object-fit: cover; margin: -18px 0; align-self: stretch; }
    .ai-card-k, .ai-card-t, .ai-card-q, .ai-card-l, .ai-card-n { grid-column: 2; }
    .ai-card-n { align-self: end; }
    .ai-card--soon { grid-template-columns: 1fr; padding-left: 22px; }
    .ai-card--soon .ai-card-k, .ai-card--soon .ai-card-t, .ai-card--soon .ai-card-l { grid-column: 1; }
    @media (max-width: 720px) {
      .ai-card { grid-template-columns: 1fr; grid-template-rows: auto; padding: 0 18px 16px; row-gap: 6px; }
      .ai-card-img { grid-column: 1; grid-row: auto; height: auto; min-height: 0; aspect-ratio: 16 / 9; width: calc(100% + 36px); max-width: none; margin: 0 -18px 8px; }
      .ai-card-k, .ai-card-t, .ai-card-q, .ai-card-l, .ai-card-n { grid-column: 1; }
    }
    a.ai-card:hover, a.ai-card:focus-visible { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(30,40,30,.1); }
    .ai-card { overflow: hidden; }
    .ai-card-img { transition: transform .5s cubic-bezier(.2,.8,.2,1); }
    a.ai-card:hover .ai-card-img, a.ai-card:focus-visible .ai-card-img { transform: scale(1.05); }
    .ai-card-k { font-family: "IBM Plex Mono", monospace; font-size: .7rem; letter-spacing: .24em; color: #b23a2f; }
    .ai-card-t { font-family: "Shippori Mincho", serif; font-weight: 800; font-size: 1.25rem; color: var(--ink); }
    /* 問いは2行、説明は3行の高さに固定（超えたら省略）＝カードの高さをそろえる */
    .ai-card-q { font-size: .88rem; color: var(--ink); line-height: 1.7; min-height: calc(2 * 1.7em); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .ai-card-l { font-size: .84rem; color: #555; line-height: 1.8; min-height: calc(3 * 1.8em); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    @media (max-width: 720px) { .ai-card-q, .ai-card-l { min-height: 0; -webkit-line-clamp: unset; display: block; } }
    .ai-card-n { font-family: "IBM Plex Mono", monospace; font-size: .72rem; color: #888; }
    .ai-card--soon { border-left-color: var(--line); background: #f8f7f2; }
    .ai-card--soon .ai-card-t { color: #6b7a70; }
    /* この部屋の決まり：ほかのカードと区別がつく掲示板風の一枚。左に文、右に絵 */
    .ai > section.ai-rule { margin: 40px 0 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 26px; align-items: center; padding: 22px 26px; background: #FFFDF6; border: 3px double var(--ink); border-radius: 6px; box-shadow: 0 6px 18px rgba(31,42,68,.08); }
    .ai-rule-k { margin: 0 0 4px; font-family: "IBM Plex Mono", monospace; font-size: .66rem; letter-spacing: .28em; color: var(--stamp); }
    .ai-rule h2 { font-family: "Shippori Mincho", serif; font-size: 1.5rem; margin: 0 0 12px; padding-bottom: 8px; border-bottom: 2px solid var(--ink); }
    .ai-rule-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
    .ai-rule-list li { position: relative; padding-left: 1.7em; font-size: .9rem; line-height: 1.85; color: #333; }
    .ai-rule-list li span { display: block; margin-top: 3px; }
    .ai-rule-list li::before { content: "一、"; position: absolute; left: 0; top: 0; font-family: "Shippori Mincho", serif; color: var(--ink); font-weight: 700; }
    .ai-rule-list b { display: inline-block; margin-right: 0; padding: 0 .55em; font-size: .74rem; letter-spacing: .08em; color: #fff; background: var(--ink); border-radius: 3px; line-height: 1.7; vertical-align: .1em; }
    .ai-rule-duo { display: block; width: calc(100% + 14px); margin-right: -14px; height: auto; border-radius: 6px; }
    @media (max-width: 760px) {
      .ai > section.ai-rule { grid-template-columns: 1fr; gap: 14px; padding: 18px 16px; }
      .ai-rule-duo { order: -1; }
    }
    .ai-source { margin-top: 28px; font-size: .74rem; color: #888; line-height: 1.8; }
  </style>
</BaseLayout>
