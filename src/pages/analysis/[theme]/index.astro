---
// =====================================================
// Countopia Stats - 目的別の分析（読み解きの間）テーマのページ
// src/pages/analysis/[theme]/index.astro
// 設定は src/data/analysis.js。PPDAC（問い→計画→データ→分析→結論）の順に組む。
// ※スタイルは is:global（JS生成要素にスコープCSSが効かないため）。全セレクタ .an- 接頭辞。
// =====================================================
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Talk from '../../../components/Talk.astro';
import { THEMES } from '../../../data/analysis.js';
export function getStaticPaths() {
  return THEMES.map((t) => ({ params: { theme: t.id }, props: { t } }));
}
const { t } = Astro.props;
const cfg = { indicators: t.indicators, pairs: t.pairs, trends: t.trends, lq: t.lq || null, ss: !!t.shiftShare };
---
<BaseLayout title={`${t.title}｜読み解きの間｜Countopia Stats`} description={t.lead} backHref="/analysis/" backLabel="読み解きの間">
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <main class="an">
    <header class="an-hero">
      <p class="an-kicker">ANALYSIS｜{t.kicker}</p>
      <h1>{t.title}</h1>
      <p class="an-lead">{t.lead}</p>
    </header>

    <Talk speaker="kei">ここでは、国の統計の手引きにならって「問い→計画→データ→分析→結論」の順に読み進めます。県を選ぶと、下の段がすべてその県で埋まります。</Talk>

    <section class="an-pick" aria-label="県を選ぶ">
      <label><span>読み解く県</span><select id="anPref"><option value="">選んでください</option></select></label>
      <p class="an-sim" id="anSim" hidden></p>
      <ul class="an-chips" id="anChips"></ul>
    </section>

    <section class="an-step">
      <p class="an-step-no"><b>1</b>PROBLEM｜問い</p>
      <h2>{t.question}</h2>
      <ul class="an-qs">{t.subQuestions.map((q) => <li>{q}</li>)}</ul>
    </section>

    <section class="an-step">
      <p class="an-step-no"><b>2</b>PLAN｜計画</p>
      <h2>何と比べるか</h2>
      <ul class="an-plan">
        <li><b>全国の中の位置</b>：47都道府県の中で、各項目が平均からどれだけ離れているかを偏差値で並べます（平均50、標準偏差10）。</li>
        <li><b>似た県</b>：この組の項目の偏差値の並びがいちばん近い県を、計算で3つ挙げます（標準化した値どうしの距離が近い県）。似た県と見くらべると、全国と比べるだけでは見えない差が分かります。</li>
        <li><b>関係</b>：組の中の二つの項目を散布図に置き、相関係数と回帰直線で、そろって動くかを確かめます。</li>
        {t.lq && <li><b>特化係数</b>：業種ごとに「県の割合÷全国の割合」を、生み出した額（純付加価値額）と働く人の両方で出し、1人あたりの額も全国を1としてくらべます（地域経済分析システム RESAS の「稼ぐ力分析」と同じ見方です）。</li>}
        {t.shiftShare && <li><b>増減の分解（シフトシェア分析）</b>：2016年から2021年に働く人が増えた（減った）分を、「全国の流れ」「産業の構成」「地域の分」の3つに分けます。産業の構成は、全国で伸びた業種を多く持っていたかどうか、地域の分は、同じ業種でも全国より伸びたかどうかを示します。</li>}
        {t.shiftShare && <li><b>業種の集まり方（ハーフィンダール指数）</b>：働く人が少ない業種に集まっているか、多くの業種に散らばっているかを、業種ごとの割合の2乗の合計で表します。</li>}
        {t.trends.length > 0 && <li><b>時間</b>：毎年の数字がある項目は、最初の年を100にそろえて、全国と伸び方をくらべます。</li>}
      </ul>
    </section>

    <section class="an-step">
      <p class="an-step-no"><b>3</b>DATA｜データ</p>
      <h2>使う項目と、その素性</h2>
      <div class="an-wrap"><table class="an-data" id="anData"><thead><tr><th>項目</th><th>年</th><th>単位</th><th>注意</th></tr></thead><tbody>
        {t.indicators.map((i) => <tr data-id={i.id}><th scope="row">{i.short}</th><td class="an-y">—</td><td class="an-u">—</td><td>{i.note || ''}</td></tr>)}
      </tbody></table></div>
      <ul class="an-cautions">{t.cautions.map((c) => <li>{c}</li>)}</ul>
    </section>

    <section class="an-step" id="anAnalysis">
      <p class="an-step-no"><b>4</b>ANALYSIS｜分析</p>
      <h2>全国の中の位置（偏差値のプロフィール）</h2>
      <p class="an-note">棒は平均（50）からの離れ方です。右へのびるほど値が大きく、左へのびるほど小さいことを示します。大きいことが良いとはかぎりません。</p>
      <div class="an-prof" id="anProf"><p class="an-empty">県を選ぶと、ここにプロフィールが出ます。</p></div>

      {t.lq && <>
        <h3 class="an-h3">稼ぐ力の見取り図（特化係数）</h3>
        <p class="an-note">業種ごとに、全国の割合を1としたときの倍率です。<b class="an-lqk an-lqk--va">額</b>は生み出した額（純付加価値額）、<b class="an-lqk an-lqk--wk">人</b>は働く人、<b class="an-lqk an-lqk--pr">1人</b>は働く人1人あたりの額。縦の線が1（全国と同じ）です。生み出した額の倍率が大きい順に並べています。</p>
        <div class="an-lq" id="anLq"><p class="an-empty">県を選ぶと、ここに業種ごとの特化係数が出ます。</p></div>
      </>}

      {t.shiftShare && <>
        <h3 class="an-h3">働く人の増減を分ける（シフトシェア分析）</h3>
        <p class="an-note">2016年から2021年にかけての、県の事業所で働く人の増減を3つに分けます。<b class="an-lqk an-ssk--n">全国</b>は全国と同じ割合で増えたとしたときの分、<b class="an-lqk an-ssk--m">構成</b>は業種の顔ぶれによる分、<b class="an-lqk an-ssk--r">地域</b>はそれ以外（同じ業種でも全国より伸びた・伸びなかった分）です。読み方は<a href="/how-to-read/shift-share/">増えた分を、三つに分ける</a>。</p>
        <div class="an-ss" id="anSS"><p class="an-empty">県を選ぶと、ここに増減の分け方が出ます。</p></div>
        <div class="an-sstown">
          <p class="an-sstown-h">市区町村でも分ける</p>
          <label><span>市区町村</span><select id="anSSTownSel" disabled><option value="">先に県を選んでください</option></select></label>
          <p class="an-note">全国の流れ・業種ごとの全国の伸び方は、県と同じもの（47都道府県の合計）を使います。市区町村では、人数が伏せられている（秘匿）業種があり、2回のどちらかの数字が無い業種は分解から外します。</p>
          <div class="an-ss" id="anSSTown"></div>
        </div>

        <h3 class="an-h3">業種の集まり方（ハーフィンダール指数）</h3>
        <p class="an-note">働く人が、いくつかの業種に集まっているか、たくさんの業種に散らばっているかを1つの数で表します。業種ごとの割合を2乗して足したもの（ハーフィンダール指数）で、大きいほど少ない業種に集まっています。わかりやすくするため、「同じ大きさの業種が何個あるのと同じか」（指数の逆数）でも示します。集まっていることも、散らばっていることも、それだけで良し悪しは決まりません。</p>
        <div class="an-hhi" id="anHHI"><p class="an-empty">県を選ぶと、ここに業種の集まり方が出ます。</p></div>
      </>}

      <h3 class="an-h3">二つの項目の関係</h3>
      <div class="an-pairs" id="anPairs"></div>

      {t.trends.length > 0 && <>
        <h3 class="an-h3">伸び方</h3>
        <div class="an-trends" id="anTrends"></div>
      </>}
    </section>

    <section class="an-step">
      <p class="an-step-no"><b>5</b>CONCLUSION｜結論</p>
      <h2>言えること</h2>
      <ul class="an-can" id="anCan"><li>県を選ぶと、数字から言えることをここにまとめます。</li></ul>
      <h2>言えないこと</h2>
      <ul class="an-cannot">{t.cannot.map((c) => <li>{c}</li>)}</ul>
    </section>

    <Talk speaker="touko">数字を並べたあとに「ここまでは言えて、ここからは言えない」と書いておくのね。</Talk>
    <Talk speaker="kei">はい。言えないことを書いておくのも、読み解きのうちです。</Talk>

    <p class="an-cross">あわせて見る：<a href="/compare/">見くらべの間</a>｜<a href="/how-to-read/position/">10位は、近いのか遠いのか</a>｜<a href="/how-to-read/correlation/">二つの数字が、そろって動くとき</a>｜<a href="/how-to-read/growth/">伸び方は、そろえてから比べる</a>{t.lq && <>｜<a href="/how-to-read/specialization/">町の得意を測る物差し</a></>}</p>
    <footer class="an-source"><p>出典：各窓口の出典のとおり（総務省統計局「社会・人口統計体系」「家計調査」「消費者物価地域差指数」ほか）。分析の進め方は、総務省統計局『データ利活用実践ガイドブック EBPMのための』のPPDACサイクルにならっています。このページはe-Stat APIで取得した統計データを独自に加工して作成しています。</p></footer>
  </main>

  <script is:inline define:vars={{ CFG: cfg }}>
  (async function () {
    const COLORS = ['#b23a2f', '#2d6a4f', '#4a6fa5', '#c99a2e'];
    const IND = CFG.indicators;
    // ---- 読みこみ（同じファイルは1回だけ） ----
    const files = {};
    const urlOf = (i) => (i.src === 'room' ? `/data/room-${i.room}.json` : i.src === 'price' ? '/data/price-ledger.json' : `/data/${i.file}.json`);
    const LQ = CFG.lq;
    const lqUrls = LQ ? [LQ.va, LQ.wk, LQ.pr].map((r) => `/data/room-${r}.json`) : [];
    await Promise.all([...new Set([...IND.map(urlOf), ...lqUrls])].map(async (u) => { try { files[u] = await (await fetch(u)).json(); } catch (e) { files[u] = null; } }));
    // ---- 項目ごとに { label, unit, year, dec, val:{県コード:値}, series } にそろえる ----
    const decOf = (vals) => { let d = 0; for (const v of vals) if (typeof v === 'number' && !Number.isInteger(v)) d = Math.max(d, Math.min((String(v).split('.')[1] || '').length, 2)); return d; };
    const M = {};
    for (const i of IND) {
      const D = files[urlOf(i)];
      if (!D) continue;
      const m = { id: i.id, short: i.short, val: {}, series: null };
      if (i.src === 'room') {
        const ind = D.indicators.find((x) => x.key === i.key);
        if (!ind) continue;
        const L = ind.years.length - 1;
        m.unit = ind.unit; m.year = ind.yearLabels[L]; m.dec = ind.decimals;
        if (ind.se && (!ind.se.y || ind.years[L] === ind.se.y)) m.se = ind.se.r; // 標本調査の誤差（県コード→標準誤差率％）
        for (const a of D.areas) if (!a.x && a.v[i.key]) m.val[a.c] = a.v[i.key][L];
        const natArr = D.nationalIsAvg && (D.nationalIsAvg[i.key] || (D.nationalIsTotal && D.nationalIsTotal[i.key])) ? D.prefAverage[i.key] : D.national[i.key];
        m.series = { years: ind.years, by: Object.fromEntries(D.areas.map((a) => [a.c, a.v[i.key]])), nat: natArr };
      } else if (i.src === 'price') {
        const L = D.years.length - 1;
        m.unit = ''; m.year = D.yearLabel || D.years[L] + '年'; m.dec = 1;
        for (const a of D.areas) { const s = a.v[i.code]; if (s) m.val[a.c] = s[L]; }
        m.series = { years: D.years, by: Object.fromEntries(D.areas.map((a) => [a.c, a.v[i.code]])), nat: D.years.map(() => 100) };
      } else {
        const k = D.indicators.findIndex((x) => x.code === i.code);
        if (k < 0) continue;
        const ind = D.indicators[k];
        m.unit = ind.unit === '‐' || ind.unit === '-' ? '' : ind.unit === '%' ? '％' : ind.unit; m.year = ind.year || '';
        for (const a of D.areas) if (!a.x && /^\d{2}000$/.test(a.c)) m.val[a.c] = a.v[k];
        m.dec = decOf(Object.values(m.val));
      }
      const vs = Object.values(m.val).filter((v) => typeof v === 'number');
      m.n = vs.length;
      m.mean = vs.reduce((s, v) => s + v, 0) / m.n;
      m.sd = Math.sqrt(vs.reduce((s, v) => s + (v - m.mean) ** 2, 0) / m.n);
      M[i.id] = m;
    }
    const IDS = IND.map((i) => i.id).filter((id) => M[id]);
    // データの段に、年と単位を書き入れる
    for (const id of IDS) { const tr = document.querySelector(`#anData tr[data-id="${id}"]`); if (tr) { tr.querySelector('.an-y').textContent = M[id].year || '—'; tr.querySelector('.an-u').textContent = M[id].unit || '指数'; } }
    // 県の一覧（最初に読めた項目から）
    const prefList = Object.keys(M[IDS[0]].val).sort();
    const NAMES = {};
    for (const D of Object.values(files)) if (D && D.areas) for (const a of D.areas) if (/^\d{2}000$/.test(a.c) && a.n) NAMES[a.c] = a.n;
    const sel = document.getElementById('anPref');
    for (const c of prefList) { const o = document.createElement('option'); o.value = c; o.textContent = NAMES[c] || c; sel.appendChild(o); }
    const fmt = (m, v) => (typeof v === 'number' ? v.toLocaleString('ja-JP', { minimumFractionDigits: m.dec, maximumFractionDigits: m.dec }) + (m.unit || '') : '—');
    const dev = (m, v) => (m.sd > 0 && typeof v === 'number' ? 50 + (10 * (v - m.mean)) / m.sd : null);
    const rankOf = (m, v) => Object.values(m.val).filter((x) => typeof x === 'number' && x > v + 1e-12).length + 1;
    // 似た県：標準化した値（z）の並びの距離が近い県
    const zOf = (id, c) => { const m = M[id]; const v = m.val[c]; return m.sd > 0 && typeof v === 'number' ? (v - m.mean) / m.sd : null; };
    const similar = (c) => prefList.filter((d) => d !== c).map((d) => {
      let s = 0, n = 0;
      for (const id of IDS) { const a = zOf(id, c), b = zOf(id, d); if (a !== null && b !== null) { s += (a - b) ** 2; n++; } }
      return { c: d, dist: n ? Math.sqrt(s / n) : Infinity };
    }).sort((x, y) => x.dist - y.dist).slice(0, 3);

    let main = null;
    let others = [];
    const charts = [];
    sel.addEventListener('change', () => { main = sel.value || null; others = others.filter((c) => c !== main); draw(); });

    function chips() {
      const ul = document.getElementById('anChips');
      ul.innerHTML = '';
      [main, ...others].filter(Boolean).forEach((c, k) => {
        const li = document.createElement('li');
        li.innerHTML = `<i style="background:${COLORS[k]}"></i>${NAMES[c]}`;
        if (k > 0) { const b = document.createElement('button'); b.type = 'button'; b.textContent = '×'; b.setAttribute('aria-label', `${NAMES[c]}を外す`); b.addEventListener('click', () => { others = others.filter((x) => x !== c); draw(); }); li.appendChild(b); }
        ul.appendChild(li);
      });
      const sim = document.getElementById('anSim');
      if (!main) { sim.hidden = true; return; }
      sim.hidden = false;
      const s = similar(main);
      sim.innerHTML = 'この組で似た県：' + s.map((x) => `<button type="button" data-c="${x.c}"${others.includes(x.c) ? ' disabled' : ''}>${NAMES[x.c]}を足す</button>`).join('');
      sim.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => { if (others.length < 3 && !others.includes(b.dataset.c)) { others.push(b.dataset.c); draw(); } }));
      // 似た県のほかに、どの県でも足せる（並べるのは選んだ県＋3県まで）
      const full = others.length >= 3;
      const rest = prefList.filter((c) => c !== main && !others.includes(c));
      const pick = document.createElement('select');
      pick.className = 'an-sim-any';
      pick.setAttribute('aria-label', 'ほかの県を足す');
      pick.disabled = full;
      pick.innerHTML = `<option value="">${full ? '並べられるのは3県までです' : 'ほかの県を足す'}</option>` + rest.map((c) => `<option value="${c}">${NAMES[c]}</option>`).join('');
      pick.addEventListener('change', () => { const c = pick.value; if (c && others.length < 3 && !others.includes(c)) { others.push(c); draw(); } });
      sim.appendChild(pick);
    }

    // 標本調査の項目：誤差の目安（95％）の半分の幅。値と同じ単位
    const seHalf = (m, c) => { const v = m.val[c], r = m.se && m.se[c]; return typeof v === 'number' && typeof r === 'number' ? (1.96 * r * v) / 100 : null; };
    function profile() {
      const box = document.getElementById('anProf');
      const who = [main, ...others];
      box.innerHTML = IDS.map((id) => {
        const m = M[id];
        const v = m.val[main];
        const d = dev(m, v);
        const marks = who.map((c, k) => { const dd = dev(m, m.val[c]); if (dd === null) return ''; const x = Math.max(0, Math.min(100, ((dd - 20) / 60) * 100)); return `<span class="an-mk" style="left:${x}%;background:${COLORS[k]}" title="${NAMES[c]} 偏差値${dd.toFixed(1)}"></span>`; }).join('');
        const bar = d === null ? '' : (() => { const x = Math.max(0, Math.min(100, ((d - 20) / 60) * 100)); const l = Math.min(50, x), w = Math.abs(x - 50); return `<span class="an-bar" style="left:${l}%;width:${w}%"></span>`; })();
        return `<div class="an-row"><div class="an-lab">${m.short}<small>${m.year || ''}</small></div><div class="an-val">${fmt(m, v)}<small>${typeof v === 'number' ? rankOf(m, v) + '位／' + m.n : ''}</small>${seHalf(m, main) !== null ? `<small class="an-se">±${fmt(m, seHalf(m, main)).replace(/％$/, 'ポイント')}</small>` : ''}</div><div class="an-track"><span class="an-mid"></span>${bar}${marks}</div><div class="an-dev">${d === null ? '—' : d.toFixed(1)}</div></div>`;
      }).join('') + '<div class="an-scale"><span>20</span><span>35</span><span>50</span><span>65</span><span>80</span></div>';
    }

    function pairs() {
      const box = document.getElementById('anPairs');
      charts.forEach((c) => c.destroy()); charts.length = 0;
      box.innerHTML = '';
      const out = [];
      CFG.pairs.forEach((p, k) => {
        const X = M[p.x], Y = M[p.y];
        if (!X || !Y) return;
        const pts = prefList.map((c) => ({ c, x: X.val[c], y: Y.val[c] })).filter((d) => typeof d.x === 'number' && typeof d.y === 'number');
        const n = pts.length, mx = pts.reduce((s, d) => s + d.x, 0) / n, my = pts.reduce((s, d) => s + d.y, 0) / n;
        const sxx = pts.reduce((s, d) => s + (d.x - mx) ** 2, 0), syy = pts.reduce((s, d) => s + (d.y - my) ** 2, 0), sxy = pts.reduce((s, d) => s + (d.x - mx) * (d.y - my), 0);
        const r = sxx > 0 && syy > 0 ? sxy / Math.sqrt(sxx * syy) : 0;
        const b = sxx > 0 ? sxy / sxx : 0, a = my - b * mx;
        const ar = Math.abs(r);
        const word = ar >= 0.7 ? '強い' : ar >= 0.4 ? 'はっきりした' : ar >= 0.2 ? '弱い' : 'ほとんど見えない';
        const dir = ar < 0.2 ? '' : r > 0 ? '右上がりの' : '右下がりの';
        const me = pts.find((d) => d.c === main);
        let res = '';
        if (me && ar >= 0.2) {
          const e = me.y - (a + b * me.x);
          const ses = Math.sqrt(pts.reduce((s, d) => s + (d.y - (a + b * d.x)) ** 2, 0) / Math.max(1, n - 2));
          const z = ses > 0 ? e / ses : 0;
          const eu = Y.unit === '％' ? 'ポイント' : (Y.unit || '');
          res = Math.abs(z) < 1 ? `${NAMES[main]}は、直線のそば（横の値から見込まれるとおり）にあります。` : `${NAMES[main]}は、横の値から見込まれるより${e > 0 ? '大きい' : '小さい'}側にあります（直線から ${e > 0 ? '+' : '−'}${Math.abs(e).toLocaleString('ja-JP', { minimumFractionDigits: Y.dec, maximumFractionDigits: Y.dec })}${eu}）。`;
        }
        out.push({ p, r, word, dir, res });
        const card = document.createElement('div');
        card.className = 'an-pair';
        card.innerHTML = `<p class="an-pair-q">${p.why}</p><canvas height="230"></canvas><p class="an-pair-r">相関係数 <b>${r.toFixed(2)}</b>（${n}都道府県）。${dir}${word}関係です。${res}</p>`;
        box.appendChild(card);
        const who = [main, ...others];
        charts.push(new Chart(card.querySelector('canvas'), {
          type: 'scatter',
          data: { datasets: [
            { data: pts.map((d) => ({ x: d.x, y: d.y, n: NAMES[d.c] })), backgroundColor: pts.map((d) => { const k2 = who.indexOf(d.c); return k2 >= 0 ? COLORS[k2] : 'rgba(27,67,50,.35)'; }), pointRadius: pts.map((d) => (who.includes(d.c) ? 6 : 3.5)) },
            ...(ar >= 0.2 ? [{ type: 'line', data: [{ x: Math.min(...pts.map((d) => d.x)), y: a + b * Math.min(...pts.map((d) => d.x)) }, { x: Math.max(...pts.map((d) => d.x)), y: a + b * Math.max(...pts.map((d) => d.x)) }], borderColor: '#c99a2e', borderWidth: 2, pointRadius: 0 }] : []),
          ] },
          options: { responsive: true, aspectRatio: window.innerWidth < 600 ? 1.1 : 1.35, plugins: { legend: { display: false }, tooltip: { filter: (it) => it.datasetIndex === 0, callbacks: { label: (c) => `${c.raw.n}：${fmt(X, c.raw.x)}、${fmt(Y, c.raw.y)}` } } },
            scales: { x: { title: { display: true, text: X.short } }, y: { title: { display: true, text: Y.short } } } },
        }));
      });
      return out;
    }

    function trends() {
      const box = document.getElementById('anTrends');
      if (!box) return [];
      box.innerHTML = '';
      const out = [];
      CFG.trends.forEach((id) => {
        const m = M[id];
        if (!m || !m.series) return;
        const ys = m.series.years;
        const who = [main, ...others];
        // 割合（％）の項目は、指数にすると大げさに見えるので、値そのままで描く（結論ではポイントの差で言う）
        const share = m.unit === '％';
        const idx = (arr) => { if (!arr) return null; const k0 = ys.findIndex((_, k) => typeof arr[k] === 'number' && who.every((c) => m.series.by[c] && typeof m.series.by[c][k] === 'number') && typeof m.series.nat[k] === 'number'); if (k0 < 0) return null; const b0 = arr[k0]; return { k0, data: arr.map((v, k) => (k < k0 || typeof v !== 'number' || (!share && !b0) ? null : share ? v : (v / b0) * 100)) }; };
        const sets = who.map((c, k) => { const r = idx(m.series.by[c]); return r && { label: NAMES[c], data: r.data, borderColor: COLORS[k], backgroundColor: COLORS[k], pointRadius: 1.5, tension: 0.2, spanGaps: true, k0: r.k0 }; }).filter(Boolean);
        const nat = idx(m.series.nat);
        if (!sets.length || !nat) return;
        sets.push({ label: '全国（平均）', data: nat.data, borderColor: '#4A6355', borderDash: [6, 4], borderWidth: 1.5, pointRadius: 0, spanGaps: true });
        const last = (arr) => { for (let k = arr.length - 1; k >= 0; k--) if (typeof arr[k] === 'number') return arr[k]; return null; };
        const first = (arr) => { for (let k = 0; k < arr.length; k++) if (typeof arr[k] === 'number') return arr[k]; return null; };
        out.push({ m, share, me: last(sets[0].data), me0: first(sets[0].data), nat: last(nat.data), nat0: first(nat.data), y0: ys[sets[0].k0], y1: ys[ys.length - 1] });
        const card = document.createElement('div');
        card.className = 'an-trend';
        card.innerHTML = `<p class="an-pair-q">${m.short}<small>${share ? '割合なので、値そのままで描いています' : '最初の年を100にそろえています'}</small></p><canvas height="200"></canvas>`;
        box.appendChild(card);
        charts.push(new Chart(card.querySelector('canvas'), { type: 'line', data: { labels: ys, datasets: sets }, options: { responsive: true, aspectRatio: window.innerWidth < 600 ? 1.3 : 1.6, plugins: { legend: { labels: { boxWidth: 12 } }, tooltip: { callbacks: { label: (c) => `${c.dataset.label}：${Number(c.raw).toFixed(1)}` } } } } }));
      });
      return out;
    }

    function conclude(P, T, Q, SSr, H) {
      const ul = document.getElementById('anCan');
      if (!main) return;
      const nm = NAMES[main];
      const hi = IDS.filter((id) => (dev(M[id], M[id].val[main]) ?? 50) >= 60).map((id) => M[id].short);
      const lo = IDS.filter((id) => (dev(M[id], M[id].val[main]) ?? 50) <= 40).map((id) => M[id].short);
      const li = [];
      li.push(`${nm}は、この組の${IDS.length}項目のうち、偏差値60以上（全国の中で大きいほう）が${hi.length}項目${hi.length ? `（${hi.join('、')}）` : ''}、40以下（小さいほう）が${lo.length}項目${lo.length ? `（${lo.join('、')}）` : ''}です。残りは全国の中ほどにあります。`);
      const s = similar(main);
      li.push(`この組の数字の並びが${nm}に近いのは、${s.map((x) => NAMES[x.c]).join('・')}です。`);
      const seIds = IDS.filter((id) => seHalf(M[id], main) !== null && M[id].sd > 0);
      if (seIds.length) {
        const parts = seIds.map((id) => `${M[id].short}は±${(10 * seHalf(M[id], main) / M[id].sd).toFixed(1)}`);
        li.push(`一部の世帯や人を調べた項目は、値に誤差があります。${nm}の誤差の目安（95％）を偏差値に直すと、${parts.join('、')}です。偏差値の差がこれより小さい県どうしは、並びが入れかわることがあります。`);
      }
      if (Q && Q.rows) {
        const big = Q.rows.filter((r) => (r.va ?? 0) >= 1.2).slice(0, 3);
        const both = Q.rows.filter((r) => (r.va ?? 0) > 1 && (r.wk ?? 0) > 1).map((r) => r.name);
        if (big.length) li.push(`${nm}で、生み出した額の特化係数が大きい業種は、${big.map((r) => `${r.name}（${r.va.toFixed(2)}）`).join('、')}です。`);
        else li.push(`${nm}には、生み出した額の特化係数が1.2以上の業種はなく、業種の割合は全国に近い並びです。`);
        if (both.length) li.push(`生み出した額と働く人の両方で特化係数が1を超えるのは、${both.join('、')}です。`);
        if (typeof Q.allPr === 'number') li.push(`全産業の1人あたりの額は、全国を1とすると${Q.allPr.toFixed(2)}です。`);
      }
      if (SSr) {
        const fp = (v) => `${v >= 0 ? '+' : '−'}${Math.abs((v / SSr.E0) * 100).toFixed(1)}％`;
        li.push(`2016年から2021年の働く人の増減（${fp(SSr.E1 - SSr.E0)}）を分けると、全国の流れが${fp(SSr.ns)}、産業の構成が${fp(SSr.im)}、地域の分が${fp(SSr.rs)}でした。`);
        li.push(`地域の分が大きかったのは${SSr.up.map((r) => r.n).join('、')}、小さかったのは${SSr.down.map((r) => r.n).join('、')}です。`);
      }
      if (H) li.push(`${nm}の働く人の業種の集まり方は、同じ大きさの業種が${H.eq1.toFixed(1)}個あるのと同じで（全国${H.nat.toFixed(1)}個）、47都道府県で集まり方が${H.rank}番目に大きい県です。いちばん割合が大きい業種は${H.top.n}（${(H.top.x * 100).toFixed(1)}％）です。`);
      for (const q of P) li.push(`${q.p.why.replace(/か。$/, '')}——47都道府県では、相関係数${q.r.toFixed(2)}の${q.dir}${q.word}関係でした。${q.res}`);
      for (const q of T) if (q.me !== null && q.nat !== null) li.push(q.share
        ? `${q.m.short}は、${q.y0}年から${q.y1}年にかけて、${nm}が${(q.me - q.me0) >= 0 ? '+' : '−'}${Math.abs(q.me - q.me0).toFixed(1)}ポイント、全国（平均）が${(q.nat - q.nat0) >= 0 ? '+' : '−'}${Math.abs(q.nat - q.nat0).toFixed(1)}ポイント動きました。`
        : `${q.m.short}は、${q.y0}年を100とすると${q.y1}年に${nm}が${q.me.toFixed(1)}、全国（平均）が${q.nat.toFixed(1)}です。`);
      ul.innerHTML = li.map((x) => `<li>${x}</li>`).join('');
    }


    // ---- 稼ぐ力の見取り図：業種ごとの特化係数（額・人・1人あたり） ----
    function lqOf(roomId, key, c) {
      const D = files[`/data/room-${roomId}.json`];
      if (!D) return null;
      const a = D.areas.find((x) => x.c === c);
      const v = a && a.v[key] ? a.v[key][a.v[key].length - 1] : null;
      const n = D.national && D.national[key] ? D.national[key][D.national[key].length - 1] : null;
      return typeof v === 'number' && typeof n === 'number' && n > 0 ? v / n : null;
    }
    function lqView() {
      const box = document.getElementById('anLq');
      if (!LQ || !box) return [];
      const rows = LQ.industries.map(([k, name]) => ({ k, name, va: lqOf(LQ.va, k, main), wk: lqOf(LQ.wk, k, main), pr: lqOf(LQ.pr, k, main) })).filter((r) => r.va !== null || r.wk !== null);
      rows.sort((a, b) => (b.va ?? 0) - (a.va ?? 0));
      const max = Math.max(2, ...rows.flatMap((r) => [r.va, r.wk, r.pr].filter((x) => typeof x === 'number')));
      const top = Math.min(4, Math.ceil(max * 2) / 2);
      const bar = (v, cls) => { if (typeof v !== 'number') return `<span class="an-lqb ${cls}"><i style="width:0"></i><em>—</em></span>`; const w = Math.min(100, (v / top) * 100); return `<span class="an-lqb ${cls}"><i style="width:${w}%"></i><em>${v.toFixed(2)}${v > top ? '→' : ''}</em></span>`; };
      const one = (1 / top) * 100;
      box.innerHTML = rows.map((r) => `<div class="an-lqr"><div class="an-lqn">${r.name}</div><div class="an-lqbars" style="--one:${one}%">${bar(r.va, 'an-lqb--va')}${bar(r.wk, 'an-lqb--wk')}${bar(r.pr, 'an-lqb--pr')}</div></div>`).join('')
        + `<p class="an-lqscale">目もりの右端は ${top} 倍です。</p>`;
      const allPr = lqOf(LQ.pr, 'all', main);
      return { rows, allPr };
    }

    // ---- シフトシェア分析（事業従事者数、2016→2021） ----
    let SS = null;
    if (CFG.ss) { try { SS = await (await fetch('/data/shift-share.json')).json(); } catch (e) { SS = null; } }
    let SSN = null;
    function ssNat() {
      if (SSN || !SS) return SSN;
      const sum = (arr) => arr.reduce((t, x) => t + (typeof x === 'number' ? x : 0), 0);
      const N0 = SS.industries.map((_, i) => sum(SS.areas.map((a) => a.e0[i])));
      const N1 = SS.industries.map((_, i) => sum(SS.areas.map((a) => a.e1[i])));
      SSN = { N0, N1, gN: sum(N1) / sum(N0) - 1 };
      return SSN;
    }
    // e0s・e1s は業種ごとの人数。skip のときは、どちらかが数字でない業種を分解から外す（市区町村の秘匿）
    function ssHtml(e0s, e1s, skip) {
      const { N0, N1, gN } = ssNat();
      const ok = (i) => !skip || (typeof e0s[i] === 'number' && typeof e1s[i] === 'number');
      const excluded = SS.industries.filter((_, i) => !ok(i)).map((x) => x.n);
      let ns = 0, im = 0, rs = 0, E0 = 0, E1 = 0;
      const rows = [];
      SS.industries.forEach((ind, i) => {
        if (!ok(i)) return;
        const e0 = e0s[i] || 0, e1 = e1s[i] || 0;
        const gi = N0[i] > 0 ? N1[i] / N0[i] - 1 : 0;
        const r = { n: ind.n, e0, e1, d: e1 - e0, ns: e0 * gN, im: e0 * (gi - gN), rs: e1 - e0 * (1 + gi) };
        ns += r.ns; im += r.im; rs += r.rs; E0 += e0; E1 += e1; rows.push(r);
      });
      if (!(E0 > 0)) return { html: '<p class="an-empty">分けられる数字がありません。</p>', res: null };
      const pct = (v) => ((v / E0) * 100);
      const f = (v) => `${v >= 0 ? '+' : '−'}${Math.abs(Math.round(v)).toLocaleString('ja-JP')}人`;
      const fp = (v) => `${v >= 0 ? '+' : '−'}${Math.abs(pct(v)).toFixed(1)}％`;
      const mx = Math.max(Math.abs(pct(ns)), Math.abs(pct(im)), Math.abs(pct(rs)), Math.abs(pct(E1 - E0)), 1);
      const bar = (v, cls, label) => { const w = (Math.abs(pct(v)) / mx) * 50; return `<div class="an-ssr"><span class="an-ssl">${label}</span><span class="an-sst"><span class="an-ssmid"></span><i class="${cls}" style="${v >= 0 ? `left:50%` : `right:50%`};width:${w}%"></i></span><b>${fp(v)}</b><small>${f(v)}</small></div>`; };
      const top = [...rows].sort((x, y) => y.rs - x.rs);
      const k = Math.min(3, Math.floor(top.length / 2));
      const pick = (arr) => arr.map((r) => `<li><span>${r.n}</span><b>${f(r.rs)}</b><small>${r.e0.toLocaleString('ja-JP')}→${r.e1.toLocaleString('ja-JP')}人</small></li>`).join('');
      const html = `<div class="an-ssbars">${bar(E1 - E0, 'an-ssb--t', '増減の合計')}${bar(ns, 'an-ssb--n', '全国の流れ')}${bar(im, 'an-ssb--m', '産業の構成')}${bar(rs, 'an-ssb--r', '地域の分')}</div>
        <p class="an-ssnote">${SS.y0}の${E0.toLocaleString('ja-JP')}人から、${SS.y1}の${E1.toLocaleString('ja-JP')}人へ。全国は${(gN * 100).toFixed(1)}％の増え方でした。割合は${SS.y0}の人数に対するものです。${excluded.length ? `数字が無いため外した業種：${excluded.join('、')}（人数の合計もこれらを除いたものです）。` : ''}</p>
        ${k > 0 ? `<div class="an-sslists"><div><h4>地域の分が大きかった業種</h4><ol>${pick(top.slice(0, k))}</ol></div><div><h4>地域の分が小さかった業種</h4><ol>${pick(top.slice(-k).reverse())}</ol></div></div>` : ''}`;
      return { html, res: { ns, im, rs, E0, E1, gN, up: top.slice(0, 2), down: top.slice(-2).reverse() } };
    }
    function ssView() {
      const box = document.getElementById('anSS');
      if (!box || !SS || !main) return null;
      const a = SS.areas.find((x) => x.c === main);
      if (!a) return null;
      const { html, res } = ssHtml(a.e0, a.e1, false);
      box.innerHTML = html;
      return res;
    }
    // ---- 市区町村のシフトシェア（県を選んだあとで市区町村を選ぶ） ----
    const SST = {};
    async function ssTown() {
      const sel = document.getElementById('anSSTownSel'), box = document.getElementById('anSSTown');
      if (!sel || !box || !SS) return;
      if (!main) { sel.innerHTML = '<option value="">先に県を選んでください</option>'; sel.disabled = true; sel.dataset.pref = ''; box.innerHTML = ''; return; }
      if (!(main in SST)) { try { SST[main] = await (await fetch(`/data/shift-share-town/${main}.json`)).json(); } catch (e) { SST[main] = null; } }
      const D = SST[main];
      if (!D) { box.innerHTML = '<p class="an-empty">市区町村の数字を読みこめませんでした。</p>'; return; }
      if (sel.dataset.pref !== main) {
        sel.innerHTML = '<option value="">市区町村を選んでください</option>' + D.towns.map((t) => `<option value="${t.c}">${t.n}</option>`).join('');
        sel.dataset.pref = main; sel.disabled = false; box.innerHTML = '';
      }
      const t = D.towns.find((x) => x.c === sel.value);
      if (!t) { box.innerHTML = ''; return; }
      box.innerHTML = `<p class="an-sstown-name">${t.n}</p>` + ssHtml(t.e0, t.e1, true).html + hhiTownLine(t);
    }

    // ---- 業種の集まり方（ハーフィンダール指数、事業従事者数・産業大分類17業種） ----
    function hhiOf(es) {
      const v = es.map((x) => (typeof x === 'number' ? x : 0));
      const T = v.reduce((a, b) => a + b, 0);
      if (!(T > 0)) return null;
      const sh = v.map((x) => x / T);
      return { h: sh.reduce((a, x) => a + x * x, 0), sh };
    }
    let HHA = null;
    function hhiAll() {
      if (HHA || !SS) return HHA;
      const { N0, N1 } = ssNat();
      HHA = { nat0: hhiOf(N0), nat1: hhiOf(N1), areas: SS.areas.map((a) => ({ c: a.c, h0: hhiOf(a.e0), h1: hhiOf(a.e1) })).filter((a) => a.h1) };
      return HHA;
    }
    function hhiView() {
      const box = document.getElementById('anHHI');
      const A = hhiAll();
      if (!box || !A || !main) return null;
      const me = A.areas.find((a) => a.c === main);
      if (!me) return null;
      const sorted = [...A.areas].sort((x, y) => y.h1.h - x.h1.h);
      const rank = sorted.findIndex((a) => a.h1.h === me.h1.h) + 1;
      const eq = (o) => 1 / o.h;
      const lo = Math.min(...A.areas.map((a) => eq(a.h1))), hi = Math.max(...A.areas.map((a) => eq(a.h1)));
      const x0 = Math.floor(lo), x1 = Math.ceil(hi);
      const pos = (v) => ((v - x0) / (x1 - x0)) * 100;
      const dots = A.areas.map((a) => `<i class="an-hhid${a.c === main ? ' is-me' : ''}" style="left:${pos(eq(a.h1)).toFixed(2)}%" title="${NAMES[a.c]} ${eq(a.h1).toFixed(1)}"></i>`).join('');
      const ticks = Array.from({ length: x1 - x0 + 1 }, (_, i) => `<span style="left:${pos(x0 + i)}%">${x0 + i}</span>`).join('');
      const top3 = me.h1.sh.map((x, i) => ({ n: SS.industries[i].n, x })).sort((a, b) => b.x - a.x).slice(0, 3);
      const d = eq(me.h1) - eq(me.h0);
      const html = `<div class="an-hhinum"><div><span>同じ大きさの業種が</span><b>${eq(me.h1).toFixed(1)}個</b><span>あるのと同じ</span></div><div><span>指数</span><b>${me.h1.h.toFixed(3)}</b><span>47都道府県で集まり方が${rank}番目に大きい</span></div><div><span>全国</span><b>${eq(A.nat1).toFixed(1)}個</b><span>指数 ${A.nat1.h.toFixed(3)}</span></div></div>
        <div class="an-hhistrip"><div class="an-hhiline">${dots}</div><div class="an-hhiticks">${ticks}</div><p>点は47都道府県（${SS.y1}）。左ほど少ない業種に集まり、右ほど散らばっています。赤い点が${NAMES[main]}です。</p></div>
        <p class="an-ssnote">割合の大きい業種：${top3.map((r) => `${r.n} ${(r.x * 100).toFixed(1)}％`).join('、')}。${SS.y0}は${eq(me.h0).toFixed(1)}個でした（${SS.y1}までに${d >= 0 ? '+' : '−'}${Math.abs(d).toFixed(1)}個）。業種は経済センサスの産業大分類17区分で数えています。区分を細かくすると、数は変わります。</p>`;
      box.innerHTML = html;
      return { eq1: eq(me.h1), eq0: eq(me.h0), nat: eq(A.nat1), rank, top: top3[0] };
    }
    function hhiTownLine(t) {
      const o = hhiOf(t.e1);
      if (!o) return '';
      const miss = t.e1.filter((x) => typeof x !== 'number').length;
      return `<p class="an-ssnote">業種の集まり方：${SS.y1}は同じ大きさの業種が${(1 / o.h).toFixed(1)}個あるのと同じ（指数 ${o.h.toFixed(3)}）。${miss ? `数字が無い${miss}業種を除いて計算しています。` : ''}</p>`;
    }
    document.getElementById('anSSTownSel')?.addEventListener('change', ssTown);

    function draw() {
      chips();
      ssTown();
      if (!main) return;
      profile();
      const Q = lqView();
      const SSr = ssView();
      const H = hhiView();
      const P = pairs();
      const T = trends();
      conclude(P, T, Q, SSr, H);
    }
    // 県を選ぶ前でも、散布図は全国の並びで見せておく
    pairs();
  })();
  </script>

  <style is:global>
    .an-ss { margin: 8px 0 20px; }
    .an-sstown { margin: 4px 0 24px; padding: 14px 16px; border: 1px dashed #c9c2ae; border-radius: 10px; background: #fdfcf6; }
    .an-sstown-h { font-weight: 700; color: #1b4332; font-size: .9rem; margin: 0 0 8px; }
    .an-sstown label { display: flex; align-items: center; gap: 10px; font-size: .86rem; flex-wrap: wrap; }
    .an-sstown select { padding: 6px 8px; border: 1px solid #c9c2ae; border-radius: 8px; font-size: .9rem; background: #fff; min-width: 12em; }
    .an-sstown .an-note { margin: 8px 0 4px; }
    .an-sstown-name { font-weight: 700; margin: 10px 0 6px; }
    .an-ssbars { display: flex; flex-direction: column; gap: 6px; }
    .an-ssr { display: grid; grid-template-columns: 7em 1fr 5em 7.5em; gap: 10px; align-items: center; font-size: .86rem; }
    .an-ssl { color: #1b4332; font-weight: 700; }
    .an-sst { position: relative; height: 16px; background: #f4f1e8; border-radius: 3px; }
    .an-ssmid { position: absolute; left: 50%; top: -3px; bottom: -3px; border-left: 1.5px dashed #555; }
    .an-sst i { position: absolute; top: 0; bottom: 0; border-radius: 2px; }
    .an-ssr b { font-family: "IBM Plex Mono", monospace; text-align: right; }
    .an-ssr small { font-family: "IBM Plex Mono", monospace; color: #777; font-size: .74rem; text-align: right; }
    .an-ssb--t, .an-ssk--t { background: #555; }
    .an-ssb--n, .an-ssk--n { background: #8a9a8f; }
