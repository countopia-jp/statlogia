---
// =====================================================
// Statlogia - 定番統計ダッシュボード「国勢の間」
// src/pages/population/index.astro
//
// 都道府県を選んで人口・世帯の基礎データを見る窓口。
// データは /data/population.json（ビルド時生成）から取得。
// トップのヒーロー検索窓から ?pref=県名 で渡されると自動選択する。
// 総人口は時系列（折れ線グラフ、Chart.js）も表示する。
// ※スタイルは is:global（JS生成要素にスコープCSSが効かないため）。
//   誤爆防止で全セレクタを .pop- 接頭辞で統一している。
// =====================================================
import BaseLayout from '../../layouts/BaseLayout.astro';
import Talk from '../../components/Talk.astro';
import CompareAddon from '../../components/CompareAddon.astro';
import { getPopulationData } from '../../lib/population.js';
import HeroFig from '../../components/HeroFig.astro';

const pop = await getPopulationData();
const years = [...new Set(pop.indicators.map((i) => i.year).filter(Boolean))].sort();
const yearNote = years.join('・');
import GrowthTool from '../../components/GrowthTool.astro';
import PyramidTool from '../../components/PyramidTool.astro';
import FutureTool from '../../components/FutureTool.astro';
---

<BaseLayout title="国勢の間｜人口と世帯｜Statlogia" description="都道府県を選んで、総人口・高齢化率・年少人口率・世帯数・出生率・婚姻率を一枚の台帳でご覧いただける窓口。総人口の推移と全国ベスト5つき。" backHref="/dashboard/" backLabel="閲覧室">
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>

  <main class="pop-dash">
    <HeroFig src="/images/icon/population-large.webp" alt="丘の上から見おろす、屋根の連なる町並みと遠い山" width={1400} height={788}>
      <p class="pop-kicker">閲覧室｜人と世帯</p>
      <h1>国勢の間</h1>
      <p class="pop-lead">
        総人口、高齢化率、世帯数、出生率、婚姻率。<br />
        あなたの県の「人のかたち」を、数字でご覧ください。
      </p>
    </HeroFig>

    <Talk speaker="chiaki">
      ここでは、県の人口と世帯のすがたをまとめて見られる。数字の基本のきだ。
    </Talk>
    <Talk speaker="hitoha">
      その土地に、どれくらいの人が暮らしているか、ということですね。
    </Talk>

    <!-- ===== 都道府県セレクタ ===== -->
    <section class="pop-selector" aria-label="都道府県の選択">
      <label>
        <span>都道府県</span>
        <select id="prefSelect">
          <option value="">選んでください</option>
        </select>
      </label>
    </section>

    <!-- ===== 選択結果 ===== -->
    <section id="resultArea" class="pop-result" hidden aria-live="polite">
      <h2 id="resultTitle"></h2>
      <div class="pop-cards" id="cardGrid"></div>

      <div class="pop-chart-wrap">
        <p class="pop-chart-title">総人口の推移</p>
        <canvas id="popChart" data-growth="level" height="120"></canvas>
        <p class="pop-chart-note">点線は47都道府県の平均です。「ほかの県と並べる」で県を足すと、その県の線も重なります。</p>
      </div>

      <Talk speaker="chiaki"><span id="keiLine">県を選ぶと、台帳を出そう。</span></Talk>
      <Talk speaker="hitoha"><span id="toukoLine">どんな土地でしょうか。</span></Talk>
    </section>

    <CompareAddon level="pref" selectId="prefSelect" src="/data/population.json" />

    <FutureTool level="pref" selectId="prefSelect" />
    <PyramidTool level="pref" selectId="prefSelect" />

    <!-- ===== ランキング ===== -->

    <section class="pop-ranking" aria-label="ランキング">
      <h2>全国ベスト5</h2>
      <div class="pop-tabs" role="tablist">
        <button class="pop-tab is-active" data-rank="pop" role="tab">人口が多い</button>
        <button class="pop-tab" data-rank="aging" role="tab">高齢化率が高い</button>
        <button class="pop-tab" data-rank="young" role="tab">高齢化率が低い</button>
      </div>
      <ol class="pop-rank-list" id="rankList"></ol>
      <p class="pop-note" id="rankNote"></p>
    </section>

    <Talk speaker="chiaki">
      人口の順位と高齢化率の順位は、同じ並びにはならない。数字を並べてみると、県ごとの違いが見えてくる。
    </Talk>
    <Talk speaker="hitoha">
      人が多い県、少ない県。それぞれに、暮らしがあるんですね。
    </Talk>

    <p class="pop-cross">あわせて見る：<a href="/living/">暮らしの見積所</a>｜<a href="/education/">学びの登記所</a></p>

    <footer class="pop-source">
      <p>
        出典：{pop.source}（{yearNote}）<br />
        高齢化率は65歳以上人口の割合（％）、年少人口率は15歳未満人口の割合（％）、婚姻率は人口千人あたりの婚姻件数（‰）、合計特殊出生率は一人の女性が一生のあいだに産む子どもの数にあたる指標です。<br />
        年次は指標ごとに異なり、各カードに記しています（国勢調査にもとづく値は5年ごと、人口動態統計にもとづく値は毎年の値です）。<br />
        「平均」は47都道府県の単純平均であり、全国値とは一致しません。割合（％・‰）の平均との差は「ポイント」で、それ以外は平均に対する比（％）で示しています。<br />
        このページはe-Stat APIで取得した統計データを独自に加工して作成しています。
      </p>
    </footer>
  </main>

  <script is:inline>
    (async function () {
      const res = await fetch('/data/population.json');
      const data = await res.json();
      const IND = data.indicators;
      const idx = Object.fromEntries(IND.map((ind, i) => [ind.code, i]));
      const meta = Object.fromEntries(IND.map((ind) => [ind.code, ind]));
      const val = (area, code) => area.v[idx[code]];

      const CARDS = [
        { code: 'A1101', short: '総人口', dir: 'desc' },
        { code: 'A1306', short: '高齢化率', dir: 'desc' },
        { code: 'A1304', short: '年少人口率', dir: 'desc' },
        { code: 'A192003', short: '人口増減率', dir: 'desc' },
        { code: 'A7101', short: '世帯数', dir: 'desc' },
        { code: 'A710211', short: '1世帯あたり人員', dir: 'desc' },
        { code: 'A4103', short: '合計特殊出生率', dir: 'desc' },
        { code: 'A9121', short: '婚姻率', dir: 'desc' },
      ];

      function fmtValue(code, v) {
        if (v === null || v === undefined) return '—';
        const unit = meta[code].unit || '';
        if (unit === '人' && v >= 10000) return (v / 10000).toFixed(1) + '万人';
        if (unit === '％' || unit === '‰') return v.toFixed(1) + unit;
        if (unit === '世帯' && v >= 10000) return (v / 10000).toFixed(1) + '万世帯';
        return v.toLocaleString('ja-JP') + unit;
      }

      const stats = {};
      for (const c of CARDS) {
        const rows = data.areas
          .filter((a) => val(a, c.code) !== null)
          .sort((x, y) =>
            c.dir === 'desc' ? val(y, c.code) - val(x, c.code) : val(x, c.code) - val(y, c.code)
          );
        const avg = rows.reduce((s, a) => s + val(a, c.code), 0) / rows.length;
        stats[c.code] = {
          avg,
          rank: Object.fromEntries(rows.map((a, i) => [a.c, i + 1])),
          total: rows.length,
        };
      }

      const prefSelect = document.getElementById('prefSelect');
      for (const a of data.areas) {
        const opt = document.createElement('option');
        opt.value = a.c;
        opt.textContent = a.n;
        prefSelect.appendChild(opt);
      }
      prefSelect.addEventListener('change', () => {
        const area = data.areas.find((a) => a.c === prefSelect.value);
        if (area) render(area);
      });

      // 10-24 比べる地域の線と、47都道府県の平均の点線（engine の窓口と同じ作り）
      // 総人口は「合計」の項目なので、くらべる相手は全国ではなく47県の平均にする
      const CMP_COLORS = ['#B3402A', '#4B5570', '#c99a2e', '#4a6fa5', '#7a5c99'];
      let cmpList = [];
      let cmpColors = CMP_COLORS;
      let curArea = null;
      let _avgByYear = null;
      function prefAverageByYear() {
        if (_avgByYear) return _avgByYear;
        const acc = {};
        for (const a of data.areas) for (const q of (a.series || [])) {
          if (typeof q.value === 'number') (acc[q.year] = acc[q.year] || []).push(q.value);
        }
        _avgByYear = {};
        for (const y in acc) _avgByYear[y] = acc[y].reduce((t, v) => t + v, 0) / acc[y].length;
        return _avgByYear;
      }

      function renderChart(area) {
        const ctx = document.getElementById('popChart');
        if (!ctx || !area.series || area.series.length === 0) return;
        curArea = area;
        const labels = area.series.map((p) => p.year);
        const alone = cmpList.length === 0;
        const sets = [{
          label: area.n,
          data: area.series.map((p) => p.value),
          borderColor: cmpColors[0], backgroundColor: alone ? cmpColors[0] + '22' : cmpColors[0],
          tension: 0.2, fill: alone, pointRadius: 2,
        }];
        cmpList.forEach((b, k) => {
          const o = data.areas.find((a) => a.c === b.c);
          if (!o || !o.series) return;
          const byYear = {};
          for (const q of o.series) byYear[q.year] = q.value;
          sets.push({
            label: b.n, data: labels.map((y) => (typeof byYear[y] === 'number' ? byYear[y] : null)),
            borderColor: cmpColors[(k + 1) % cmpColors.length], backgroundColor: cmpColors[(k + 1) % cmpColors.length],
            tension: 0.2, fill: false, pointRadius: 2, spanGaps: false,
          });
        });
        const avg = prefAverageByYear();
        sets.push({
          label: '47都道府県の平均',
          data: labels.map((y) => (typeof avg[y] === 'number' ? avg[y] : null)),
          borderColor: '#7F97A8', borderDash: [6, 4], borderWidth: 1.5,
          pointRadius: 0, fill: false, tension: 0.2, spanGaps: false,
        });
        if (window._popChartInstance) window._popChartInstance.destroy();
        window._popChartInstance = new Chart(ctx, {
          type: 'line',
          data: { labels, datasets: sets },
          options: {
            responsive: true,
            plugins: {
              legend: {
                display: !alone,
                labels: { boxWidth: 14, filter: (it) => it.text !== '47都道府県の平均' },
              },
            },
            scales: { y: { ticks: { callback: (v) => (v / 10000).toFixed(0) + '万人' } } },
          },
        });
      }

      // 「ほかの県と並べる」で足し引きされたら、同じ線を図にも引く
      document.addEventListener('cmpx:change', (ev) => {
        const d = ev.detail || {};
        if (d.select !== 'prefSelect') return;
        cmpList = d.compare || [];
        if (Array.isArray(d.colors) && d.colors.length) cmpColors = d.colors;
        if (curArea) renderChart(curArea);
      });

      function render(area) {
        document.getElementById('resultArea').hidden = false;
        document.getElementById('resultTitle').textContent = `${area.n}の台帳`;

        const grid = document.getElementById('cardGrid');
        grid.innerHTML = '';
        for (const c of CARDS) {
          const v = val(area, c.code);
          const st = stats[c.code];
          const rank = st.rank[area.c];
          const unit = meta[c.code].unit || '';
          const isRate = unit === '％' || unit === '‰';
          const hasV = typeof v === 'number';
          const diff = !hasV ? null : isRate ? v - st.avg : ((v - st.avg) / st.avg) * 100;
          const sign = diff === null ? '' : diff >= 0 ? '+' : '';
          const diffText = diff === null ? '' : isRate ? `平均との差 ${sign}${diff.toFixed(1)}ポイント` : `平均比 ${sign}${diff.toFixed(1)}％`;

          const card = document.createElement('div');
          card.className = 'pop-card';
          card.innerHTML =
            `<div class="pop-card-label">${c.short}</div>` +
            `<div class="pop-card-num">${fmtValue(c.code, v)}</div>` +
            `<div class="pop-card-sub">${meta[c.code].year || ''}</div>` +
            (!hasV || !rank
              ? ''
              : `<div class="pop-card-meta"><span class="pop-rank">${st.total}県中 ${rank}位</span>` +
                `<span class="pop-diff">${diffText}</span></div>`);
          grid.appendChild(card);
        }

        renderChart(area);
        updateLines(area);
      }

      function updateLines(area) {
        const kei = document.getElementById('keiLine');
        const TOUKO_LINES = ["人口と高齢化率を、並べて見るんですね。", "国勢調査は5年に一度、全員を数えるんですよね。", "お年寄りも子どもも、分けて数えてあるんですね。"];
        // 一葉の一言は順位や値を言い直さず、数字への驚きや感心を言う（値のない町の一言はそのまま）
        const touko = { set textContent(v) { const el = document.getElementById('toukoLine'); if (/値のない|定めのない|ない町|0校/.test(v)) { el.textContent = v; return; } const k = document.getElementById('keiLine').textContent || ''; let h = 0; for (const ch of k) h = (h * 31 + ch.charCodeAt(0)) >>> 0; el.textContent = TOUKO_LINES[h % TOUKO_LINES.length]; } };
        const popRank = stats['A1101'].rank[area.c];
        const agingRank = stats['A1306'].rank[area.c];
        const total = stats['A1101'].total;
        const seed = parseInt(area.c, 10) || 0;
        const hasPop = typeof popRank === 'number';
        const hasAging = typeof agingRank === 'number';

        let k = hasPop && hasAging
          ? `総人口は${total}県中${popRank}位、高齢化率は${agingRank}位だ。`
          : `${hasPop ? `総人口は${total}県中${popRank}位だ。` : '総人口は、この県の値が無い。'} ${hasAging ? `高齢化率は${agingRank}位だ。` : '高齢化率は、この県の値が無い。'}`;
        let t = '';

        if (!hasPop || !hasAging) {
          t = '値のない欄もあるんですね。';
        } else if (popRank <= 5 && agingRank >= 38) {
          k += ' 人口が多く、高齢化率は低いほうの県だ。';
          t = ['人口の順位と、高齢化の順位は、そろわないんですね。', '二つの数字を並べると、見え方が変わるんですね。'][seed % 2];
        } else if (popRank >= 38 && agingRank <= 10) {
          k += ' 人口は少なめで、高齢化率は高いほうだ。';
          t = ['どちらの数字も、端のほうにあるんですね。', '二つとも、まん中からは離れているんですね。'][seed % 2];
        } else if (agingRank <= 5) {
          k += ' 高齢化率は全国でも上位だ。';
          t = ['65歳以上の方の割合が、高いほうなんですね。', 'この県は、上のほうにあるんですね。'][seed % 2];
        } else if (agingRank >= 43) {
          k += ' 高齢化率は全国でも低いほうだ。';
          t = ['65歳以上の方の割合が、低いほうなんですね。'][0];
        } else {
          k += ' 高齢化率は、全国の中ほどだ。';
          t = ['高齢化率は、まん中あたりなんですね。'][0];
        }

        kei.textContent = k;
        touko.textContent = t;
      }

      const RANKS = {
        pop: { code: 'A1101', dir: 'desc', note: '総人口が多い県ベスト5。' },
        aging: { code: 'A1306', dir: 'desc', note: '高齢化率が高い県ベスト5。' },
        young: { code: 'A1306', dir: 'asc', note: '高齢化率が低い県ベスト5。' },
      };

      const rankList = document.getElementById('rankList');
      const rankNote = document.getElementById('rankNote');

      function showRank(mode) {
        const cfg = RANKS[mode];
        rankList.innerHTML = '';
        const rows = data.areas
          .filter((a) => val(a, cfg.code) !== null)
          .sort((x, y) =>
            cfg.dir === 'desc' ? val(y, cfg.code) - val(x, cfg.code) : val(x, cfg.code) - val(y, cfg.code)
          )
          .slice(0, 5);
        for (const a of rows) {
          const li = document.createElement('li');
          li.innerHTML =
            `<span class="pop-rank-name">${a.n}</span>` +
            `<span class="pop-rank-val">${fmtValue(cfg.code, val(a, cfg.code))}</span>`;
          li.addEventListener('click', () => {
            prefSelect.value = a.c;
            prefSelect.dispatchEvent(new Event('change'));
          });
          rankList.appendChild(li);
        }
        rankNote.textContent = cfg.note;
      }

      document.querySelectorAll('.pop-tab').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.pop-tab').forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          showRank(btn.dataset.rank);
        });
      });

      showRank('pop');

      // URLの ?pref=県名 を受けて自動選択（トップページのヒーロー検索窓から遷移した場合）
      const params = new URLSearchParams(location.search);
      const wantedName = params.get('pref');
      if (wantedName) {
        const target = data.areas.find((a) => a.n === wantedName);
        if (target) {
          prefSelect.value = target.c;
          render(target);
          document.getElementById('resultArea').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    })();
  </script>

  <style is:global>
    .pop-dash { max-width: 860px; margin: 0 auto; padding: 0 16px 48px; }
    .pop-hero { text-align: center; padding: 32px 0 8px; }
    .pop-hero-figure { display: block; width: 100%; max-width: 780px; height: auto; border-radius: 4px; margin: 0 auto 20px; }
    .pop-kicker { font-family: "IBM Plex Mono", monospace; font-size: .74rem; letter-spacing: .22em; font-weight: 600; color: var(--stamp); margin: 0; }
    .pop-hero h1 { margin: 4px 0 12px; font-family: "Shippori Mincho", serif; font-weight: 800; }
    .pop-lead { color: #555; line-height: 1.9; }

    .pop-selector { margin: 24px 0; display: flex; justify-content: center; }
    .pop-selector label { display: flex; flex-direction: column; gap: 6px; font-size: 0.85rem; }
    .pop-selector select {
      min-width: 240px; padding: 10px 12px; border: 1px solid #1F2A44;
      border-radius: 6px; background: #fff; font-size: 1rem;
    }

    .pop-result h2 { text-align: center; margin: 24px 0 16px; font-family: "Shippori Mincho", serif; }
    .pop-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
    .pop-card {
      border: 1px solid #DEDFE3; border-radius: 8px; padding: 16px;
      background: #fff; text-align: center;
    }
    .pop-card-label { font-size: 0.78rem; color: #4B5570; letter-spacing: 0.08em; }
    .pop-card-num {
      font-family: "IBM Plex Mono", monospace; font-size: 1.5rem;
      font-weight: 700; margin: 6px 0 2px; color: #1F2A44;
    }
    .pop-card-sub { font-size: 0.7rem; color: #999; }
    .pop-card-meta {
      display: flex; justify-content: center; gap: 10px;
      margin-top: 8px; font-size: 0.75rem;
    }
    .pop-rank { color: #B3402A; font-weight: 700; }
    .pop-diff { color: #666; }

    .pop-chart-note { font-size: .78rem; color: var(--ink-soft); line-height: 1.8; margin: 6px 0 0; }
    .pop-chart-wrap {
      margin: 28px 0 8px; padding: 16px; border: 1px solid #DEDFE3;
      border-radius: 8px; background: #fff;
    }
    .pop-chart-title {
      font-size: 0.8rem; color: #4B5570; letter-spacing: 0.06em;
      margin: 0 0 10px; text-align: center;
    }

    .pop-ranking { margin-top: 44px; }
    .pop-ranking h2 { text-align: center; font-family: "Shippori Mincho", serif; }
    .pop-tabs { display: flex; gap: 8px; justify-content: center; margin: 12px 0 16px; flex-wrap: wrap; }
    .pop-tab {
      padding: 8px 16px; border: 1px solid #1F2A44; border-radius: 999px;
      background: #fff; cursor: pointer; font-size: 0.85rem;
    }
    .pop-tab.is-active { background: #1F2A44; color: #fff; }
    .pop-rank-list {
      list-style: none; counter-reset: rank; padding: 8px 20px;
      max-width: 560px; margin: 0 auto 8px;
      border: 1px solid #DEDFE3; border-radius: 8px; background: #fdfdf8;
    }
    .pop-rank-list li {
      counter-increment: rank; display: flex; justify-content: space-between;
      align-items: center; padding: 10px 4px; border-bottom: 1px solid #DEDFE3; cursor: pointer;
    }
    .pop-rank-list li:last-child { border-bottom: none; }
    .pop-rank-list li::before {
      content: counter(rank); font-weight: 700; color: #B3402A;
      margin-right: 12px; min-width: 1.4em; text-align: center;
    }
    .pop-rank-list li:hover { background: #F3F4F7; }
    .pop-rank-name { flex: 1; }
    .pop-rank-val { font-weight: 700; font-family: "IBM Plex Mono", monospace; }

    .pop-cross { margin-top: 36px; font-size: 0.9rem; text-align: center; }
    .pop-cross a { color: #B3402A; }
    .pop-source { margin-top: 40px; font-size: 0.75rem; color: #888; line-height: 1.8; }
  </style>
  <GrowthTool />
</BaseLayout>