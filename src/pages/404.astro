---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="迷子になりました | Countopia">
  <section class="err-page">
    <img src="/images/icon/touko-404.webp" alt="道に迷った橙子" class="err-illust" />
    <h1>404 - このページは見つかりません</h1>
    <p>お探しのページは、まだ地図に載っていないようです。</p>
    <a href="/">玄関に戻る</a>
  </section>
</BaseLayout>

<style>
  .err-page {
    text-align: center;
    padding: 3rem 1rem;
  }
  .err-illust {
    max-width: 480px;
    width: 100%;
    height: auto;
    margin: 0 auto 1.5rem;
    display: block;
  }
</style>
