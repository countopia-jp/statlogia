---
import fs from 'node:fs';
import path from 'node:path';
// 扉絵の縮小版があればカードに出す（新しい窓口は絵が届くまで文だけ）
const thumbOf = (id) => (fs.existsSync(path.join(process.cwd(), 'public/images/icon', `${id}-thumb.webp`)) ? `/images/icon/${id}-thumb.webp` : null);
import BaseLayout from '../../layouts/BaseLayout.astro';
import Talk from '../../components/Talk.astro';
---
<BaseLayout title="閲覧室｜Countopia Stats" description="都道府県・市区町村を選んで、学校・人口・住まい・医療・通勤などの数字を自分の手で引き出す閲覧室。各窓口の案内一覧です。" backHref="/" backLabel="玄関">
  <main class="rr">
    <header class="rr-hero">
      <img class="rr-figure" src="/images/icon/reading-room-large.webp" alt="木造の書庫で、開いた台帳を指さす橙子と、のぞきこむ京の水彩画" width="1400" height="788" loading="lazy" />
      <p class="rr-kicker">閲覧室</p>
      <h1>自分の手で、数字を引き出す部屋</h1>
     <p class="rr-lead">
        展示はこちらが選んだ数字の物語。閲覧室では、あなたが選びます。<br />
        知りたい町を指定して、台帳から数字を取り寄せてください。
      </p>
      <p class="rr-note">※各窓口カードの「出典」年度はカード設置時点のものです。実際にお調べいただく数字は、常に最新の統計に自動で更新されています。</p>
    </header>
    <form class="rr-search" action="/search/" role="search" onsubmit="location.href='/search/#q='+encodeURIComponent(this.querySelector('input').value);return false">
      <label for="rrQ">どの窓口か分からないときは、言葉でたずねてください</label>
      <div class="rr-search-row"><input id="rrQ" type="search" placeholder="例：保育園、家賃、雪" autocomplete="off" /><button type="submit">たずねる</button></div>
    </form>
    <p class="rr-area-link"><a href="/tower/">土地を選んで、いろいろな数字を一枚で見る「展望塔」→</a></p>
    <Talk speaker="kei">
      閲覧室のご利用は自由です。台帳はすべて国の統計から写しています。どうぞ、お好きな窓口へ。
    </Talk>

    <section class="rr-group" aria-label="人と住まい">
      <h2 class="rr-group-title">人と住まい</h2>
      <div class="rr-grid">
        <a class="rr-card" href="/population/">
          <img class="rr-card-img" src="/images/icon/population-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>国勢の間</h3>
          <p class="rr-card-desc">
            都道府県を選んで、総人口・高齢化率・世帯数・出生率・婚姻率をまとめた台帳をご覧いただけます。
            人口の多さと高齢化の進み方を、全国平均と並べて見られます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（2020・2023・2024年度）</p>
          </div>
        </a>
        <a class="rr-card" href="/town-population/">
          <img class="rr-card-img" src="/images/icon/town-population-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>わが町の人口</h3>
          <p class="rr-card-desc">
            市区町村を選んで、あなたの町の総人口・高齢化率・年少人口率・世帯数と、将来の推計人口をご覧いただけます。
            県より一段細かく、町の来し方行く末が数字で見えてきます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（2023年度）</p>
          </div>
        </a>
        <a class="rr-card" href="/town-housing/">
          <img class="rr-card-img" src="/images/icon/town-housing-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>わが町の住まい</h3>
          <p class="rr-card-desc">
            市区町村を選んで、空き家率・持ち家率・1軒あたりの広さ・家賃をご覧いただけます。
            住むところを探すとき、その町の住まいがどんな様子かを、数字で。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（2023年度）</p>
          </div>
        </a>
        <a class="rr-card" href="/town-landuse/">
          <img class="rr-card-img" src="/images/icon/town-landuse-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>わが町の土地の使われ方</h3>
          <p class="rr-card-desc">
            市区町村を選んで、住まい・商い・工場それぞれの土地がどれだけあるかをご覧いただけます。
            都市計画で定められた、町のかたちを数字で。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（2023年度）</p>
          </div>
        </a>
        <a class="rr-card" href="/home-features/">
          {thumbOf('home-features') && <img class="rr-card-img" src={thumbOf('home-features')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>家のつくりと設備</h3>
          <p class="rr-card-desc">
            都道府県を選んで、部屋の数や広さ、建てた年、鉄筋コンクリートの家、高齢者などのための設備がある家、借家の割合を見られます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（住宅・土地統計調査）</p>
          </div>
        </a>
        <a class="rr-card" href="/house-build/">
          {thumbOf('house-build') && <img class="rr-card-img" src={thumbOf('house-build')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>家の建ちかた</h3>
          <p class="rr-card-desc">
            都道府県を選んで、新しく建て始めた持ち家・貸家・分譲住宅の数と、1戸あたりの床面積を見られます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（建築着工統計）</p>
          </div>
        </a>
        <a class="rr-card" href="/home-space/">
          {thumbOf('home-space') && <img class="rr-card-img" src={thumbOf('home-space')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>住まいの広さと近さ</h3>
          <p class="rr-card-desc">
            都道府県を選んで、1人あたりの家の広さや畳の数、持ち家と借家の部屋の数、敷地の広さ、保育所やデイサービスまでの近さを見られます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（住宅・土地統計調査）</p>
          </div>
        </a>
      </div>
    </section>

    <section class="rr-group" aria-label="近くにあるもの">
      <h2 class="rr-group-title">近くにあるもの</h2>
      <div class="rr-grid">
        <a class="rr-card" href="/town-medical/">
          <img class="rr-card-img" src="/images/icon/town-medical-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>わが町の医療</h3>
          <p class="rr-card-desc">
            市区町村を選んで、病院・診療所・お医者さん・薬剤師の数をご覧いただけます。
            人口では割らず、その町にある数をそのまま。お医者さんの数は長い年月の移りかわりも。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（2023年度）</p>
          </div>
        </a>
        <a class="rr-card" href="/town-nursery/">
          <img class="rr-card-img" src="/images/icon/town-nursery-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>保育所は、近いか</h3>
          <p class="rr-card-desc">
            市区町村を選んで、最寄りの保育所までの近さ（500m未満・1000m以上の世帯割合）をご覧いただけます。
            子育ての足もとが、町ごとに見えてきます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（2018年度）</p>
          </div>
        </a>
        <a class="rr-card" href="/town-daycare/">
          <img class="rr-card-img" src="/images/icon/town-daycare-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>介護は、近いか</h3>
          <p class="rr-card-desc">
            市区町村を選んで、最寄りの老人デイサービスセンターまでの近さ（500m未満・1000m以上の世帯割合）をご覧いただけます。
            「保育所は、近いか」の介護版。介護の足もとが、町ごとに見えてきます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（2018年度）</p>
          </div>
        </a>
        <a class="rr-card" href="/fire-ems/">
          {thumbOf('fire-ems') && <img class="rr-card-img" src={thumbOf('fire-ems')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>消防と救急</h3>
          <p class="rr-card-desc">
            都道府県を選んで、消防署・消防団・救急車の数と、救急の出動や火事の件数を、人口あたりで。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（消防庁の調べ）</p>
          </div>
        </a>
        <a class="rr-card" href="/care-places/">
          {thumbOf('care-places') && <img class="rr-card-img" src={thumbOf('care-places')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>子どもと高齢者の施設</h3>
          <p class="rr-card-desc">
            都道府県を選んで、老人ホームの定員やデイサービス、認定こども園や小規模保育の数を、お年寄りや子どもの人口あたりで見られます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（社会福祉施設等調査ほか）</p>
          </div>
        </a>
        <a class="rr-card" href="/medical-staff/">
          {thumbOf('medical-staff') && <img class="rr-card-img" src={thumbOf('medical-staff')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>医療の担い手</h3>
          <p class="rr-card-desc">
            都道府県を選んで、医師・歯科医師・薬剤師・看護師・助産師・保健師などの人数と、薬局や訪問看護ステーションの数を、人口10万人あたりで見られます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（医師・歯科医師・薬剤師統計、衛生行政報告例ほか）</p>
          </div>
        </a>
      </div>
    </section>

    <section class="rr-group" aria-label="働く・通う・暮らす">
      <h2 class="rr-group-title">働く・通う・暮らす</h2>
      <div class="rr-grid">
        <a class="rr-card" href="/town-commute/">
          <img class="rr-card-img" src="/images/icon/town-commute-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>通勤の足は、何か</h3>
          <p class="rr-card-desc">
            市区町村を選んで、その町の人が主に何で通うのか（自家用車・公共交通の割合）をご覧いただけます。
            自家用車で通う人と、鉄道・バスで通う人の割合を、数字で。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（2020年度）</p>
          </div>
        </a>
        <a class="rr-card" href="/town-commute-time/">
          <img class="rr-card-img" src="/images/icon/town-commute-time-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>通勤に、どれだけかかるか</h3>
          <p class="rr-card-desc">
            市区町村を選んで、その町から通う人が片道にかける時間（30分未満・1時間以上・1時間30分以上の世帯割合）をご覧いただけます。
            となりの窓口が「何で通うか」なら、こちらは「どれだけかかるか」。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（2023年度）</p>
          </div>
        </a>
        <a class="rr-card" href="/living/">
          <img class="rr-card-img" src="/images/icon/living-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>暮らしの見積所</h3>
          <p class="rr-card-desc">
            都道府県を選んで、給与・最低賃金・家賃・家の広さ・持ち家率を一枚の見積書に。
            稼ぎと住まいを並べると、暮らしの釣り合いが見えてきます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（2023・2024年度）</p>
          </div>
        </a>
        <a class="rr-card" href="/prices/">
          <img class="rr-card-img" src="/images/icon/prices-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>物価の帳場</h3>
          <p class="rr-card-desc">
            都道府県を選んで、食料・住居・光熱・教育など10の分類ごとに、値段の水準を全国平均＝100で並べます。
            分類ごとの移りかわりと、全国の高い県・安い県つき。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（2013〜2024年）</p>
          </div>
        </a>
        <a class="rr-card" href="/appliances/">
          {thumbOf('appliances') && <img class="rr-card-img" src={thumbOf('appliances')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>暮らしの道具</h3>
          <p class="rr-card-desc">
            都道府県を選んで、エアコン・電子レンジ・温水洗浄便座・自動車・オートバイ・ピアノの数を1000世帯あたりで。1979年からの移りかわりつき。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（全国消費実態調査、2014年まで）</p>
          </div>
        </a>
        <a class="rr-card" href="/work-forms/">
          {thumbOf('work-forms') && <img class="rr-card-img" src={thumbOf('work-forms')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>働き方のかたち</h3>
          <p class="rr-card-desc">
            都道府県を選んで、自営業の人や、仕事の種類ごとの人の割合、有効求人倍率、転職した人の割合、共働きの世帯を見られます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（国勢調査・職業安定業務統計ほか）</p>
          </div>
        </a>
      </div>
    </section>

    <section class="rr-group" aria-label="空と大地">
      <h2 class="rr-group-title">空と大地</h2>
      <div class="rr-grid">
        <a class="rr-card" href="/sky/">
          <img class="rr-card-img" src="/images/icon/sky-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>空の帳場</h3>
          <p class="rr-card-desc">
            都道府県を選んで、気温・降水・雪・日照・湿度を。全国の順位と、長い年月の移りかわりつき。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（気象庁の観測値）</p>
          </div>
        </a>
        <a class="rr-card" href="/disaster/">
          <img class="rr-card-img" src="/images/icon/disaster-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>自然災害の帳場</h3>
          <p class="rr-card-desc">
            都道府県を選んで、自然災害の被害額・水につかった建物・被害を受けた世帯と人の数を、年ごとに。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（消防庁の調べ）</p>
          </div>
        </a>
        <a class="rr-card" href="/town-forest/">
          <img class="rr-card-img" src="/images/icon/town-forest-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>わが町の森と土地</h3>
          <p class="rr-card-desc">
            市区町村を選んで、町の面積・人が住める土地・森林の広さと割合を、全国と県内の順位で。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系</p>
          </div>
        </a>
        <a class="rr-card" href="/nature/">
          <img class="rr-card-img" src="/images/icon/nature-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>自然公園と植生</h3>
          <p class="rr-card-desc">
            都道府県を選んで、国立公園・国定公園・県立自然公園の広さと、自然のままの植生が残る割合を。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系</p>
          </div>
        </a>
      </div>
    </section>

    <section class="rr-group" aria-label="仕事と産業">
      <h2 class="rr-group-title">仕事と産業</h2>
      <div class="rr-grid">
        <a class="rr-card" href="/town-work/">
          <img class="rr-card-img" src="/images/icon/town-work-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>わが町の仕事</h3>
          <p class="rr-card-desc">
            市区町村を選んで、田畑や海・ものづくり・お店やサービスで働く人の割合と、事業所や働く人の数を。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（国勢調査・経済センサス）</p>
          </div>
        </a>
        <a class="rr-card" href="/town-shops/">
          <img class="rr-card-img" src="/images/icon/town-shops-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>工場とお店</h3>
          <p class="rr-card-desc">
            市区町村を選んで、工場の数と製造品の出荷額、お店の数と販売額を、全国と県内の順位で。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（工業統計・経済センサスほか）</p>
          </div>
        </a>
        <a class="rr-card" href="/farm-sea/">
          <img class="rr-card-img" src="/images/icon/farm-sea-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>田畑と海</h3>
          <p class="rr-card-desc">
            都道府県を選んで、農業産出額・田畑の広さ・耕作放棄地と、海の漁獲量や養殖の収獲量を。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（農林水産省の調べ）</p>
          </div>
        </a>
        <a class="rr-card" href="/stay/">
          <img class="rr-card-img" src="/images/icon/stay-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>宿と観光</h3>
          <p class="rr-card-desc">
            都道府県を選んで、延べ宿泊者数・外国人の宿泊・客室稼働率と、旅館・ホテルの数を。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（宿泊旅行統計ほか）</p>
          </div>
        </a>
        <a class="rr-card" href="/town-farm/">
          {thumbOf('town-farm') && <img class="rr-card-img" src={thumbOf('town-farm')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
