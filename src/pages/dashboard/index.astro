---
import fs from 'node:fs';
import path from 'node:path';
const duoLedger = fs.existsSync(path.join(process.cwd(), 'public/images/chara/duo-ledger-scene.webp')) ? '/images/chara/duo-ledger-scene.webp' : null;
// 扉絵の縮小版があればカードに出す（新しい窓口は絵が届くまで文だけ）
const thumbOf = (id) => (fs.existsSync(path.join(process.cwd(), 'public/images/icon', `${id}-thumb.webp`)) ? `/images/icon/${id}-thumb.webp` : null);
import BaseLayout from '../../layouts/BaseLayout.astro';
import Talk from '../../components/Talk.astro';
import HeroFig from '../../components/HeroFig.astro';
import { ROOM_COUNT } from '../../data/page-names.js';
---
<BaseLayout title="情報棟｜Statlogia" description="都道府県・市区町村を選んで、人口・住まい・仕事・お金・医療・教育・自然などの数字を自分の手で引き出す情報棟。閲覧室の窓口一覧です。" backHref="/" backLabel="玄関">
  <main class="rr">
    <HeroFig src="/images/icon/reading-room-large.webp" pos="l" alt="帳面とファイルの棚を背にした木のカウンターで、来た人を迎える一葉の水彩画" width={1400} height={788}>
      <p class="rr-kicker">情報棟</p>
      <h1>閲覧室｜自分の手で、数字を引き出す</h1>
     <p class="rr-lead">
        知りたい県や町を選んで、台帳から数字を取り寄せる。<br />
        順位・全国との差・移りかわりを、窓口ごとに。
      </p>
    </HeroFig>
    <p class="rr-note">※窓口カードの「出典」の年度は、窓口を置いた時点のものです。<br />お調べいただく数字は、最新の統計に自動で更新されています。</p>
    <p class="rr-ask">どの窓口か分からないときは<br /><a class="rr-ask-btn" href="/search/"><i aria-hidden="true">INFO</i>案内所で言葉からたずねる<em aria-hidden="true">→</em></a></p>
    <div class="rr-intro">
      <div class="rr-intro-talk">
        <Talk speaker="chiaki">
          閲覧室は自由に使ってよい。台帳はすべて国の統計から写している。好きな窓口へ行きたまえ。
        </Talk>
      </div>
    </div>

    <section class="rr-group" aria-label="人と家族">
      <h2 class="rr-group-title">人と家族</h2>
      <div class="rr-grid">
        <a class="rr-card" href="/population/">
          <img class="rr-card-img" src="/images/icon/population-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>国勢の間</h3>
          <p class="rr-card-desc">
            都道府県を選んで、総人口・高齢化率・世帯数・出生率・婚姻率をまとめた台帳をご覧いただけます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（2020・2023・2024年度）</p>
          </div>
        </a>
        <a class="rr-card" href="/life-family/">
          {thumbOf('life-family') && <img class="rr-card-img" src={thumbOf('life-family')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>人の一生と家族のかたち</h3>
          <p class="rr-card-desc">
            都道府県を選んで、生まれる人と亡くなる人、初めて結婚する年齢、高齢の人のいる世帯、昼夜間人口比率、住んでいる外国人を。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（人口動態統計・国勢調査・在留外国人統計）</p>
          </div>
        </a>
        <a class="rr-card" href="/town-population/">
          <img class="rr-card-img" src="/images/icon/town-population-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>わが町の人口</h3>
          <p class="rr-card-desc">
            市区町村を選んで、あなたの町の総人口・高齢化率・年少人口率・世帯数と、将来の推計人口をご覧いただけます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（2023年度）</p>
          </div>
        </a>
        <a class="rr-card" href="/town-households/">
          {thumbOf('town-households') && <img class="rr-card-img" src={thumbOf('town-households')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>わが町の世帯のかたち</h3>
          <p class="rr-card-desc">
            ひとり暮らしや高齢の夫婦だけの世帯の割合、1世帯あたりの人数、年齢の真ん中、人口集中地区に住む人の割合を。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（国勢調査）</p>
          </div>
        </a>
        <a class="rr-card" href="/pref-migration/">
          {thumbOf('pref-migration') && <img class="rr-card-img" src={thumbOf('pref-migration')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>県の人の出入り</h3>
          <p class="rr-card-desc">
            引っ越してきた人・出ていった人とその差、自然増減率、海外へ出かけた日本人の数です。
          </p>
          <p class="rr-card-meta">都道府県</p>
          </div>
        </a>
        <a class="rr-card" href="/town-migration/">
          {thumbOf('town-migration') && <img class="rr-card-img" src={thumbOf('town-migration')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>わが町の人の出入り</h3>
          <p class="rr-card-desc">
            転入・転出の数字から、町の人の動きを追います。
          </p>
          <p class="rr-card-meta">市区町村</p>
          </div>
        </a>
        <a class="rr-card" href="/pref-foreign/">
          {thumbOf('pref-foreign') && <img class="rr-card-img" src={thumbOf('pref-foreign')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>県の外国人住民</h3>
          <p class="rr-card-desc">
            住民基本台帳の外国人住民の数と割合、その推移を都道府県で。国勢調査の値も添えて。
          </p>
          <p class="rr-card-meta">都道府県</p>
          </div>
        </a>
        <a class="rr-card" href="/town-daynight/">
          {thumbOf('town-daynight') && <img class="rr-card-img" src={thumbOf('town-daynight')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>わが町の昼と夜</h3>
          <p class="rr-card-desc">
            昼間人口と昼夜間人口比率。県内・他県からどれだけ通ってきて、どれだけ出ていくか。
          </p>
          <p class="rr-card-meta">市区町村</p>
          </div>
        </a>
        <a class="rr-card" href="/town-foreign/">
          {thumbOf('town-foreign') && <img class="rr-card-img" src={thumbOf('town-foreign')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>わが町の外国人住民</h3>
          <p class="rr-card-desc">
            住民基本台帳の外国人住民の数と割合、2013年からの推移を市区町村で。
          </p>
          <p class="rr-card-meta">市区町村</p>
          </div>
        </a>
        <a class="rr-card" href="/town-marriage/">
          {thumbOf('town-marriage') && <img class="rr-card-img" src={thumbOf('town-marriage')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>わが町の結婚と離婚</h3>
          <p class="rr-card-desc">
            1年の婚姻件数と離婚件数を人口1000人あたりに直して、推移とともに。
          </p>
          <p class="rr-card-meta">市区町村</p>
          </div>
        </a>
      </div>
    </section>

    <section class="rr-group" aria-label="住まいと土地">
      <h2 class="rr-group-title">住まいと土地</h2>
      <div class="rr-grid">
        <a class="rr-card" href="/home-features/">
          {thumbOf('home-features') && <img class="rr-card-img" src={thumbOf('home-features')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>家のつくりと設備</h3>
          <p class="rr-card-desc">
            都道府県を選んで、部屋の数や広さ、建てた年、鉄筋コンクリートの家、高齢者などのための設備がある家、借家の割合を見られます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（住宅・土地統計調査）</p>
          </div>
        </a>
        <a class="rr-card" href="/house-build/">
          {thumbOf('house-build') && <img class="rr-card-img" src={thumbOf('house-build')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>家の建ちかた</h3>
          <p class="rr-card-desc">
            都道府県を選んで、新しく建て始めた持ち家・貸家・分譲住宅の数と、1戸あたりの床面積を見られます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（建築着工統計）</p>
          </div>
        </a>
        <a class="rr-card" href="/home-space/">
          {thumbOf('home-space') && <img class="rr-card-img" src={thumbOf('home-space')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>住まいの広さ</h3>
          <p class="rr-card-desc">
            都道府県を選んで、1人あたりの畳の数や、持ち家と借家の部屋の数と畳の数、一戸建ての敷地の広さを見られます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（住宅・土地統計調査）</p>
          </div>
        </a>
        <a class="rr-card" href="/town-housing/">
          <img class="rr-card-img" src="/images/icon/town-housing-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>わが町の住まい</h3>
          <p class="rr-card-desc">
            市区町村を選んで、空き家率・持ち家率・1軒あたりの広さ・家賃をご覧いただけます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（2023年度）</p>
          </div>
        </a>
        <a class="rr-card" href="/town-house-age/">
          {thumbOf('town-house-age') && <img class="rr-card-img" src={thumbOf('town-house-age')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>わが町の家の建った年</h3>
          <p class="rr-card-desc">
            建った年代ごとの家の割合と、二重サッシや高齢者向けの設備がある家、耐震改修をした持ち家の割合を。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（住宅・土地統計調査）</p>
          </div>
        </a>
        <a class="rr-card" href="/town-landuse/">
          <img class="rr-card-img" src="/images/icon/town-landuse-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>わが町の土地の使われ方</h3>
          <p class="rr-card-desc">
            市区町村を選んで、住まい・商い・工場それぞれの土地がどれだけあるかをご覧いただけます。
            都市計画で定められた、町のかたちを数字で。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（2023年度）</p>
          </div>
        </a>
        <a class="rr-card" href="/land-price/">
          {thumbOf('land-price') && <img class="rr-card-img" src={thumbOf('land-price')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>土地の値段</h3>
          <p class="rr-card-desc">
            住宅地・商業地・工業地の、1平方メートルあたりの値段の移りかわりです。
          </p>
          <p class="rr-card-meta">都道府県</p>
          </div>
        </a>
      </div>
    </section>

    <section class="rr-group" aria-label="暮らしと家計">
      <h2 class="rr-group-title">暮らしと家計</h2>
      <div class="rr-grid">
        <a class="rr-card" href="/prices/">
          <img class="rr-card-img" src="/images/icon/prices-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>物価の帳場</h3>
          <p class="rr-card-desc">
            都道府県を選んで、食料・住居・光熱・教育など10の分類ごとに、値段の水準を全国平均＝100で並べます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（2013〜2024年）</p>
          </div>
        </a>
        <a class="rr-card" href="/household/">
          {thumbOf('household') && <img class="rr-card-img" src={thumbOf('household')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>家計の帳場</h3>
          <p class="rr-card-desc">
            県庁所在市の世帯の、1か月の収入と、食料から交通・通信まで支出の内訳、手取りのうち使った割合です。
          </p>
          <p class="rr-card-meta">都道府県</p>
          </div>
        </a>
        <a class="rr-card" href="/living/">
          {thumbOf('living') && <img class="rr-card-img" src={thumbOf('living')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>暮らしの見積所</h3>
          <p class="rr-card-desc">
            給与・最低賃金・家賃・家の広さ・持ち家率を、一枚の見積書に並べます。
          </p>
          <p class="rr-card-meta">都道府県</p>
          </div>
        </a>
        <a class="rr-card" href="/town-income/">
          {thumbOf('town-income') && <img class="rr-card-img" src={thumbOf('town-income')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>わが町の所得</h3>
          <p class="rr-card-desc">
            市区町村ごとに、住民税の課税対象になった所得を、納める人1人あたりで。人口に対する納める人の割合も。
          </p>
          <p class="rr-card-meta">市区町村</p>
          </div>
        </a>
        <a class="rr-card" href="/appliances/">
          {thumbOf('appliances') && <img class="rr-card-img" src={thumbOf('appliances')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>暮らしの道具</h3>
          <p class="rr-card-desc">
            都道府県を選んで、エアコン・電子レンジ・温水洗浄便座・自動車・オートバイ・ピアノの数を1000世帯あたりで。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（全国消費実態調査、2014年まで）</p>
          </div>
        </a>
        <a class="rr-card" href="/driving/">
          {thumbOf('driving') && <img class="rr-card-img" src={thumbOf('driving')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>運転免許とクルマの保険</h3>
          <p class="rr-card-desc">
            運転免許を持つ人の数と75歳以上の割合、任意の自動車保険の普及率、歩道橋や地下道の数を都道府県で。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（運転免許統計・損害保険料率算出機構ほか）</p>
          </div>
        </a>
        <a class="rr-card" href="/transport/">
          {thumbOf('transport') && <img class="rr-card-img" src={thumbOf('transport')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>乗りものと運ぶもの</h3>
          <p class="rr-card-desc">
            都道府県を選んで、JR・私鉄・バス・タクシー・飛行機・船に乗った人の数を1人あたりで。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（国土交通省の鉄道・航空・港湾・自動車の統計ほか）</p>
          </div>
        </a>
      </div>
    </section>

    <section class="rr-group" aria-label="働く・通う">
      <h2 class="rr-group-title">働く・通う</h2>
      <div class="rr-grid">
        <a class="rr-card" href="/work-style/">
          {thumbOf('work-style') && <img class="rr-card-img" src={thumbOf('work-style')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>働き方の帳場</h3>
          <p class="rr-card-desc">
            完全失業率と、正社員・パート・派遣の割合、65歳以上で働く人の割合、ハローワークで仕事を探した人と就職した人の割合です。
          </p>
          <p class="rr-card-meta">都道府県</p>
          </div>
        </a>
        <a class="rr-card" href="/work-forms/">
          {thumbOf('work-forms') && <img class="rr-card-img" src={thumbOf('work-forms')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>働き方のかたち</h3>
          <p class="rr-card-desc">
            自営業の人や仕事の種類ごとの割合、有効求人倍率、転職した人の割合、共働きの世帯です。
          </p>
          <p class="rr-card-meta">都道府県</p>
          </div>
        </a>
        <a class="rr-card" href="/town-work/">
          <img class="rr-card-img" src="/images/icon/town-work-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>わが町の仕事</h3>
          <p class="rr-card-desc">
            市区町村を選んで、田畑や海・ものづくり・お店やサービスで働く人の割合と、事業所や働く人の数を。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（国勢調査・経済センサス）</p>
          </div>
        </a>
        <a class="rr-card" href="/town-workplace/">
          {thumbOf('town-workplace') && <img class="rr-card-img" src={thumbOf('town-workplace')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>働きに出る町・来る町</h3>
          <p class="rr-card-desc">
            市区町村を選んで、町に住む人がどこで働いているかと、町の外から働きに来る人の割合を。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（国勢調査）</p>
          </div>
        </a>
        <a class="rr-card" href="/town-commute/">
          <img class="rr-card-img" src="/images/icon/town-commute-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>通勤の足は、何か</h3>
          <p class="rr-card-desc">
            市区町村を選んで、その町の人が主に何で通うのか（自家用車・公共交通の割合）をご覧いただけます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（2020年度）</p>
          </div>
        </a>
        <a class="rr-card" href="/town-commute-time/">
          <img class="rr-card-img" src="/images/icon/town-commute-time-thumb.webp" alt="" aria-hidden="true" width="560" height="315" loading="lazy" />
          <div class="rr-card-body">
          <h3>通勤に、どれだけかかるか</h3>
          <p class="rr-card-desc">
            市区町村を選んで、その町から通う人が片道にかける時間（30分未満・1時間以上・1時間30分以上の世帯割合）をご覧いただけます。
          </p>
          <p class="rr-card-meta">出典：社会・人口統計体系（2023年度）</p>
          </div>
        </a>
        <a class="rr-card" href="/time-use/">
          {thumbOf('time-use') && <img class="rr-card-img" src={thumbOf('time-use')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="rr-card-body">
          <h3>一日の使い方</h3>
          <p class="rr-card-desc">
