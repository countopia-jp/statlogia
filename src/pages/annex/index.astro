---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Talk from '../../components/Talk.astro';
import fs from 'node:fs';
import path from 'node:path';
// 窓口の扉絵の縮小版（public/images/icon/<窓口>-thumb.webp）。置いてあればカードに出す
const thumbOf = (slug) => (fs.existsSync(path.join(process.cwd(), 'public/images/icon', `${slug}-thumb.webp`)) ? `/images/icon/${slug}-thumb.webp` : null);
---
<BaseLayout title="町の出納帳｜Countopia Stats" description="財政や人の出入り、所得や家計、土地の値段や働き方など、お金と暮らしの内側に関わる数字をまとめた別館です。12の窓口があります。">
  <main class="rr">
    <header class="rr-hero">
      <img class="rr-figure" src="/images/icon/annex-large.webp" alt="障子窓の前の机に、開いた帳簿と硬貨、筆と硯、算盤が置かれた水彩画" width="1400" height="788" loading="lazy" />
      <p class="rr-kicker">別館</p>
      <h1>町の出納帳</h1>
      <p class="rr-lead">
        財政や人の出入り、所得や家計、土地の値段や働き方など、<br />お金と暮らしの内側に関わる数字です。<br />
        本館とは別に、出納帳としてここにまとめました。
      </p>
    </header>

    <Talk speaker="shiori">
      ようこそ、別館「町の出納帳」へ。昭和36年の市役所で、統計係をしている栞です。わたしたちBGは、毎日この帳簿とにらめっこなんですよ。
    </Talk>
    <Talk speaker="shiori">
      ここには、財政やひとの出入りなど、町の内側の数字の帳簿を綴じてあります。欄の名前をひとつずつ確かめながら、読んでいきましょうね。
    </Talk>
    <p class="rr-shiori-link"><a href="/annex/shiori/">別館の案内人・栞のこと →</a></p>

    <section class="rr-group" aria-label="県のお金">
      <h2 class="ledger-shelf">県のお金</h2>
      <div class="ledger-grid ledger-grid--4">
        <a class={`ledger-card${thumbOf('pref-spending') ? ' ledger-card--img' : ''}`} href="/pref-spending/">
          {thumbOf('pref-spending') && <img class="lc-img" src={thumbOf('pref-spending')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">支</span>
          <h3>県のお金の使いみち</h3>
          <p class="lc-desc">
            都道府県が1年に使ったお金と、福祉・教育・土木など使いみちごとの割合を。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('pref-revenue') ? ' ledger-card--img' : ''}`} href="/pref-revenue/">
          {thumbOf('pref-revenue') && <img class="lc-img" src={thumbOf('pref-revenue')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">入</span>
          <h3>県のお金の入り口</h3>
          <p class="lc-desc">
            都道府県の1年間の収入が、税・地方交付税・国からのお金・借り入れなど、どこから入ってきたかの割合を。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('pref-economy') ? ' ledger-card--img' : ''}`} href="/pref-economy/">
          {thumbOf('pref-economy') && <img class="lc-img" src={thumbOf('pref-economy')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">県</span>
          <h3>県のふところ</h3>
          <p class="lc-desc">
            県内総生産と県民所得、1人当たり県民所得と、その内訳をまとめた帳場です。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('education-budget') ? ' ledger-card--img' : ''}`} href="/education-budget/">
          {thumbOf('education-budget') && <img class="lc-img" src={thumbOf('education-budget')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">教</span>
          <h3>教育の帳場</h3>
          <p class="lc-desc">
            都道府県ごとの財政力指数と、教育費のかけ方をまとめた帳場です。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
      </div>
    </section>

    <section class="rr-group" aria-label="町のお金">
      <h2 class="ledger-shelf">町のお金</h2>
      <div class="ledger-grid">
        <a class={`ledger-card${thumbOf('town-spending') ? ' ledger-card--img' : ''}`} href="/town-spending/">
          {thumbOf('town-spending') && <img class="lc-img" src={thumbOf('town-spending')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">使</span>
          <h3>町のお金の使いみち</h3>
          <p class="lc-desc">
            市区町村が1年に使ったお金と、福祉・衛生・土木・消防など使いみちごとの割合を。
          </p>
          <span class="lc-foot">別館・市区町村</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('town-revenue') ? ' ledger-card--img' : ''}`} href="/town-revenue/">
          {thumbOf('town-revenue') && <img class="lc-img" src={thumbOf('town-revenue')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">納</span>
          <h3>町のお金の入り口</h3>
          <p class="lc-desc">
            市区町村の1年間の収入が、税・地方交付税・国や県からのお金・借り入れなど、どこから入ってきたかの割合を。
          </p>
          <span class="lc-foot">別館・市区町村</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('town-finance') ? ' ledger-card--img' : ''}`} href="/town-finance/">
          {thumbOf('town-finance') && <img class="lc-img" src={thumbOf('town-finance')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">財</span>
          <h3>わが町の財政と教育費</h3>
          <p class="lc-desc">
            市区町村ごとの財政力指数と、教育費のかけ方をまとめた数字です。
          </p>
          <span class="lc-foot">別館・市区町村</span>
          </div>
        </a>
      </div>
    </section>

    <section class="rr-group" aria-label="暮らしと人の動き">
      <h2 class="ledger-shelf">暮らしと人の動き</h2>
      <div class="ledger-grid ledger-grid--4">
        <a class={`ledger-card${thumbOf('household') ? ' ledger-card--img' : ''}`} href="/household/">
          {thumbOf('household') && <img class="lc-img" src={thumbOf('household')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">家</span>
          <h3>家計の帳場</h3>
          <p class="lc-desc">
            県庁所在市の世帯の、1か月の収入と、食料から交通・通信まで支出の内訳、手取りのうち使った割合です。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('work-style') ? ' ledger-card--img' : ''}`} href="/work-style/">
          {thumbOf('work-style') && <img class="lc-img" src={thumbOf('work-style')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">働</span>
          <h3>働き方の帳場</h3>
          <p class="lc-desc">
            完全失業率と、正社員・パート・派遣の割合、65歳以上で働く人の割合、ハローワークで仕事を探した人と就職した人の割合です。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('land-price') ? ' ledger-card--img' : ''}`} href="/land-price/">
          {thumbOf('land-price') && <img class="lc-img" src={thumbOf('land-price')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">地</span>
          <h3>土地の値段</h3>
          <p class="lc-desc">
            住宅地・商業地・工業地の、1平方メートルあたりの値段の移りかわりです。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('town-migration') ? ' ledger-card--img' : ''}`} href="/town-migration/">
          {thumbOf('town-migration') && <img class="lc-img" src={thumbOf('town-migration')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">人</span>
          <h3>わが町の人の出入り</h3>
          <p class="lc-desc">
            転入・転出の数字から、町の人の動きを追います。
          </p>
          <span class="lc-foot">別館・市区町村</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('pref-migration') ? ' ledger-card--img' : ''}`} href="/pref-migration/">
          {thumbOf('pref-migration') && <img class="lc-img" src={thumbOf('pref-migration')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">移</span>
          <h3>県の人の出入り</h3>
          <p class="lc-desc">
            引っ越してきた人・出ていった人とその差、自然増減率、海外へ出かけた日本人の数です。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
      </div>
    </section>

  </main>

  <style>
   .rr { max-width: 1280px; margin: 0 auto; padding: 0 16px 48px; }
    .rr-hero { text-align: center; padding: 28px 0 8px; }
    .rr-figure { display: block; width: 100%; max-width: 780px; height: auto; border-radius: 4px; margin: 0 auto 20px; }
    .rr-shiori-link { text-align: right; font-size: .85rem; margin: 4px 0 24px; }
    .rr-shiori-link a { color: #2c4a7a; }
    .rr-kicker { letter-spacing: 0.2em; font-size: 0.8rem; color: #2d6a4f; }
    .rr-hero h1 { margin: 4px 0 12px; font-family: "Shippori Mincho", serif; }
    .rr-lead { color: #555; line-height: 1.9; }
    .rr-group { margin: 0; padding: 20px 0 8px; }

    .ledger-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
      max-width: 1280px;
      margin: 0 auto;
    }

    .ledger-card {
      position: relative;
      display: block;
      padding: 24px 20px 20px 26px;
      border: 1px solid #B8C4B4;
      border-left: 4px solid #B3402A;
      border-radius: 4px;
      background-color: #FBFAF5;
      background-image: repeating-linear-gradient(
        180deg,
        transparent, transparent 27px,
        #DCE4DB 28px
      );
      color: inherit;
      text-decoration: none;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .ledger-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 14px rgba(27, 67, 50, 0.15);
    }
    /* 閲覧室一覧と同じ仕様：横長カード1段2枚、左に絵38%・右に文。1100px以下1列、600px以下は絵を上に */
    .ledger-grid, .ledger-grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    @media(max-width:1100px){ .ledger-grid, .ledger-grid--4{grid-template-columns:1fr} }
    @media(min-width:1101px){ .ledger-card{min-height:15.5rem} }
    .ledger-card--img { display: flex; gap: 18px; align-items: stretch; }
    .lc-img { flex: 0 0 38%; width: 38%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 4px; align-self: flex-start; }
    .lc-body { display: flex; flex-direction: column; flex: 1; min-width: 0; }
    .lc-body .lc-foot { margin-top: auto; }
    @media(max-width:600px){ .ledger-card--img{flex-direction:column} .lc-img{width:100%;flex-basis:auto} }
    .ledger-shelf {
      font-family: "Shippori Mincho", serif; font-weight: 800; font-size: 1.05rem;
      border-left: 4px solid #1b4332; padding-left: 10px; margin: 0 0 14px;
    }
    .lc-mark {
      position: absolute;
      top: 14px;
      right: 14px;
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1.5px solid #B3402A;
      border-radius: 50%;
      color: #B3402A;
      font-family: "Shippori Mincho", serif;
      font-weight: 800;
      font-size: 0.9rem;
      opacity: 0.75;
      transform: rotate(-8deg);
      background: #FBFAF5;
    }
    .ledger-card h3 {
      margin: 0 44px 10px 0;
      font-size: 1.15rem;
      font-family: "Shippori Mincho", serif;
    }
    .lc-desc {
      font-size: 0.9rem;
      line-height: 1.8;
      color: #444;
      margin: 0 0 14px;
    }
    .lc-foot {
      display: inline-block;
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      color: #4A6355;
      border-top: 1px dashed #B8C4B4;
      padding-top: 8px;
      width: 100%;
    }
  </style>
</BaseLayout>
