---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Talk from '../../components/Talk.astro';
import fs from 'node:fs';
import path from 'node:path';
import HeroFig from '../../components/HeroFig.astro';
// 窓口の扉絵の縮小版（public/images/icon/<窓口>-thumb.webp）。置いてあればカードに出す
const thumbOf = (slug) => (fs.existsSync(path.join(process.cwd(), 'public/images/icon', `${slug}-thumb.webp`)) ? `/images/icon/${slug}-thumb.webp` : null);
---
<BaseLayout title="暮らしの台帳｜Countopia Stats" description="財政や人の出入り、所得や家計、土地の値段や働き方、自然災害の被害など、お金と暮らしの内側に関わる数字をまとめた別館です。15の窓口があります。">
  <main class="rr">
    <HeroFig src="/images/icon/annex-large.webp" alt="昭和の市役所の書庫。札の下がった台帳の棚と鉄の書類キャビネット、壁の柱時計と窓辺の扇風機、机にしおりをはさんだ台帳と帳票、算盤、黒電話が置かれた水彩画" width={1400} height={788} eager>
        <p class="rr-kicker">別館</p>
        <h1>暮らしの台帳</h1>
        <p class="rr-lead">
          財政や人の出入り、所得や家計、土地の値段や働き方など、<br />お金と暮らしの内側に関わる数字です。<br />
          本館とは別に、台帳としてここに綴じました。
        </p>
    </HeroFig>

    <section class="rr-shiori" aria-label="案内人のことば">
      <div class="rr-shiori-say">
        <span class="rr-shiori-name">栞（昭和の帳場から来た子）</span>
        <p class="rr-shiori-bubble">ようこそ、別館「暮らしの台帳」へ。昭和36年の市役所で、統計係をしている栞です。わたしたちBGは、毎日この帳簿とにらめっこなんですよ。ここには、お金や働き方、ひとの出入りや災害など、暮らしの内側の数字の台帳を綴じてあります。欄の名前をひとつずつ確かめながら、読んでいきましょうね。</p>
        <p class="rr-shiori-link"><a href="/annex/shiori/">別館の案内人・栞のこと →</a></p>
      </div>
      <img class="rr-shiori-fig" src="/images/chara/shiori-point.webp" alt="帳簿を抱えて、手のひらで窓口のほうを示す栞" width="487" height="1100" loading="lazy" />
    </section>

    <section class="rr-group" aria-label="県のお金">
      <h2 class="ledger-shelf">県のお金</h2>
      <div class="ledger-grid ledger-grid--4">
        <a class={`ledger-card${thumbOf('pref-spending') ? ' ledger-card--img' : ''}`} href="/pref-spending/">
          {thumbOf('pref-spending') && <img class="lc-img" src={thumbOf('pref-spending')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">支</span>
          <h3>県のお金の使いみち</h3>
          <p class="lc-desc">
            都道府県が1年に使ったお金と、福祉・教育・土木など使いみちごとの割合を。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('pref-revenue') ? ' ledger-card--img' : ''}`} href="/pref-revenue/">
          {thumbOf('pref-revenue') && <img class="lc-img" src={thumbOf('pref-revenue')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">入</span>
          <h3>県のお金の入り口</h3>
          <p class="lc-desc">
            都道府県の1年間の収入が、税・地方交付税・国からのお金・借り入れなど、どこから入ってきたかの割合を。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('pref-economy') ? ' ledger-card--img' : ''}`} href="/pref-economy/">
          {thumbOf('pref-economy') && <img class="lc-img" src={thumbOf('pref-economy')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">県</span>
          <h3>県のふところ</h3>
          <p class="lc-desc">
            県内総生産と県民所得、1人当たり県民所得と、その内訳をまとめた帳場です。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('education-budget') ? ' ledger-card--img' : ''}`} href="/education-budget/">
          {thumbOf('education-budget') && <img class="lc-img" src={thumbOf('education-budget')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">教</span>
          <h3>教育の帳場</h3>
          <p class="lc-desc">
            都道府県ごとの財政力指数と、教育費のかけ方をまとめた帳場です。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
      </div>
    </section>

    <section class="rr-group" aria-label="町のお金">
      <h2 class="ledger-shelf">町のお金</h2>
      <div class="ledger-grid">
        <a class={`ledger-card${thumbOf('town-spending') ? ' ledger-card--img' : ''}`} href="/town-spending/">
          {thumbOf('town-spending') && <img class="lc-img" src={thumbOf('town-spending')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">使</span>
          <h3>町のお金の使いみち</h3>
          <p class="lc-desc">
            市区町村が1年に使ったお金と、福祉・衛生・土木・消防など使いみちごとの割合を。
          </p>
          <span class="lc-foot">別館・市区町村</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('town-revenue') ? ' ledger-card--img' : ''}`} href="/town-revenue/">
          {thumbOf('town-revenue') && <img class="lc-img" src={thumbOf('town-revenue')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">納</span>
          <h3>町のお金の入り口</h3>
          <p class="lc-desc">
            市区町村の1年間の収入が、税・地方交付税・国や県からのお金・借り入れなど、どこから入ってきたかの割合を。
          </p>
          <span class="lc-foot">別館・市区町村</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('town-finance') ? ' ledger-card--img' : ''}`} href="/town-finance/">
          {thumbOf('town-finance') && <img class="lc-img" src={thumbOf('town-finance')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">財</span>
          <h3>わが町の財政と教育費</h3>
          <p class="lc-desc">
            市区町村ごとの財政力指数と、教育費のかけ方をまとめた数字です。
          </p>
          <span class="lc-foot">別館・市区町村</span>
          </div>
        </a>
      </div>
    </section>

    <section class="rr-group" aria-label="暮らしと稼ぎ">
      <h2 class="ledger-shelf">暮らしと稼ぎ</h2>
      <div class="ledger-grid ledger-grid--4">
        <a class={`ledger-card${thumbOf('household') ? ' ledger-card--img' : ''}`} href="/household/">
          {thumbOf('household') && <img class="lc-img" src={thumbOf('household')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">家</span>
          <h3>家計の帳場</h3>
          <p class="lc-desc">
            県庁所在市の世帯の、1か月の収入と、食料から交通・通信まで支出の内訳、手取りのうち使った割合です。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('living') ? ' ledger-card--img' : ''}`} href="/living/">
          {thumbOf('living') && <img class="lc-img" src={thumbOf('living')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">見</span>
          <h3>暮らしの見積所</h3>
          <p class="lc-desc">
            給与・最低賃金・家賃・家の広さ・持ち家率を、一枚の見積書に並べます。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('land-price') ? ' ledger-card--img' : ''}`} href="/land-price/">
          {thumbOf('land-price') && <img class="lc-img" src={thumbOf('land-price')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">地</span>
          <h3>土地の値段</h3>
          <p class="lc-desc">
            住宅地・商業地・工業地の、1平方メートルあたりの値段の移りかわりです。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
      </div>
    </section>

    <section class="rr-group" aria-label="働く">
      <h2 class="ledger-shelf">働く</h2>
      <div class="ledger-grid ledger-grid--4">
        <a class={`ledger-card${thumbOf('work-style') ? ' ledger-card--img' : ''}`} href="/work-style/">
          {thumbOf('work-style') && <img class="lc-img" src={thumbOf('work-style')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">働</span>
          <h3>働き方の帳場</h3>
          <p class="lc-desc">
            完全失業率と、正社員・パート・派遣の割合、65歳以上で働く人の割合、ハローワークで仕事を探した人と就職した人の割合です。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('work-forms') ? ' ledger-card--img' : ''}`} href="/work-forms/">
          {thumbOf('work-forms') && <img class="lc-img" src={thumbOf('work-forms')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">職</span>
          <h3>働き方のかたち</h3>
          <p class="lc-desc">
            自営業の人や仕事の種類ごとの割合、有効求人倍率、転職した人の割合、共働きの世帯です。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
      </div>
    </section>

    <section class="rr-group" aria-label="人の動きと災害">
      <h2 class="ledger-shelf">人の動きと災害</h2>
      <div class="ledger-grid ledger-grid--4">
        <a class={`ledger-card${thumbOf('town-migration') ? ' ledger-card--img' : ''}`} href="/town-migration/">
          {thumbOf('town-migration') && <img class="lc-img" src={thumbOf('town-migration')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">人</span>
          <h3>わが町の人の出入り</h3>
          <p class="lc-desc">
            転入・転出の数字から、町の人の動きを追います。
          </p>
          <span class="lc-foot">別館・市区町村</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('pref-migration') ? ' ledger-card--img' : ''}`} href="/pref-migration/">
          {thumbOf('pref-migration') && <img class="lc-img" src={thumbOf('pref-migration')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">移</span>
          <h3>県の人の出入り</h3>
          <p class="lc-desc">
            引っ越してきた人・出ていった人とその差、自然増減率、海外へ出かけた日本人の数です。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
        <a class={`ledger-card${thumbOf('disaster') ? ' ledger-card--img' : ''}`} href="/disaster/">
          {thumbOf('disaster') && <img class="lc-img" src={thumbOf('disaster')} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
          <div class="lc-body">
          <span class="lc-mark">災</span>
          <h3>自然災害の帳場</h3>
          <p class="lc-desc">
            自然災害の被害額・水につかった建物・被害を受けた世帯と人の数を、年ごとに。
          </p>
          <span class="lc-foot">別館・都道府県</span>
          </div>
        </a>
      </div>
    </section>

  </main>

  <style>
   .rr { max-width: 1280px; margin: 0 auto; padding: 0 16px 48px; }
    .rr-hero { text-align: center; padding: 28px 0 8px; }
    .rr-figure { display: block; width: 100%; max-width: 780px; height: auto; border-radius: 4px; margin: 0 auto 20px; }
    .rr-shiori { display: flex; align-items: center; justify-content: center; gap: 8px; max-width: 980px; margin: 8px auto 28px; }
    .rr-shiori-say { flex: 1; min-width: 0; }
    .rr-shiori-name { display: block; font-family: "IBM Plex Mono", monospace; font-size: .62rem; letter-spacing: .12em; color: #2c4a7a; margin-bottom: 4px; }
    .rr-shiori-bubble { position: relative; background: #e3eef7; color: #222; border-radius: 12px; padding: 18px 22px; font-size: 1.02rem; line-height: 1.95; margin: 0; }
    .rr-shiori-bubble::after { content: ""; position: absolute; top: 40%; right: -8px; border: 8px solid transparent; border-right: 0; border-left-color: #e3eef7; }
    .rr-shiori-link { text-align: right; font-size: .85rem; margin: 10px 0 0; }
    .rr-shiori-link a { color: #2c4a7a; }
    .rr-shiori-fig { flex: none; width: auto; height: 400px; display: block; }
    /* 10-18 上下の空白を詰める（全体の section の余白56pxを打ち消す） */
    .rr-shiori { padding: 12px 0 0; margin-bottom: 4px; }
    @media (max-width: 900px) {
      .rr-shiori { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 12px 10px; }
      .rr-shiori-fig { height: 380px; }
    }
    /* 10-18 タブレット：栞の手先が吹き出しの角に来るように */
    @media (min-width: 601px) and (max-width: 900px) {
      .rr-shiori-say { align-self: start; margin-top: 72px; }
      .rr-shiori-fig { align-self: start; margin-left: -14px; position: relative; z-index: 1; }
    }
    @media (max-width: 600px) {
      .rr-shiori { gap: 10px 4px; }
      .rr-shiori-fig { height: 252px; }
      .rr-shiori-bubble { font-size: .9rem; padding: 12px 14px; }
    }
    .rr-kicker { letter-spacing: 0.2em; font-size: 0.8rem; color: #2d6a4f; }
    .rr-hero h1 { margin: 4px 0 12px; font-family: "Shippori Mincho", serif; }
    .rr-lead { color: #555; line-height: 1.9; }
    .rr-group { margin: 0; padding: 20px 0 8px; }
    /* 10-18 扉絵を上に大きく置き、題と説明を白いもやの上に重ねる */
    .rr-hero--fig { position: relative; max-width: 868px; margin: 20px auto 8px; padding: 0; }
    .rr-hero-img { display: block; width: 100%; height: auto; border-radius: 8px; box-shadow: 0 6px 18px rgba(60,40,20,.14); }
    .rr-hero-text { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(72%, 640px); padding: 22px 30px 18px; text-align: center; border-radius: 14px;
      background: radial-gradient(ellipse at center, rgba(255,253,247,.94) 0%, rgba(255,253,247,.86) 55%, rgba(255,253,247,.62) 100%);
      box-shadow: 0 0 40px 26px rgba(255,253,247,.55); -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); }
    .rr-hero-text .rr-kicker { margin: 0; }
    .rr-hero-text h1 { margin: 2px 0 8px; font-size: clamp(1.5rem, 3.2vw, 2.2rem); color: #3a2a1a; }
    .rr-hero-text .rr-lead { margin: 0; color: #3d3528; font-size: clamp(.82rem, 1.5vw, .98rem); line-height: 1.85; }
    @media (max-width: 760px) {
      .rr-hero-text { position: relative; left: auto; top: auto; transform: none; width: auto; margin: -36px 12px 0; padding: 16px 16px 12px; box-shadow: 0 4px 14px rgba(60,40,20,.12); background: rgba(255,253,247,.96); }
      .rr-hero-text .rr-lead br { display: none; }
    }

    .ledger-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
      max-width: 1280px;
      margin: 0 auto;
    }

    .ledger-card {
      position: relative;
      display: block;
      padding: 24px 20px 20px 26px;
      border: 1px solid #B8C4B4;
      border-left: 4px solid #B3402A;
      border-radius: 4px;
      background-color: #FBFAF5;
      background-image: repeating-linear-gradient(
        180deg,
        transparent, transparent 27px,
        #DCE4DB 28px
      );
      color: inherit;
      text-decoration: none;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .ledger-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 14px rgba(27, 67, 50, 0.15);
    }
    /* 閲覧室一覧と同じ仕様：横長カード1段2枚、左に絵38%・右に文。1100px以下1列、600px以下は絵を上に */
    .ledger-grid, .ledger-grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    @media(max-width:1100px){ .ledger-grid, .ledger-grid--4{grid-template-columns:1fr} }
    @media(min-width:1101px){ .ledger-card{min-height:15.5rem} }
    .ledger-card--img { display: flex; gap: 18px; align-items: stretch; }
    .lc-img { flex: 0 0 38%; width: 38%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 4px; align-self: flex-start; }
    .lc-body { display: flex; flex-direction: column; flex: 1; min-width: 0; }
    .lc-body .lc-foot { margin-top: auto; }
    @media(max-width:600px){ .ledger-card--img{flex-direction:column} .lc-img{width:100%;flex-basis:auto} }
    .ledger-shelf {
      font-family: "Shippori Mincho", serif; font-weight: 800; font-size: 1.05rem;
      border-left: 4px solid #1b4332; padding-left: 10px; margin: 0 0 14px;
    }
    .lc-mark {
      position: absolute;
      top: 14px;
      right: 14px;
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1.5px solid #B3402A;
      border-radius: 50%;
      color: #B3402A;
      font-family: "Shippori Mincho", serif;
      font-weight: 800;
      font-size: 0.9rem;
      opacity: 0.75;
      transform: rotate(-8deg);
      background: #FBFAF5;
    }
    .ledger-card h3 {
      margin: 0 44px 10px 0;
      font-size: 1.15rem;
      font-family: "Shippori Mincho", serif;
    }
    .lc-desc {
      font-size: 0.9rem;
      line-height: 1.8;
      color: #444;
      margin: 0 0 14px;
    }
    .lc-foot {
      display: inline-block;
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      color: #4A6355;
      border-top: 1px dashed #B8C4B4;
      padding-top: 8px;
      width: 100%;
    }
  </style>
</BaseLayout>
