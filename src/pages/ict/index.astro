---
// =====================================================
// Statlogia - 学校情報化ダッシュボード「情報化の帳場」
// src/pages/ict/index.astro
//
// 都道府県を選んで、学校のICT整備（小中高）を見る窓口。
// データは /data/ict.json（ビルド時生成）から取得。
// ※スタイルは is:global（JS生成要素にスコープCSSが効かないため）。
//   誤爆防止で全セレクタを .ict- 接頭辞で統一している。
// =====================================================
import BaseLayout from '../../layouts/BaseLayout.astro';
import Talk from '../../components/Talk.astro';
import CompareAddon from '../../components/CompareAddon.astro';
import { getIctData } from '../../lib/ict.js';
import HeroFig from '../../components/HeroFig.astro';

const ict = await getIctData();
const years = [...new Set(ict.indicators.map((i) => i.year).filter(Boolean))].sort();
const yearNote = years.join('・');
import GrowthTool from '../../components/GrowthTool.astro';
---

<BaseLayout title="情報化の帳場｜学校のデジタル化｜Statlogia" description="都道府県を選んで、学校の学習用パソコン・大型提示装置・デジタル教科書の整備状況を小・中・高ごとに、以前の調査の電子黒板などとあわせてご覧いただける窓口。" backHref="/dashboard/" backLabel="閲覧室">
  <main class="ict-dash">
    <HeroFig src="/images/icon/ict-large.webp" alt="古い帳場机に並ぶ、タブレット端末・電子黒板・デジタル教科書と算盤や筆" width={1400} height={788}>
      <p class="ict-kicker">閲覧室｜学校と学び</p>
      <h1>情報化の帳場</h1>
      <p class="ict-lead">
        学習用のパソコン、大きな画面、デジタル教科書。<br />
        あなたの県の学校に、どんな機器がそろっているかをご覧ください。
      </p>
    </HeroFig>

    <Talk speaker="chiaki">
      ここでは、学校のデジタル化を小・中・高それぞれで見る。GIGAスクールを経て、教室の風景はずいぶん変わった。
    </Talk>
    <Talk speaker="hitoha">
      わたしのころは、まだ黒板にチョークでした。
    </Talk>

    <!-- ===== 都道府県セレクタ ===== -->
    <section class="ict-selector" aria-label="都道府県の選択">
      <label>
        <span>都道府県</span>
        <select id="prefSelect">
          <option value="">選んでください</option>
        </select>
      </label>
    </section>

    <!-- ===== 選択結果 ===== -->
    <section id="resultArea" class="ict-result" hidden aria-live="polite">
      <h2 id="resultTitle"></h2>
      <div id="groupArea"></div>

      <div class="ict-line-wrap">
        <p class="ict-line-title">端末整備の推移（小学校・1台当たり児童数）</p>
        <canvas id="pcLineChart" data-growth="level" height="120"></canvas>
        <p class="ict-line-note">※教育用コンピュータ1台を何人で使っているか。右肩下がりは、1台あたりの児童数が減ったことを表します（この数え方は2022年度まで）</p>
      </div>

      <Talk speaker="chiaki"><span id="keiLine">県を選ぶと、帳面を出そう。</span></Talk>
      <Talk speaker="hitoha"><span id="toukoLine">どんな教室でしょうか。</span></Talk>
    </section>

    <CompareAddon level="pref" selectId="prefSelect" src="/data/ict.json" />

    <!-- ===== 散布図 ===== -->
    <section class="ict-scatter-sec" aria-label="大型提示装置とデジタル教科書の散布図">
      <h2>教室の機器 見取り図</h2>
      <p class="ict-note">横軸が大型提示装置のある普通教室の割合、縦軸がデジタル教科書の整備率（どちらも小学校）。右へ行くほど大きな画面のある教室が多く、上へ行くほどデジタル教科書の整備率が高い県です。</p>
      <div class="ict-chart-wrap">
        <canvas id="scatterChart" height="260"></canvas>
      </div>
    </section>

    <!-- ===== ランキング ===== -->
    <section class="ict-ranking" aria-label="ランキング">
      <h2>全国ベスト5</h2>
      <div class="ict-tabs" role="tablist">
        <button class="ict-tab is-active" data-rank="display" role="tab">大型提示装置が多い</button>
        <button class="ict-tab" data-rank="text" role="tab">デジタル教科書が多い</button>
        <button class="ict-tab" data-rank="pc1" role="tab">1人あたりのPCが多い</button>
      </div>
      <ol class="ict-rank-list" id="rankList"></ol>
      <p class="ict-note" id="rankNote"></p>
    </section>

    <Talk speaker="chiaki">
      学習用のパソコン、大型提示装置、デジタル教科書は、それぞれ別の調査の項目だ。県ごとの数字を、カードで見たまえ。
    </Talk>
    <Talk speaker="hitoha">
      同じ日本でも、教室の景色はずいぶん違うんですね。
    </Talk>

    <p class="ict-cross">あわせて見る：<a href="/education/">学びの登記所</a>｜<a href="/education-budget/">教育の帳場</a></p>

    <footer class="ict-source">
      <p>
        出典：{ict.source}（{yearNote}）<br />
        指標によって調査年度が異なります。各カードに年度を明記しています。<br />
        「1台あたりの児童生徒数」は、教育用のコンピュータ1台を何人で使っているかを表します（2022年度まで）。2023年度からは「1人あたりの学習用PCの台数」で数えています。<br />
        「大型提示装置」は、電子黒板・大型テレビ・プロジェクターなどの大きな画面です。電子黒板だけの整備率は2017年度までの調査です。<br />
        「平均」は47都道府県の単純平均であり、全国値とは一致しません。<br />
        このページはe-Stat APIで取得した統計データを独自に加工して作成しています。
      </p>
    </footer>
  </main>

  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <script is:inline>
    (async function () {
      const res = await fetch('/data/ict.json');
      const data = await res.json();
      const IND = data.indicators;
      const idx = Object.fromEntries(IND.map((ind, i) => [ind.code, i]));
      const meta = Object.fromEntries(IND.map((ind) => [ind.code, ind]));
      const val = (area, code) => area.v[idx[code]];

      // 3グループ×小中高。dir は「良い方向」（pcだけ少ないほど良い＝asc）
      const GROUPS = [
        {
          title: '1人あたりの学習用PC', note: '児童生徒1人あたりの学習用PCの台数。', dir: 'desc',
          items: [
            { code: 'E9404', school: '小学校' },
            { code: 'E9405', school: '中学校' },
            { code: 'E9406', school: '高等学校' },
          ],
        },
        {
          title: '大型提示装置', note: '普通教室のうち、電子黒板・大型テレビ・プロジェクターなどの大きな画面がある教室の割合。', dir: 'desc',
          items: [
            { code: 'E9417', school: '小学校' },
            { code: 'E9418', school: '中学校' },
            { code: 'E9419', school: '高等学校' },
          ],
        },
        {
          title: 'デジタル教科書', note: 'デジタル教科書の整備率。', dir: 'desc',
          items: [
            { code: 'E9421', school: '小学校' },
            { code: 'E9422', school: '中学校' },
            { code: 'E9423', school: '高等学校' },
          ],
        },
      ];
      // 以前の調査の数字（カードには出さず、下の表に年つきで出す）
      const OLD = [
        { code: 'E9414', label: '電子黒板の整備率（小学校）' },
        { code: 'E9415', label: '電子黒板の整備率（中学校）' },
        { code: 'E9416', label: '電子黒板の整備率（高等学校）' },
        { code: 'E9401', label: '教育用コンピュータ1台あたりの児童数（小学校）' },
        { code: 'E9402', label: '教育用コンピュータ1台あたりの生徒数（中学校）' },
        { code: 'E9403', label: '教育用コンピュータ1台あたりの生徒数（高等学校）' },
      ];

      function fmtValue(code, v) {
        if (v === null || v === undefined) return '—';
        const unit = meta[code].unit || '';
        if (unit === '%' || unit === '％') return v.toFixed(1) + '％';
        if (unit === '人') return v.toFixed(1) + '人';
        return v.toLocaleString('ja-JP') + unit;
      }

      // 指標ごとの平均・順位（dirは各グループの「良い方向」）
      const dirByCode = {};
      for (const g of GROUPS) for (const it of g.items) dirByCode[it.code] = g.dir;

      const stats = {};
      for (const g of GROUPS) {
        for (const it of g.items) {
          const code = it.code;
          const rows = data.areas
            .filter((a) => val(a, code) !== null)
            .sort((x, y) =>
              g.dir === 'desc' ? val(y, code) - val(x, code) : val(x, code) - val(y, code)
            );
          const avg = rows.reduce((s, a) => s + val(a, code), 0) / rows.length;
          stats[code] = {
            avg,
            rank: Object.fromEntries(rows.map((a, i) => [a.c, i + 1])),
            total: rows.length,
          };
        }
      }

      // ---- セレクタ ----
      const prefSelect = document.getElementById('prefSelect');
      for (const a of data.areas) {
        const opt = document.createElement('option');
        opt.value = a.c;
        opt.textContent = a.n;
        prefSelect.appendChild(opt);
      }
      prefSelect.addEventListener('change', () => {
        const area = data.areas.find((a) => a.c === prefSelect.value);
        if (area) render(area);
      });

      // ---- 端末整備の推移（折れ線） ----
      let pcLineChart = null;
      function renderPcLine(area) {
        const wrap = document.querySelector('.ict-line-wrap');
        if (!area.series || area.series.length === 0) {
          wrap.hidden = true;
          return;
        }
        wrap.hidden = false;
        const ctx = document.getElementById('pcLineChart');
        if (pcLineChart) pcLineChart.destroy();
        pcLineChart = new Chart(ctx, {
          type: 'line',
          data: {
            labels: area.series.map((p) => p.year),
            datasets: [{
              label: '1台当たり児童数',
              data: area.series.map((p) => p.value),
              borderColor: '#1b4332',
              backgroundColor: '#1b433222',
              tension: 0.2,
              fill: true,
            }],
          },
          options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { ticks: { callback: (v) => v.toFixed(1) + '人' } } },
          },
        });
      }

      // ---- カード描画（グループごと） ----
      function render(area) {
        document.getElementById('resultArea').hidden = false;
        document.getElementById('resultTitle').textContent = `${area.n}の帳面`;

        const wrap = document.getElementById('groupArea');
        wrap.innerHTML = '';
        for (const g of GROUPS) {
          const sec = document.createElement('div');
          sec.className = 'ict-group';
          sec.innerHTML = `<div class="ict-group-head"><h3>${g.title}</h3><p>${g.note}</p></div>`;

          const grid = document.createElement('div');
          grid.className = 'ict-cards';
          for (const it of g.items) {
            const v = val(area, it.code);
            const st = stats[it.code];
            const rank = st.rank[area.c];
            const card = document.createElement('div');
            card.className = 'ict-card';
            card.innerHTML =
              `<div class="ict-card-label">${it.school}</div>` +
              `<div class="ict-card-num">${fmtValue(it.code, v)}</div>` +
              `<div class="ict-card-sub">${meta[it.code].year || ''}</div>` +
              (v === null || v === undefined || !rank
                ? ''
                : `<div class="ict-card-meta"><span class="ict-rank">${st.total}県中 ${rank}位</span></div>`);
            grid.appendChild(card);
          }
          sec.appendChild(grid);
          wrap.appendChild(sec);
        }

        const old = document.createElement('div');
        old.className = 'ict-old';
        old.innerHTML = '<h3>以前の調査の数字</h3><p>いまは数え方が変わったり、調べられなくなったりした数字です。</p><table>' +
          OLD.map((o) => `<tr><th>${o.label}</th><td>${fmtValue(o.code, val(area, o.code))}</td><td class="ict-old-year">${meta[o.code].year || ''}</td></tr>`).join('') +
          '</table>';
        wrap.appendChild(old);

        renderPcLine(area);
        updateLines(area);
        highlightScatter(area);
      }

      // ---- 案内人コメント ----
      function updateLines(area) {
        const kei = document.getElementById('keiLine');
        const toukoEl = document.getElementById('toukoLine');
        // 一葉の一言は順位に反応しない。数字への気づきを一つ（知秋の文から1行を選ぶ）
        const TOUKO_LINES = ['1人1台が、もう当たり前なんですね。', '大型提示装置の整備率は、県でずいぶん違うんですね。', 'デジタル教科書は、まだこれからなんですね。'];
        const dRank = stats['E9417'].rank[area.c];
        const tRank = stats['E9421'].rank[area.c];
        const hasD = typeof dRank === 'number';
        const hasT = typeof tRank === 'number';
        const k = '小学校で見ると、' +
          (hasD ? `大型提示装置のある教室の割合は${stats['E9417'].total}県中${dRank}位、` : '大型提示装置は、この県の値がありません。') +
          (hasT ? `デジタル教科書の整備率は${stats['E9421'].total}県中${tRank}位です。` : 'デジタル教科書は、この県の値がありません。');
        kei.textContent = k;
        if (!hasD || !hasT) { toukoEl.textContent = '値のない欄もあるんですね。'; return; }
        let h = 0;
        for (const ch of k) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
        toukoEl.textContent = TOUKO_LINES[h % TOUKO_LINES.length];
      }

      // ---- 散布図（大型提示装置×デジタル教科書・小学校） ----
      let chart = null;
      let selectedCode = null;

      function buildScatter() {
        const points = data.areas
          .filter((a) => val(a, 'E9417') !== null && val(a, 'E9421') !== null)
          .map((a) => ({ x: val(a, 'E9417'), y: val(a, 'E9421'), n: a.n, c: a.c }));

        const ctx = document.getElementById('scatterChart');
        chart = new Chart(ctx, {
          type: 'scatter',
          data: {
            datasets: [
              {
                label: '都道府県',
                data: points,
                pointRadius: (c) => (c.raw && c.raw.c === selectedCode ? 8 : 4),
                pointBackgroundColor: (c) =>
                  c.raw && c.raw.c === selectedCode ? '#b23a2f' : '#2d6a4f88',
                pointBorderColor: (c) =>
                  c.raw && c.raw.c === selectedCode ? '#b23a2f' : '#2d6a4f',
              },
            ],
          },
          options: {
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: (c) =>
                    `${c.raw.n}：大型提示装置 ${c.raw.x.toFixed(1)}％ / デジタル教科書 ${c.raw.y.toFixed(1)}％`,
                },
              },
            },
            scales: {
              x: { title: { display: true, text: '大型提示装置のある教室の割合（小学校・％）' } },
              y: { title: { display: true, text: 'デジタル教科書整備率（小学校・％）' } },
            },
            responsive: true,
            maintainAspectRatio: false,
          },
        });
      }

      function highlightScatter(area) {
        selectedCode = area.c;
        if (chart) chart.update();
      }

      buildScatter();

      // ---- ランキング ----
      const RANKS = {
        display: { code: 'E9417', dir: 'desc', note: '普通教室のうち大型提示装置がある教室の割合が高い県ベスト5（小学校）。' },
        text: { code: 'E9421', dir: 'desc', note: 'デジタル教科書の整備率が高い県ベスト5（小学校）。' },
        pc1: { code: 'E9404', dir: 'desc', note: '児童1人あたりの学習用PCの台数が多い県ベスト5（小学校）。' },
      };

      const rankList = document.getElementById('rankList');
      const rankNote = document.getElementById('rankNote');

      function showRank(mode) {
        const cfg = RANKS[mode];
        rankList.innerHTML = '';
        const rows = data.areas
          .filter((a) => val(a, cfg.code) !== null)
          .sort((x, y) =>
            cfg.dir === 'desc' ? val(y, cfg.code) - val(x, cfg.code) : val(x, cfg.code) - val(y, cfg.code)
          )
          .slice(0, 5);
        for (const a of rows) {
          const li = document.createElement('li');
          li.innerHTML =
            `<span class="ict-rank-name">${a.n}</span>` +
            `<span class="ict-rank-val">${fmtValue(cfg.code, val(a, cfg.code))}</span>`;
          li.addEventListener('click', () => {
            prefSelect.value = a.c;
            prefSelect.dispatchEvent(new Event('change'));
          });
          rankList.appendChild(li);
        }
        rankNote.textContent = cfg.note;
      }

      document.querySelectorAll('.ict-tab').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.ict-tab').forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          showRank(btn.dataset.rank);
        });
      });

      showRank('display');
    })();
  </script>

  <style is:global>
    .ict-dash { max-width: 860px; margin: 0 auto; padding: 0 16px 48px; }
    .ict-hero { text-align: center; padding: 32px 0 8px; }
    .ict-hero-figure { display: block; width: 100%; max-width: 780px; height: auto; border-radius: 4px; margin: 0 auto 20px; }
    .ict-kicker { font-family: "IBM Plex Mono", monospace; font-size: .74rem; letter-spacing: .22em; font-weight: 600; color: var(--stamp); margin: 0; }
    .ict-hero h1 { margin: 4px 0 12px; font-family: "Shippori Mincho", serif; font-weight: 800; }
    .ict-lead { color: #555; line-height: 1.9; }

    .ict-selector { margin: 24px 0; display: flex; justify-content: center; }
    .ict-selector label { display: flex; flex-direction: column; gap: 6px; font-size: 0.85rem; }
    .ict-selector select {
      min-width: 240px; padding: 10px 12px; border: 1px solid #1b4332;
      border-radius: 6px; background: #fff; font-size: 1rem;
    }

    .ict-result h2 { text-align: center; margin: 24px 0 16px; font-family: "Shippori Mincho", serif; }
    .ict-group { margin-bottom: 22px; }
    .ict-group-head { text-align: center; margin-bottom: 10px; }
    .ict-group-head h3 { margin: 0; font-family: "Shippori Mincho", serif; font-size: 1.05rem; }
    .ict-group-head p { margin: 2px 0 0; font-size: 0.75rem; color: #888; }
    .ict-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    @media (max-width: 560px) { .ict-cards { grid-template-columns: 1fr; } }
    .ict-card {
      border: 1px solid #e0e0d8; border-radius: 8px; padding: 14px;
      background: #fff; text-align: center;
    }
    .ict-card-label { font-size: 0.78rem; color: #2d6a4f; letter-spacing: 0.08em; }
    .ict-card-num {
      font-family: "IBM Plex Mono", monospace; font-size: 1.4rem;
      font-weight: 700; margin: 6px 0 2px; color: #1b4332;
    }
    .ict-card-sub { font-size: 0.7rem; color: #999; }
    .ict-card-meta { margin-top: 6px; font-size: 0.75rem; }
    .ict-rank { color: #b23a2f; font-weight: 700; }

    .ict-old { margin: 8px 0 22px; padding: 14px 16px; border: 1px dashed #cfcab8; border-radius: 8px; background: #fbfaf5; }
    .ict-old h3 { margin: 0; font-family: "Shippori Mincho", serif; font-size: 0.95rem; text-align: center; color: #555; }
    .ict-old p { margin: 2px 0 10px; font-size: 0.72rem; color: #888; text-align: center; }
    .ict-old table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
    .ict-old th { text-align: left; font-weight: 400; color: #444; padding: 6px 4px; border-top: 1px solid #e6e2d4; }
    .ict-old td { text-align: right; padding: 6px 4px; border-top: 1px solid #e6e2d4; white-space: nowrap; font-family: "IBM Plex Mono", monospace; }
    .ict-old td.ict-old-year { color: #999; font-family: inherit; font-size: 0.72rem; width: 5.5em; }
    .ict-line-wrap {
      margin: 24px 0 8px; padding: 16px; border: 1px solid #e0e0d8;
      border-radius: 8px; background: #fff;
    }
    .ict-line-title {
      font-size: 0.8rem; color: #2d6a4f; letter-spacing: 0.06em;
      margin: 0 0 10px; text-align: center;
    }
    .ict-line-note {
      font-size: 0.72rem; color: #888; text-align: center;
      margin: 10px 0 0;
    }

    .ict-scatter-sec { margin-top: 44px; }
    .ict-scatter-sec h2 { text-align: center; font-family: "Shippori Mincho", serif; }
    .ict-chart-wrap { position: relative; height: 300px; margin: 16px 0 8px; }
    .ict-note { font-size: 0.8rem; color: #666; text-align: center; line-height: 1.8; }

    .ict-ranking { margin-top: 44px; }
    .ict-ranking h2 { text-align: center; font-family: "Shippori Mincho", serif; }
    .ict-tabs { display: flex; gap: 8px; justify-content: center; margin: 12px 0 16px; flex-wrap: wrap; }
    .ict-tab {
      padding: 8px 16px; border: 1px solid #1b4332; border-radius: 999px;
      background: #fff; cursor: pointer; font-size: 0.85rem;
    }
    .ict-tab.is-active { background: #1b4332; color: #fff; }
    .ict-rank-list {
      list-style: none; counter-reset: rank; padding: 8px 20px;
      max-width: 560px; margin: 0 auto 8px;
      border: 1px solid #e0e0d8; border-radius: 8px; background: #fdfdf8;
