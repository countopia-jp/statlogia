---
// =====================================================
// Statlogia - 日々のイラスト集（/gallery/chiaki/ ・ /gallery/hitoha/）
// 研究員紹介ページの絵をクリックするとここに来る。中身は src/data/gallery.js
// =====================================================
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PEOPLE, galleryOf } from '../../../data/gallery.js';
import Talk from '../../../components/Talk.astro';

export function getStaticPaths() {
  return Object.keys(PEOPLE).map((who) => ({ params: { who } }));
}
const { who } = Astro.params;
const p = PEOPLE[who];
const items = galleryOf(who);
---
<BaseLayout title={`${p.title}｜Statlogia`} description={`${p.name}の日々のイラスト集。${p.lead}`} backHref="/gallery/" backLabel="イラスト集">
  <main class="gl">
    <header class="gl-hero">
      <p class="gl-kicker">GALLERY ｜ {p.romaji}</p>
      <h1>{p.title}</h1>
      <p class="gl-lead">{p.lead}</p>
    </header>

    {items.length === 0 ? (
      <p class="gl-empty">まだ一枚もありません。</p>
    ) : (
      <ol class="gl-list">
        {items.map((g) => (
          <li class={`gl-item ${g.h > g.w ? 'gl-item--tall' : ''}`}>
            <figure>
              <img src={`/images/chara/${g.file}`} alt={`${p.name}：${g.title}。${g.caption}`} width={g.w} height={g.h} loading="lazy" />
              <figcaption>
                <b>{g.title}</b>
                <span>{g.caption}</span>
              </figcaption>
            </figure>
            {g.talk && (
              <div class="gl-talk">
                {g.talk.map(([sp, text]) => <Talk speaker={sp}>{text}</Talk>)}
              </div>
            )}
          </li>
        ))}
      </ol>
    )}

    <p class="gl-foot"><a href="/gallery/">イラスト集の入口へ →</a>｜<a href="/guide/">研究員の紹介へ →</a>｜<a href={`/gallery/${who === 'chiaki' ? 'hitoha' : 'chiaki'}/`}>{who === 'chiaki' ? '一葉' : '知秋'}の日々へ →</a></p>
  </main>
  <script>
    // 絵をタップしたら一度だけ揺れる（連打しても最初から揺れ直す）
    document.querySelectorAll('.gl-item figure').forEach((f) => {
      f.addEventListener('click', () => {
        f.classList.remove('is-wobble');
        void f.offsetWidth;
        f.classList.add('is-wobble');
      });
      f.addEventListener('animationend', () => f.classList.remove('is-wobble'));
    });
  </script>
  <style>
    .gl { max-width: 1040px; margin: 0 auto; padding: 0 16px 56px; }
    /* 絵に添える二人の会話（gallery.js の talk） */
    .gl-talk { margin: 10px 18px 0; padding: 12px 0 2px; border-top: 1px dashed #D9D4C7; }
    .gl-talk :global(.say) { margin-top: 8px; }
    .gl-talk :global(.say .bubble) { font-size: .88rem; }
    .gl-hero { text-align: center; padding: 32px 0 8px; }
    .gl-kicker { font-family: "IBM Plex Mono", monospace; letter-spacing: .3em; font-size: .74rem; color: var(--stamp); font-weight: 600; margin: 0; }
    .gl-hero h1 { font-family: "Shippori Mincho", serif; font-weight: 800; margin: 6px 0 10px; }
    .gl-lead { color: var(--ink-soft); margin: 0; }
    .gl-empty { text-align: center; color: var(--ink-soft); margin: 40px 0; }
    .gl-list { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
    .gl-item figure { margin: 0; background: #FFFDF8; border: 1px solid #D9D4C7; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 14px rgba(31,42,68,.08); }
    /* タップ（クリック）で、画鋲で留めた紙のように揺れる */
    .gl-item figure { cursor: pointer; transform-origin: 50% 0; }
    .gl-item figure.is-wobble { animation: glWobble .9s cubic-bezier(.3,.7,.3,1) both; }
    @keyframes glWobble {
      0% { transform: rotate(0); }
      18% { transform: rotate(-2.4deg); }
      38% { transform: rotate(1.8deg); }
      58% { transform: rotate(-1deg); }
      78% { transform: rotate(.5deg); }
      100% { transform: rotate(0); }
    }
    .gl-item img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
    .gl-item--tall img { max-height: 620px; width: auto; max-width: 100%; margin: 0 auto; }
    .gl-item--tall figure { background: #FFFDF8; text-align: center; }
    /* カードの高さをそろえる：絵は16:9に、一言は2行ぶんの高さを確保 */
    .gl-item figcaption { padding: 12px 16px 14px; text-align: left; font-size: .9rem; line-height: 1.8; }
    .gl-item figcaption span { min-height: 3.6em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .gl-item b { font-family: "Shippori Mincho", serif; font-size: 1rem; }
    .gl-item span { display: block; color: #444; }
    .gl-foot { margin-top: 36px; text-align: center; font-size: .9rem; }
    .gl-foot a, .gl-foot a:visited { color: var(--ink); }
    @media (max-width: 720px) { .gl-list { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
