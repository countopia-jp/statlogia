---
// =====================================================
// Statlogia - 掲示板（更新のお知らせ一覧）
// src/pages/news/index.astro
// =====================================================
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
const duoStand = fs.existsSync(path.join(process.cwd(), 'public/images/chara/duo-stand-scene.webp')) ? '/images/chara/duo-stand-scene.webp' : null;
import Talk from '../../components/Talk.astro';
import { news } from '../../data/news.js';
---
<BaseLayout title="掲示板｜更新のお知らせ｜Statlogia" description="Statlogia の更新のお知らせ。窓口やテーマの追加、数字の写し替えの記録です。" backHref="/" backLabel="玄関">
  <main class="np">
    <header class="np-hero">
      <img class="np-figure" src="/images/icon/icon-news.webp" alt="" aria-hidden="true" width="160" height="160" loading="lazy" />
      <p class="np-kicker">お知らせ</p>
      <h1>掲示板</h1>
      <p class="np-lead">研究都市の、新しいお知らせを貼り出しています。</p>
    </header>
    <div class="np-intro">
      <div class="np-intro-talk">
        <Talk speaker="chiaki">
          この都市の出来事は、すべてここに貼り出す。新しい窓口も、新しいテーマもだ。
        </Talk>
      </div>
      {duoStand && <img class="np-duo" src={duoStand} width="1376" height="768" alt="並んで立つ一葉と知秋" loading="lazy" />}
    </div>
    <ol class="np-list">
      {news.map((n) => (
        <li>
          <time class="np-date" datetime={n.date}>{n.date.replaceAll('-', '.')}</time>
          <div class="np-body">
            {n.href ? (
              <a class="np-title" href={n.href}>{n.title}</a>
            ) : (
              <span class="np-title">{n.title}</span>
            )}
            {n.text && <p class="np-text">{n.text}</p>}
          </div>
        </li>
      ))}
    </ol>
  </main>
  <style>
    .np { max-width: 680px; margin: 0 auto; padding: 0 16px 56px; }
    .np-hero { text-align: center; padding: 28px 0 8px; }
    .np-duo { display: block; width: 100%; max-width: 760px; height: auto; margin: 10px auto 4px; border-radius: 6px; }
    .np-figure { width: 96px; height: 96px; object-fit: contain; mix-blend-mode: multiply; margin-bottom: 4px; }
    .np-kicker { font-family: "IBM Plex Mono", monospace; font-size: .74rem; letter-spacing: .22em; font-weight: 600; color: var(--stamp); margin: 0; }
    .np-hero h1 { font-family: "Shippori Mincho", serif; font-weight: 800; margin: 6px 0 12px; }
    .np-lead { color: #555; line-height: 1.9; }
    .np-list { list-style: none; padding: 0; margin: 28px 0 0; }
    .np-list li {
      display: flex; gap: 18px; align-items: baseline;
      padding: 16px 4px; border-bottom: 1px dashed #c9c9bd;
    }
    .np-date {
      font-family: "IBM Plex Mono", monospace; font-size: 0.78rem;
      color: #b23a2f; flex-shrink: 0; letter-spacing: 0.04em;
    }
    .np-title { font-family: "Shippori Mincho", serif; font-weight: 600; font-size: 1rem; color: inherit; }
    a.np-title:hover { color: #b23a2f; }
    .np-text { font-size: 0.85rem; color: #666; line-height: 1.8; margin: 6px 0 0; }
  </style>
</BaseLayout>
