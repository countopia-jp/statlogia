---
// パスが src/pages/exhibits/sleep/index.astro の場合はこの3行
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Talk from '../../../components/Talk.astro';
import { fetchSleepByPrefecture } from '../../../lib/estat.js';
// ※ src/pages/exhibits/sleep.astro（フォルダなし）の場合は ../../ に減らす

const rows = await fetchSleepByPrefecture(); // 短い順ソート済み
const shortest = rows.slice(0, 5);
const longest = rows.slice(-5).reverse();
const top = rows[0];
const bottom = rows[rows.length - 1];
const diff = bottom.minutes - top.minutes;
const yearlyHours = Math.round((diff * 365) / 60);
const fmt = (m) => `${Math.floor(m / 60)}時間${m % 60}分`;
---
<BaseLayout>
  <main>
    <section class="exhibit">
      <div class="sec-head">
        <span class="no">EXHIBIT 01</span>
        <h1>日本一「眠らない県」はどこだ</h1>
        <p class="sub">時間の広場｜睡眠時間の都道府県ランキング（2021年）</p>
      </div>

      <Talk speaker="kei">最初の展示です。日本人が1日にどれだけ眠っているか、47都道府県で比べました。</Talk>
      <Talk speaker="touko">へぇ……そんなの調べてる人がいるの？</Talk>
      <Talk speaker="kei">国が5年に1度、全国規模で調べています。社会生活基本調査という立派な統計です。</Talk>

      <div class="highlight">
        <div class="card">
          <span class="label">いちばん眠らない</span>
          <strong>{top.pref}</strong>
          <span class="num">{fmt(top.minutes)}</span>
        </div>
        <div class="card">
          <span class="label">いちばんよく眠る</span>
          <strong>{bottom.pref}</strong>
          <span class="num">{fmt(bottom.minutes)}</span>
        </div>
      </div>

      <Talk speaker="touko">その差、たった{diff}分でしょ？　大したことなくない？</Talk>
      <Talk speaker="kei">1日{diff}分でも、1年つもれば約{yearlyHours}時間。まる{Math.round(yearlyHours / 24)}日ぶん、{bottom.pref}の人は{top.pref}より長く眠っている計算です。</Talk>
      <Talk speaker="touko">まる{Math.round(yearlyHours / 24)}日！？　へぇ……！</Talk>

      <h2>眠らない県 TOP5</h2>
      <ol class="rank">
        {shortest.map((r, i) => (
          <li>
            <span class="pos">{i + 1}</span>
            <span class="pref">{r.pref}</span>
            <span class="bar" style={`--w:${((r.minutes - 460) / 30) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <h2>よく眠る県 TOP5</h2>
      <ol class="rank sleepwell">
        {longest.map((r, i) => (
          <li>
            <span class="pos">{i + 1}</span>
            <span class="pref">{r.pref}</span>
            <span class="bar" style={`--w:${((r.minutes - 460) / 30) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <details class="all">
        <summary>47都道府県すべてを見る（眠らない順）</summary>
        <ol>
          {rows.map((r) => <li>{r.pref}　{fmt(r.minutes)}</li>)}
        </ol>
      </details>

      <Talk speaker="kei">首都圏が上位に並ぶのは、通勤時間の長さと無関係ではなさそうですね。</Talk>
      <Talk speaker="touko">わたしの時代は日が暮れたら寝るしかなかったけど……今の人は忙しいのねぇ。</Talk>

      <div class="source">
        <p>出典：総務省統計局「令和3年社会生活基本調査」（生活時間編・週全体・10歳以上・総平均時間）を加工して作成</p>
        <p>このサービスは、政府統計総合窓口(e-Stat)のAPI機能を使用していますが、サービスの内容は国によって保証されたものではありません。</p>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
.exhibit{padding:56px 0 80px;max-width:720px;margin:0 auto}
.sec-head .no{font-family:"IBM Plex Mono",monospace;font-size:.72rem;letter-spacing:.3em;color:var(--stamp)}
h1{font-family:"Shippori Mincho",serif;font-weight:800;font-size:clamp(1.5rem,4vw,2.2rem);margin-top:8px}
.sub{color:var(--ink-soft);font-size:.85rem;margin-top:6px;margin-bottom:28px}
h2{font-family:"Shippori Mincho",serif;font-size:1.15rem;margin:40px 0 16px;border-left:4px solid var(--stamp);padding-left:12px}
.highlight{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:28px 0}
@media(max-width:560px){.highlight{grid-template-columns:1fr}}
.card{border:1px solid var(--line);border-radius:12px;padding:20px;background:#fff8;display:flex;flex-direction:column;gap:6px;align-items:flex-start}
.card .label{font-size:.72rem;letter-spacing:.2em;color:var(--ink-soft)}
.card strong{font-family:"Shippori Mincho",serif;font-size:1.5rem}
.card .num{font-family:"IBM Plex Mono",monospace;color:var(--stamp);font-weight:600}
.rank{list-style:none;padding:0;display:flex;flex-direction:column;gap:10px}
.rank li{display:grid;grid-template-columns:2em 6.5em 1fr auto;align-items:center;gap:10px}
.rank .pos{font-family:"IBM Plex Mono",monospace;color:var(--stamp);font-weight:600}
.rank .bar{height:10px;border-radius:99px;background:var(--stamp);width:var(--w);opacity:.85;min-width:8px}
.rank.sleepwell .bar{background:#3a6b52}
.rank .min{font-family:"IBM Plex Mono",monospace;font-size:.85rem;color:var(--ink-soft)}
.all{margin:32px 0}
.all summary{cursor:pointer;color:var(--stamp);font-size:.9rem}
.all ol{columns:2;margin-top:14px;font-size:.9rem;color:var(--ink-soft)}
@media(max-width:560px){.all ol{columns:1}}
.source{margin-top:48px;padding-top:20px;border-top:1px solid var(--line);font-size:.75rem;
