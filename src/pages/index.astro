---
// =====================================================
// Statlogia - 玄関（トップページ）
// src/pages/index.astro
// 三つの棟（情報棟・研究棟・講義棟）への入口と、案内人の紹介。
// =====================================================
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Talk from '../components/Talk.astro';
import { ROOM_COUNT } from '../data/page-names.js';
import { THEMES } from '../data/analysis.js';
import { news } from '../data/news.js';
import { INDICATOR_COUNT, TABLE_COUNT } from '../lib/counts.js';

const img = (name) => (fs.existsSync(path.join(process.cwd(), 'public/images', name)) ? `/images/${name}` : null);
const heroImg = img('icon/research-large.webp');
const chiakiImg = img('chara/chiaki-stand.webp');
const hitohaImg = img('chara/hitoha-stand.webp');
const duoImg = img('chara/duo-walk.webp');
const wingArt = { info: img('icon/reading-room-thumb.webp'), research: img('icon/research-thumb.webp'), lecture: img('icon/training-thumb.webp') };
const themeCount = THEMES.length;
const toolCount = fs.readdirSync(path.join(process.cwd(), 'src/pages/how-to-read'), { withFileTypes: true }).filter((d) => d.isDirectory()).length;
const updated = (news[0]?.date || '').replace(/-/g, '.');
const buildJst = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10).replace(/-/g, '.');
const stampDate = buildJst.slice(0, 7);
---
<BaseLayout>
  <main class="gate">
    <section class="gate-hero">
      <div class="notice">
        <p class="gate-kicker">STATLOGIA ｜ 数字の研究都市</p>
        <h1>数字の背景を、<br class="pc" />別の数字で読み解く。</h1>
        <p class="gate-lead"><span class="nw">都道府県・市区町村の統計を引き、くらべ、</span><br class="pc" /><span class="nw">読み解く研究都市です。</span></p>
        <p class="gate-scale"><span><b>{ROOM_COUNT}</b>の窓口</span><span><b>{TABLE_COUNT}</b>の統計表</span><span><b>{INDICATOR_COUNT.toLocaleString('ja-JP')}</b>の指標</span><a class="gate-src" href="/sources/"><i aria-hidden="true">SOURCES</i>出典一覧<em aria-hidden="true">→</em></a></p>
        <p class="gate-dates"><span>最終更新 <b>{updated}</b></span><span>数字の取得 <b>{buildJst}</b></span></p>
        <div class="stamp" aria-hidden="true">
          <span class="top">RESEARCH PASS</span>
          <span class="big">STATLOGIA</span>
          <span class="date">{stampDate}</span>
          <span class="bottom">入館を許可する</span>
        </div>
      </div>
      {(duoImg || chiakiImg || hitohaImg) && (
        <div class="gate-figs">
          <svg class="gate-charts" viewBox="0 0 1000 560" aria-hidden="true" preserveAspectRatio="none">
            <!-- 壁の模様：一葉の左にレーダー図、上に右上がりの折れ線と点、知秋の前（指し棒の下・足元）に棒グラフ。どれも薄く -->
            <g fill="none" stroke="#1F2A44" stroke-linecap="round" stroke-linejoin="round" opacity=".07">
              <path d="M400 200 H860" stroke-width="1.5" />
              <path d="M420 176 L470 158 L570 136 L670 108 L770 82 L850 58" stroke-width="2.5" />
              <polygon points="40,178 102,214 102,286 40,322 -22,286 -22,214"/><polygon points="40,214 71,232 71,268 40,286 9,268 9,232" stroke-width="1"/><path d="M40 250 L40 178"/><path d="M40 250 L102 214"/><path d="M40 250 L102 286"/><path d="M40 250 L40 322"/><path d="M40 250 L-22 286"/><path d="M40 250 L-22 214"/><polygon points="40,189 77,228 96,282 40,282 -4,275 6,230" stroke-width="2.2" fill="#1F2A44" fill-opacity=".35"/>
              <path d="M840 530 H1000" stroke-width="1.5" /><rect x="856" y="455" width="26" height="75" /><rect x="892" y="405" width="26" height="125" /><rect x="928" y="432" width="26" height="98" /><rect x="964" y="365" width="26" height="165" />
            </g>
            <g fill="#1F2A44" opacity=".07">
              <circle cx="445" cy="170" r="3.5" /><circle cx="520" cy="146" r="3.5" /><circle cx="620" cy="120" r="3.5" /><circle cx="720" cy="96" r="3.5" /><circle cx="810" cy="68" r="3.5" />
            </g>
            <g fill="none" stroke="#B3402A" stroke-width="1.5" stroke-dasharray="5 9" opacity=".12"><path d="M420 164 L850 72" /></g>
          </svg>
          {duoImg ? (
            <a class="fig-link fig-duo" href="/guide/" title="二人の紹介へ"><img src={duoImg} width="866" height="716" alt="指し棒で先を指して歩く知秋と、クリップボードを抱えて付いていく一葉" /></a>
          ) : (
            <>
              {hitohaImg && <a class="fig-link fig-hitoha" href="/guide/#hitoha" title="一葉の紹介へ"><img src={hitohaImg} width="518" height="1300" alt="眼鏡をかけてクリップボードを抱えた見習い研究員・一葉" /></a>}
              {chiakiImg && <a class="fig-link fig-chiaki" href="/guide/#chiaki" title="知秋の紹介へ"><img src={chiakiImg} width="539" height="1100" alt="指し棒を担いだ知秋教授" /></a>}
            </>
          )}
        </div>
      )}
    </section>

    <section class="gate-wings" aria-label="三つの棟">
      <a class="wing" href="/dashboard/">
        {wingArt.info && <img class="wing-art" src={wingArt.info} alt="" aria-hidden="true" width="560" height="313" loading="lazy" />}
        <span class="wing-plate"><b>01</b>INFORMATION WING</span>
                <h2>情報棟</h2>
        <p class="wing-role">引く</p>
        <p class="wing-desc">閲覧室の{ROOM_COUNT}の窓口。県や町を選んで、人口・住まい・仕事・お金・医療・教育・自然の数字を台帳から取り寄せます。</p>
        <span class="wing-foot"><svg class="wing-crest" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="29"/><circle cx="32" cy="32" r="25" stroke-width="1"/><path d="M20 19h24v26H20zM20 27.5h24M20 36h24M29 23.3h6M29 31.8h6M29 40.3h6"/></svg><span class="wing-go">閲覧室へ →</span></span>
      </a>
      <a class="wing" href="/analysis/">
        {wingArt.research && <img class="wing-art" src={wingArt.research} alt="" aria-hidden="true" width="560" height="313" loading="lazy" />}
        <span class="wing-plate"><b>02</b>RESEARCH WING</span>
                <h2>研究棟</h2>
        <p class="wing-role">考える</p>
        <p class="wing-desc">見くらべの間で指標を並べ、読み解きの間で{themeCount}のテーマを追う。偏差値、似た県、散布図と相関、増減の分解。</p>
        <span class="wing-foot"><svg class="wing-crest" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="29"/><circle cx="32" cy="32" r="25" stroke-width="1"/><circle cx="29" cy="29" r="11"/><path d="M37 37l8 8" stroke-width="2.6"/><path d="M22 34l5-4 4 2 6-6" stroke-width="1.6"/><circle cx="24" cy="31" r="1.3" fill="var(--ink)" stroke="none"/><circle cx="28" cy="27" r="1.3" fill="var(--ink)" stroke="none"/><circle cx="32" cy="30" r="1.3" fill="var(--ink)" stroke="none"/><circle cx="35" cy="25" r="1.3" fill="var(--ink)" stroke="none"/></svg><span class="wing-go">研究室へ →</span></span>
      </a>
      <a class="wing" href="/how-to-read/">
        {wingArt.lecture && <img class="wing-art" src={wingArt.lecture} alt="" aria-hidden="true" width="560" height="313" loading="lazy" />}
        <span class="wing-plate"><b>03</b>LECTURE WING</span>
                <h2>講義棟</h2>
        <p class="wing-role">学ぶ</p>
        <p class="wing-desc">統計の道具{toolCount}本の使い方。位置と散らばり、伸び率、特化係数、相関、誤差の幅、人口の形。</p>
        <span class="wing-foot"><svg class="wing-crest" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="29"/><circle cx="32" cy="32" r="25" stroke-width="1"/><path d="M18 21h28v20H18zM32 41v5M26 46h12"/><path d="M22 36l6-6 5 4 9-9" stroke-width="2.2"/></svg><span class="wing-go">講義室へ →</span></span>
      </a>
    </section>

    <section class="gate-guide" aria-label="案内人">
      <div class="gate-guide-text">
        <p class="gate-kicker">GUIDE</p>
        <h2>この都市の研究員</h2>
        <Talk speaker="chiaki">うむ、よく来たね。わたしは知秋。この都市で数字を読む研究員だ。数字から読めることは読み、読めないことは「分からぬ」と言う。それがここの流儀だよ。</Talk>
        <Talk speaker="hitoha">一葉です。先生の下で見習い中です。分からないことは、その場で先生に聞きます。……先生、どこの国の方ですか？</Talk>
        <Talk speaker="chiaki">見て分からんのかね。生粋のジャパニーズだ。</Talk>
      </div>
      {heroImg && <a class="gate-scene-link" href="/guide/" title="二人の紹介へ"><span class="gate-scene-photo"><img class="gate-scene" src={heroImg} alt="打ちっぱなしコンクリートの研究室。机を挟んで同じ方眼紙を見る一葉と知秋の水彩画" width="1400" height="782" loading="lazy" /></span><span class="gate-scene-cap">二人のことをくわしく →</span></a>}
    </section>
  </main>
  <style>
    .gate { max-width: 1312px; padding: 18px 16px 16px; }
    .gate-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; align-items: end; padding: 18px 8px 0; }
    .notice { position: relative; align-self: start; margin-top: 70px; padding: 34px 40px 30px 36px; background: #FFFDF8; border: 1px solid #D9D4C7; box-shadow: 0 1px 0 #fff inset, 0 6px 18px rgba(31,42,68,.10); transform: rotate(-.6deg); }
    .notice::before, .notice::after { content: ""; position: absolute; top: -7px; width: 14px; height: 14px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #e8e8e8, #8d8d8d 60%, #5c5c5c); box-shadow: 0 1px 2px rgba(0,0,0,.35); }
    .notice::before { left: 22px; } .notice::after { right: 22px; }
    .gate-kicker { margin: 0; font-family: "IBM Plex Mono", monospace; font-size: .72rem; letter-spacing: .22em; color: var(--stamp); font-weight: 600; }
    .notice h1 { font-family: "Shippori Mincho", serif; font-weight: 800; font-size: clamp(1.5rem, 2.6vw, 2.05rem); line-height: 1.45; margin: 8px 0 12px; }
    .gate-lead { color: var(--ink-soft); line-height: 1.95; margin: 0; }
    .gate-lead .nw { display: inline-block; }
    .gate-scale { margin: 16px 200px 0 0; padding-top: 12px; border-top: 1px dashed #D9D4C7; font-size: .8rem; color: var(--ink-soft); display: flex; flex-wrap: wrap; gap: 6px 18px; align-items: baseline; }
    .gate-scale b { color: var(--ink); font-family: "IBM Plex Mono", monospace; font-weight: 600; font-size: 1.1rem; margin-right: .15em; }
    /* 出典一覧：紙に留めた小さな札。訪問済みでも色を変えない */
    .gate-src { margin-left: 4px; display: inline-flex; align-items: center; gap: 8px; padding: 4px 10px 4px 8px; border: 1px solid var(--ink); border-radius: 999px; color: var(--ink); background: rgba(255,255,255,.55); text-decoration: none; font-size: .76rem; line-height: 1; transition: background .2s, color .2s, transform .2s; }
    .gate-src i { font-style: normal; font-family: "IBM Plex Mono", monospace; font-size: .58rem; letter-spacing: .18em; padding: 2px 6px; border-radius: 999px; background: var(--ink); color: #fff; }
    .gate-src em { font-style: normal; transition: transform .2s; }
    .gate-src:hover, .gate-src:focus-visible { background: var(--ink); color: #fff; }
    .gate-src:hover i, .gate-src:focus-visible i { background: #fff; color: var(--ink); }
    .gate-src:hover em, .gate-src:focus-visible em { transform: translateX(3px); }
    .gate-src:visited { color: var(--ink); }
    .gate-dates { margin: 8px 200px 0 0; font-size: .74rem; color: var(--ink-soft); display: flex; gap: 18px; }
    .gate-dates b { color: var(--ink); font-family: "IBM Plex Mono", monospace; font-weight: 600; }
    .gate-figs { position: relative; display: flex; justify-content: center; align-items: flex-end; gap: 0; padding: 0 2%; margin-top: 90px; }
    .gate-charts { position: absolute; left: -8%; top: -34%; width: 110%; height: 134%; z-index: 0; pointer-events: none; }
    .fig-link { position: relative; z-index: 1; }
    .stamp { position: absolute; right: 14px; bottom: 14px; width: 200px; aspect-ratio: 1; border-radius: 50%; border: 4px double var(--seal); color: var(--seal); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .1em; transform: rotate(-10deg); font-size: 19px; opacity: .92; mix-blend-mode: multiply; animation: stampIn .62s cubic-bezier(.3,.9,.2,1) .45s both; --seal: #2F5D8A; }
    /* 入館印を「ポン」と押す：上から降りてきて（大きく薄い）、押した瞬間に少し沈み、戻る */
    @keyframes stampIn {
      0%   { transform: rotate(-14deg) scale(2.2); opacity: 0; filter: blur(1px); }
      55%  { transform: rotate(-10deg) scale(.94); opacity: 1; filter: blur(0); }
      70%  { transform: rotate(-10deg) scale(1.04); opacity: .9; }
      85%  { transform: rotate(-10deg) scale(.99); opacity: .93; }
      100% { transform: rotate(-10deg) scale(1); opacity: .92; }
    }
    @media (prefers-reduced-motion: reduce) { .stamp { animation: none; } }
    .stamp .top { font-size: .58em; letter-spacing: .26em; font-weight: 600; }
    .stamp .big { font-family: "IBM Plex Mono", monospace; font-weight: 600; font-size: 1.25em; letter-spacing: .06em; }
    .stamp .date { font-family: "IBM Plex Mono", monospace; font-size: .78em; border-top: 1.5px solid var(--seal); border-bottom: 1.5px solid var(--seal); padding: .08em .5em; margin-top: .15em; }
    .stamp .bottom { font-size: .58em; letter-spacing: .22em; margin-top: .1em; }
    .gate-figs img { display: block; width: 100%; height: auto; }
    .fig-link { display: block; transition: transform .15s ease; }
    .fig-link:hover, .fig-link:focus-visible { transform: translateY(-4px); }
    .fig-duo { width: 92%; }
    .fig-hitoha { width: 52%; }
    .fig-chiaki { width: 28%; margin-left: -3%; }
    .gate-wings { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin: 30px 8px 0; padding: 0; }
    .wing { position: relative; overflow: hidden; display: flex; flex-direction: column; padding: 44px 22px 18px; min-height: 290px; background: rgba(255,255,255,.42); border: 1px solid rgba(255,255,255,.75); border-top: 3px solid var(--ink); border-radius: 8px; color: inherit; text-decoration: none; backdrop-filter: blur(10px) saturate(1.1); -webkit-backdrop-filter: blur(10px) saturate(1.1); box-shadow: 0 8px 24px rgba(31,42,68,.08), inset 0 1px 0 rgba(255,255,255,.9); transition: transform .15s, box-shadow .15s; }
    .wing-art { position: absolute; right: -10%; top: -2%; width: 82%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; opacity: .95; pointer-events: none; -webkit-mask-image: radial-gradient(ellipse 75% 85% at 70% 30%, #000 40%, transparent 80%); mask-image: radial-gradient(ellipse 75% 85% at 70% 30%, #000 40%, transparent 80%); }
    .wing > *:not(.wing-art) { position: relative; z-index: 1; }
    .wing:hover, .wing:focus-visible { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(31,42,68,.14), inset 0 1px 0 rgba(255,255,255,.9); }
    .wing-art { transition: transform .5s cubic-bezier(.2,.8,.2,1), opacity .3s; }
    .wing:hover .wing-art, .wing:focus-visible .wing-art { transform: scale(1.05) translate(-2%, 1%); opacity: 1; }
    /* 棟らしさ：壁に打った館名板（カードの左端から少しはみ出す）＋建物の線画＋入口の形の案内 */
    .wing-plate { position: absolute; left: 0; top: 0; z-index: 2; margin: 0; padding: .35em 1em .35em .95em; border-radius: 0 0 6px 0; font-family: "IBM Plex Mono", monospace; font-size: .62rem; letter-spacing: .22em; color: #F7F6F2; background: var(--ink); border-radius: 0 3px 3px 0; box-shadow: 0 2px 4px rgba(0,0,0,.18); }
    .wing-plate b { color: #F0B78A; font-weight: 600; margin-right: .9em; }
    .wing > .wing-plate { position: absolute; }
    .wing-foot { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 14px; }
    /* 棟の紋章：紺一色の二重丸に、帳面の棚／方眼紙と虫めがね／黒板と折れ線 */
    .wing-crest { width: 52px; height: 52px; flex: none; fill: none; stroke: var(--ink); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; opacity: .55; transition: opacity .2s, transform .3s; }
    .wing:hover .wing-crest, .wing:focus-visible .wing-crest { opacity: .9; transform: rotate(-6deg); }
    .wing h2 { font-family: "Shippori Mincho", serif; font-size: 1.5rem; margin: 4px 0 0; }
    .wing-role { font-size: .8rem; letter-spacing: .3em; color: var(--ink-soft); margin: 0 0 10px; }
    .wing-desc { font-size: .92rem; line-height: 1.85; color: #333; flex: 1; max-width: 66%; margin-top: 44px; }
    .wing-go { margin: 0; font-size: .86rem; color: var(--ink); font-weight: 500; padding: .35em 1em .35em .9em; border: 1.5px solid var(--ink); border-radius: 10px 10px 3px 3px; background: rgba(255,255,255,.5); transition: background .2s, color .2s; }
    .wing:hover .wing-go, .wing:focus-visible .wing-go { background: var(--ink); color: #fff; }
    .gate-guide { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; align-items: center; margin: 40px 8px 0; padding: 28px 0 0; border-top: 1px solid var(--line); }
    .gate-guide h2 { font-family: "Shippori Mincho", serif; font-size: 1.4rem; margin: 6px 0 14px; }
    /* 研究員の区画の絵はコルクボード：木枠のボードに、白ふちの写真を画鋲で留める。札も画鋲で */
    .gate-scene-link { position: relative; display: block; color: inherit; text-decoration: none; padding: 28px 28px 52px; border: 6px solid #8a7156; border-radius: 2px; background-color: #D8C09A; background-image: radial-gradient(rgba(110,80,45,.13) .7px, transparent 1px), radial-gradient(rgba(110,80,45,.10) .6px, transparent .9px), radial-gradient(rgba(255,245,225,.45) .6px, transparent .9px), linear-gradient(135deg, rgba(255,255,255,.08), rgba(90,60,30,.06)); background-size: 7px 7px, 11px 13px, 13px 9px, 100% 100%; background-position: 0 0, 3px 5px, 6px 2px, 0 0; box-shadow: inset 0 0 0 1px rgba(255,255,255,.25), inset 0 2px 0 rgba(255,255,255,.18), inset 0 0 34px rgba(90,60,30,.16), 0 12px 28px -10px rgba(31,42,68,.35), 0 2px 5px rgba(0,0,0,.12); transition: transform .25s ease, box-shadow .25s ease; }
    .gate-scene-link:hover, .gate-scene-link:focus-visible { transform: translateY(-3px); box-shadow: inset 0 0 0 1px rgba(255,255,255,.25), inset 0 2px 0 rgba(255,255,255,.18), inset 0 0 34px rgba(90,60,30,.16), 0 20px 38px -12px rgba(31,42,68,.4), 0 2px 5px rgba(0,0,0,.12); }
    .gate-scene-photo { position: relative; display: block; padding: 8px 8px 10px; background: #FFFEFA; box-shadow: 0 1px 1px rgba(0,0,0,.12), 0 6px 14px -4px rgba(60,40,20,.35); transform: rotate(-1.8deg); transition: transform .25s ease; }
    .gate-scene-link:hover .gate-scene-photo, .gate-scene-link:focus-visible .gate-scene-photo { transform: rotate(-.6deg); }
    .gate-scene-photo::before, .gate-scene-photo::after { content: ""; position: absolute; top: -5px; width: 11px; height: 11px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #f0f0f0, #9a9a9a 55%, #5c5c5c); box-shadow: 0 2px 3px rgba(0,0,0,.35), 0 0 0 1px rgba(0,0,0,.08); }
    .gate-scene-photo::before { left: 14px; } .gate-scene-photo::after { right: 14px; }
    .gate-scene { display: block; width: 100%; height: auto; border-radius: 0; }
    .gate-scene-cap { position: absolute; right: 26px; bottom: 13px; font-size: .78rem; letter-spacing: .06em; color: var(--ink); padding: .32em .9em .32em 1.45em; background: #FCFAF2; box-shadow: 0 1px 1px rgba(0,0,0,.1), 0 4px 10px -3px rgba(60,40,20,.4); transform: rotate(1.6deg); }
    .gate-scene-cap::before { content: ""; position: absolute; left: 7px; top: 50%; width: 9px; height: 9px; margin-top: -5px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #f4b4a4, #B3402A 60%, #7a2a1c); box-shadow: 0 2px 3px rgba(0,0,0,.35); }
    @media (max-width: 900px) {
      .gate-hero, .gate-guide { grid-template-columns: 1fr; }
      .gate-wings { grid-template-columns: 1fr; }
      .gate-figs { max-width: 440px; margin: 0 auto; }
      .gate-charts { display: none; }
      .notice { margin-top: 18px; padding: 26px 22px 22px; transform: none; }
      .stamp { position: static; width: 150px; font-size: 14px; margin: 14px 0 -6px auto; }
        .notice h1 .pc, .gate-lead .pc { display: none; }
    }
  </style>
</BaseLayout>
