---
import BaseLayout from '../layouts/BaseLayout.astro';
import Talk from '../components/Talk.astro';
import { news } from '../data/news.js';
import { catalog } from '../data/catalog.js';
const latestNews = news.slice(0, 3);
const publishedCount = catalog.filter((c) => c.status === 'published').length;
const prefectures = [
  ['01','北海道'],['02','青森県'],['03','岩手県'],['04','宮城県'],['05','秋田県'],
  ['06','山形県'],['07','福島県'],['08','茨城県'],['09','栃木県'],['10','群馬県'],
  ['11','埼玉県'],['12','千葉県'],['13','東京都'],['14','神奈川県'],['15','新潟県'],
  ['16','富山県'],['17','石川県'],['18','福井県'],['19','山梨県'],['20','長野県'],
  ['21','岐阜県'],['22','静岡県'],['23','愛知県'],['24','三重県'],['25','滋賀県'],
  ['26','京都府'],['27','大阪府'],['28','兵庫県'],['29','奈良県'],['30','和歌山県'],
  ['31','鳥取県'],['32','島根県'],['33','岡山県'],['34','広島県'],['35','山口県'],
  ['36','徳島県'],['37','香川県'],['38','愛媛県'],['39','高知県'],['40','福岡県'],
  ['41','佐賀県'],['42','長崎県'],['43','熊本県'],['44','大分県'],['45','宮崎県'],
  ['46','鹿児島県'],['47','沖縄県'],
];
---
<BaseLayout>
  <main>
    <!-- HERO -->
    <div class="hero">
      <div>
        <span class="eyebrow">JAPAN IN NUMBERS</span>
        <div class="hero-title-row">
          <h1>数字の国へ、<br />ようこそ<span class="num">。</span></h1>
          <a class="btn primary" href="/exhibits/sleep/">最初の展示を見る</a>
        </div>
        <p class="lead">Countopia Stats（カウントピア・スタッツ）は、都道府県・市区町村で引ける、暮らしの統計サイト。日本の公的統計を「へぇ」と眺めて遊ぶ国です。難しい話はしません。数字の風景を、案内人と一緒にのんびり巡ってください。</p>
        <span class="api-count">現在 {publishedCount} 指標とAPI連携中</span>
      </div>

      <div class="hero-side">
        <div class="stamp-area" aria-hidden="true">
          <div class="stamp">
            <span class="top">IMMIGRATION</span>
            <span class="big">COUNTOPIA</span>
            <span class="big2">STATS</span>
            <span class="date">2026.07</span>
            <span class="bottom">入国を許可する</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 県選択（左）＋ 瓦版（右） -->
    <div class="hero-row">
      <form class="hero-search" action="/population/" method="get">
        <label for="hero-pref">あなたの県は、どんな数字？</label>
        <div class="hero-search-row">
          <select id="hero-pref" name="pref" required>
            <option value="" disabled selected>都道府県を選ぶ</option>
            {prefectures.map(([code, name]) => (
              <option value={name}>{name}</option>
            ))}
          </select>
          <button type="submit">見にいく →</button>
        </div>
        <p class="hero-search-note">「国勢の間」で、人口・世帯の数字をご覧いただけます。</p>
      </form>

      <aside class="gazette" aria-label="更新のお知らせ">
        <span class="gz-label">
          <img class="gz-icon" src="/images/icon/icon-news.webp" alt="" width="160" height="160" loading="lazy" />
          瓦版
        </span>
        <ul class="gz-list">
          {latestNews.map((n) => (
            <li>
              <time datetime={n.date}>{n.date.slice(5).replace('-', '.')}</time>
              {n.href ? <a href={n.href}>{n.title}</a> : <span>{n.title}</span>}
            </li>
          ))}
        </ul>
        <a class="gz-more" href="/news/">一覧 →</a>
      </aside>
    </div>

    <!-- 展示 -->
    <section id="exhibits">
      <div class="sec-head">
        <img class="sec-icon" src="/images/icon/icon-exhibit.webp" alt="" width="160" height="160" loading="lazy" />
        <div class="sec-text">
          <span class="no">EXHIBITS</span>
          <h2>いまの展示</h2>
        </div>
      </div>
      <div class="cards">
        <a class="card pc" href="/exhibits/food/">
          <span class="pc-postmark" aria-hidden="true"><i>EXHIBIT</i><b>08</b></span>
          <span class="pc-kind">全国平均</span>
          <span class="pc-num">4.0<small>店</small></span>
          <h3>日本一「外食の街」はどの県だ</h3>
          <p>人口千人当たりの飲食店数を47都道府県で比較。いちばん大きな街が、いちばん多いとは限りません。</p>
          <span class="c-place">暮らしの広場</span>
        </a>
        <a class="card pc" href="/exhibits/day-night-ratio/">
          <span class="pc-postmark" aria-hidden="true"><i>EXHIBIT</i><b>09</b></span>
          <span class="pc-kind">最高・東京都</span>
          <span class="pc-num">116.1<small>％</small></span>
          <h3>日本一「昼間だけ賑わう」県はどこだ</h3>
          <p>昼夜間人口比率を47都道府県で比較。通勤・通学で、昼間だけ人が増える県はどこか。</p>
          <span class="c-place">暮らしの広場</span>
        </a>
        <a class="card pc" href="/exhibits/fishing/">
          <span class="pc-postmark" aria-hidden="true"><i>EXHIBIT</i><b>10</b></span>
          <span class="pc-kind">全国平均</span>
          <span class="pc-num">7.8<small>％</small></span>
          <h3>日本一「釣りをする」県はどこだ</h3>
          <p>過去1年間につりをした人の割合を47都道府県で比較。海の近さだけでは、決まらないようです。</p>
          <span class="c-place">暮らしの広場</span>
        </a>
      </div>
      <div class="more-actions">
        <a class="more-btn" href="/exhibits/">すべての展示を見る（全10展示）→</a>
        <a class="more-btn ghost" href="/tower/">展望塔から一望する →</a>
      </div>
    </section>

    <!-- データの仕組み（橙子の高札） -->
    <section class="notice-board" aria-label="この国のデータについて">
      <div class="notice-frame">
        <img class="notice-figure" src="/images/icon/toko-board.webp"
             alt="高札に筆で書き入れる橙子" width="1400" height="788" loading="lazy" />
        <div class="notice-overlay">
          <p>この国の数字は、すべて政府統計の総合窓口〈e-Stat〉のお国の統計から写しています。</p>
          <p>ただ、そのまま並べるだけだと、大きな町の陰にかくれて、小さな町のほんとうの姿が見えにくいんです。</p>
          <p>だから台帳によっては、割合や、人・世帯ごとに均した形に直して、大きな町も小さな町も、同じ物差しで比べられるようにしています。</p>
          <p>数字は、月のはじめにお国の統計をあらためて、新しいものがあれば写し替えているので、いつ来ても、いちばん新しい数字が並んでいます。</p>
        </div>
      </div>
    </section>

    <!-- 閲覧室 -->
    <section id="reading-room">
      <div class="sec-head">
        <img class="sec-icon" src="/images/icon/icon-reading.webp" alt="" width="160" height="160" loading="lazy" />
        <div class="sec-text">
          <span class="no">READING ROOM</span>
          <h2>閲覧室</h2>
        </div>
      </div>
      <div class="cards">
        <a class="card" href="/education/">
          <h3>学びの登記所</h3>
          <p>全国の市区町村から選んで、幼稚園から高校までの学校の数字を自分の手で引き出せます。あなたの町に、学校はいくつ？</p>
          <span class="c-place">閲覧室</span>
        </a>
        <a class="card" href="/muni-finance/">
          <h3>町の台所事情</h3>
          <p>財政力指数、実質収支比率、経常収支比率。あなたの町の「懐具合」を、数字でご覧ください。</p>
          <span class="c-place">閲覧室</span>
        </a>
        <a class="card" href="/population/">
          <h3>国勢の間</h3>
          <p>総人口、高齢化率、世帯数、出生率、婚姻率。あなたの県の「人のかたち」を、数字でご覧ください。</p>
          <span class="c-place">閲覧室</span>
        </a>
      </div>
      <div class="more-actions">
        <a class="more-btn" href="/dashboard/">閲覧室のご案内（全11窓口）→</a>
      </div>
    </section>

    <!-- 案内人 -->
    <section id="guide">
      <div class="sec-head">
        <div class="sec-text">
          <span class="no">GUIDE</span>
          <h2>この国の案内人</h2>
        </div>
      </div>
      <div class="guides">
        <a class="portrait-link" href="/guide/#kei">
          <figure class="portrait">
            <img src="/images/chara/kei-madobe.webp" alt="統計局案内人・京。アーチ窓の内側で書類を抱えて立つ" width="1200" height="670" loading="lazy" />
            <figcaption><b>京</b><span>統計局案内人</span></figcaption>
          </figure>
        </a>
        <a class="portrait-link" href="/guide/#touko">
          <figure class="portrait">
            <img src="/images/chara/touko-yano.webp" alt="大正から来た子・橙子。山あいの野道で手を振っている" width="1200" height="670" loading="lazy" />
            <figcaption><b>橙子</b><span>大正から来た子</span></figcaption>
          </figure>
        </a>
      </div>
      <Talk speaker="kei">ようこそCountopia Statsへ。この国では、数字はぜんぶ「景色」です。</Talk>
      <Talk speaker="touko">へぇ……で、まず何を見ればいいの？</Talk>
      <Talk speaker="kei">まずは「時間の広場」へどうぞ。日本一眠らない県の話をしましょう。</Talk>
    </section>
  </main>
</BaseLayout>
<style>
.hero{
  display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:center;
  padding:72px 0 24px;
  position:relative;
}
.hero::before{
  content:"";
  position:absolute;
  right:20%;
  top:14%;
  width:80%;
  height:150%;
  background:url("/images/icon/japan-map.webp") no-repeat right center/contain;
  opacity:.10;
  mix-blend-mode:multiply;
  pointer-events:none;
  z-index:0;
}
.hero > *{position:relative;z-index:1}
.portrait-link{display:block;text-decoration:none;color:inherit;transition:transform .15s ease}
.portrait-link:hover{transform:translateY(-3px)}
@media(max-width:760px){.hero{grid-template-columns:1fr;padding-top:48px}}
.eyebrow{
  display:inline-block;font-size:.72rem;letter-spacing:.28em;
  color:var(--ink-soft);border:1px solid var(--line);
  padding:4px 12px;border-radius:99px;margin-bottom:20px;background:#fff9;
}
.api-count{
  display:block;font-family:"IBM Plex Mono",monospace;font-size:.78rem;
  color:#2d6a4f;letter-spacing:.04em;margin:8px 0 0;
}
/* タイトルの右下にボタンを置く */
.hero-title-row{display:flex;align-items:flex-end;gap:28px;flex-wrap:wrap}
.hero-title-row .btn{flex-shrink:0;margin-bottom:.5rem}
h1{
  font-family:"Shippori Mincho",serif;font-weight:800;
  font-size:clamp(2rem,5.2vw,3.4rem);line-height:1.35;letter-spacing:.04em;
  margin:0;
}
h1 .num{color:var(--stamp)}
.lead{margin-top:20px;color:var(--ink-soft);font-size:.98rem;max-width:34em}
/* 右カラムはスタンプのみ */
.hero-side{
  display:flex;flex-direction:column;align-items:stretch;
  margin-top:48px;
}
@media(max-width:760px){
  .hero-side{margin-top:0}
}
/* 県選択（左）＋瓦版（右）を同じ高さで横並び。中央寄せ＋上に余白 */
.hero-row{
  display:flex;gap:20px;align-items:stretch;flex-wrap:wrap;justify-content:center;
  max-width:1140px;margin:150px auto 28px;
}
.hero-search{
  width:340px;flex-shrink:0;
  padding:14px 16px;border:1px solid var(--line);
  border-radius:12px;background:#fff9;
}
@media(max-width:760px){
  .hero-search{width:100%}
  .hero-row{margin-top:36px}
}
.hero-search label{
  display:block;font-size:.78rem;color:var(--ink-soft);margin-bottom:8px;
  font-family:"Shippori Mincho",serif;
}
.hero-search-row{display:flex;gap:8px;flex-wrap:wrap}
.hero-search-note{
  margin-top:8px;font-size:.72rem;color:var(--ink-soft);
}
.hero-search select{
  flex:1;min-width:120px;padding:7px 9px;border:1px solid var(--line);
  border-radius:8px;background:#fff;font-size:.85rem;color:inherit;
}
.hero-search button{
  padding:7px 14px;border:1px solid var(--stamp);border-radius:8px;
  background:var(--stamp);color:#fff;font-size:.82rem;cursor:pointer;
  white-space:nowrap;
}
.hero-search button:hover{opacity:.88}
.stamp-area{display:flex;justify-content:center}
.stamp{
  width:min(240px,60vw);aspect-ratio:1;border-radius:50%;
  border:5px double var(--stamp);color:var(--stamp);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;
  transform:rotate(-8deg);background:#fff5;
  animation:stampIn .5s cubic-bezier(.2,1.6,.4,1) .3s both;
}
@keyframes stampIn{from{transform:rotate(-8deg) scale(1.7);opacity:0}to{transform:rotate(-8deg) scale(1);opacity:1}}
@media(prefers-reduced-motion:reduce){.stamp{animation:none}}
.stamp .top{font-size:.65rem;letter-spacing:.34em;font-weight:600}
.stamp .big{font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:1.5rem;letter-spacing:.08em}
.stamp .big2{font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:.95rem;letter-spacing:.14em;margin-top:-2px}
.stamp .date{font-family:"IBM Plex Mono",monospace;font-size:.8rem;border-top:1.5px solid var(--stamp);border-bottom:1.5px solid var(--stamp);padding:2px 10px;margin-top:4px}
.stamp .bottom{font-size:.62rem;letter-spacing:.28em;margin-top:2px}
.gazette{
  flex:1;min-width:340px;max-width:700px;
  display:flex;gap:12px;align-items:center;
  border:1px solid var(--line);border-radius:12px;
  padding:12px 16px;margin:0;background:#fff8;
}
.gz-label{
  display:inline-flex;align-items:center;gap:6px;
  font-family:"Shippori Mincho",serif;font-weight:800;font-size:.78rem;
  color:#b23a2f;border:1.5px solid #b23a2f;border-radius:4px;
  padding:3px 8px;flex-shrink:0;
}
.gz-icon{width:34px;height:34px;object-fit:contain;mix-blend-mode:multiply}
.gz-list{list-style:none;margin:0;padding:0;flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}
.gz-list li{display:flex;gap:10px;align-items:baseline;font-size:.78rem;line-height:1.6}
.gz-list time{font-family:"IBM Plex Mono",monospace;font-size:.68rem;color:var(--ink-soft);flex-shrink:0}
.gz-list a{color:inherit}
.gz-list a:hover{color:#b23a2f}
.gz-more{font-size:.76rem;color:#b23a2f;flex-shrink:0;align-self:center}
@media(max-width:600px){.gazette{flex-direction:column;align-items:flex-start;gap:10px}.gz-more{align-self:flex-end}}
.sec-head{display:flex;align-items:center;gap:14px;margin-bottom:24px}
.sec-text{display:flex;flex-direction:column}
.sec-icon{width:56px;height:56px;object-fit:contain;flex-shrink:0;mix-blend-mode:multiply}
.sec-head .no{font-family:"IBM Plex Mono",monospace;font-size:.72rem;letter-spacing:.3em;color:var(--stamp)}
.sec-head h2{font-family:"Shippori Mincho",serif;font-weight:800;font-size:1.5rem;margin:4px 0 0}
#exhibits,#reading-room,#guide{padding:40px 0}
.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
@media(max-width:900px){
  .cards{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:600px){
  .cards{grid-template-columns:1fr}
}
.card{
  border:1px solid var(--line);border-radius:14px;padding:24px;background:#fff8;
  display:flex;flex-direction:column;gap:10px;text-decoration:none;color:inherit;
  transition:transform .15s,box-shadow .15s;
}
.card:hover{transform:translateY(-3px);box-shadow:0 6px 18px #0001}
.card--closed{border-style:dashed;color:var(--ink-soft);background:#f4f4ee88}
.card--closed:hover{transform:none;box-shadow:none}
.c-no{font-family:"IBM Plex Mono",monospace;font-size:.68rem;letter-spacing:.26em;color:var(--stamp)}
.card.pc{position:relative;padding-top:22px}
.pc-postmark{
  position:absolute;top:14px;right:16px;width:52px;height:52px;
  border:2px solid #2d6a4f66;border-radius:50%;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;
  transform:rotate(-14deg);font-family:"IBM Plex Mono",monospace;color:#2d6a4f88;
  background:#fdfdf8cc;transition:transform .18s,color .18s,border-color .18s;
}
.pc-postmark i{font-style:normal;font-size:.44rem;letter-spacing:.16em}
.pc-postmark b{font-size:.95rem;line-height:1}
.card.pc:hover .pc-postmark{transform:rotate(-5deg) scale(1.06);color:#2d6a4f;border-color:#2d6a4f}
/* 数字が何を指すかの極小ラベル（数字の上に置く） */
.pc-kind{
  font-size:.62rem;letter-spacing:.16em;color:var(--ink-soft);
  opacity:.75;margin-bottom:-6px;
}
.pc-num{
  font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:2.3rem;
  color:#1b4332;line-height:1;letter-spacing:-0.02em;margin:2px 0 0;
}
.pc-num small{font-size:.85rem;margin-left:3px;color:#b23a2f;font-weight:600}
.card--closed .c-no{color:var(--ink-soft)}
.card h3{font-family:"Shippori Mincho",serif;font-size:1.1rem;line-height:1.5}
.card p{font-size:.85rem;color:var(--ink-soft);line-height:1.7}
.c-place{font-size:.7rem;letter-spacing:.2em;color:var(--ink-soft);margin-top:auto;padding-top:8px;border-top:1px dashed var(--line)}
.more-actions{margin-top:28px;display:flex;gap:14px;flex-wrap:wrap}
.more-btn{
  display:inline-block;padding:11px 22px;border-radius:8px;
  border:1px solid var(--stamp);background:var(--stamp);color:#fff;
  font-size:.85rem;font-weight:600;text-decoration:none;
  white-space:nowrap;transition:opacity .15s;
}
.more-btn:hover{opacity:.88}
.more-btn.ghost{
  border-color:#1b4332;background:#1b4332;
}

/* データの仕組み（橙子の高札）── 板に文字を重ねる */
.notice-board{max-width:900px;margin:8px auto 40px;padding:0 16px}
.notice-frame{position:relative;width:100%}
.notice-figure{display:block;width:100%;height:auto;border-radius:6px}
.notice-overlay{
  position:absolute;
  /* 板の無地部分に収める。橙子は右下寄りなので右側は空ける */
  left:18%;right:26%;top:15%;bottom:22%;
  display:flex;flex-direction:column;justify-content:center;align-items:center;gap:.5em;
  color:#3a3226;
}
.notice-overlay p{
  margin:0;line-height:1.55;
  font-size:clamp(.62rem,1.55vw,1.02rem);
  font-family:"Shippori Mincho",serif;
  text-align:left;
}
/* 狭い画面：板に4段落は収まらないので、板を上に見せて本文はその下へ（絶対配置を解除） */
@media(max-width:720px){
  .notice-overlay{
    position:static;
    left:auto;right:auto;top:auto;bottom:auto;
    max-width:640px;margin:10px auto 0;padding:0 4px;
    display:flex;flex-direction:column;justify-content:center;gap:.6em;
    color:var(--ink-soft);
  }
  .notice-overlay p{font-size:.9rem;line-height:1.9;font-family:inherit}
}

.guides{display:grid;grid-template-columns:1fr 1fr;gap:26px;margin:8px 0 30px}
@media(max-width:760px){.guides{grid-template-columns:1fr}}
.portrait{
  margin:0;background:#fff;border:1px solid var(--line);
  padding:10px 10px 6px;box-shadow:0 6px 16px #0002;
  transform:rotate(-1deg);
}
.portrait:last-child{transform:rotate(1.2deg)}
.portrait img{display:block;width:100%;height:auto;border:1px solid var(--line)}
.portrait figcaption{
  display:flex;align-items:baseline;gap:10px;padding:8px 4px 4px;
}
.portrait figcaption b{font-family:"Shippori Mincho",serif;font-size:1.05rem}
.portrait figcaption span{font-size:.72rem;letter-spacing:.18em;color:var(--ink-soft)}

/* ── タブレット調整（761〜1024px）──────── */
@media(min-width:761px) and (max-width:1024px){
  .hero{grid-template-columns:1fr .58fr;gap:24px;padding:48px 0 16px}
  .hero::before{
    right:2%;top:58%;width:70%;height:108%;opacity:.09;
