---
import BaseLayout from '../layouts/BaseLayout.astro';
import Talk from '../components/Talk.astro';
import { news } from '../data/news.js';
import { catalog } from '../data/catalog.js';
import { getPriceData } from '../lib/price.js';
import { getReadingData } from '../lib/reading.js';

const latestNews = news.slice(0, 3);
const publishedCount = catalog.filter((c) => c.status === 'published').length;

// 展示の本数は catalog の usedIn から数える（手で直さなくてよいように）
const exhibitCount = new Set(
  catalog
    .flatMap((c) => c.usedIn || [])
    .filter((u) => u.startsWith('/exhibits/'))
).size;

// カードの数字も統計から出す（月次の再ビルドで自動的に入れ替わる）
const price = await getPriceData();
const priceTop = price.rows[0];
const foodTop = price.food.rows[0];
const heatTop = price.heat.rows[0];
const eduTop = price.education.rows[0];
const reading = await getReadingData();
const readingTop = reading.rows[0];

const num = (v) => v.toFixed(1);

// 入国印の日付はビルド時のもの（月初の再ビルドで押し直される）
const stampDate = new Date().toISOString().slice(0, 7).replace('-', '.');

// 今月の一数字：読み込み済みのデータから、月ごとに1つ選ぶ
const monthlyFacts = [
  { text: `物価がいちばん高いのは${priceTop.n}。全国平均を100として${num(priceTop.minutes)}です。`, href: '/exhibits/price/' },
  { text: `食べものの値段がいちばん高いのは${foodTop.n}。全国平均を100として${num(foodTop.minutes)}。`, href: '/exhibits/price/' },
  { text: `電気やガスの値段がいちばん高いのは${heatTop.n}。全国平均を100として${num(heatTop.minutes)}。`, href: '/exhibits/utility/' },
  { text: `教育にかかる値段がいちばん高いのは${eduTop.n}。全国平均を100として${num(eduTop.minutes)}。`, href: '/exhibits/education-price/' },
  { text: `本を読んだ人は全国で${num(reading.national)}％。マンガを読んだ人は${num(reading.manga.national)}％でした。`, href: '/exhibits/reading/' },
  { text: `本を読む人がいちばん多いのは${readingTop.n}で${num(readingTop.minutes)}％です。`, href: '/exhibits/reading/' },
];
const monthlyFact = monthlyFacts[new Date().getMonth() % monthlyFacts.length];

const prefectures = [
  ['01','北海道'],['02','青森県'],['03','岩手県'],['04','宮城県'],['05','秋田県'],
  ['06','山形県'],['07','福島県'],['08','茨城県'],['09','栃木県'],['10','群馬県'],
  ['11','埼玉県'],['12','千葉県'],['13','東京都'],['14','神奈川県'],['15','新潟県'],
  ['16','富山県'],['17','石川県'],['18','福井県'],['19','山梨県'],['20','長野県'],
  ['21','岐阜県'],['22','静岡県'],['23','愛知県'],['24','三重県'],['25','滋賀県'],
  ['26','京都府'],['27','大阪府'],['28','兵庫県'],['29','奈良県'],['30','和歌山県'],
  ['31','鳥取県'],['32','島根県'],['33','岡山県'],['34','広島県'],['35','山口県'],
  ['36','徳島県'],['37','香川県'],['38','愛媛県'],['39','高知県'],['40','福岡県'],
  ['41','佐賀県'],['42','長崎県'],['43','熊本県'],['44','大分県'],['45','宮崎県'],
  ['46','鹿児島県'],['47','沖縄県'],
];
---
<BaseLayout>
  <main>
    <!-- 製図台の上に、白紙を1枚広げている -->
    <div class="desk">
      <div class="sheet">
        <span class="tape tape-l" aria-hidden="true"></span>
        <span class="tape tape-r" aria-hidden="true"></span>

        <!-- HERO -->
        <div class="hero">
          <div>
            <div class="hero-title-row">
              <h1>数字の国へ、<br />ようこそ<span class="num">。</span></h1>
              <a class="btn primary" href="/exhibits/sleep/">最初の展示を見る</a>
            </div>
            <p class="lead">Countopia Stats（カウントピア・スタッツ）は、都道府県・市区町村で引ける、暮らしの統計サイト。難しい話はしません。数字の風景を、案内人と一緒にのんびり巡ってください。</p>
            <span class="api-count">現在 {publishedCount} 指標とAPI連携中</span>
          </div>

          <div class="hero-side">
            <div class="stamp-area" aria-hidden="true">
              <div class="stamp">
                <span class="top">IMMIGRATION</span>
                <span class="big">COUNTOPIA</span>
                <span class="big2">STATS</span>
                <span class="date">{stampDate}</span>
                <span class="bottom">入国を許可する</span>
              </div>
            </div>
            <img class="hero-chara" src="/images/chara/kei-touko-look.webp"
                 alt="上を指し示す京と、その先を見上げる橙子"
                 width="720" height="960" />
          </div>
        </div>

        <!-- 今月の一数字 -->
        <a class="today" href={monthlyFact.href}>
          <span class="today-label">今月の一数字</span>
          <span class="today-text">{monthlyFact.text}</span>
          <span class="today-more">→</span>
        </a>
      </div>
    </div>

    <!-- 県選択（左）＋ 瓦版（右）：紙の外、方眼の上に置く -->
    <div class="hero-row">
      <form class="hero-search" action="/population/" method="get">
        <label for="hero-pref">あなたの県は、どんな数字？</label>
        <div class="hero-search-row">
          <select id="hero-pref" name="pref" required>
            <option value="" disabled selected>都道府県を選ぶ</option>
            {prefectures.map(([code, name]) => (
              <option value={name}>{name}</option>
            ))}
          </select>
          <button type="submit">見にいく →</button>
        </div>
        <p class="hero-search-note">「国勢の間」で、人口・世帯の数字をご覧いただけます。</p>
      </form>

      <aside class="gazette" aria-label="更新のお知らせ">
        <span class="gz-label">
          <img class="gz-icon" src="/images/icon/icon-news.webp" alt="" width="160" height="160" loading="lazy" />
          瓦版
        </span>
        <ul class="gz-list">
          {latestNews.map((n) => (
            <li>
              <time datetime={n.date}>{n.date.slice(5).replace('-', '.')}</time>
              {n.href ? <a href={n.href}>{n.title}</a> : <span>{n.title}</span>}
            </li>
          ))}
        </ul>
        <a class="gz-more" href="/news/">一覧 →</a>
      </aside>
    </div>

    <!-- 展示 -->
    <section id="exhibits">
      <div class="sec-head">
        <img class="sec-icon" src="/images/icon/icon-exhibit.webp" alt="" width="160" height="160" loading="lazy" />
        <div class="sec-text">
          <span class="no">EXHIBITS</span>
          <h2>いまの展示</h2>
        </div>
      </div>
      <div class="cards">
        <a class="card pc" href="/exhibits/utility/">
          <span class="pc-postmark" aria-hidden="true"><i>EXHIBIT</i><b>14</b></span>
          <span class="pc-kind">最高・{heatTop.n}</span>
          <span class="pc-num">{num(heatTop.minutes)}</span>
          <h3>日本一「電気やガスが高い」県はどこだ</h3>
          <p>光熱・水道の消費者物価地域差指数を47都道府県で比較。同じ電気やガスでも、県によって値段の水準は違います。</p>
          <span class="c-place">暮らしの広場</span>
        </a>
        <a class="card pc" href="/exhibits/reading/">
          <span class="pc-postmark" aria-hidden="true"><i>EXHIBIT</i><b>15</b></span>
          <span class="pc-kind">全国平均</span>
          <span class="pc-num">{num(reading.national)}<small>％</small></span>
          <h3>日本一「本を読む」県はどこだ</h3>
          <p>過去1年間に本を読んだ人の割合を47都道府県で比較。マンガを見ると、また別の景色が現れます。</p>
          <span class="c-place">暮らしの広場</span>
        </a>
        <a class="card pc" href="/exhibits/education-price/">
          <span class="pc-postmark" aria-hidden="true"><i>EXHIBIT</i><b>16</b></span>
          <span class="pc-kind">最高・{eduTop.n}</span>
          <span class="pc-num">{num(eduTop.minutes)}</span>
          <h3>日本一「教育にお金がかかる」県はどこだ</h3>
          <p>教育の消費者物価地域差指数を47都道府県で比較。何の値段を見るかで、県の順番は入れかわります。</p>
          <span class="c-place">暮らしの広場</span>
        </a>
      </div>
      <div class="more-actions">
        <a class="more-btn" href="/exhibits/">すべての展示を見る（全{exhibitCount}展示）→</a>
        <a class="more-btn ghost" href="/tower/">展望塔から一望する →</a>
      </div>
    </section>

    <!-- データの仕組み（橙子の高札） -->
    <section class="notice-board" aria-label="この国のデータについて">
      <div class="notice-frame">
        <img class="notice-figure" src="/images/icon/toko-board.webp"
             alt="高札に筆で書き入れる橙子" width="1400" height="788" loading="lazy" />
        <div class="notice-overlay">
          <p>この国の数字は、すべて政府統計の総合窓口〈e-Stat〉のお国の統計から写しています。</p>
          <p>ただ、そのまま並べるだけだと、大きな町の陰にかくれて、小さな町のほんとうの姿が見えにくいんです。</p>
          <p>だから台帳によっては、割合や、人・世帯ごとに均した形に直して、大きな町も小さな町も、同じ物差しで比べられるようにしています。</p>
          <p>数字は、月のはじめにお国の統計をあらためて、新しいものがあれば写し替えているので、いつ来ても、いちばん新しい数字が並んでいます。</p>
        </div>
      </div>
    </section>

    <!-- 閲覧室 -->
    <section id="reading-room">
      <div class="sec-head">
        <img class="sec-icon" src="/images/icon/icon-reading.webp" alt="" width="160" height="160" loading="lazy" />
        <div class="sec-text">
          <span class="no">READING ROOM</span>
          <h2>閲覧室</h2>
        </div>
      </div>
      <div class="cards">
        <a class="card" href="/education/">
          <h3>学びの登記所</h3>
          <p>全国の市区町村から選んで、幼稚園から高校までの学校の数字を自分の手で引き出せます。あなたの町に、学校はいくつ？</p>
          <span class="c-place">閲覧室</span>
        </a>
        <a class="card" href="/muni-finance/">
          <h3>町の台所事情</h3>
          <p>財政力指数、実質収支比率、経常収支比率。あなたの町の「懐具合」を、数字でご覧ください。</p>
          <span class="c-place">閲覧室</span>
        </a>
        <a class="card" href="/population/">
          <h3>国勢の間</h3>
          <p>総人口、高齢化率、世帯数、出生率、婚姻率。あなたの県の「人のかたち」を、数字でご覧ください。</p>
          <span class="c-place">閲覧室</span>
        </a>
      </div>
      <div class="more-actions">
        <a class="more-btn" href="/dashboard/">閲覧室のご案内（全11窓口）→</a>
      </div>
    </section>

    <!-- 案内人 -->
    <section id="guide">
      <div class="sec-head">
        <div class="sec-text">
          <span class="no">GUIDE</span>
          <h2>この国の案内人</h2>
        </div>
      </div>
      <div class="guides">
        <a class="portrait-link" href="/guide/#kei">
          <figure class="portrait">
            <img src="/images/chara/kei-madobe.webp" alt="統計局案内人・京。アーチ窓の内側で書類を抱えて立つ" width="1200" height="670" loading="lazy" />
            <figcaption><b>京</b><span class="romaji">KEI</span><span>統計局案内人</span></figcaption><figcaption><b>京</b><span class="romaji">KEI</span><span>統計局案内人</span></figcaption>
          </figure>
        </a>
        <a class="portrait-link" href="/guide/#touko">
          <figure class="portrait">
            <img src="/images/chara/touko-yano.webp" alt="大正から来た子・橙子。山あいの野道で手を振っている" width="1200" height="670" loading="lazy" />
            <figcaption><b>橙子</b><span class="romaji">TOUKO</span><span>大正から来た子</span></figcaption>
          </figure>
        </a>
      </div>
      <Talk speaker="kei">ようこそCountopia Statsへ。この国では、数字はぜんぶ「景色」です。</Talk>
      <Talk speaker="touko">へぇ……で、まず何を見ればいいの？</Talk>
      <Talk speaker="kei">まずは「時間の広場」へどうぞ。日本一眠らない県の話をしましょう。</Talk>
    </section>
  </main>
</BaseLayout>
<style>
/* ── 製図台と白紙 ───────────────────── */
.desk{
  position:relative;
  width:100vw;
  margin-left:calc(50% - 50vw);
  padding:40px 0 56px;
  margin-bottom:34px;
  background:
    repeating-linear-gradient(90deg, rgba(0,0,0,.055) 0 2px, transparent 2px 9px),
    repeating-linear-gradient(90deg, rgba(255,255,255,.045) 0 1px, transparent 1px 17px),
    linear-gradient(180deg, #8b6b49 0%, #7d5d3e 55%, #6f5236 100%);
  box-shadow:0 22px 30px -14px rgba(30,25,15,.45);
}
/* 天板の上面のハイライト */
.desk::before{
  content:"";
  position:absolute;left:0;right:0;top:0;height:5px;
  background:linear-gradient(180deg,#a88760,#6b5033);
}
/* 天板の厚み（小口）。下に張り出して板に見せる */
.desk::after{
  content:"";
  position:absolute;left:0;right:0;top:100%;height:16px;
  background:
    repeating-linear-gradient(90deg, rgba(0,0,0,.07) 0 3px, transparent 3px 11px),
    linear-gradient(180deg, #5f462d 0%, #4c3822 70%, #3f2e1b 100%);
  box-shadow:0 12px 18px -6px rgba(30,25,15,.5);
}
/* 台に広げた1枚の白紙 */
.sheet{
  position:relative;
  max-width:1360px;
  margin:0 auto;
  padding:40px 4.5% 44px;
  background:#FBFAF5;
  transform:rotate(-.4deg);
  outline:1px solid rgba(40,30,16,.07);
  box-shadow:
    0 1px 2px rgba(28,22,14,.22),
    0 26px 44px -14px rgba(28,22,14,.5);
}
.sheet > *{position:relative;z-index:1}
/* 留めテープ（左右の上隅に斜めがけ） */
.tape{
  position:absolute;top:14px;width:110px;height:24px;
  background:linear-gradient(180deg, rgba(255,253,242,.78), rgba(238,229,200,.62));
  border-left:1px solid rgba(255,255,255,.4);
  border-right:1px solid rgba(255,255,255,.4);
  box-shadow:0 1px 3px rgba(0,0,0,.2);
  pointer-events:none;
}
.tape-l{left:-34px;transform:rotate(-45deg)}
.tape-r{right:-34px;transform:rotate(45deg)}

.hero{
  display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:start;
  padding:8px 0 0;
}
.portrait-link{display:block;text-decoration:none;color:inherit;transition:transform .15s ease}
.portrait-link:hover{transform:translateY(-3px)}
@media(max-width:760px){.hero{grid-template-columns:1fr;padding-top:4px}}
.api-count{
  display:block;font-family:"IBM Plex Mono",monospace;font-size:.78rem;
  color:#2d6a4f;letter-spacing:.04em;margin:8px 0 0;
}
/* タイトルの右下にボタンを置く */
.hero-title-row{display:flex;align-items:flex-end;gap:28px;flex-wrap:wrap}
.hero-title-row .btn{flex-shrink:0;margin-bottom:.5rem}
h1{
  font-family:"Shippori Mincho",serif;font-weight:800;
  font-size:clamp(2rem,5.2vw,3.4rem);line-height:1.35;letter-spacing:.04em;
  margin:0;
}
h1 .num{color:var(--stamp)}
.lead{margin-top:18px;color:var(--ink-soft);font-size:.98rem;max-width:34em}
/* 右カラム：入国印にキャラを重ねる */
.hero-side{
  position:relative;
  display:flex;flex-direction:column;align-items:stretch;
  margin-top:4px;
  min-height:340px;
}
@media(max-width:760px){
  .hero-side{margin-top:8px;min-height:300px}
}
/* 案内人の立ち絵：スタンプの左下に重ねる */
.hero-chara{
  position:absolute;left:-4%;bottom:-16px;
  width:56%;max-width:230px;height:auto;
  z-index:2;
  filter:drop-shadow(0 6px 10px rgba(28,22,14,.14));
}
/* 今月の一数字（紙の上・最下段） */
.today{
  display:flex;align-items:center;gap:16px;
  margin:28px 0 0;
  padding:14px 20px;
  border:1.5px solid var(--ink);border-radius:12px;
  background:#fffdf6;text-decoration:none;color:inherit;
  box-shadow:0 3px 0 var(--ink);
  transition:transform .15s,box-shadow .15s;
}
.today:hover{transform:translateY(-2px);box-shadow:0 5px 0 var(--ink)}
.today-label{
  flex-shrink:0;font-family:"Shippori Mincho",serif;font-weight:800;
  font-size:.72rem;letter-spacing:.16em;color:var(--paper);
  background:var(--ink);border-radius:4px;padding:5px 10px;
}
.today-text{
  flex:1;min-width:0;font-family:"Shippori Mincho",serif;
  font-size:clamp(.88rem,1.6vw,1.08rem);line-height:1.7;
}
.today-more{flex-shrink:0;color:var(--stamp);font-size:1.1rem}
@media(max-width:600px){
  .today{flex-direction:column;align-items:flex-start;gap:8px;margin-top:22px}
  .today-more{align-self:flex-end;margin-top:-24px}
}
/* 県選択（左）＋瓦版（右）：紙の外、方眼の上 */
.hero-row{
  display:flex;gap:20px;align-items:stretch;flex-wrap:wrap;justify-content:center;
  max-width:1140px;margin:0 auto 8px;
}
.hero-search{
  width:340px;flex-shrink:0;
  padding:14px 16px;border:1px solid var(--line);
  border-radius:12px;background:#fff9;
}
@media(max-width:760px){
  .hero-search{width:100%}
}
.hero-search label{
  display:block;font-size:.78rem;color:var(--ink-soft);margin-bottom:8px;
  font-family:"Shippori Mincho",serif;
}
.hero-search-row{display:flex;gap:8px;flex-wrap:wrap}
.hero-search-note{
  margin-top:8px;font-size:.72rem;color:var(--ink-soft);
}
.hero-search select{
  flex:1;min-width:120px;padding:7px 9px;border:1px solid var(--line);
  border-radius:8px;background:#fff;font-size:.85rem;color:inherit;
}
.hero-search button{
  padding:7px 14px;border:1px solid var(--stamp);border-radius:8px;
  background:var(--stamp);color:#fff;font-size:.82rem;cursor:pointer;
  white-space:nowrap;
}
.hero-search button:hover{opacity:.88}
/* 入国印は右端に寄せる（左下にキャラが入るぶんの逃げ） */
.stamp-area{display:flex;justify-content:flex-end;position:relative;z-index:1;padding-right:8%}
/* 中の文字は em 基準にして円のサイズに追従させる */
.stamp{
  width:min(290px,68vw);aspect-ratio:1;border-radius:50%;
  border:5px double var(--stamp);color:var(--stamp);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.14em;
  transform:rotate(-8deg);background:#fff5;
  font-size:min(20px,4.6vw);
  animation:stampIn .5s cubic-bezier(.2,1.6,.4,1) .3s both;
}
@keyframes stampIn{from{transform:rotate(-8deg) scale(1.7);opacity:0}to{transform:rotate(-8deg) scale(1);opacity:1}}
@media(prefers-reduced-motion:reduce){.stamp{animation:none}}
.stamp .top{font-size:.62em;letter-spacing:.34em;font-weight:600}
.stamp .big{font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:1.5em;letter-spacing:.08em}
.stamp .big2{font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:.95em;letter-spacing:.14em;margin-top:-.1em}
.stamp .date{font-family:"IBM Plex Mono",monospace;font-size:.8em;border-top:1.5px solid var(--stamp);border-bottom:1.5px solid var(--stamp);padding:.1em .6em;margin-top:.22em}
.stamp .bottom{font-size:.6em;letter-spacing:.28em;margin-top:.1em}
.gazette{
  flex:1;min-width:340px;max-width:700px;
  display:flex;gap:12px;align-items:center;
  border:1px solid var(--line);border-radius:12px;
  padding:12px 16px;margin:0;background:#fff8;
}
.gz-label{
  display:inline-flex;align-items:center;gap:6px;
  font-family:"Shippori Mincho",serif;font-weight:800;font-size:.78rem;
  color:#b23a2f;border:1.5px solid #b23a2f;border-radius:4px;
  padding:3px 8px;flex-shrink:0;
}
.gz-icon{width:34px;height:34px;object-fit:contain;mix-blend-mode:multiply}
.gz-list{list-style:none;margin:0;padding:0;flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}
