import BaseLayout from '../../../layouts/BaseLayout.astro';
import Talk from '../../../components/Talk.astro';
import HeroFig from '../../../components/HeroFig.astro';
---
<BaseLayout title="小さな町の1位は、あてにならない｜統計の歩き方 - Countopia Stats" description="人口の少ない町の「人口あたり」は大きく揺れます。ファンネルプロット、見込みの数との比、経験ベイズ推定の読み方。" backHref="/how-to-read/" backLabel="歩き方">
  <main class="art">
    <HeroFig src="/images/icon/small-towns-large.webp" alt="山あいの村と遠くの町を見下ろす丘の上の机で、大きな升と、豆がこぼれる小さな升を橙子がのぞきこむ水彩画" width={1400} height={782} eager>
      <p class="art-kicker">HOW TO READ</p>
      <h1><span class="nw">小さな町の1位は、</span><span class="nw">あてにならない</span></h1>
    </HeroFig>

    <Talk speaker="touko">
      京、人口10万人あたりの順位を見たら、上のほうに知らない小さな村ばかり並んでいるの。
    </Talk>
    <Talk speaker="kei">
      人口あたりの数字では、よくあることです。人口が少ないと、数が1つ増えるだけで、割り算の答えが大きく跳ねるのです。
    </Talk>

    <section class="art-sec">
      <h2>1つの差が、どれだけ響くか</h2>
      <p>
        人口1,000人の村に施設が1つあれば、人口10万人あたりでは100。2つになれば200です。
        人口100万人の市で同じ100から200になるには、施設が1,000から2,000に増えなければなりません。
        小さな町の「人口あたり」は、ほんの少しの出来事で上にも下にも大きく動きます。
        ですから、順位表の1位が小さな町でも、それが偶然のゆらぎなのか、本当にちがうのかは、順位だけでは分かりません。
      </p>
    </section>

