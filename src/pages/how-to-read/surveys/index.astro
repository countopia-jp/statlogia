---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Talk from '../../../components/Talk.astro';
const hasHero = fs.existsSync(path.join(process.cwd(), 'public/images/icon/surveys-large.webp'));

// この国の数字のもとになっている主な調査。kind: all=全数 / sample=標本 / record=業務記録・届け出 / derived=加工統計
const SURVEYS = [
  { name: '国勢調査', who: '総務省', cycle: '5年ごと', kind: 'all', what: '日本に住むすべての人と世帯。人数、年齢、世帯のかたち、働き方、通勤・通学先など。', used: '国勢の間・わが町の人口・働き方の帳場・わが町の世帯のかたち など' },
  { name: '住民基本台帳人口移動報告', who: '総務省', cycle: '毎月', kind: 'record', what: '市区町村に出された転入届をもとに、ほかの市区町村・都道府県から引っ越してきた人の数。', used: '県の人の出入り・わが町の人の出入り' },
  { name: '家計調査', who: '総務省', cycle: '毎月', kind: 'sample', what: '選ばれた全国約9,000世帯に家計簿をつけてもらい、収入と、何にいくら使ったかを集める。市ごとの値は県庁所在市と政令指定都市のみ。', used: '家計の帳場・食卓や暮らしの展示（パン・コーヒー・日本酒など）' },
  { name: '全国家計構造調査（旧・全国消費実態調査）', who: '総務省', cycle: '5年ごと', kind: 'sample', what: '家計調査より多い世帯を対象に、家にある道具や家計の中身をくわしく調べる。', used: '暮らしの道具' },
  { name: '社会生活基本調査', who: '総務省', cycle: '5年ごと', kind: 'sample', what: '10歳以上の人に、1日の時間の使い方と、この1年に趣味・スポーツ・学習・ボランティアなどをしたかを聞く。2021年は約9万世帯が対象。', used: '時間・スポーツ・趣味の展示、余暇の過ごし方・ボランティア' },
  { name: '住宅・土地統計調査', who: '総務省', cycle: '5年ごと', kind: 'sample', what: '選ばれた地域の住宅と世帯について、建て方・広さ・建てた年・設備、空き家などを調べる。', used: '暮らしの見積所・家のつくりと設備・住まいの広さ・空き家や一戸建ての展示' },
  { name: '経済センサス', who: '総務省・経済産業省', cycle: '5年ごと（活動調査）', kind: 'all', what: 'すべての事業所と企業について、業種、働く人の数、売り上げなどを調べる。', used: 'わが町の業種・事業所の大きさ・お店と商い・工場とお店' },
  { name: '学校基本調査', who: '文部科学省', cycle: '毎年', kind: 'all', what: '幼稚園から大学まですべての学校について、学校の数、子どもの数、先生の数、卒業後の進路などを調べる。', used: '学びの登記所・学校のつくり・卒業したあと・大学と専門学校' },
  { name: '社会教育調査', who: '文部科学省', cycle: '3年ごと', kind: 'all', what: '図書館・博物館・公民館・体育施設などの数と、そこで開かれた講座や利用のようすを調べる。', used: '文化施設・図書館の利用・運動の場・学びの場と集い' },
  { name: '医師・歯科医師・薬剤師統計', who: '厚生労働省', cycle: '2年ごと', kind: 'record', what: '医師・歯科医師・薬剤師が国に出す届け出をもとに、どこで何人が働いているかをまとめる。', used: '医療の担い手・わが町の医療' },
  { name: '衛生行政報告例', who: '厚生労働省', cycle: '毎年（看護職などは2年ごと）', kind: 'record', what: '都道府県などが国に報告する、看護師・保健師・助産師の人数や薬局の数など。', used: '医療の担い手' },
  { name: '社会福祉施設等調査', who: '厚生労働省', cycle: '毎年', kind: 'all', what: '保育所・老人ホームなどの福祉施設の数、定員、利用している人の数を調べる。', used: '保育所・老人ホーム・子どもと高齢者の施設' },
  { name: '職業安定業務統計', who: '厚生労働省', cycle: '毎月', kind: 'record', what: 'ハローワークでの求人・求職・就職の件数。民間の求人サイトなどで決まった仕事は入らない。', used: '働き方の帳場・働き方のかたち（有効求人倍率）' },
  { name: '建築着工統計調査', who: '国土交通省', cycle: '毎月', kind: 'record', what: '建物を建てるときに出す届け出をもとに、新しく建て始めた住宅の数や床面積をまとめる。', used: '家の建ちかた・家のつくりと設備' },
  { name: '宿泊旅行統計調査', who: '観光庁', cycle: '毎月', kind: 'sample', what: 'ホテルや旅館に、泊まった人の数、県外や外国から来た人の割合などを聞く。', used: '宿と観光' },
  { name: '地方財政状況調査（決算統計）', who: '総務省', cycle: '毎年', kind: 'record', what: 'すべての都道府県と市区町村の決算。お金の入り口（税・交付税など）と使いみち。', used: '別館の県のお金・町のお金の窓口' },
  { name: '県民経済計算', who: '内閣府・各都道府県', cycle: '毎年', kind: 'derived', what: 'いろいろな統計を組み合わせて計算する、県の経済の大きさや所得。', used: '県のふところ' },
  { name: '気象観測', who: '気象庁', cycle: '毎日の観測を毎年まとめる', kind: 'record', what: '各地の気象台が測った気温・降水量・日照時間など（県庁所在地などの値）。', used: '空の帳場・日照や雪の展示' },
];
const KIND = {
  all: ['全部を数える', 'all'],
  sample: ['一部を選んで推し量る', 'sample'],
  record: ['届け出・業務の記録', 'record'],
  derived: ['ほかの統計から計算', 'derived'],
};
---
<BaseLayout title="数字のもとになった調査｜統計の歩き方 - Countopia Stats" description="この国の数字は、どんな調査から来ているのか。国勢調査・家計調査・社会生活基本調査など、主な調査を、だれが・何を・どのくらいの間隔で調べているかで紹介します。" backHref="/how-to-read/" backLabel="歩き方">
  <main class="art">
    <header class="art-hero">
      {hasHero && <img class="art-hero-figure" src="/images/icon/surveys-large.webp" alt="腕章をつけた調査員が坂の町の家の玄関先で封筒を手渡し、窓の向こうの役所では職員たちが積まれた調査票の束を仕分けている水彩画" width="1400" height="788" loading="lazy" />}
      <p class="art-kicker">HOW TO READ</p>
      <h1>数字のもとになった調査</h1>
    </header>

    <Talk speaker="touko">
      ねえ京、この国の数字は、e-Statという窓口から写しているのでしょう。では、その前は？　だれがどうやって数えたのかしら。
    </Talk>
    <Talk speaker="kei">
      e-Statは、国のいろいろな調査の結果を集めた棚です。棚に並ぶ前に、それぞれの役所が調査をしています。この国で使っている主な調査を、まとめてご案内しましょう。
    </Talk>
    <Talk speaker="touko">
      国勢調査なら知っているわ。わたくしの頃に、はじめて行われたのよ。
    </Talk>
    <Talk speaker="kei">
      大正九年、1920年が第1回です。いまも五年ごとに続いています。ただ、調査のやり方は一つではありません。大きく分けると四つあります。
    </Talk>

    <section class="art-sec">
      <h2>調べ方は、四つに分けられる</h2>
      <dl class="sv-kinds">
        <div><dt><span class="sv-tag all">全部を数える</span></dt><dd>対象をひとつ残らず調べます（全数調査）。国勢調査や学校基本調査がそうです。小さな町の数字まで出せるのが強みですが、手間が大きいので、何年かに一度になりがちです。</dd></div>
        <div><dt><span class="sv-tag sample">一部を選んで推し量る</span></dt><dd>全体からくじのように選んだ一部の世帯や人に聞き、全体の姿を推し量ります（標本調査）。家計調査や社会生活基本調査がそうです。くわしいことを聞けますが、選び方によるゆれがあるので、県どうしの小さな差はそのまま受け取らないほうが安全です。</dd></div>
        <div><dt><span class="sv-tag record">届け出・業務の記録</span></dt><dd>調査のために聞くのではなく、引っ越しの届けや、建物を建てるときの届け、ハローワークの受付など、役所の仕事の記録を数え上げたものです。毎月出せるものが多い一方、届け出の外にあるもの（民間の求人サイトで決まった仕事など）は入りません。</dd></div>
        <div><dt><span class="sv-tag derived">ほかの統計から計算</span></dt><dd>いくつもの統計を組み合わせて、直接は数えられない大きさを計算したものです（加工統計）。県民経済計算がそうです。</dd></div>
      </dl>
    </section>

    <Talk speaker="touko">
      全部を数えるものと、一部から推し量るものがあるのね。
    </Talk>
    <Talk speaker="kei">
      はい。展示で「0.1ポイントの差は調査のゆれの範囲」と書いてあるのは、一部から推し量る調査だからです。
    </Talk>

    <section class="art-sec">
      <h2>この国で使っている主な調査</h2>
      <p>窓口や展示のいちばん下にある出典の行に、もとの調査の名前を書いています。主なものは次のとおりです。</p>
      <div class="sv-list">
        {SURVEYS.map((s) => (
          <article class="sv-card">
            <h3>{s.name}</h3>
            <p class="sv-meta"><span>{s.who}</span><span>{s.cycle}</span><span class={`sv-tag ${KIND[s.kind][1]}`}>{KIND[s.kind][0]}</span></p>
            <p class="sv-what">{s.what}</p>
            <p class="sv-used">この国では：{s.used}</p>
          </article>
        ))}
      </div>
      <p class="art-note">※ほかにも、消防庁の消防年報や、都道府県の統計など、いくつかの調査を使っています。それぞれの窓口の注記と出典をご覧ください。</p>
    </section>

    <Talk speaker="touko">
      ずいぶんたくさんの役所が、それぞれに数えているのねえ。
    </Talk>
    <Talk speaker="kei">
      ですから、同じ「人の数」でも、調査によって少しずつ数字が違うことがあります。どの調査の、いつの数字かを、出典で確かめてから読んでいただけると安心です。
    </Talk>

    <section class="art-sec">
      <h2>くわしく知りたいとき</h2>
      <p>
        それぞれの調査のやり方や、言葉の定義は、調査をしている役所のページに書かれています。
        e-Statの表からも、もとの調査の説明へたどることができます。表番号は<a href="/sources/">出典一覧</a>に載せています。
      </p>
    </section>

    <p class="art-links">
      <a href="/how-to-read/data-source/">データの出どころ（e-Stat） →</a><br />
      <a href="/how-to-read/data-lag/">いちばん新しい数字が、数年前なわけ →</a><br />
      <a href="/how-to-read/">歩き方の一覧へ →</a>
    </p>
  </main>

  <style>
    .art { max-width: 760px; margin: 0 auto; padding: 0 16px 56px; }
    .art-hero { text-align: center; padding: 32px 0 16px; }
    .art-hero-figure { display: block; width: 100%; max-width: 780px; height: auto; border-radius: 4px; margin: 0 auto 20px; }
    .art-kicker { font-family: "IBM Plex Mono", monospace; letter-spacing: 0.3em; font-size: 0.72rem; color: #b23a2f; }
    .art-hero h1 { font-family: "Shippori Mincho", serif; font-weight: 800; margin: 6px 0 0; font-size: 1.5rem; }
    .art-sec { padding: 16px 0; }
    .art-sec h2 { font-family: "Shippori Mincho", serif; font-weight: 800; font-size: 1.05rem; border-left: 4px solid #1b4332; padding-left: 10px; margin-bottom: 10px; }
    .art-sec p { line-height: 2; font-size: 0.92rem; color: #333; margin: 0 0 12px; }
    .art-sec a { color: #b23a2f; }
    .art-note { font-size: 0.8rem !important; color: #777 !important; }
    .sv-kinds { margin: 0; display: grid; gap: 12px; }
    .sv-kinds div { background: #fff; border: 1px solid #e0e0d8; border-radius: 10px; padding: 12px 14px; }
    .sv-kinds dt { margin-bottom: 6px; }
    .sv-kinds dd { margin: 0; line-height: 1.9; font-size: 0.9rem; color: #333; }
    .sv-tag { display: inline-block; font-size: 0.74rem; font-weight: 700; padding: 2px 10px; border-radius: 999px; border: 1px solid currentColor; }
    .sv-tag.all { color: #1b4332; background: #e4eee7; }
    .sv-tag.sample { color: #8a4b12; background: #f8ecd9; }
    .sv-tag.record { color: #2c4a6b; background: #e3ebf3; }
    .sv-tag.derived { color: #6a3d6a; background: #f0e6f0; }
    .sv-list { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 8px; }
    @media (max-width: 640px) { .sv-list { grid-template-columns: 1fr; } }
    .sv-card { background: #fff; border: 1px solid #e0e0d8; border-radius: 10px; padding: 14px 16px; }
    .sv-card h3 { font-family: "Shippori Mincho", serif; font-weight: 800; font-size: 1rem; margin: 0 0 6px; }
    .sv-meta { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; font-size: 0.78rem !important; color: #555 !important; margin: 0 0 6px !important; line-height: 1.6 !important; }
    .sv-what { font-size: 0.86rem !important; line-height: 1.85 !important; margin: 0 0 6px !important; }
    .sv-used { font-size: 0.78rem !important; color: #666 !important; line-height: 1.7 !important; margin: 0 !important; }
    .art-links { text-align: center; margin-top: 32px; font-size: 0.9rem; line-height: 2.2; }
    .art-links a { color: #b23a2f; }
  </style>
</BaseLayout>
