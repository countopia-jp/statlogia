---
// =====================================================
// Statlogia - 案内人紹介ページ（知秋と一葉）
// src/pages/guide/index.astro
// =====================================================
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Talk from '../../components/Talk.astro';
const img = (name) => (fs.existsSync(path.join(process.cwd(), 'public/images/chara', name)) ? `/images/chara/${name}` : null);
const chiakiDesk = img('chiaki-desk.webp');
const hitohaDesk = img('hitoha-desk.webp');
const duoPoint = img('duo-point-scene.webp');
const chiakiShrine = img('chiaki-shrine.webp');
const hitohaBike = img('hitoha-bike.webp');
---

<BaseLayout title="研究員｜知秋と一葉｜Statlogia" description="Statlogia を案内する二人の研究員、白衣の小さな先生・知秋と、見習いの一葉のご紹介。名前の由来と、二人の話し方。" backHref="/" backLabel="玄関">
  <main class="guide-page">
    <header class="guide-hero">
      <p class="guide-kicker">案内</p>
      <h1>この都市の研究員</h1>
      <p class="guide-lead">
        Statlogia を案内する、二人の研究員をご紹介します。<br />
        小さな先生の知秋と、見習いの一葉。年の順と教える順が、逆さまの二人です。
      </p>
      <p class="guide-gallery-line"><a class="guide-gallery-btn" href="/gallery/"><i aria-hidden="true">GALLERY</i>日々のイラスト集<em aria-hidden="true">→</em></a></p>
      {duoPoint && <img class="guide-duo" src={duoPoint} width="1376" height="768" alt="紙を留めたコルクボードの前に並んで立つ一葉と知秋" loading="eager" />}
    </header>

    <section class="guide-profile" id="chiaki">
      <div class="guide-frames">
        {chiakiDesk && (
          <a class="guide-portrait" href="/gallery/chiaki/" title="知秋の日々（イラスト集）へ">
            <span class="guide-portrait-mat"><img src={chiakiDesk} alt="研究室の机で、方眼紙を虫めがねでのぞきこむ知秋。机の端に丼と七味" width="1376" height="768" loading="lazy" /></span>
            <span class="guide-portrait-cap">知秋の日々 →</span>
          </a>
        )}
        {chiakiShrine && (
          <figure class="guide-portrait guide-snap">
            <span class="guide-portrait-mat"><img src={chiakiShrine} alt="杉木立の参道。白い着物に鶴の模様、巾着を提げて歩く知秋。奥に朱の鳥居と石段" width="1376" height="768" loading="lazy" /></span>
            <figcaption class="guide-portrait-cap">初詣</figcaption>
          </figure>
        )}
      </div>
      <div class="guide-text">
        <span class="guide-no">RESEARCHER 01</span>
        <h2>知秋<span class="guide-romaji">CHIAKI</span><span class="guide-role">教授</span></h2>
        <p>
          白衣の小さな教授。数字から読めることは読み、読めないことは「この数字だけでは分からぬ」と言う。数字に書いていない理由を推測するときは、必ず「わたしの仮説だが」と断ります。この都市では、その仮説に「知秋理論」という札が付きます。ふだんは「うむ、これはだね」の調子ですが、重い数字の前では口数が減ります。激辛が好きで、七味を常に持ち歩いています。休みの日は神社を巡るのが好きで、古い社ほど足を運びます。
        </p>
        <Talk speaker="chiaki">うむ。順位だけ見て帰るのはもったいない。隣の数字も並べてごらん。</Talk>
      </div>
    </section>

    <section class="guide-profile" id="hitoha">
      <div class="guide-frames">
        {hitohaDesk && (
          <a class="guide-portrait" href="/gallery/hitoha/" title="一葉の日々（イラスト集）へ">
            <span class="guide-portrait-mat"><img src={hitohaDesk} alt="研究室の机で、クリップボードにメモを取る一葉。机にフィナンシェと紅茶" width="1376" height="768" loading="lazy" /></span>
            <span class="guide-portrait-cap">一葉の日々 →</span>
          </a>
        )}
        {hitohaBike && (
          <figure class="guide-portrait guide-snap">
            <span class="guide-portrait-mat"><img src={hitohaBike} alt="田舎道のカーブ。ヘルメットをかぶり、白衣を風になびかせて小さなバイクで走る一葉" width="1376" height="768" loading="lazy" /></span>
            <figcaption class="guide-portrait-cap">町へ出る日</figcaption>
          </figure>
        )}
      </div>
      <div class="guide-text">
        <span class="guide-no">RESEARCHER 02</span>
        <h2>一葉<span class="guide-romaji">HITOHA</span><span class="guide-role">研究員（見習い）</span></h2>
        <p>
          この春に来た見習いの研究員。姉妹サイト Countopia の出身で、あちらの案内人・京の後輩にあたります。分からないことは、その場で「それはどういうことですか」「なぜですか」と聞く。驚くのも、感心するのも、だいたい一葉の役です。甘いものが好きで、とくにフィナンシェに目がありません。
        </p>
        <Talk speaker="hitoha">先生、それは数字から読めることですか。それとも、先生の仮説ですか。</Talk>
      </div>
    </section>

    <p class="guide-note">
      二人の名前は、四字熟語「<b>一葉知秋</b>（いちようちしゅう）」——「<b>一葉</b>落ちて天下の<b>秋を知る</b>」から。一枚の葉から季節を推し量るように、一部の数字から全体を読む。それが統計の仕事です。ただし、一葉だけで秋と決めてよいのか、と問い続けるのも、同じ仕事のうちです。
    </p>

    <nav class="guide-links" aria-label="三つの棟へ">
      <a class="guide-wing" href="/dashboard/"><i aria-hidden="true">01</i><b>情報棟</b><small>引く</small><em aria-hidden="true">→</em></a>
      <a class="guide-wing" href="/analysis/"><i aria-hidden="true">02</i><b>研究棟</b><small>考える</small><em aria-hidden="true">→</em></a>
      <a class="guide-wing" href="/how-to-read/"><i aria-hidden="true">03</i><b>講義棟</b><small>学ぶ</small><em aria-hidden="true">→</em></a>
    </nav>
  </main>

  <style>
    .guide-page { max-width: 1040px; margin: 0 auto; padding: 0 16px 56px; }
    .guide-hero { text-align: center; padding: 32px 0 8px; }
    .guide-duo { display: block; width: 100%; max-width: 900px; height: auto; margin: 22px auto 0; border-radius: 6px; }
    .guide-kicker { font-family: "IBM Plex Mono", monospace; font-size: .74rem; letter-spacing: .22em; font-weight: 600; color: var(--stamp); margin: 0; }
    .guide-hero h1 { font-family: "Shippori Mincho", serif; font-weight: 800; margin: 6px 0 12px; }
    .guide-lead { color: var(--ink-soft); line-height: 1.9; }
    /* イラスト集への札：玄関の出典一覧・情報棟の案内所と同じ形 */
    .guide-gallery-line { margin: 12px 0 0; text-align: center; }
    .guide-gallery-btn { display: inline-flex; align-items: center; gap: 8px; padding: 5px 12px 5px 8px; border: 1.5px solid var(--ink); border-radius: 999px; color: var(--ink); background: rgba(255,255,255,.6); text-decoration: none; font-weight: 600; font-size: .86rem; line-height: 1; transition: background .2s, color .2s; }
    .guide-gallery-btn i { font-style: normal; font-family: "IBM Plex Mono", monospace; font-size: .6rem; letter-spacing: .18em; padding: 3px 7px; border-radius: 999px; background: var(--ink); color: #fff; }
    .guide-gallery-btn em { font-style: normal; transition: transform .2s; }
    .guide-gallery-btn:hover, .guide-gallery-btn:focus-visible { background: var(--ink); color: #fff; }
    .guide-gallery-btn:hover i, .guide-gallery-btn:focus-visible i { background: #fff; color: var(--ink); }
    .guide-gallery-btn:hover em, .guide-gallery-btn:focus-visible em { transform: translateX(3px); }
    .guide-gallery-btn:visited { color: var(--ink); }
    .guide-profile { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; margin: 48px 0; scroll-margin-top: 90px; }
    /* 机まわりの絵は壁に掛けたフォトフレーム：木の額＋厚紙のマット＋下に小さな銘板（イラスト集への入口） */
    /* 10-24 研究員ひとりにつき額を2枚。1枚目は日々のイラスト集への入口、2枚目は休みの日の一枚。
       広い画面では横に並べ、720px以下では縦に積む */
    .guide-frames { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; width: 100%; max-width: 860px; align-items: start; }
    @media (max-width: 720px) { .guide-frames { grid-template-columns: minmax(0, 1fr); gap: 24px; max-width: 460px; } }
    .guide-snap { margin: 0; }
    .guide-snap:hover { transform: none; }
    /* 2枚目は押せないので、札の下線（押せる合図）は付けない */
    .guide-snap .guide-portrait-cap { border-bottom: none; }

    .guide-portrait { position: relative; display: block; color: inherit; text-decoration: none; padding: 7px; border-radius: 2px; background: linear-gradient(160deg, #7a6250 0%, #5a4636 40%, #6a533f 70%, #4e3b2c 100%); box-shadow: inset 1px 1px 0 rgba(255,255,255,.28), inset -1px -1px 0 rgba(0,0,0,.35), 0 1px 0 rgba(255,255,255,.4), 0 14px 30px -10px rgba(31,42,68,.35), 0 3px 6px rgba(0,0,0,.14); transition: transform .25s ease, box-shadow .25s ease; }
    .guide-portrait:hover, .guide-portrait:focus-visible { transform: rotate(0) translateY(-3px); box-shadow: inset 1px 1px 0 rgba(255,255,255,.28), inset -1px -1px 0 rgba(0,0,0,.35), 0 1px 0 rgba(255,255,255,.4), 0 22px 40px -12px rgba(31,42,68,.4), 0 3px 6px rgba(0,0,0,.14); }
    .guide-portrait-mat { display: block; background: #F4F0E6; padding: 22px 22px 46px; box-shadow: inset 0 0 0 1px rgba(0,0,0,.05); }
    .guide-portrait img { display: block; width: 100%; height: auto; border-radius: 0; box-shadow: 0 0 0 1px rgba(0,0,0,.14), inset 0 0 0 1px rgba(255,255,255,.6), 0 0 0 4px #ECE6D8, 0 0 0 5px rgba(0,0,0,.08), inset 0 2px 6px rgba(0,0,0,.12); }
    .guide-portrait-cap { position: absolute; left: 50%; bottom: 17px; transform: translateX(-50%); white-space: nowrap; font-family: "Shippori Mincho", serif; font-size: .8rem; letter-spacing: .14em; color: #4B5570; padding: 0 .4em .15em; border-bottom: 1px solid rgba(75,85,112,.45); }
    #chiaki .guide-portrait { transform: rotate(-.6deg); }
    #hitoha .guide-portrait { transform: rotate(.5deg); }
    #chiaki .guide-snap { transform: rotate(.7deg); }
    #hitoha .guide-snap { transform: rotate(-.6deg); }
    #chiaki .guide-portrait:hover, #hitoha .guide-portrait:hover, #chiaki .guide-portrait:focus-visible, #hitoha .guide-portrait:focus-visible { transform: rotate(0) translateY(-3px); }
    .guide-no { display: block; text-align: center; font-family: "IBM Plex Mono", monospace; letter-spacing: 0.2em; font-size: 0.72rem; color: var(--ink-soft); }
    .guide-text { max-width: 640px; text-align: left; }
    .guide-text h2 { font-family: "Shippori Mincho", serif; font-weight: 800; font-size: 1.5rem; margin: 6px 0 14px; display: flex; align-items: baseline; justify-content: center; gap: 10px; flex-wrap: wrap; }
    .guide-romaji { font-family: "IBM Plex Mono", monospace; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.16em; color: var(--stamp); }
    .guide-role { font-size: 0.75rem; font-weight: 400; color: #888; }
    .guide-text > p { text-align: left; line-height: 2; font-size: 0.92rem; color: #333; margin: 0 0 14px; }
    .guide-note { margin-top: 40px; padding: 16px 20px; border: 1px dashed var(--stamp); border-radius: 8px; font-size: 0.88rem; color: #444; line-height: 1.9; background: #fdfdf8; }
    /* 三つの棟への札：玄関の三棟カードの館名板と同じ系統（紺の板に番号、入口の形） */
    .guide-links { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; margin-top: 36px; }
    .guide-wing { display: inline-flex; align-items: center; gap: 10px; padding: 8px 16px 8px 10px; border: 1.5px solid var(--ink); border-radius: 12px 12px 4px 4px; color: var(--ink); background: rgba(255,255,255,.6); text-decoration: none; transition: background .2s, color .2s, transform .2s; }
    .guide-wing i { font-style: normal; font-family: "IBM Plex Mono", monospace; font-size: .62rem; letter-spacing: .14em; padding: 3px 7px; border-radius: 3px; background: var(--ink); color: #F0B78A; font-weight: 600; }
    .guide-wing b { font-family: "Shippori Mincho", serif; font-weight: 800; font-size: 1.02rem; }
    .guide-wing small { font-size: .74rem; color: var(--ink-soft); letter-spacing: .1em; }
    .guide-wing em { font-style: normal; transition: transform .2s; }
    .guide-wing:hover, .guide-wing:focus-visible { background: var(--ink); color: #fff; transform: translateY(-2px); }
    .guide-wing:hover small, .guide-wing:focus-visible small { color: rgba(255,255,255,.8); }
    .guide-wing:hover i, .guide-wing:focus-visible i { background: #fff; color: var(--ink); }
    .guide-wing:hover em, .guide-wing:focus-visible em { transform: translateX(3px); }
    .guide-wing:visited { color: var(--ink); }
    @media (max-width: 600px) { .guide-links { flex-direction: column; align-items: stretch; } .guide-wing { justify-content: space-between; } }
  </style>
</BaseLayout>
