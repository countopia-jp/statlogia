---
// 県の台帳：1つの都道府県について、閲覧室のいろいろな数字を計器盤で（47ページをビルド時に作る）
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Talk from '../../../components/Talk.astro';
import AreaLedgerStyle from '../../../components/AreaLedgerStyle.astro';
import { getPrefLedger, prefRows, getTownLedger } from '../../../lib/area-ledger.js';

export async function getStaticPaths() {
  const ledger = await getPrefLedger();
  return ledger.prefs.map((p) => ({ params: { pref: p.c.slice(0, 2) }, props: { code: p.c, name: p.n } }));
}
const { code, name } = Astro.props;
const ledger = await getPrefLedger();
const tl = await getTownLedger();
const prefNo = code.slice(0, 2);
const towns = tl.towns.filter((t) => t.c.startsWith(prefNo));
const groups = prefRows(ledger, code);
const fmt = (v, d) => (typeof v === 'number' && Number.isFinite(v) ? v.toLocaleString('ja-JP', { minimumFractionDigits: d, maximumFractionDigits: d }) : null);
const total = groups.reduce((n, g) => n + g.rows.length, 0);
---
<BaseLayout title={`${name}の台帳｜Countopia Stats`} description={`${name}の人口・気候・物価・給与・県のお金・観光・文化施設など${total}の数字を一覧で。それぞれの数字の年と、47都道府県の中の順位、くわしく見られる窓口つき。`} backHref="/tower/" backLabel="展望塔">
  <AreaLedgerStyle />
  <main class="al">
    <div class="sec-head">
      <span class="no">OBSERVATORY｜都道府県</span>
      <h1>{name}の台帳</h1>
      <p class="sub">閲覧室と別館の窓口から、{name}の数字を{total}項目、計器盤に写しました。計器を押すと、その数字の窓口でくわしく見られます。</p>
    </div>

    <section class="tw-picker">
      <label>
        <span>都道府県</span>
        <select id="twPref" onchange="if(this.value)location.href='/tower/'+this.value+'/'">
          {ledger.prefs.map((p) => <option value={p.c.slice(0, 2)} selected={p.c === code}>{p.n}</option>)}
        </select>
      </label>
      <label>
        <span>市区町村</span>
        <select id="twTown" onchange={`if(this.value)location.href='/tower/town/${prefNo}/#'+this.value`}>
          <option value="">{name}全体（このページ）</option>
          {towns.map((t) => <option value={t.c}>{t.n}</option>)}
        </select>
      </label>
    </section>

    <div class="al-talk">
      <Talk speaker="kei">{name}の数字を、分野ごとに並べました。順位は、数字の大きいほうから数えたもので、良し悪しを表すものではありません。</Talk>
      <Talk speaker="touko">ひとつの県のことが、帳面一枚にまとまっているのね。</Talk>
    </div>

    {groups.map((g) => (<>
      <h2 class="board-head">{g.title}</h2>
      <div class="board">
        {g.rows.map((r) => (
          <a class="gauge" href={r.href}>
            <span class="g-label">{r.label}</span>
            {fmt(r.v, r.decimals) !== null
              ? <span class="g-value">{fmt(r.v, r.decimals)}{r.unit && <small>{r.unit}</small>}</span>
              : <span class="g-value small">値なし</span>}
            <span class="g-unit">
              {r.year}<br />
              {r.compare && fmt(r.compare.v, r.decimals) !== null ? <>{r.compare.label} {fmt(r.compare.v, r.decimals)}{r.unit}<br /></> : null}
              {r.rank ? <>47都道府県の中で <b>{r.rank}</b>位（{r.rankWord}）</> : null}
            </span>
            <span class="g-link">→ {r.room}で見る</span>
          </a>
        ))}
      </div>
    </>))}

    <p class="al-note">
      数字はすべて、政府統計の総合窓口（e-Stat）から取ったもので、項目ごとに調べた年が違います。全国の値がない項目や、全国の値が合計になる項目は、47都道府県の平均を出しています。家計の数字は、県庁所在市の二人以上の世帯の値です。総人口・世帯数・高齢化率・年少人口率・婚姻率の全国の値は、47都道府県の数字から計算したもの（総数は合計、割合は人口で重みづけた平均）で、国の公表値と小数の位で少し違うことがあります。同じ値の県は同じ順位にしています。くわしい定義と注意は、それぞれの窓口の注記をご覧ください。
    </p>
  </main>
</BaseLayout>
