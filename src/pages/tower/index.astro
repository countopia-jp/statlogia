---
// 展望塔：日本全体の数字を一望し、そこから都道府県・市区町村の台帳へ降りていく
// （2026-10-13 に計器の展望塔から、地域の台帳に換装）
import BaseLayout from '../../layouts/BaseLayout.astro';
import Talk from '../../components/Talk.astro';
import AreaLedgerStyle from '../../components/AreaLedgerStyle.astro';
import { getPrefLedger, nationalRows } from '../../lib/area-ledger.js';
const pl = await getPrefLedger();
const nat = nationalRows(pl);
const natCount = nat.reduce((n, g) => n + g.rows.length, 0);
const fmt = (v, d) => (typeof v === 'number' && Number.isFinite(v) ? v.toLocaleString('ja-JP', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—');
const REGIONS = [
  ['北海道・東北', 1, 7], ['関東', 8, 14], ['中部', 15, 23], ['近畿', 24, 30], ['中国', 31, 35], ['四国', 36, 39], ['九州・沖縄', 40, 47],
];
const inRegion = (from, to) => pl.prefs.filter((p) => { const n = Number(p.c.slice(0, 2)); return n >= from && n <= to; });
---
<BaseLayout title="展望塔｜Countopia Stats" description="日本全体の数字を一望し、都道府県や市区町村を1つ選んで、人口・気候・物価・給与・住まい・施設など、いろいろな数字を一枚の台帳で見られる展望塔。" backHref="/" backLabel="玄関">
  <AreaLedgerStyle />
  <main class="al">
    <header class="al-head">
      <p class="al-kicker">展望塔</p>
      <h1>この国を、上から見渡す</h1>
      <p class="al-lead">閲覧室は「数字を選んで、土地を見る」窓口です。<br />展望塔は逆に「土地を選んで、いろいろな数字を見る」ところです。<br />まず日本全体を見渡して、それから県へ、町へと降りていけます。</p>
    </header>
    <div class="al-talk">
      <Talk speaker="kei">展望塔へようこそ。閲覧室と別館の窓口から、土地ごとの数字を写した台帳をお出しします。まずは日本全体から。</Talk>
      <Talk speaker="touko">まあ、高いところから見ると、国じゅうが帳面みたいね。</Talk>
    </div>

    <p class="al-jump"><a href="#japan">日本全体の数字</a>／<a href="#pref">都道府県の台帳</a>／<a href="#town">市区町村の台帳</a></p>
    <h2 class="al-bighead" id="japan">日本全体の数字</h2>
    <p class="al-lead">全国の値がある{natCount}項目です。項目の名前を押すと、県ごとの数字を窓口で見られます。</p>
    {nat.map((g) => (
      <section class="al-group">
        <h2>{g.title}</h2>
        <table class="al-table">
          <thead><tr><th>項目</th><th>全国</th><th>年</th></tr></thead>
          <tbody>
            {g.rows.map((r) => (
              <tr>
                <td class="al-label"><a href={r.href}>{r.label}</a><span class="al-room">{r.room}</span></td>
                <td class="al-val">{fmt(r.v, r.decimals)}<small>{r.unit}</small></td>
                <td class="al-year" data-h="年">{r.year}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}
    <h2 class="al-bighead" id="pref">都道府県の台帳</h2>
    <section class="al-group">
      {REGIONS.map(([r, a, b]) => (<>
        <p class="al-region">{r}</p>
        <div class="al-list">{inRegion(a, b).map((p) => <a href={`/tower/${p.c.slice(0, 2)}/`}>{p.n}</a>)}</div>
      </>))}
    </section>
    <h2 class="al-bighead" id="town">市区町村の台帳</h2>
    <section class="al-group">
      <p class="al-lead">都道府県を選ぶと、その中の市区町村を選べるページへ進みます。</p>
      {REGIONS.map(([r, a, b]) => (<>
        <p class="al-region">{r}</p>
        <div class="al-list">{inRegion(a, b).map((p) => <a href={`/tower/town/${p.c.slice(0, 2)}/`}>{p.n}</a>)}</div>
      </>))}
    </section>

    <p class="al-note">
      数字はすべて、政府統計の総合窓口（e-Stat）から取ったもので、項目ごとに調べた年が違います。都道府県の台帳には、全国の値がない項目（給与や出生率など）も含めて、50ほどの項目を並べています。家計の数字は、県庁所在市の二人以上の世帯の値です。総人口・世帯数・高齢化率・年少人口率・婚姻率の全国の値は、47都道府県の数字から計算したもの（総数は合計、割合は人口で重みづけた平均）で、国の公表値と小数の位で少し違うことがあります。くわしい定義と注意は、それぞれの窓口の注記をご覧ください。
    </p>
  </main>
</BaseLayout>
