---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchSleepByPrefecture, fetchCommuteByPrefecture, fetchHouseworkBySex } from '../../lib/estat.js';
import { getVacancyData } from '../../lib/vacancy.js';
import { getPriceData } from '../../lib/price.js';
import { getReadingData } from '../../lib/reading.js';
import { getHikingData } from '../../lib/hiking.js';

const sleep = await fetchSleepByPrefecture();
const sleepTop = sleep[0];
const sleepAvg = Math.round(sleep.reduce((s, r) => s + r.minutes, 0) / sleep.length);

const commute = await fetchCommuteByPrefecture();
const commuteTop = commute[0];

const housework = await fetchHouseworkBySex();
const hwAvgGap = Math.round(housework.reduce((s, r) => s + r.gap, 0) / housework.length);

const vacancy = await getVacancyData();
const vacancyAvg = vacancy.national;

const reading = await getReadingData();
const hiking = await getHikingData();

const price = await getPriceData();
const priceTop = price.rows[0];
const foodTop = price.food.rows[0];
const heatTop = price.heat.rows[0];
const eduTop = price.education.rows[0];

const fmt = (m) => `${Math.floor(m / 60)}:${String(m % 60).padStart(2, '0')}`;
const pct = (v) => v.toFixed(1);
---
<BaseLayout title="展望塔｜Countopia" description="日本の数字を一望する、Countopiaの展望塔。" backHref="/" backLabel="玄関">
  <main>
    <section class="tower">
      <img class="tw-figure" src="/images/icon/tower-large.webp" alt="霧の山並みに立つ展望塔の遠景" width="1400" height="781" loading="lazy" />
        <div class="sec-head">
          <span class="no">OBSERVATORY</span>
          <h1>展望塔</h1>
          <p class="sub">この国の数字を、いくつか選んで並べた観測盤。気になった計器から、展示へどうぞ。</p>
        </div>

      <h2 class="board-head">時間の計器</h2>
      <div class="board">
        <a class="gauge" href="/exhibits/sleep/">
          <span class="g-label">平均睡眠時間（全国）</span>
          <span class="g-value">{fmt(sleepAvg)}</span>
          <span class="g-unit">時間：分／日</span>
          <span class="g-link">→ 展示を見る</span>
        </a>
        <a class="gauge" href="/exhibits/sleep/">
          <span class="g-label">いちばん眠らない</span>
          <span class="g-value small">{sleepTop.pref}</span>
          <span class="g-unit">{fmt(sleepTop.minutes)}</span>
          <span class="g-link">→ 展示を見る</span>
        </a>
        <a class="gauge" href="/exhibits/commute/">
          <span class="g-label">通勤地獄・日本一</span>
          <span class="g-value small">{commuteTop.pref}</span>
          <span class="g-unit">{commuteTop.minutes}分／日</span>
          <span class="g-link">→ 展示を見る</span>
        </a>
        <a class="gauge" href="/exhibits/housework/">
          <span class="g-label">家事の男女差（全国平均）</span>
          <span class="g-value">{hwAvgGap}<small>分</small></span>
          <span class="g-unit">1日あたり・女性−男性</span>
          <span class="g-link">→ 展示を見る</span>
        </a>
      </div>

      <h2 class="board-head">暮らしの計器</h2>
      <div class="board">
        <a class="gauge" href="/exhibits/vacancy/">
          <span class="g-label">空き家率（全国平均）</span>
          <span class="g-value">{vacancyAvg}<small>％</small></span>
          <span class="g-unit">総住宅数に占める割合</span>
          <span class="g-link">→ 展示を見る</span>
        </a>
        <a class="gauge" href="/exhibits/reading/">
          <span class="g-label">本を読む人（全国平均）</span>
          <span class="g-value">{pct(reading.national)}<small>％</small></span>
          <span class="g-unit">過去1年間・10歳以上</span>
          <span class="g-link">→ 展示を見る</span>
        </a>
        <a class="gauge" href="/exhibits/reading/">
          <span class="g-label">マンガを読む人（全国平均）</span>
          <span class="g-value">{pct(reading.manga.national)}<small>％</small></span>
          <span class="g-unit">本より多いという結果</span>
          <span class="g-link">→ 展示を見る</span>
        </a>
        <a class="gauge" href="/exhibits/hiking/">
          <span class="g-label">山を歩く人（全国平均）</span>
          <span class="g-value">{pct(hiking.national)}<small>％</small></span>
          <span class="g-unit">過去1年間・10歳以上</span>
          <span class="g-link">→ 展示を見る</span>
        </a>
      </div>

      <h2 class="board-head">物価の計器</h2>
      <div class="board">
        <a class="gauge" href="/exhibits/price/">
          <span class="g-label">物価がいちばん高い</span>
          <span class="g-value small">{priceTop.n}</span>
          <span class="g-unit">{priceTop.minutes}（全国平均＝100）</span>
          <span class="g-link">→ 展示を見る</span>
        </a>
        <a class="gauge" href="/exhibits/price/">
          <span class="g-label">食べものがいちばん高い</span>
          <span class="g-value small">{foodTop.n}</span>
          <span class="g-unit">{foodTop.minutes}（全国平均＝100）</span>
          <span class="g-link">→ 展示を見る</span>
        </a>
        <a class="gauge" href="/exhibits/utility/">
          <span class="g-label">光熱・水道がいちばん高い</span>
          <span class="g-value small">{heatTop.n}</span>
          <span class="g-unit">{heatTop.minutes}（全国平均＝100）</span>
          <span class="g-link">→ 展示を見る</span>
        </a>
        <a class="gauge" href="/exhibits/education-price/">
          <span class="g-label">教育がいちばん高い</span>
          <span class="g-value small">{eduTop.n}</span>
          <span class="g-unit">{eduTop.minutes}（全国平均＝100）</span>
          <span class="g-link">→ 展示を見る</span>
        </a>
      </div>

      <p class="note">出典：総務省統計局「令和3年社会生活基本調査」を加工して作成（2021年・週全体・10歳以上）</p>
      <p class="note">物価・空き家率：政府統計の総合窓口(e-Stat) 社会・人口統計体系 都道府県データ 基礎データ（表番号0000010103・0000010108）</p>
    </section>
  </main>
</BaseLayout>
<style>
.tower{padding:56px 0 80px;max-width:880px;margin:0 auto}
.sec-head .no{font-family:"IBM Plex Mono",monospace;font-size:.72rem;letter-spacing:.3em;color:var(--stamp)}
h1{font-family:"Shippori Mincho",serif;font-weight:800;font-size:clamp(1.6rem,4vw,2.4rem);margin-top:8px}
.sub{color:var(--ink-soft);font-size:.9rem;margin-top:8px;margin-bottom:36px;max-width:36em}
.board-head{
  font-family:"Shippori Mincho",serif;font-size:1.05rem;
  border-left:4px solid var(--stamp);padding-left:12px;
  margin:36px 0 14px;
}
.board-head:first-of-type{margin-top:0}
.board{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:2px;
  background:var(--line);border:2px solid var(--line);border-radius:14px;overflow:hidden;
}
.gauge{
  background:#fdfcf7;padding:26px 22px 20px;display:flex;flex-direction:column;gap:8px;
  text-decoration:none;color:inherit;position:relative;transition:background .15s;
}
a.gauge:hover{background:#f7f4e9}
.g-label{font-size:.72rem;letter-spacing:.16em;color:var(--ink-soft);border-bottom:1px dashed var(--line);padding-bottom:8px}
.g-value{font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:2.4rem;color:var(--stamp);line-height:1.1}
.g-value.small{font-family:"Shippori Mincho",serif;font-size:1.7rem;color:inherit}
.g-value small{font-size:1rem;margin-left:2px}
.g-unit{font-family:"IBM Plex Mono",monospace;font-size:.75rem;color:var(--ink-soft)}
.g-link{font-size:.72rem;color:var(--stamp);margin-top:auto;padding-top:10px}
.gauge.soon{opacity:.55}
.gauge.soon .g-value{color:var(--ink-soft)}
.note{margin-top:20px;font-size:.72rem;color:var(--ink-soft)}
.note + .note{margin-top:6px}
.tw-figure{display:block;width:100%;max-width:900px;height:auto;border-radius:4px;margin:0 auto 28px}
</style>