---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getKakeiPair } from '../../../lib/kakei-pair.js';
const data = await getKakeiPair('011100020', '011100050');
---
<PairExhibit
  data={data} unit="yen" area="市" no={55} slug="shochu-wine"
  title="焼酎とワイン、日本一はどの市だ"
  sub="食卓の広場｜1世帯当たりの焼酎・ワインの年間支出額"
  pageTitle="焼酎とワインにかけるお金｜Countopia Stats"
  description="都市別・1世帯当たりの焼酎・ワインの年間支出額。焼酎とワイン、日本一はどの市か。"
  a={{ label: '焼酎に使うお金', short: '焼酎' }}
  b={{ label: 'ワインに使うお金', short: 'ワイン' }}
  genre="お酒"
  intro={[
    ['kei', '55番目の展示は「焼酎」です。1世帯が1年間に焼酎を買ったお金を、市ごとに並べました。全国では{A_NAT}です。'],
    ['touko', '焼酎は、九州のほうでよく飲まれていると聞いたわ。いまの時代は、どこの町の人がよく買うのかしら。'],
    ['kei', '家で飲むために買った分の数字です。この調査は、県庁所在市と政令指定都市、あわせて{N}市が対象です。'],
  ]}
  secondAsk="ワインはどうなの？　葡萄酒は、わたくしの時代ではまだ珍しい飲みものよ。"
  shareLabel="焼酎とワイン、どちらにお金を使う？"
  notes="数字は総務省統計局「家計調査」の、二人以上の世帯の1世帯当たり年間支出額です。家計調査の対象は都道府県庁所在市と政令指定都市で、都道府県別の数字はありません。店で買って家で飲む分の数字で、飲み屋や料理店で飲んだ分は入りません。調べる世帯の数が市ごとに限られるので、1年分の数字には年ごとのゆれがあります。5番目と同じ値の市があるときは、TOP5の表にいっしょに載せています。「焼酎の割合」は、焼酎とワインの支出額を足した額に占める焼酎の割合です。"
  cross={[['/exhibits/sake-beer/', '日本酒とビール、日本一はどの市だ'], ['/exhibits/coffee-tea/', 'コーヒーと緑茶、日本一はどの市だ'], ['/household/', '別館　家計の帳場']]}
/>
