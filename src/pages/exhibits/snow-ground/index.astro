---
import ExhibitHero from '../../../components/ExhibitHero.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Talk from '../../../components/Talk.astro';
import { getSnowGroundData } from '../../../lib/snow-ground.js';
import { regionsOf } from '../../../data/geo.js';

const data = await getSnowGroundData();
const rows = data.rows;
const most = rows.slice(0, 5);
const least = rows.slice(-5).reverse();
const top = rows[0];
const bottom = rows[rows.length - 1];
const avg = data.national;
const maxMin = top.minutes;
const fmt = (v) => `${v.toFixed(1)}％`;
const r1 = (v) => Number(v.toFixed(1));
const same = (a, b) => a.toFixed(1) === b.toFixed(1);

// 同値に備えて順位は値から引く（下位側も同じ）
const rankOf = (v) => rows.findIndex((r) => same(r.minutes, v)) + 1;
const lowRankOf = (v) => least.findIndex((r) => same(r.minutes, v)) + 1;
// 最多・最少は同値の県を連名にする
const topNames = rows.filter((r) => same(r.minutes, top.minutes)).map((r) => r.n);
const bottomNames = least.filter((r) => same(r.minutes, bottom.minutes)).map((r) => r.n);

const ground = data.ground;
const groundMost = ground.rows.slice(0, 5);
const groundMax = ground.rows[0].minutes;
const groundTop = ground.rows[0];
const groundSecond = ground.rows[1];
const groundRankOf = (v) => ground.rows.findIndex((r) => same(r.minutes, v)) + 1;
const groundTopNames = ground.rows.filter((r) => same(r.minutes, groundTop.minutes)).map((r) => r.n);
const groundTopTie = groundTopNames.length > 1;
// 2番目の県（同値なら連名）
const groundSecondNames = ground.rows.filter((r) => same(r.minutes, groundSecond.minutes)).map((r) => r.n);

// 名前から値を引き、同じ値は同じ順位にする
const rankIn = (list, name) => {
  const v = list.find((r) => r.n === name)?.minutes;
  return v === undefined ? 0 : list.findIndex((r) => same(r.minutes, v)) + 1;
};
const sameTop = topNames.length === 1 && groundTopNames.length === 1 && top.n === groundTop.n;
const topInGround = topNames.map((n) => `${n}は、こちらでは${rankIn(ground.rows, n)}番目`).join('、');
const groundTopInSki = groundTopNames.map((n) => `${n}は、スキーでは${rankIn(rows, n)}番目`).join('、');

// スキーの上下の開き（表示値で割る。最少が0なら倍率は出さない）
const skiRatio = r1(bottom.minutes) > 0 ? (r1(top.minutes) / r1(bottom.minutes)).toFixed(1) : null;

// グラウンドゴルフの1位と2位の開き（表示値の差）
const groundGap = (r1(groundTop.minutes) - r1(groundSecond.minutes)).toFixed(1);

// 両方の上位5に入る県
const bothTop = most.map((r) => r.n).filter((n) => groundMost.some((r) => r.n === n));
const hasBothTop = bothTop.length > 0;

const topRegions = regionsOf(most);
const groundRegions = regionsOf(groundMost);
// 見出しの接続詞：一番が違い、上位5の重なりが2県以下なら「ところが」、似ていれば「こんどは」
const twist = !sameTop && bothTop.length <= 2;
---
<BaseLayout title="スキーとグラウンドゴルフの行動者率｜Countopia Stats" description="都道府県別・スキーとグラウンドゴルフの行動者率。スキーとグラウンドゴルフ、日本一はどの県か。" backHref="/exhibits/" backLabel="展示一覧">
  <main>
    <section class="exhibit">
      <div class="sec-head">
        <span class="no">EXHIBIT 24</span>
        <h1>スキーとグラウンドゴルフ、日本一はどの県だ</h1>
        <p class="sub">スポーツの広場｜スキー・グラウンドゴルフの行動者率（{data.year}）</p>
      </div>
      <ExhibitHero slug="snow-ground" />

      <Talk speaker="kei">24番目の展示は「スキーとグラウンドゴルフ」です。まずはスキー・スノーボードから。1年のあいだに滑った人は、全国で{fmt(avg)}でした。</Talk>
      <Talk speaker="touko">雪の上を、板で滑るのでしょう。それなら、行ける土地は決まっていそうねえ。</Talk>
      <Talk speaker="kei">この数字だけでは、そこまでは分かりません。分かるのは、県ごとの並びだけです。</Talk>

      <div class="highlight">
        <div class="card card--hot">
          <span class="seal" aria-hidden="true"><b>雪</b></span>
          <span class="label">いちばん多い</span>
          <strong>{topNames.join('・')}</strong>
          <span class="num">{fmt(top.minutes)}</span>
        </div>
        <div class="card card--cool">
          <span class="seal" aria-hidden="true"><b>芝</b></span>
          <span class="label">いちばん多い</span>
          <strong>{groundTopNames.join('・')}</strong>
          <span class="num">{fmt(groundTop.minutes)}</span>
        </div>
      </div>

      <h2>スキーをする人が多い県 TOP5</h2>
      <ol class="rank">
        {most.map((r) => (
          <li>
            <span class="pos">{rankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / maxMin) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <Talk speaker="touko">{topRegions.length > 1 ? `${topRegions.join('と')}の県が並んでいるのねえ。` : `${topRegions[0]}の県ばかりねえ。`}</Talk>

      <h2>スキーをする人が少ない県 TOP5</h2>
      <ol class="rank low">
        {least.map((r) => (
          <li>
            <span class="pos">{lowRankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / maxMin) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <Talk speaker="kei">{topNames.join('と')}の{fmt(top.minutes)}に対して、{bottomNames.join('・')}は{fmt(bottom.minutes)}。{skiRatio ? `${skiRatio}倍の開きがあります。` : ''}</Talk>

      <details class="all">
        <summary>スキーの47都道府県すべてを見る（多い順）</summary>
        <ol>
          {rows.map((r) => <li>{r.n}　{fmt(r.minutes)}</li>)}
        </ol>
      </details>

      <h2>{twist ? "ところが" : "こんどは"}、グラウンドゴルフを数えると</h2>

      <Talk speaker="touko">ぐらうんど……ごるふ。それは、どういうものかしら。</Talk>
      <Talk speaker="kei">芝生や広場でボールを打って、決められた場所に入れる遊びです。道具も場所も簡単で、年齢を問わず楽しめます。全国では{fmt(ground.national)}でした。</Talk>

      <ol class="rank ground">
        {groundMost.map((r) => (
          <li>
            <span class="pos">{groundRankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / groundMax) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <Talk speaker="touko">{groundRegions.length > 1 ? `こちらは${groundRegions.join('と')}なのねえ。` : `こちらは${groundRegions[0]}ばかりなのねえ。`}</Talk>
      <Talk speaker="kei">{groundTopTie ? `${groundTopNames.join('と')}が${fmt(groundTop.minutes)}で並んでいます。` : `${groundTop.n}が${fmt(groundTop.minutes)}。2番目の${groundSecondNames.join('・')}に${groundGap}ポイントの差をつけています。`}</Talk>

      <details class="all">
        <summary>グラウンドゴルフの47都道府県すべてを見る（多い順）</summary>
        <ol>
          {ground.rows.map((r) => <li>{r.n}　{fmt(r.minutes)}</li>)}
        </ol>
      </details>

      {hasBothTop && (
        <Talk speaker="kei">上位5県のうち、{bothTop.join('と')}は両方に入っています。</Talk>
      )}
      <Talk speaker="kei">{sameTop ? `${top.n}が、どちらも一番です。` : `スキーで一番だった${topInGround}。グラウンドゴルフで一番だった${groundTopInSki}でした。`}</Talk>
      <Talk speaker="touko">{twist ? '雪の上と、芝の上。顔ぶれが、すっかり違うのねえ。' : '雪の上と、芝の上。顔ぶれは、案外かさなるのねえ。'}</Talk>

      <p class="note">「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。同じ値の県が複数あるときは、同じ順位として並べています。</p>

      <p class="cross">あわせて読む：<a href="/exhibits/hiking/">日本一「山を歩く」県はどこだ</a>｜<a href="/exhibits/games-crafts/">ゲームと編み物、日本一はどの県だ</a>｜<a href="/how-to-read/rate-and-count/">割合だけ見ると、消えるもの</a></p>

      <div class="source">
        <p>出典：{data.source}</p>
        <p>このサービスは、政府統計総合窓口(e-Stat)のAPI機能を使用していますが、サービスの内容は国によって保証されたものではありません。</p>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
.exhibit{padding:56px 0 80px;max-width:720px;margin:0 auto}
.sec-head .no{font-family:"IBM Plex Mono",monospace;font-size:.72rem;letter-spacing:.3em;color:var(--stamp)}
h1{font-family:"Shippori Mincho",serif;font-weight:800;font-size:clamp(1.5rem,4vw,2.2rem);margin-top:8px}
.sub{color:var(--ink-soft);font-size:.85rem;margin-top:6px;margin-bottom:28px}
h2{font-family:"Shippori Mincho",serif;font-size:1.15rem;margin:40px 0 16px;border-left:4px solid var(--stamp);padding-left:12px}
.highlight{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:28px 0}
@media(max-width:560px){.highlight{grid-template-columns:1fr}}
.card{position:relative;border:1px solid var(--line);border-radius:12px;padding:20px;background:#fff;display:flex;flex-direction:column;gap:4px;align-items:flex-start}
.card .label{font-size:.72rem;letter-spacing:.2em;color:var(--ink-soft)}
.card strong{font-family:"Shippori Mincho",serif;font-size:1.9rem;line-height:1.2}
.card .num{font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:1.1rem}
.card--hot .num{color:#b23a2f}
.card--cool .num{color:#2d6a4f}
.seal{
  position:absolute;top:12px;right:14px;width:48px;height:48px;
  border:2px solid currentColor;border-radius:50%;
  display:flex;align-items:center;justify-content:center;gap:1px;
  transform:rotate(-12deg);opacity:.55;
  font-family:"Shippori Mincho",serif;
}
.seal b{font-size:.9rem;line-height:1;letter-spacing:.02em}
.card--hot .seal{color:#b23a2f}
.card--cool .seal{color:#2d6a4f}
.rank{list-style:none;padding:0;display:flex;flex-direction:column;gap:10px}
.rank li{display:grid;grid-template-columns:2em 6.5em 1fr auto;align-items:center;gap:10px}
.rank .pos{font-family:"IBM Plex Mono",monospace;color:var(--stamp);font-weight:600}
.rank .bar{height:10px;border-radius:99px;background:var(--stamp);width:var(--w);opacity:.85;min-width:8px}
.rank.low .bar{background:#3a6b52}
.rank.ground .bar{background:#c08a3e}
.rank .min{font-family:"IBM Plex Mono",monospace;font-size:.85rem;color:var(--ink-soft)}
.all{margin:32px 0}
.all summary{cursor:pointer;color:var(--stamp);font-size:.9rem}
.all ol{columns:2;margin-top:14px;font-size:.9rem;color:var(--ink-soft)}
@media(max-width:560px){.all ol{columns:1}}
.note{margin-top:28px;font-size:.85rem;color:var(--ink-soft);line-height:1.9}
.cross{margin-top:36px;font-size:.9rem}
.cross a{color:var(--stamp)}
.source{margin-top:48px;padding-top:20px;border-top:1px solid var(--line);font-size:.75rem;color:var(--ink-soft);line-height:1.8}
</style>
