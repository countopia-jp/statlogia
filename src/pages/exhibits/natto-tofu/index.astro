---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getKakeiPair } from '../../../lib/kakei-pair.js';
const data = await getKakeiPair('010530030', '010530010');
---
<PairExhibit
  data={data} unit="yen" area="市" no={42} slug="natto-tofu"
  title="納豆と豆腐、日本一はどの市だ"
  sub="暮らしの広場｜1世帯当たりの納豆・豆腐の年間支出額"
  pageTitle="納豆と豆腐にかけるお金｜Countopia Stats"
  description="都市別・1世帯当たりの納豆と豆腐の年間支出額。納豆と豆腐、日本一はどの市か。"
  a={{ label: '納豆に使うお金', short: '納豆' }}
  b={{ label: '豆腐に使うお金', short: '豆腐' }}
  genre="大豆の食べもの"
  intro={[
    ['kei', '42番目の展示は「納豆」です。1世帯が1年間に納豆へ使ったお金を、市ごとに並べました。全国では{A_NAT}です。'],
    ['touko', '納豆売りの声で、朝が始まるのよ。'],
    ['kei', 'いまは、お店で買う家がほとんどです。この調査は、県庁所在市と政令指定都市、あわせて{N}市が対象です。'],
  ]}
  secondAsk="お豆腐はどうなの？　ラッパの音で、買いに出るのよ。"
  shareLabel="納豆と豆腐、どちらにお金を使う？"
  notes="数字は総務省統計局「家計調査」の、二人以上の世帯の1世帯当たり年間支出額です。家計調査の対象は都道府県庁所在市と政令指定都市で、都道府県別の数字はありません。「豆腐」は豆腐だけで、油揚げ・がんもどきは含みません。お店で食べた分は入りません。調べる世帯の数が市ごとに限られるので、1年分の数字には年ごとのゆれがあります。5番目と同じ値の市があるときは、TOP5の表にいっしょに載せています。「納豆の割合」は、納豆と豆腐の支出額を足した額に占める納豆の割合です。"
  cross={[['/exhibits/bread-rice/', 'パンとお米、日本一はどの市だ'], ['/exhibits/tuna-salmon/', 'マグロとサケ、日本一はどの市だ'], ['/household/', '別館　家計の帳場']]}
/>
