---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getKakeiPair } from '../../../lib/kakei-pair.js';
const data = await getKakeiPair('010800050', '010800020');
---
<PairExhibit
  data={data} unit="yen" area="市" no={35} slug="cake-manju"
  title="ケーキとまんじゅう、日本一はどの市だ"
  sub="食卓の広場｜1世帯当たりのケーキ・まんじゅうの年間支出額"
  pageTitle="ケーキとまんじゅうにかけるお金｜Countopia Stats"
  description="都市別・1世帯当たりのケーキとまんじゅうの年間支出額。ケーキとまんじゅう、日本一はどの市か。"
  a={{ label: 'ケーキに使うお金', short: 'ケーキ' }}
  b={{ label: 'まんじゅうに使うお金', short: 'まんじゅう' }}
  genre="お菓子"
  intro={[
    ['kei', '35番目の展示は「ケーキ」です。1世帯が1年間にケーキへ使ったお金を、市ごとに並べました。全国では{A_NAT}です。'],
    ['touko', 'ケーキ？　わたくしの時代では、洋菓子は、たまにしかいただけないごちそうよ。'],
    ['kei', 'いまは、誕生日などにケーキを買う家も多くなりました。この調査は、県庁所在市と政令指定都市、あわせて{N}市が対象です。'],
  ]}
  secondAsk="おまんじゅうには、どれだけ使っているの？"
  shareLabel="ケーキとまんじゅう、どちらにお金を使う？"
  notes="数字は総務省統計局「家計調査」の、二人以上の世帯の1世帯当たり年間支出額です。家計調査の対象は都道府県庁所在市と政令指定都市で、都道府県別の数字はありません。「ケーキ」は買ってきたケーキで、ゼリーやプリンなどの洋生菓子は含みません。「まんじゅう」はまんじゅうだけで、ようかんやほかの和生菓子は含みません。お店で食べた分は入りません。調べる世帯の数が市ごとに限られるので、1年分の数字には年ごとのゆれがあります。5番目と同じ値の市があるときは、TOP5の表にいっしょに載せています。「ケーキの割合」は、ケーキとまんじゅうの支出額を足した額に占めるケーキの割合です。"
  cross={[['/exhibits/coffee-tea/', 'コーヒーと緑茶、日本一はどの市だ'], ['/exhibits/bread-rice/', 'パンとお米、日本一はどの市だ'], ['/household/', '別館　家計の帳場']]}
/>
