---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getActivityPair } from '../../../lib/activity-pair.js';
const data = await getActivityPair('15', '18', '0003456409');
---
<PairExhibit
  data={data} unit="pct" area="県" no={47} slug="swim-cycling"
  title="水泳とサイクリング、日本一はどの県だ"
  sub="スポーツの広場｜水泳、サイクリングの行動者率"
  pageTitle="水泳とサイクリングの行動者率｜Countopia Stats"
  description="都道府県別・水泳をした人と、サイクリングをした人の割合。水泳とサイクリング、日本一はどの県か。"
  a={{ label: '水泳をする人', short: '水泳' }}
  b={{ label: 'サイクリングをする人', short: 'サイクリング' }}
  genre="ひとりでもできる運動"
  intro={[
    ['kei', '47番目の展示は「水泳」です。1年のあいだに、泳いだ人の割合を、県ごとに並べました。全国では{A_NAT}です。'],
    ['touko', 'わたくしの村の子は、夏になると川で泳ぐのよ。いまの時代の人は、どこで泳いでいるのかしら。'],
    ['kei', 'いまは、プールで泳ぐ人がほとんどです。海や川で泳いだ人も、数に入ります。'],
  ]}
  secondAsk="サイクリングというのは、自転車に乗って出かける遊びなの？　わたくしの時代では、自転車はまだ高価な乗りものよ。"
  notes="「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。サイクリングは、通勤や買い物など用事のために自転車に乗ったものは入りません。部活動や学校の授業として行ったものも入りません。5番目と同じ値の県があるときは、TOP5の表にいっしょに載せています。"
  cross={[['/exhibits/jogging-walking/', 'ジョギングとウォーキング、日本一はどの県だ'], ['/exhibits/golf-bowling/', 'ゴルフとボウリング、日本一はどの県だ'], ['/sports-fields/', '閲覧室　運動の場']]}
/>
