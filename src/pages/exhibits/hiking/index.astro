---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Talk from '../../../components/Talk.astro';
import { getHikingData } from '../../../lib/hiking.js';

const data = await getHikingData();
const rows = data.rows;
const most = rows.slice(0, 5);
const least = rows.slice(-5).reverse();
const top = rows[0];
const bottom = rows[rows.length - 1];
const avg = data.national;
const maxMin = top.minutes;
const fmt = (v) => `${v.toFixed(1)}％`;
const r1 = (v) => Number(v.toFixed(1));

// 同値があるので順位は並び順ではなく値から引く（1・1・3・3・5と出る）
const rankOf = (v) => rows.findIndex((r) => r.minutes.toFixed(1) === v.toFixed(1)) + 1;
const lowRankOf = (v) => least.findIndex((r) => r.minutes.toFixed(1) === v.toFixed(1)) + 1;
// 最も多い県が複数あるときは連名にする
const topTies = rows.filter((r) => r.minutes.toFixed(1) === top.minutes.toFixed(1));
const topNames = topTies.map((r) => r.n).join('と');
const bottomTies = least.filter((r) => r.minutes.toFixed(1) === bottom.minutes.toFixed(1));
const bottomNames = bottomTies.map((r) => r.n).join('と');
// 最下位（同値を含む）のひとつ上の県との差
const second = [...rows].reverse().find((r) => r.minutes.toFixed(1) !== bottom.minutes.toFixed(1)) ?? rows[rows.length - 2];
const bottomGap = (r1(second.minutes) - r1(bottom.minutes)).toFixed(1);

// 山地の広い県が実際に何位にいるかを毎回引き直す
const MOUNTAIN_PREFS = ['長野県', '岐阜県', '山梨県', '北海道', '岩手県', '高知県'];
const mountainRanks = MOUNTAIN_PREFS
  .map((n) => {
    const r = rows.find((x) => x.n === n);
    return r ? { n, rank: rankOf(r.minutes) } : null;
  })
  .filter(Boolean)
  .sort((a, b) => a.rank - b.rank);
const mountainHigh = mountainRanks.filter((m) => m.rank <= 10);
const mountainMid = mountainRanks.filter((m) => m.rank > 10 && m.rank <= 20);
const mountainLow = mountainRanks.filter((m) => m.rank > 20);
const listRanks = (arr) => arr.map((m) => `${m.n}が${m.rank}番目`).join('、');
// 首位が山地の広い県かどうかで、橙子の受けを変える
const topIsMountain = topTies.some((r) => MOUNTAIN_PREFS.includes(r.n));
---
<BaseLayout title="登山・ハイキングをする人の割合｜Countopia Stats" description="都道府県別・過去1年間に登山やハイキングをした人の割合。日本一「山を歩く」県はどこか。" backHref="/exhibits/" backLabel="展示一覧">
  <main>
    <section class="exhibit">
      <div class="sec-head">
        <span class="no">EXHIBIT 13</span>
        <h1>日本一「山を歩く」県はどこだ</h1>
        <p class="sub">スポーツの広場｜過去1年間に登山・ハイキングをした人の割合（{data.year}）</p>
      </div>

      <Talk speaker="kei">13番目の展示は「登山・ハイキング」です。過去1年のあいだに、一度でも山を歩いた人の割合を県ごとに並べました。全国平均は{fmt(avg)}です。</Talk>
      <Talk speaker="touko">それなら、山の深い県が上に来るのでしょうね。</Talk>
      <Talk speaker="kei">いちばん多いのは{topNames}で{fmt(top.minutes)}{topTies.length > 1 ? '、同じ値で並びました' : ''}。</Talk>

      <div class="highlight">
        <div class="card card--hot">
          <span class="seal" aria-hidden="true"><b>最多</b></span>
          <span class="label">山を歩く人がいちばん多い</span>
          <strong>{topNames}</strong>
          <span class="num">{fmt(top.minutes)}</span>
        </div>
        <div class="card card--cool">
          <span class="seal" aria-hidden="true"><b>最少</b></span>
          <span class="label">山を歩く人がいちばん少ない</span>
          <strong>{bottomNames}</strong>
          <span class="num">{fmt(bottom.minutes)}</span>
        </div>
      </div>

      {topIsMountain ? (
        <Talk speaker="touko">山の多い県が、上に来ているのね。</Talk>
      ) : (
        <Talk speaker="touko">この顔ぶれは、思っていたのと違うわ。</Talk>
      )}
      <Talk speaker="kei">ひとつお断りしておくと、ここで数えているのは「その県に住んでいる人」であって、「その県の山に登った人」ではありません。県境を越えて出かけた人も、住んでいる県の側に数えられます。</Talk>

      <h2>山を歩く人が多い県 TOP5</h2>
      <ol class="rank">
        {most.map((r) => (
          <li>
            <span class="pos">{rankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / maxMin) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      {mountainLow.length > 0 ? (
        <>
          <Talk speaker="touko">山の名所が、そのまま上に並ぶわけではないのねえ。</Talk>
          <Talk speaker="kei">はい。山の広い県で言えば、{listRanks(mountainLow)}。{mountainMid.length > 0 ? `${listRanks(mountainMid)}と、まんなかあたりにいます。` : ''}{mountainHigh.length > 0 ? `いっぽうで${listRanks(mountainHigh)}と、上位に入る県もあります。` : '山の多さと、そのまま同じ順にはならないんです。'}</Talk>
        </>
      ) : (
        <>
          <Talk speaker="touko">山の多い県が、やはり上のほうにいるのね。</Talk>
          <Talk speaker="kei">そうですね。{listRanks(mountainRanks)}という並びでした。</Talk>
        </>
      )}

      <h2>山を歩く人が少ない県 TOP5</h2>
      <ol class="rank low">
        {least.map((r) => (
          <li>
            <span class="pos">{lowRankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / maxMin) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      {Number(bottomGap) >= 1 ? (
        <>
          <Talk speaker="touko">いちばん下が、ずいぶん離れているのね。</Talk>
          <Talk speaker="kei">{bottomNames}が{fmt(bottom.minutes)}。ひとつ上の{second.n}が{fmt(second.minutes)}ですから、最下位{bottomTies.length > 1 ? `の${bottomTies.length}県` : 'の一県'}だけが{bottomGap}ポイント開いています。</Talk>
        </>
      ) : (
        <>
          <Talk speaker="touko">下のほうは、団子になっているのね。</Talk>
          <Talk speaker="kei">{bottomNames}が{fmt(bottom.minutes)}、ひとつ上の{second.n}が{fmt(second.minutes)}。下位は僅差で並んでいます。</Talk>
        </>
      )}

      <details class="all">
        <summary>47都道府県すべてを見る（多い順）</summary>
        <ol>
          {rows.map((r) => <li>{r.n}　{fmt(r.minutes)}</li>)}
        </ol>
      </details>

      <p class="note">この数字は「過去1年間に1回でも行った人」の割合です。毎週山に入る人も、一度だけ近所の丘を歩いた人も、同じ1人として数えられています。「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。同じ値の県が複数あるときは、同じ順位として並べています。</p>

      <p class="cross">あわせて読む：<a href="/exhibits/fishing/">日本一「釣りをする」県はどこだ</a>｜<a href="/exhibits/pachinko/">日本一「パチンコをする」県はどこだ</a></p>

      <div class="source">
        <p>出典：{data.source}</p>
        <p>このサービスは、政府統計総合窓口(e-Stat)のAPI機能を使用していますが、サービスの内容は国によって保証されたものではありません。</p>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
.exhibit{padding:56px 0 80px;max-width:720px;margin:0 auto}
.sec-head .no{font-family:"IBM Plex Mono",monospace;font-size:.72rem;letter-spacing:.3em;color:var(--stamp)}
h1{font-family:"Shippori Mincho",serif;font-weight:800;font-size:clamp(1.5rem,4vw,2.2rem);margin-top:8px}
.sub{color:var(--ink-soft);font-size:.85rem;margin-top:6px;margin-bottom:28px}
h2{font-family:"Shippori Mincho",serif;font-size:1.15rem;margin:40px 0 16px;border-left:4px solid var(--stamp);padding-left:12px}
.highlight{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:28px 0}
@media(max-width:560px){.highlight{grid-template-columns:1fr}}
.card{position:relative;border:1px solid var(--line);border-radius:12px;padding:20px;background:#fff;display:flex;flex-direction:column;gap:4px;align-items:flex-start}
.card .label{font-size:.72rem;letter-spacing:.2em;color:var(--ink-soft)}
.card strong{font-family:"Shippori Mincho",serif;font-size:1.9rem;line-height:1.2}
.card--hot strong{font-size:clamp(1.3rem,4.4vw,1.9rem)}
.card .num{font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:1.1rem}
.card--hot .num{color:#b23a2f}
.card--cool .num{color:#2d6a4f}
.seal{
  position:absolute;top:12px;right:14px;width:48px;height:48px;
  border:2px solid currentColor;border-radius:50%;
  display:flex;align-items:center;justify-content:center;gap:1px;
  transform:rotate(-12deg);opacity:.55;
  font-family:"Shippori Mincho",serif;
}
.seal b{font-size:.8rem;line-height:1;letter-spacing:.06em}
.card--hot .seal{color:#b23a2f}
.card--cool .seal{color:#2d6a4f}
.rank{list-style:none;padding:0;display:flex;flex-direction:column;gap:10px}
.rank li{display:grid;grid-template-columns:2em 6.5em 1fr auto;align-items:center;gap:10px}
.rank .pos{font-family:"IBM Plex Mono",monospace;color:var(--stamp);font-weight:600}
.rank .bar{height:10px;border-radius:99px;background:var(--stamp);width:var(--w);opacity:.85;min-width:8px}
.rank.low .bar{background:#3a6b52}
.rank .min{font-family:"IBM Plex Mono",monospace;font-size:.85rem;color:var(--ink-soft)}
.all{margin:32px 0}
.all summary{cursor:pointer;color:var(--stamp);font-size:.9rem}
.all ol{columns:2;margin-top:14px;font-size:.9rem;color:var(--ink-soft)}
@media(max-width:560px){.all ol{columns:1}}
.note{margin-top:28px;font-size:.85rem;color:var(--ink-soft);line-height:1.9}
.cross{margin-top:36px;font-size:.9rem}
.cross a{color:var(--stamp)}
.source{margin-top:48px;padding-top:20px;border-top:1px solid var(--line);font-size:.75rem;color:var(--ink-soft);line-height:1.8}
</style>