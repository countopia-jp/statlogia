---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getActivityPair } from '../../../lib/activity-pair.js';
const data = await getActivityPair('34', '33');
---
<PairExhibit
  data={data} unit="pct" area="県" no={34} slug="camp-park"
  title="キャンプと遊園地、日本一はどの県だ"
  sub="つくる・遊ぶ広場｜キャンプ・遊園地や動植物園などの見物の行動者率"
  pageTitle="キャンプと遊園地・動物園の行動者率｜Countopia Stats"
  description="都道府県別・キャンプをした人と、遊園地や動植物園・水族館に行った人の割合。キャンプと遊園地、日本一はどの県か。"
  a={{ label: 'キャンプをする人', short: 'キャンプ' }}
  b={{ label: '遊園地や動物園に行く人', short: '遊園地や動物園' }}
  genre="外の遊び"
  intro={[
    ['kei', '34番目の展示は「キャンプ」です。1年のあいだにキャンプをした人の割合を、県ごとに並べました。全国では{A_NAT}です。'],
    ['touko', 'お外でテントを張って寝るの？　まるで兵隊さんの野営みたいね。'],
    ['kei', 'いまは家族や友だちと、遊びで泊まる人がたくさんいます。'],
  ]}
  secondAsk="遊園地や動物園には、どれだけの人が行くのかしら。上野の動物園なら、わたくしも行ったことがあるわ。"
  notes="「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。「遊園地や動物園」は、調査の「遊園地、動植物園、水族館などの見物」の項目です。2021年の調査は、出かける遊びが控えられがちだった時期に行われています。5番目と同じ値の県があるときは、TOP5の表にいっしょに載せています。"
  cross={[['/exhibits/hiking/', '日本一「山を歩く」県はどこだ'], ['/exhibits/fishing/', '日本一「釣りをする」県はどこだ'], ['/sports-fields/', '閲覧室　運動の場']]}
/>
