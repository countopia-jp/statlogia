---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getActivityPair } from '../../../lib/activity-pair.js';
const data = await getActivityPair('13', '14');
---
<PairExhibit
  data={data} unit="pct" area="県" no={48} slug="odori-dance"
  title="おどりと社交ダンス、日本一はどの県だ"
  sub="つくる・遊ぶ広場｜邦舞・おどり、洋舞・社交ダンスの行動者率"
  pageTitle="おどりと社交ダンスの行動者率｜Countopia Stats"
  description="都道府県別・日本舞踊や民謡のおどりをした人と、洋舞や社交ダンスをした人の割合。おどりと社交ダンス、日本一はどの県か。"
  a={{ label: '邦舞・おどりをする人', short: '邦舞・おどり' }}
  b={{ label: '洋舞・社交ダンスをする人', short: '洋舞・社交ダンス' }}
  genre="おどり"
  intro={[
    ['kei', '48番目の展示は「邦舞・おどり」です。1年のあいだに、日本舞踊や民謡のおどりなどを趣味でした人の割合を、県ごとに並べました。全国では{A_NAT}です。'],
    ['touko', '盆踊りなら、わたくしの村でも夏に輪になって踊るわ。いまの時代も、みんなで踊っているのかしら。'],
    ['kei', '趣味として習ったり踊ったりした人の割合です。'],
  ]}
  secondAsk="社交ダンスというのは、鹿鳴館で踊ったという、あのダンスのことかしら。"
  notes="「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。「邦舞・おどり」は日本舞踊や民謡のおどりなど、「洋舞・社交ダンス」はバレエやジャズダンス、社交ダンスなどです。仕事や学校の授業として行ったものは入りません。5番目と同じ値の県があるときは、TOP5の表にいっしょに載せています。"
  cross={[['/exhibits/japanese-arts/', '筆と花とお茶、日本一はどの県だ'], ['/exhibits/karaoke/', 'カラオケと楽器、日本一はどの県だ'], ['/leisure/', '閲覧室　余暇の過ごし方']]}
/>
