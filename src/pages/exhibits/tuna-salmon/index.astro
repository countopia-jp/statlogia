---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getKakeiPair } from '../../../lib/kakei-pair.js';
const data = await getKakeiPair('010211010', '010211060');
---
<PairExhibit
  data={data} unit="yen" area="市" no={36} slug="tuna-salmon"
  title="マグロとサケ、日本一はどの市だ"
  sub="食卓の広場｜1世帯当たりのまぐろ・さけの年間支出額"
  pageTitle="マグロとサケにかけるお金｜Countopia Stats"
  description="都市別・1世帯当たりの生鮮のまぐろとさけの年間支出額。マグロとサケ、日本一はどの市か。"
  a={{ label: 'マグロに使うお金', short: 'マグロ' }}
  b={{ label: 'サケに使うお金', short: 'サケ' }}
  genre="お魚"
  intro={[
    ['kei', '36番目の展示は「マグロ」です。1世帯が1年間に、生のマグロへ使ったお金を、市ごとに並べました。全国では{A_NAT}です。'],
    ['touko', 'まぐろは、お寿司屋さんの屋台で、つまんでいただくものよ。'],
    ['kei', 'いまは、お刺身などで家でもよく食べられています。この調査は、県庁所在市と政令指定都市、あわせて{N}市が対象です。'],
  ]}
  secondAsk="鮭には、どれだけ使っているの？"
  shareLabel="マグロとサケ、どちらにお金を使う？"
  notes="数字は総務省統計局「家計調査」の、二人以上の世帯の1世帯当たり年間支出額です。家計調査の対象は都道府県庁所在市と政令指定都市で、都道府県別の数字はありません。どちらも生鮮の魚（刺身や切り身など）として買った分で、塩さけ・ツナ缶・お寿司などは含みません。お店で食べた分も入りません。調べる世帯の数が市ごとに限られるので、1年分の数字には年ごとのゆれがあります。5番目と同じ値の市があるときは、TOP5の表にいっしょに載せています。「マグロの割合」は、マグロとサケの支出額を足した額に占めるマグロの割合です。"
  cross={[['/exhibits/beef-pork/', '牛肉と豚肉、日本一はどの市だ'], ['/exhibits/fishing/', '日本一「釣りをする」県はどこだ'], ['/farm-sea/', '閲覧室　田畑と海']]}
/>
