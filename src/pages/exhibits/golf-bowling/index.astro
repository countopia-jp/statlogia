---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getActivityPair } from '../../../lib/activity-pair.js';
const data = await getActivityPair('09', '13', '0003456409');
---
<PairExhibit
  data={data} unit="pct" area="県" no={43} slug="golf-bowling"
  title="ゴルフとボウリング、日本一はどの県だ"
  sub="スポーツの広場｜ゴルフ、ボウリングの行動者率"
  pageTitle="ゴルフとボウリングの行動者率｜Countopia Stats"
  description="都道府県別・ゴルフをした人と、ボウリングをした人の割合。ゴルフとボウリング、日本一はどの県か。"
  a={{ label: 'ゴルフをする人', short: 'ゴルフ' }}
  b={{ label: 'ボウリングをする人', short: 'ボウリング' }}
  genre="球を打つ・転がす競技"
  intro={[
    ['kei', '43番目の展示は「ゴルフ」です。1年のあいだに、ゴルフをした人の割合を、県ごとに並べました。全国では{A_NAT}です。'],
    ['touko', 'ゴルフ？　外国の人が、芝生で小さな球を打つ遊びだと聞いたことがあるわ。'],
    ['kei', 'いまは、日本じゅうにゴルフ場があります。練習場で打っただけの人も、数に入ります。'],
  ]}
  secondAsk="ボウリングというのは、どんな遊びなの？"
  notes="「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。ゴルフには練習場での練習を含みます。部活動や学校の授業として行ったものは入りません。5番目と同じ値の県があるときは、TOP5の表にいっしょに載せています。"
  cross={[['/exhibits/table-tennis/', '卓球とバドミントン、日本一はどの県だ'], ['/exhibits/ball-games/', '野球とサッカー、日本一はどの県だ'], ['/sports-fields/', '閲覧室　運動の場']]}
/>
