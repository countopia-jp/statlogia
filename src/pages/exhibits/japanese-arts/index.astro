---
import ExhibitHero from '../../../components/ExhibitHero.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Talk from '../../../components/Talk.astro';
import { getJapaneseArtsData } from '../../../lib/japanese-arts.js';
import { BIG_CITY_PREFS, regionsOf } from '../../../data/geo.js';

const data = await getJapaneseArtsData();
const rows = data.rows;
const most = rows.slice(0, 5);
const top = rows[0];
const avg = data.national;
const maxMin = top.minutes;
const fmt = (v) => `${v.toFixed(1)}％`;
const same = (a, b) => a.toFixed(1) === b.toFixed(1);
// 全国では百人に何人か（値から計算する）
const per100 = Math.round(avg);

// 同値が多い指標なので順位は値から引く
const rankOf = (v) => rows.findIndex((r) => same(r.minutes, v)) + 1;
// いちばん多い県が複数あれば連名にする
const topNames = rows.filter((r) => same(r.minutes, top.minutes)).map((r) => r.n);

const kado = data.kado;
const kadoMost = kado.rows.slice(0, 5);
const kadoMax = kado.rows[0].minutes;
const kadoTop = kado.rows[0];
const kadoRankOf = (v) => kado.rows.findIndex((r) => same(r.minutes, v)) + 1;
const kadoTopNames = kado.rows.filter((r) => same(r.minutes, kadoTop.minutes)).map((r) => r.n);

const sado = data.sado;
const sadoMost = sado.rows.slice(0, 5);
const sadoMax = sado.rows[0].minutes;
const sadoTop = sado.rows[0];
const sadoRankOf = (v) => sado.rows.findIndex((r) => same(r.minutes, v)) + 1;
const sadoTopNames = sado.rows.filter((r) => same(r.minutes, sadoTop.minutes)).map((r) => r.n);

// 全国値の大小（固定文にしない）
const kadoVsShodo = kado.national < avg ? '書道より少ない数字です。' : kado.national > avg ? '書道より多い数字です。' : '書道と同じ数字です。';
const sadoIsLeast = sado.national < avg && sado.national < kado.national;

// 上位5の顔ぶれの重なり（「顔ぶれが違う」を固定文にしない）
const mostNames = most.map((r) => r.n);
const kadoMostNames = kadoMost.map((r) => r.n);
const kadoAgain = kadoMostNames.filter((n) => mostNames.includes(n));
const sadoAgain = sadoMost.map((r) => r.n).filter((n) => mostNames.includes(n) || kadoMostNames.includes(n));

// 名前から値を引き、同じ値は同じ順位にする
const rankIn = (list, name) => {
  const v = list.find((r) => r.n === name)?.minutes;
  return v === undefined ? 0 : list.findIndex((r) => same(r.minutes, v)) + 1;
};

// 3つとも上位10に入る県
const inTop10 = rows.slice(0, 10).map((r) => r.n)
  .filter((n) => rankIn(kado.rows, n) > 0 && rankIn(kado.rows, n) <= 10)
  .filter((n) => rankIn(sado.rows, n) > 0 && rankIn(sado.rows, n) <= 10);
const hasTriple = inTop10.length > 0;

// 大きな街のある県が、3つでどのあたりにいるか
const bigCity = BIG_CITY_PREFS
  .map((n) => ({
    n,
    s: rankIn(rows, n),
    k: rankIn(kado.rows, n),
    c: rankIn(sado.rows, n),
  }))
  .filter((x) => x.s > 0 && x.k > 0 && x.c > 0);
const bigCityLow = bigCity.filter((x) => x.s > 30 && x.k > 30).map((x) => x.n);
const hasBigCityLow = bigCityLow.length > 0;
const bigCityAvg = bigCity.length
  ? Math.round(bigCity.reduce((s, x) => s + (x.s + x.k + x.c) / 3, 0) / bigCity.length)
  : null;

const topRegions = regionsOf(most);
const kadoRegions = regionsOf(kadoMost);
const sadoRegions = regionsOf(sadoMost);
---
<BaseLayout title="書道・華道・茶道の行動者率｜Countopia Stats" description="都道府県別・書道と華道と茶道の行動者率。筆と花とお茶、日本一はどの県か。" backHref="/exhibits/" backLabel="展示一覧">
  <main>
    <section class="exhibit">
      <div class="sec-head">
        <span class="no">EXHIBIT 22</span>
        <h1>筆と花とお茶、日本一はどの県だ</h1>
        <p class="sub">趣味の広場｜書道・華道・茶道の行動者率（{data.year}）</p>
      </div>
      <ExhibitHero slug="japanese-arts" />

      <Talk speaker="kei">22番目の展示は「筆と花とお茶」です。書道、華道、茶道の三つを並べます。まずは書道から。1年のあいだに筆を持った人は、全国で{fmt(avg)}でした。</Talk>
      <Talk speaker="touko">わたくしの時代なら、筆はみなさん毎日持っていましたけれど。</Talk>
      <Talk speaker="kei">いまは百人に{per100}人ほどです。ただ、県によってずいぶん違います。</Talk>

      <div class="highlight">
        <div class="card card--hot">
          <span class="seal" aria-hidden="true"><b>書道</b></span>
          <span class="label">いちばん多い</span>
          <strong class={topNames.length > 1 ? 'multi' : ''}>{topNames.join('・')}</strong>
          <span class="num">{fmt(top.minutes)}</span>
        </div>
        <div class="card card--cool">
          <span class="seal" aria-hidden="true"><b>華道</b></span>
          <span class="label">いちばん多い</span>
          <strong class={kadoTopNames.length > 1 ? 'multi' : ''}>{kadoTopNames.join('・')}</strong>
          <span class="num">{fmt(kadoTop.minutes)}</span>
        </div>
        <div class="card card--tea">
          <span class="seal" aria-hidden="true"><b>茶道</b></span>
          <span class="label">いちばん多い</span>
          <strong class={sadoTopNames.length > 1 ? 'multi' : ''}>{sadoTopNames.join('・')}</strong>
          <span class="num">{fmt(sadoTop.minutes)}</span>
        </div>
      </div>

      <h2>書道をする人が多い県 TOP5</h2>
      <ol class="rank">
        {most.map((r) => (
          <li>
            <span class="pos">{rankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / maxMin) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <Talk speaker="touko">{topRegions.length > 1 ? `${topRegions.join('と')}の県が並んでいるのねえ。` : `${topRegions[0]}の県が並んでいるのねえ。`}</Talk>

      <details class="all">
        <summary>書道の47都道府県すべてを見る（多い順）</summary>
        <ol>
          {rows.map((r) => <li>{r.n}　{fmt(r.minutes)}</li>)}
        </ol>
      </details>

      <h2>華道は、どこが多いか</h2>

      <Talk speaker="kei">花を生ける人は、全国で{fmt(kado.national)}。{kadoVsShodo}</Talk>

      <ol class="rank kado">
        {kadoMost.map((r) => (
          <li>
            <span class="pos">{kadoRankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / kadoMax) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <Talk speaker="touko">こちらは{kadoRegions.join('・')}なのねえ。{kadoAgain.length > 0 ? `${kadoAgain.join('と')}は、書道にも出ていたわ。` : '書道とは、顔ぶれが違うわ。'}</Talk>

      <details class="all">
        <summary>華道の47都道府県すべてを見る（多い順）</summary>
        <ol>
          {kado.rows.map((r) => <li>{r.n}　{fmt(r.minutes)}</li>)}
        </ol>
      </details>

      <h2>茶道は、どこが多いか</h2>

      <Talk speaker="kei">お茶は全国で{fmt(sado.national)}。{sadoIsLeast ? '三つのなかで、いちばん少ない数字です。' : ''}</Talk>

      <ol class="rank sado">
        {sadoMost.map((r) => (
          <li>
            <span class="pos">{sadoRankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / sadoMax) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <Talk speaker="touko">{sadoRegions.join('・')}。{sadoAgain.length > 0 ? `${sadoAgain.join('と')}は、さきほども出ていたわね。` : 'ここにも、また別の県が出てくるのねえ。'}</Talk>

      <details class="all">
        <summary>茶道の47都道府県すべてを見る（多い順）</summary>
        <ol>
          {sado.rows.map((r) => <li>{r.n}　{fmt(r.minutes)}</li>)}
        </ol>
      </details>

      <h2>三つ並べて、見えること</h2>

      {hasTriple && (
        <Talk speaker="kei">三つとも上位10に入っているのは{inTop10.join('と')}です。</Talk>
      )}
      {hasBigCityLow ? (
        <Talk speaker="kei">一方、{bigCityLow.join('・')}は、書道も華道も30位より下にいます。</Talk>
      ) : (
        <Talk speaker="kei">人口の多い都府県8つの順位を三つで平均すると、47都道府県のうち{bigCityAvg}番目あたりです。</Talk>
      )}
      <Talk speaker="touko">{hasBigCityLow ? '人の多い土地に、こうしたものが多いわけではないのねえ。' : '人の多い土地が上のほう、とも限らないのねえ。'}</Talk>

      <p class="note">「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。華道は{fmt(kado.national)}、茶道は{fmt(sado.national)}と数字そのものが小さく、県ごとの差もわずかな幅のなかにあります。同じ値の県が複数あるときは、同じ順位として並べています。</p>

      <p class="cross">あわせて読む：<a href="/exhibits/gardening/">庭いじりと日曜大工、日本一はどの県だ</a>｜<a href="/exhibits/board-games/">将棋と囲碁、日本一はどの県だ</a>｜<a href="/how-to-read/rate-and-count/">割合だけ見ると、消えるもの</a></p>

      <div class="source">
        <p>出典：{data.source}</p>
        <p>このサービスは、政府統計総合窓口(e-Stat)のAPI機能を使用していますが、サービスの内容は国によって保証されたものではありません。</p>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
.exhibit{padding:56px 0 80px;max-width:720px;margin:0 auto}
.sec-head .no{font-family:"IBM Plex Mono",monospace;font-size:.72rem;letter-spacing:.3em;color:var(--stamp)}
h1{font-family:"Shippori Mincho",serif;font-weight:800;font-size:clamp(1.5rem,4vw,2.2rem);margin-top:8px}
.sub{color:var(--ink-soft);font-size:.85rem;margin-top:6px;margin-bottom:28px}
h2{font-family:"Shippori Mincho",serif;font-size:1.15rem;margin:40px 0 16px;border-left:4px solid var(--stamp);padding-left:12px}
.highlight{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:28px 0}
@media(max-width:760px){.highlight{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.highlight{grid-template-columns:1fr}}
.card{position:relative;border:1px solid var(--line);border-radius:12px;padding:18px 16px;background:#fff;display:flex;flex-direction:column;gap:4px;align-items:flex-start}
.card .label{font-size:.72rem;letter-spacing:.2em;color:var(--ink-soft)}
.card strong{font-family:"Shippori Mincho",serif;font-size:1.6rem;line-height:1.2;margin-top:22px}
.card strong.multi{font-size:1.05rem}
.card .num{font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:1.1rem}
.card--hot .num{color:#b23a2f}
.card--cool .num{color:#2d6a4f}
.card--tea .num{color:#c08a3e}
.seal{
  position:absolute;top:10px;right:12px;width:42px;height:42px;
  border:2px solid currentColor;border-radius:50%;
  display:flex;align-items:center;justify-content:center;gap:1px;
  transform:rotate(-12deg);opacity:.55;
  font-family:"Shippori Mincho",serif;
}
.seal b{font-size:.72rem;line-height:1;letter-spacing:.02em}
.card--hot .seal{color:#b23a2f}
.card--cool .seal{color:#2d6a4f}
.card--tea .seal{color:#c08a3e}
.rank{list-style:none;padding:0;display:flex;flex-direction:column;gap:10px}
.rank li{display:grid;grid-template-columns:2em 6.5em 1fr auto;align-items:center;gap:10px}
.rank .pos{font-family:"IBM Plex Mono",monospace;color:var(--stamp);font-weight:600}
.rank .bar{height:10px;border-radius:99px;background:var(--stamp);width:var(--w);opacity:.85;min-width:8px}
.rank.kado .bar{background:#3a6b52}
.rank.sado .bar{background:#c08a3e}
.rank .min{font-family:"IBM Plex Mono",monospace;font-size:.85rem;color:var(--ink-soft)}
.all{margin:32px 0}
.all summary{cursor:pointer;color:var(--stamp);font-size:.9rem}
.all ol{columns:2;margin-top:14px;font-size:.9rem;color:var(--ink-soft)}
@media(max-width:560px){.all ol{columns:1}}
.note{margin-top:28px;font-size:.85rem;color:var(--ink-soft);line-height:1.9}
.cross{margin-top:36px;font-size:.9rem}
.cross a{color:var(--stamp)}
.source{margin-top:48px;padding-top:20px;border-top:1px solid var(--line);font-size:.75rem;color:var(--ink-soft);line-height:1.8}
</style>
