---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getKakeiPair } from '../../../lib/kakei-pair.js';
const data = await getKakeiPair('010720020', '010720030');
---
<PairExhibit
  data={data} unit="yen" area="市" no={49} slug="soy-miso"
  title="しょう油とみそ、日本一はどの市だ"
  sub="食卓の広場｜1世帯当たりのしょう油・みその年間支出額"
  pageTitle="しょう油とみそにかけるお金｜Countopia Stats"
  description="都市別・1世帯当たりのしょう油とみその年間支出額。しょう油とみそ、日本一はどの市か。"
  a={{ label: 'しょう油に使うお金', short: 'しょう油' }}
  b={{ label: 'みそに使うお金', short: 'みそ' }}
  genre="調味料"
  intro={[
    ['kei', '49番目の展示は「しょう油」です。1世帯が1年間にしょう油を買ったお金を、市ごとに並べました。全国では{A_NAT}です。'],
    ['touko', 'お醤油もお味噌も、わたくしの家では樽で買っているのよ。いまの時代は、どのくらい使っているのかしら。'],
    ['kei', 'いまは瓶やボトル、袋で買うのがふつうです。この調査は、県庁所在市と政令指定都市、あわせて{N}市が対象です。'],
  ]}
  secondAsk="お味噌はどうなの？　お味噌汁は、毎朝いただくわ。"
  shareLabel="しょう油とみそ、どちらにお金を使う？"
  notes="数字は総務省統計局「家計調査」の、二人以上の世帯の1世帯当たり年間支出額です。家計調査の対象は都道府県庁所在市と政令指定都市で、都道府県別の数字はありません。買った量ではなく、使ったお金の額なので、値段の高いものを選ぶ家が多い市ほど大きくなります。だしや調味料が入った「つゆ・たれ」などは、しょう油とは別の項目です。調べる世帯の数が市ごとに限られるので、1年分の数字には年ごとのゆれがあります。5番目と同じ値の市があるときは、TOP5の表にいっしょに載せています。「しょう油の割合」は、しょう油とみその支出額を足した額に占めるしょう油の割合です。"
  cross={[['/exhibits/natto-tofu/', '納豆と豆腐、日本一はどの市だ'], ['/exhibits/bread-rice/', 'パンとお米、日本一はどの市だ'], ['/household/', '別館　家計の帳場']]}
/>
