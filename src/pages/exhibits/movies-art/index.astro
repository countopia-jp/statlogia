---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getActivityPair } from '../../../lib/activity-pair.js';
const data = await getActivityPair('04', '02');
---
<PairExhibit
  data={data} unit="pct" area="県" no={33} slug="movies-art"
  title="映画館と美術館、日本一はどの県だ"
  sub="趣味の広場｜映画館での映画鑑賞・美術鑑賞の行動者率"
  pageTitle="映画館と美術鑑賞の行動者率｜Countopia Stats"
  description="都道府県別・映画館で映画を見た人と、美術鑑賞をした人の割合。映画館と美術館、日本一はどの県か。"
  a={{ label: '映画館で映画を見る人', short: '映画館' }}
  b={{ label: '美術鑑賞をする人', short: '美術鑑賞' }}
  genre="鑑賞"
  intro={[
    ['kei', '33番目の展示は「映画館」です。1年のあいだに映画館で映画を見た人の割合を、県ごとに並べました。全国では{A_NAT}です。'],
    ['touko', '活動写真なら知っていてよ。弁士さんの語りが楽しみだったわ。'],
    ['kei', 'いまは、音も声も映画そのものに入っています。県によって、どれだけ違うかご覧ください。'],
  ]}
  secondAsk="絵を見に行く人は、どうなの？"
  notes="「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。「映画館での映画鑑賞」には、テレビやパソコンなどで映画を見たことは入りません。「美術鑑賞」は美術館や展覧会などで見たもので、テレビやスマートフォンなどで見たものは入りません。5番目と同じ値の県があるときは、TOP5の表にいっしょに載せています。"
  cross={[['/exhibits/karaoke/', 'カラオケと楽器、日本一はどの県だ'], ['/exhibits/reading/', '本とマンガ、日本一はどの県だ'], ['/culture/', '閲覧室　文化施設']]}
/>
