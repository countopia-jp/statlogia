---
import ExhibitHero from '../../../components/ExhibitHero.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Talk from '../../../components/Talk.astro';
import { getKaraokeData } from '../../../lib/karaoke.js';

const data = await getKaraokeData();
const rows = data.rows;
const fmt = (v) => `${v.toFixed(1)}％`;
const r1 = (v) => Number(v.toFixed(1));
const same = (a, b) => a.toFixed(1) === b.toFixed(1);

// 上位・下位の5番目と同じ値の県は、表にいっしょに載せる（同率を切らない）
const topCut = (list) => { const v = list[4].minutes; return list.filter((r) => r.minutes > v || same(r.minutes, v)); };
const lowCut = (list) => { const v = list[list.length - 5].minutes; return list.filter((r) => r.minutes < v || same(r.minutes, v)).reverse(); };

const most = topCut(rows);
const least = lowCut(rows);
const top = rows[0];
const bottom = rows[rows.length - 1];
const avg = data.national;
const maxMin = top.minutes;
const perPeople = Math.round(100 / avg);

const rankOf = (v) => rows.findIndex((r) => same(r.minutes, v)) + 1;
const lowRankOf = (v) => least.findIndex((r) => same(r.minutes, v)) + 1;
const topNames = rows.filter((r) => same(r.minutes, top.minutes)).map((r) => r.n);
const bottomNames = least.filter((r) => same(r.minutes, bottom.minutes)).map((r) => r.n);

const inst = data.instrument;
const inMost = topCut(inst.rows);
const inLeast = lowCut(inst.rows);
const inTop = inst.rows[0];
const inMax = inTop.minutes;
const inRankOf = (v) => inst.rows.findIndex((r) => same(r.minutes, v)) + 1;
const inLowRankOf = (v) => inLeast.findIndex((r) => same(r.minutes, v)) + 1;
const inTopNames = inst.rows.filter((r) => same(r.minutes, inTop.minutes)).map((r) => r.n);

// 名前から値を引き、同じ値は同じ順位にする
const rankOfName = (list, name) => {
  const v = list.find((r) => r.n === name)?.minutes;
  return v === undefined ? 0 : list.findIndex((r) => same(r.minutes, v)) + 1;
};
const inRankOfName = (name) => rankOfName(inst.rows, name);
const kaRankOfName = (name) => rankOfName(rows, name);
const sameTop = topNames.length === 1 && inTopNames.length === 1 && top.n === inTop.n;
const topInIn = topNames.map((n) => `${n}は${inRankOfName(n)}番目`).join('、');
const inTopInKa = inTopNames.map((n) => `${n}は${kaRankOfName(n)}番目`).join('、');

// 全国の差（表示値の差）
const diff = r1(avg) - r1(inst.national);
const karaokeMore = diff > 0;
const sameNational = Math.abs(diff) < 0.05;

// 両方の上位に入る県
const mostNames = most.map((r) => r.n);
const inMostNames = inMost.map((r) => r.n);
const bothTop = mostNames.filter((n) => inMostNames.includes(n));
const hasBothTop = bothTop.length > 0;

// 片方では上位10、もう片方では下位10に入る県（楽器上位→カラオケ下位を先に探し、無ければ逆）
const kaTop10 = rows.slice(0, 10).map((r) => r.n);
const kaLow10 = rows.slice(-10).map((r) => r.n);
const inTop10 = inst.rows.slice(0, 10).map((r) => r.n);
const inLow10 = inst.rows.slice(-10).map((r) => r.n);
const swapA = inTop10.filter((n) => kaLow10.includes(n));
const swapB = kaTop10.filter((n) => inLow10.includes(n));
const hasSwap = swapA.length > 0 || swapB.length > 0;
const swapInstHigh = swapA.length > 0;
const swapName = swapInstHigh ? swapA[0] : (swapB[0] || '');
const swapInRank = hasSwap ? inRankOfName(swapName) : 0;
const swapKaRank = hasSwap ? kaRankOfName(swapName) : 0;
// 見出しの接続詞：一番が違い、上位の重なりが2県以下なら「ところが」、似ていれば「こんどは」
const twist = !sameTop && bothTop.length <= 2;
---
<BaseLayout title="カラオケと楽器の行動者率｜Countopia Stats" description="都道府県別・カラオケと楽器の演奏の行動者率。カラオケと楽器、日本一はどの県か。" backHref="/exhibits/" backLabel="展示一覧">
  <main>
    <section class="exhibit">
      <div class="sec-head">
        <span class="no">EXHIBIT 29</span>
        <h1>カラオケと楽器、日本一はどの県だ</h1>
        <p class="sub">趣味の広場｜カラオケ・楽器の演奏の行動者率（{data.year}）</p>
      </div>
      <ExhibitHero slug="karaoke" />

      <Talk speaker="kei">29番目の展示は「カラオケ」です。1年のあいだにカラオケをした人が、どのくらいいるか。全国では{fmt(avg)}、およそ{perPeople}人にひとりです。</Talk>
      <Talk speaker="touko">からおけ？ それはどういうものなの？</Talk>
      <Talk speaker="kei">あらかじめ録っておいた伴奏に合わせて、歌をうたう遊びです。橙子さんの時代より、ずっと後に生まれました。</Talk>
      <Talk speaker="touko">まあ、楽隊がいなくても歌えるのね。それは、県によって違うものなのかしら。</Talk>

      <div class="highlight">
        <div class="card card--hot">
          <span class="seal" aria-hidden="true"><b>最多</b></span>
          <span class="label">カラオケをする人がいちばん多い</span>
          <strong>{topNames.join('・')}</strong>
          <span class="num">{fmt(top.minutes)}</span>
        </div>
        <div class="card card--cool">
          <span class="seal" aria-hidden="true"><b>最少</b></span>
          <span class="label">カラオケをする人がいちばん少ない</span>
          <strong>{bottomNames.join('・')}</strong>
          <span class="num">{fmt(bottom.minutes)}</span>
        </div>
      </div>

      <h2>カラオケをする人が多い県 TOP5</h2>
      <ol class="rank">
        {most.map((r) => (
          <li>
            <span class="pos">{rankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / maxMin) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <h2>カラオケをする人が少ない県 TOP5</h2>
      <ol class="rank low">
        {least.map((r) => (
          <li>
            <span class="pos">{lowRankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / maxMin) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <details class="all">
        <summary>47都道府県すべてを見る（多い順）</summary>
        <ol>
          {rows.map((r) => <li>{r.n}　{fmt(r.minutes)}</li>)}
        </ol>
      </details>

      <h2>{twist ? "ところが" : "こんどは"}、楽器の演奏を数えると</h2>

      <Talk speaker="touko">楽器なら分かりますわ。わたくしの学校にも、オルガンがありますもの。楽器を弾く人は、どうなの？</Talk>
      <Talk speaker="kei">全国で{fmt(inst.national)}。{sameNational ? 'カラオケとほぼ同じ数字です。' : `カラオケより${Math.abs(diff).toFixed(1)}ポイント${karaokeMore ? '少ない' : '多い'}数字です。`}そして、{sameTop ? 'いちばん多い県は同じでした。' : 'いちばん多い県が入れかわります。'}</Talk>

      <h2>楽器を演奏する人が多い県 TOP5</h2>
      <ol class="rank inst">
        {inMost.map((r) => (
          <li>
            <span class="pos">{inRankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / inMax) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <h2>楽器を演奏する人が少ない県 TOP5</h2>
      <ol class="rank low">
        {inLeast.map((r) => (
          <li>
            <span class="pos">{inLowRankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / inMax) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      {!sameTop && (
        <>
          <Talk speaker="touko">カラオケで一番だった{topNames.join('と')}は、楽器では何番目なの。</Talk>
          <Talk speaker="kei">{`${topInIn}です。かわりに楽器で一番なのは${inTopNames.join('と')}で、カラオケでは${inTopInKa}でした。`}</Talk>
        </>
      )}

      <details class="all">
        <summary>楽器の演奏も47都道府県すべてを見る（多い順）</summary>
        <ol>
          {inst.rows.map((r) => <li>{r.n}　{fmt(r.minutes)}</li>)}
        </ol>
      </details>

      {hasBothTop && (
        <Talk speaker="kei">上位の県のうち、{bothTop.join('と')}はカラオケと楽器の両方に入っています。</Talk>
      )}
      {hasSwap && (
        <Talk speaker="touko">あら、{swapName}は{swapInstHigh ? `楽器では${swapInRank}番目なのに、カラオケでは${swapKaRank}番目` : `カラオケでは${swapKaRank}番目なのに、楽器では${swapInRank}番目`}なのね。</Talk>
      )}
      {hasSwap && (
        <Talk speaker="kei">はい。同じ音楽の遊びでも、県ごとの並びは別ものです。</Talk>
      )}

      <p class="note">「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。調査では「楽器の演奏」とは別に、「邦楽（民謡、日本古来の音楽を含む）」「コーラス・声楽」を項目として数えています。5番目と同じ値の県があるときは、TOP5の表にいっしょに載せています。同じ値の県が複数あるときは、同じ順位として並べています。</p>

      <p class="cross">あわせて読む：<a href="/exhibits/games-crafts/">ゲームと編み物、日本一はどの県だ</a>｜<a href="/exhibits/japanese-arts/">筆と花とお茶、日本一はどの県だ</a>｜<a href="/how-to-read/rate-and-count/">割合だけ見ると、消えるもの</a></p>

      <div class="source">
        <p>出典：{data.source}</p>
        <p>このサービスは、政府統計総合窓口(e-Stat)のAPI機能を使用していますが、サービスの内容は国によって保証されたものではありません。</p>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
.exhibit{padding:56px 0 80px;max-width:720px;margin:0 auto}
.sec-head .no{font-family:"IBM Plex Mono",monospace;font-size:.72rem;letter-spacing:.3em;color:var(--stamp)}
h1{font-family:"Shippori Mincho",serif;font-weight:800;font-size:clamp(1.5rem,4vw,2.2rem);margin-top:8px}
.sub{color:var(--ink-soft);font-size:.85rem;margin-top:6px;margin-bottom:28px}
h2{font-family:"Shippori Mincho",serif;font-size:1.15rem;margin:40px 0 16px;border-left:4px solid var(--stamp);padding-left:12px}
.highlight{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:28px 0}
@media(max-width:560px){.highlight{grid-template-columns:1fr}}
.card{position:relative;border:1px solid var(--line);border-radius:12px;padding:20px;background:#fff;display:flex;flex-direction:column;gap:4px;align-items:flex-start}
.card .label{font-size:.72rem;letter-spacing:.2em;color:var(--ink-soft)}
.card strong{font-family:"Shippori Mincho",serif;font-size:1.9rem;line-height:1.2}
.card .num{font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:1.1rem}
.card--hot .num{color:#b23a2f}
.card--cool .num{color:#2d6a4f}
.seal{
  position:absolute;top:12px;right:14px;width:48px;height:48px;
  border:2px solid currentColor;border-radius:50%;
  display:flex;align-items:center;justify-content:center;gap:1px;
  transform:rotate(-12deg);opacity:.55;
  font-family:"Shippori Mincho",serif;
}
.seal b{font-size:.8rem;line-height:1;letter-spacing:.06em}
.card--hot .seal{color:#b23a2f}
.card--cool .seal{color:#2d6a4f}
.rank{list-style:none;padding:0;display:flex;flex-direction:column;gap:10px}
.rank li{display:grid;grid-template-columns:2em 6.5em 1fr auto;align-items:center;gap:10px}
.rank .pos{font-family:"IBM Plex Mono",monospace;color:var(--stamp);font-weight:600}
.rank .bar{height:10px;border-radius:99px;background:var(--stamp);width:var(--w);opacity:.85;min-width:8px}
.rank.low .bar{background:#3a6b52}
.rank.inst .bar{background:#5f8f87}
.rank .min{font-family:"IBM Plex Mono",monospace;font-size:.85rem;color:var(--ink-soft)}
.all{margin:32px 0}
.all summary{cursor:pointer;color:var(--stamp);font-size:.9rem}
.all ol{columns:2;margin-top:14px;font-size:.9rem;color:var(--ink-soft)}
@media(max-width:560px){.all ol{columns:1}}
.note{margin-top:28px;font-size:.85rem;color:var(--ink-soft);line-height:1.9}
.cross{margin-top:36px;font-size:.9rem}
.cross a{color:var(--stamp)}
.source{margin-top:48px;padding-top:20px;border-top:1px solid var(--line);font-size:.75rem;color:var(--ink-soft);line-height:1.8}
</style>
