---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getKakeiPair } from '../../../lib/kakei-pair.js';
const data = await getKakeiPair('010120000', '010110001');
---
<PairExhibit
  data={data} unit="yen" area="市" no={32} slug="bread-rice"
  title="パンとお米、日本一はどの市だ"
  sub="食卓の広場｜1世帯当たりのパン・米の年間支出額"
  pageTitle="パンとお米にかけるお金｜Countopia Stats"
  description="都市別・1世帯当たりのパンと米の年間支出額。パンとお米、日本一はどの市か。"
  a={{ label: 'パンに使うお金', short: 'パン' }}
  b={{ label: 'お米に使うお金', short: 'お米' }}
  genre="主食"
  intro={[
    ['kei', '32番目の展示は「パン」です。1世帯が1年間にパンへ使ったお金を、市ごとに並べました。全国では{A_NAT}です。'],
    ['touko', 'パン？　わたくしの時代では、あんパンがごちそうよ。'],
    ['kei', 'いまでは、朝はパンという家も多くなりました。この調査は、県庁所在市と政令指定都市、あわせて{N}市が対象です。'],
  ]}
  secondAsk="お米には、どれだけ使っているの？"
  shareLabel="パンとお米、どちらにお金を使う？"
  notes="数字は総務省統計局「家計調査」の、二人以上の世帯の1世帯当たり年間支出額です。家計調査の対象は都道府県庁所在市と政令指定都市で、都道府県別の数字はありません。「パン」は食パンや菓子パンなどで、サンドイッチなどの調理パンは含みません。「お米」は買ったお米の金額なので、もらったり自分の家で作ったりしたお米は入りません。金額は買った量と値段の両方で決まり、お米の値段は年によって大きく動きます。調べる世帯の数が市ごとに限られるので、1年分の数字には年ごとのゆれがあります。「パンの割合」は、パンとお米の支出額を足した額に占めるパンの割合です。5番目と同じ値の市があるときは、TOP5の表にいっしょに載せています。"
  cross={[['/exhibits/coffee-tea/', 'コーヒーと緑茶、日本一はどの市だ'], ['/exhibits/beef-pork/', '牛肉と豚肉、日本一はどの市だ'], ['/exhibits/price/', '日本一「物価が高い」県はどこだ']]}
/>
