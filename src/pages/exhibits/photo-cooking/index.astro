---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getActivityPair } from '../../../lib/activity-pair.js';
const data = await getActivityPair('25', '20');
---
<PairExhibit
  data={data} unit="pct" area="県" no={53} slug="photo-cooking"
  title="写真と料理・菓子作り、日本一はどの県だ"
  sub="つくる・遊ぶ広場｜写真の撮影・プリント、趣味としての料理・菓子作りの行動者率"
  pageTitle="写真と料理・菓子作りの行動者率｜Countopia Stats"
  description="都道府県別・写真の撮影・プリント、趣味としての料理・菓子作りをした人の割合。写真と料理・菓子作り、日本一はどの県か。"
  a={{ label: '写真を撮る人', short: '写真' }}
  b={{ label: '趣味で料理や菓子を作る人', short: '料理・菓子作り' }}
  genre="身近な趣味"
  intro={[
    ['kei', '53番目の展示は「写真の撮影」です。1年のあいだに、趣味として写真を撮った人の割合を、県ごとに並べました。全国では{A_NAT}です。'],
    ['touko', '写真は、写真館で家族そろって撮ってもらうものよ。いまの時代は、自分で撮る人がそんなにいるのかしら。'],
    ['kei', 'いまはスマートフォンでも撮れますが、ここでは趣味として撮った人の割合です。記念に一枚撮っただけの人は入らないことが多いでしょう。'],
  ]}
  secondAsk="お料理やお菓子を作るのが趣味、という人もいるの？　わたくしには毎日のお手伝いよ。"
  notes="「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。「写真の撮影・プリント」「趣味としての料理・菓子作り」は、どちらも趣味として行ったものです。仕事や毎日の家事としての料理は入りません。5番目と同じ値の県があるときは、TOP5の表にいっしょに載せています。"
  cross={[['/exhibits/painting-pottery/', '絵と焼きもの、日本一はどの県だ'], ['/exhibits/games-crafts/', 'ゲームと編み物、日本一はどの県だ'], ['/leisure/', '閲覧室　余暇の過ごし方']]}
/>
