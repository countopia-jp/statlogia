---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getActivityPair } from '../../../lib/activity-pair.js';
const data = await getActivityPair('19', '20', '0003456409');
---
<PairExhibit
  data={data} unit="pct" area="県" no={38} slug="jogging-walking"
  title="ジョギングとウォーキング、日本一はどの県だ"
  sub="スポーツの広場｜ジョギング・マラソン、ウォーキング・軽い体操の行動者率"
  pageTitle="ジョギングとウォーキングの行動者率｜Countopia Stats"
  description="都道府県別・ジョギングやマラソンをした人と、ウォーキングや軽い体操をした人の割合。ジョギングとウォーキング、日本一はどの県か。"
  a={{ label: 'ジョギングをする人', short: 'ジョギング' }}
  b={{ label: 'ウォーキングをする人', short: 'ウォーキング' }}
  genre="走る・歩く"
  intro={[
    ['kei', '38番目の展示は「ジョギング」です。1年のあいだに、ジョギングやマラソンをした人の割合を、県ごとに並べました。全国では{A_NAT}です。'],
    ['touko', '急ぐ用もないのに、走るの？'],
    ['kei', 'はい。体を動かすために走る人が、いまはたくさんいます。'],
  ]}
  secondAsk="歩くだけなら、わたくしも毎日しているわ。歩く人は、どうなの？"
  notes="「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。「ジョギング」は調査の「ジョギング・マラソン」、「ウォーキング」は「ウォーキング・軽い体操」の項目で、運動として行ったものです。通勤や買い物で歩いたことは入りません。5番目と同じ値の県があるときは、TOP5の表にいっしょに載せています。"
  cross={[['/exhibits/hiking/', '日本一「山を歩く」県はどこだ'], ['/exhibits/ball-games/', '野球とサッカー、日本一はどの県だ'], ['/leisure/', '閲覧室　余暇の過ごし方']]}
/>
