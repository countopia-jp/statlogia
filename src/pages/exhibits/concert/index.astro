---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getActivityPair } from '../../../lib/activity-pair.js';
const data = await getActivityPair('06', '07');
---
<PairExhibit
  data={data} unit="pct" area="県" no={39} slug="concert"
  title="クラシックとポピュラーのコンサート、日本一はどの県だ"
  sub="趣味の広場｜コンサートなどでのクラシック音楽・ポピュラー音楽鑑賞の行動者率"
  pageTitle="コンサートに行く人の割合｜Countopia Stats"
  description="都道府県別・音楽会などでクラシック音楽を聴いた人と、ポピュラー音楽・歌謡曲を聴いた人の割合。コンサート、日本一はどの県か。"
  a={{ label: 'クラシックを聴きに行く人', short: 'クラシック' }}
  b={{ label: 'ポピュラー音楽を聴きに行く人', short: 'ポピュラー' }}
  genre="音楽会"
  intro={[
    ['kei', '39番目の展示は「クラシックのコンサート」です。1年のあいだに、音楽会などでクラシック音楽を聴いた人の割合を、県ごとに並べました。全国では{A_NAT}です。'],
    ['touko', '音楽会なら、女学校の講堂で聴いたことがあるわ。'],
    ['kei', 'いまは、大きな音楽ホールが各地にあります。CDや配信で聴いたものは入らず、会場で聴いた人だけを数えています。'],
  ]}
  secondAsk="流行りの歌の音楽会もあるの？"
  notes="「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。「クラシック」は調査の「コンサートなどによるクラシック音楽鑑賞」、「ポピュラー」は「コンサートなどによるポピュラー音楽・歌謡曲鑑賞」の項目です。テレビ・ラジオ・CD・配信などで聴いたものは入りません。2021年の調査は、出かける催しが控えられがちだった時期のものです。5番目と同じ値の県があるときは、TOP5の表にいっしょに載せています。"
  cross={[['/exhibits/spectator/', 'スポーツ観戦と演劇、日本一はどの県だ'], ['/exhibits/karaoke/', 'カラオケと楽器、日本一はどの県だ'], ['/culture/', '閲覧室　文化施設']]}
/>
