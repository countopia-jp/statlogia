---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getKakeiPair } from '../../../lib/kakei-pair.js';
const data = await getKakeiPair('011211040', '011211090');
---
<PairExhibit
  data={data} unit="yen" area="市" no={57} slug="sushi-burger"
  title="すしとハンバーガー、日本一はどの市だ"
  sub="食卓の広場｜1世帯当たりのすし（外食）・ハンバーガーの年間支出額"
  pageTitle="すしとハンバーガーにかけるお金｜Countopia Stats"
  description="都市別・1世帯当たりのすし（外食）・ハンバーガーの年間支出額。すしとハンバーガー、日本一はどの市か。"
  a={{ label: '外ですしを食べるお金', short: 'すし（外食）' }}
  b={{ label: 'ハンバーガーに使うお金', short: 'ハンバーガー' }}
  genre="外で食べるもの"
  intro={[
    ['kei', '57番目の展示は「すし（外食）」です。1世帯が1年間に、店で食べたすしに使ったお金を、市ごとに並べました。全国では{A_NAT}です。'],
    ['touko', 'お寿司は、屋台で立ったままつまむものよ。いまの時代は、どこの町の人がよく食べに行くのかしら。'],
    ['kei', 'すし屋や回転ずしなど、店で食べた分の数字です。持ち帰りのすしは別の項目です。この調査は、県庁所在市と政令指定都市、あわせて{N}市が対象です。'],
  ]}
  secondAsk="ハンバーガーというのは、どんな食べものなの？"
  shareLabel="すしとハンバーガー、どちらにお金を使う？"
  notes="数字は総務省統計局「家計調査」の、二人以上の世帯の1世帯当たり年間支出額です。家計調査の対象は都道府県庁所在市と政令指定都市で、都道府県別の数字はありません。「すし（外食）」は店で食べた分で、持ち帰りや弁当のすしは入りません。「ハンバーガー」は店で食べた分と持ち帰った分を含みます。調べる世帯の数が市ごとに限られるので、1年分の数字には年ごとのゆれがあります。5番目と同じ値の市があるときは、TOP5の表にいっしょに載せています。「すし（外食）の割合」は、すし（外食）とハンバーガーの支出額を足した額に占めるすし（外食）の割合です。"
  cross={[['/exhibits/soba-ramen/', 'そば・うどんとラーメン、日本一はどの市だ'], ['/exhibits/tuna-salmon/', 'マグロとサケ、日本一はどの市だ'], ['/exhibits/food/', '外食の展示']]}
/>
