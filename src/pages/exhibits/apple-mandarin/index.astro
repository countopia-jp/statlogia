---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getKakeiPair } from '../../../lib/kakei-pair.js';
const data = await getKakeiPair('010610010', '010610020');
---
<PairExhibit
  data={data} unit="yen" area="市" no={50} slug="apple-mandarin"
  title="りんごとみかん、日本一はどの市だ"
  sub="食卓の広場｜1世帯当たりのりんご・みかんの年間支出額"
  pageTitle="りんごとみかんにかけるお金｜Countopia Stats"
  description="都市別・1世帯当たりのりんごとみかんの年間支出額。りんごとみかん、日本一はどの市か。"
  a={{ label: 'りんごに使うお金', short: 'りんご' }}
  b={{ label: 'みかんに使うお金', short: 'みかん' }}
  genre="果物"
  intro={[
    ['kei', '50番目の展示は「りんご」です。1世帯が1年間にりんごを買ったお金を、市ごとに並べました。全国では{A_NAT}です。'],
    ['touko', 'りんごは、汽車で遠くから運ばれてくる、少しぜいたくな果物よ。いまの時代は、どこの町の人がよく食べているのかしら。'],
    ['kei', '店で買った分の数字です。人からもらった分や、自分の畑でとれた分は入りません。この調査は、県庁所在市と政令指定都市、あわせて{N}市が対象です。'],
  ]}
  secondAsk="みかんはどうなの？　冬になると、こたつでいただくわ。"
  shareLabel="りんごとみかん、どちらにお金を使う？"
  notes="数字は総務省統計局「家計調査」の、二人以上の世帯の1世帯当たり年間支出額です。家計調査の対象は都道府県庁所在市と政令指定都市で、都道府県別の数字はありません。生の果物として買った分で、ジュースや缶詰は入りません。もらった分や自分の家でとれた分も入らないので、産地の市では実際に食べている量より小さく出ることがあります。調べる世帯の数が市ごとに限られるので、1年分の数字には年ごとのゆれがあります。5番目と同じ値の市があるときは、TOP5の表にいっしょに載せています。「りんごの割合」は、りんごとみかんの支出額を足した額に占めるりんごの割合です。"
  cross={[['/exhibits/cake-manju/', 'ケーキとまんじゅう、日本一はどの市だ'], ['/exhibits/senbei-chocolate/', 'せんべいとチョコレート、日本一はどの市だ'], ['/farm-sea/', '閲覧室　田畑と海']]}
/>
