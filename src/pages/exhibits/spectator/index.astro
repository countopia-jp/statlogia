---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getActivityPair } from '../../../lib/activity-pair.js';
const data = await getActivityPair('01', '03');
---
<PairExhibit
  data={data} unit="pct" area="県" no={37} slug="spectator"
  title="スポーツ観戦と演劇、日本一はどの県だ"
  sub="見る・聴く広場｜スポーツ観覧・演芸や演劇の鑑賞の行動者率"
  pageTitle="スポーツ観戦と演劇・演芸の鑑賞の行動者率｜Countopia Stats"
  description="都道府県別・会場でスポーツを観戦した人と、演芸・演劇・舞踊を見た人の割合。スポーツ観戦と演劇、日本一はどの県か。"
  a={{ label: 'スポーツを見に行く人', short: 'スポーツ観戦' }}
  b={{ label: '演芸や演劇を見に行く人', short: '演芸・演劇' }}
  genre="見に行く楽しみ"
  intro={[
    ['kei', '37番目の展示は「スポーツ観戦」です。1年のあいだに、球場や競技場などでスポーツを見た人の割合を、県ごとに並べました。全国では{A_NAT}です。'],
    ['touko', 'わたくしの時代では、相撲を見に、国技館へ出かける人が多いのよ。'],
    ['kei', 'いまは野球やサッカーなども、大勢が会場で見ています。テレビやスマートフォンで見た分は数えていません。'],
  ]}
  secondAsk="芝居や寄席に行く人は、どうなの？"
  notes="「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。「スポーツ観戦」は調査の「スポーツ観覧・観戦」、「演芸・演劇」は「演芸・演劇・舞踊鑑賞」の項目で、どちらも会場で見たものです。テレビやスマートフォン・パソコンなどで見たものは入りません。2021年の調査は、人の集まる催しが控えられがちだった時期に行われています。5番目と同じ値の県があるときは、TOP5の表にいっしょに載せています。"
  cross={[['/exhibits/movies-art/', '映画館と美術館、日本一はどの県だ'], ['/exhibits/karaoke/', 'カラオケと楽器、日本一はどの県だ'], ['/culture/', '閲覧室　文化施設']]}
/>
