---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getActivityPair } from '../../../lib/activity-pair.js';
const data = await getActivityPair('26', '18');
---
<PairExhibit
  data={data} unit="pct" area="県" no={60} slug="writing-sewing"
  title="俳句・小説と和裁・洋裁、日本一はどの県だ"
  sub="つくる・遊ぶ広場｜詩・和歌・俳句・小説などの創作、和裁・洋裁の行動者率"
  pageTitle="俳句・小説と和裁・洋裁の行動者率｜Countopia Stats"
  description="都道府県別・詩・和歌・俳句・小説などの創作、和裁・洋裁をした人の割合。俳句・小説と和裁・洋裁、日本一はどの県か。"
  a={{ label: '詩や俳句、小説などを書く人', short: '詩・俳句・小説' }}
  b={{ label: '和裁や洋裁をする人', short: '和裁・洋裁' }}
  genre="つくる趣味"
  intro={[
    ['kei', '60番目の展示は「詩・和歌・俳句・小説などの創作」です。1年のあいだに、趣味として詩や俳句、小説などを書いた人の割合を、県ごとに並べました。全国では{A_NAT}です。'],
    ['touko', 'わたくしの女学校には短歌の会があって、雑誌に投稿するお姉さまもいるのよ。いまの時代も、歌や小説を書く人はいるのかしら。'],
    ['kei', '趣味として書いた人の割合です。仕事として書いたものは入りません。'],
  ]}
  secondAsk="和裁や洋裁はどうなの？　着物を縫うのは、わたくしもお母さまに習っているところよ。"
  notes="「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。「和裁・洋裁」は着物や洋服などを縫うことで、「編み物・手芸」（23番目の展示）とは別の項目です。どちらも趣味として行ったもので、仕事として行ったものは入りません。5番目と同じ値の県があるときは、TOP5の表にいっしょに載せています。"
  cross={[['/exhibits/painting-pottery/', '絵と焼きもの、日本一はどの県だ'], ['/exhibits/games-crafts/', 'ゲームと編み物、日本一はどの県だ'], ['/exhibits/japanese-arts/', '筆と花とお茶、日本一はどの県だ']]}
/>
