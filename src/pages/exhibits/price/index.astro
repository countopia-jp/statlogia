---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Talk from '../../../components/Talk.astro';
import { getPriceData } from '../../../lib/price.js';
import { regionsOf, BIG_CITY_PREFS } from '../../../data/geo.js';

const data = await getPriceData();
const rows = data.rows;
const most = rows.slice(0, 5);
const least = rows.slice(-5).reverse();
const top = rows[0];
const bottom = rows[rows.length - 1];
const maxMin = top.minutes;
const fmt = (v) => `${v.toFixed(1)}`;

// 同じ値の県が出たときに備えて順位は値から引く
const rankOf = (v) => rows.findIndex((r) => r.minutes === v) + 1;
const gap = (top.minutes - bottom.minutes).toFixed(1);
const ratio = top.minutes / bottom.minutes;

// 上位・下位に並ぶ地方を実データから拾う
const mostRegions = regionsOf(most).join('・');
const leastRegions = regionsOf(least).join('・');
const bigInMost = most.filter((r) => BIG_CITY_PREFS.includes(r.n)).length;

const foodRows = data.food.rows;
const foodMost = foodRows.slice(0, 5);
const foodTop = foodRows[0];
const foodMaxMin = foodTop.minutes;
const foodRankOf = (v) => foodRows.findIndex((r) => r.minutes === v) + 1;
// 総合での順位を引いて、食料との落差を見せる
const totalRank = (name) => rows.findIndex((r) => r.n === name) + 1;
const foodTopTotalRank = totalRank(foodTop.n);
const foodTopTotal = rows.find((r) => r.n === foodTop.n);
const topChanged = foodTop.n !== top.n;
const foodJump = foodTopTotalRank >= 10;
---
<BaseLayout title="物価の高い県｜Countopia Stats" description="都道府県別・消費者物価地域差指数。日本一「物価が高い」県はどこか。" backHref="/exhibits/" backLabel="展示一覧">
  <main>
    <section class="exhibit">
      <div class="sec-head">
        <span class="no">EXHIBIT 12</span>
        <h1>日本一「物価が高い」県はどこだ</h1>
        <p class="sub">暮らしの広場｜消費者物価地域差指数・総合（{data.year}）</p>
      </div>

      <Talk speaker="kei">12番目の展示は「物価」です。同じものを買っても、住む場所によって値段が違う。それを数字にしたのが消費者物価地域差指数です。</Talk>
      <Talk speaker="touko">同じお米でも、土地によってお値段が変わるということ？</Talk>
      <Talk speaker="kei">そういうことです。全国の平均を100として、その県が何になるかで表します。100より大きければ全国より高く、小さければ安い、という読み方です。</Talk>

      <div class="highlight">
        <div class="card card--hot">
          <span class="seal" aria-hidden="true"><b>最高</b></span>
          <span class="label">いちばん物価が高い</span>
          <strong>{top.n}</strong>
          <span class="num">{fmt(top.minutes)}</span>
        </div>
        <div class="card card--cool">
          <span class="seal" aria-hidden="true"><b>最低</b></span>
          <span class="label">いちばん物価が安い</span>
          <strong>{bottom.n}</strong>
          <span class="num">{fmt(bottom.minutes)}</span>
        </div>
      </div>

      <Talk speaker="kei">いちばん高い{top.n}が{fmt(top.minutes)}、いちばん安い{bottom.n}が{fmt(bottom.minutes)}。その差は{gap}ポイントです。</Talk>
      {ratio < 1.2 ? (
        <>
          <Talk speaker="touko">思ったより、差は小さいのねえ。倍もちがうのかと思っていました。</Talk>
          <Talk speaker="kei">全国どこでも同じものが同じように届く国ですから。ただ、この数ポイントが毎日の買い物に積み重なると、暮らしの手ごたえはずいぶん変わります。</Talk>
        </>
      ) : (
        <>
          <Talk speaker="touko">ずいぶん開きがあるのねえ。</Talk>
          <Talk speaker="kei">上と下で{ratio.toFixed(2)}倍。毎日の買い物に積み重なると、暮らしの手ごたえはずいぶん変わります。</Talk>
        </>
      )}

      <h2>物価が高い県 TOP5</h2>
      <ol class="rank">
        {most.map((r) => (
          <li>
            <span class="pos">{rankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / maxMin) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <h2>物価が安い県 TOP5</h2>
      <ol class="rank low">
        {least.map((r, i) => (
          <li>
            <span class="pos">{i + 1}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / maxMin) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <Talk speaker="touko">上と下では、顔ぶれがまるで違うのねえ。</Talk>
      <Talk speaker="kei">高いほうの5県は{mostRegions}、安いほうの5県は{leastRegions}の県です。{bigInMost >= 3 ? '上位には大きな都市を抱える県が目立ちます。' : '大きな都市を抱える県ばかりが上に来るわけでもありません。'}</Talk>

      <h2>ところが、食べものだけを見ると</h2>

      <Talk speaker="kei">同じ調査は、費目ごとの数字も出しています。食料だけを取り出すと、順番が変わるんです。</Talk>

      <ol class="rank food">
        {foodMost.map((r) => (
          <li>
            <span class="pos">{foodRankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / foodMaxMin) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      {topChanged ? (
        <Talk speaker="touko">あら。さっきの表と、いちばん上がちがうじゃないの。</Talk>
      ) : (
        <Talk speaker="touko">いちばん上は、さっきと同じ県なのね。</Talk>
      )}
      <Talk speaker="kei">食料でいちばん高いのは{foodTop.n}で{fmt(foodTop.minutes)}。総合では{foodTopTotalRank}位、{fmt(foodTopTotal.minutes)}でした{foodJump ? 'から、この費目だけ大きく飛び出しています' : ''}。</Talk>
      <Talk speaker="touko">同じ県なのに、見るものを変えると、順番が動くのねえ。</Talk>