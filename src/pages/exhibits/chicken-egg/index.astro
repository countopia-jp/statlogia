---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getKakeiPair } from '../../../lib/kakei-pair.js';
const data = await getKakeiPair('010310030', '010430001');
---
<PairExhibit
  data={data} unit="yen" area="市" no={61} slug="chicken-egg"
  title="鶏肉と卵、日本一はどの市だ"
  sub="食卓の広場｜1世帯当たりの鶏肉・卵の年間支出額"
  pageTitle="鶏肉と卵にかけるお金｜Countopia Stats"
  description="都市別・1世帯当たりの鶏肉・卵の年間支出額。鶏肉と卵、日本一はどの市か。"
  a={{ label: '鶏肉に使うお金', short: '鶏肉' }}
  b={{ label: '卵に使うお金', short: '卵' }}
  genre="鶏からとれる食べもの"
  intro={[
    ['kei', '61番目の展示は「鶏肉」です。1世帯が1年間に鶏肉を買ったお金を、市ごとに並べました。全国では{A_NAT}です。'],
    ['touko', '鶏なら、うちの裏庭でも飼っているのよ。お祝いの日には、かしわのお鍋をいただくの。いまの時代は、どこの町の人がよく買うのかしら。'],
    ['kei', '店で買った生の鶏肉の数字で、から揚げなどのお惣菜は別の項目です。この調査は、県庁所在市と政令指定都市、あわせて{N}市が対象です。'],
  ]}
  secondAsk="卵はどうなの？　卵は、病気のときに滋養をつけるごちそうよ。"
  shareLabel="鶏肉と卵、どちらにお金を使う？"
  notes="数字は総務省統計局「家計調査」の、二人以上の世帯の1世帯当たり年間支出額です。家計調査の対象は都道府県庁所在市と政令指定都市で、都道府県別の数字はありません。「鶏肉」は生の鶏肉で、から揚げや焼き鳥などの調理食品は入りません。「卵」は店で買った卵の数字です。調べる世帯の数が市ごとに限られるので、1年分の数字には年ごとのゆれがあります。5番目と同じ値の市があるときは、TOP5の表にいっしょに載せています。「鶏肉の割合」は、鶏肉と卵の支出額を足した額に占める鶏肉の割合です。"
  cross={[['/exhibits/beef-pork/', '牛肉と豚肉、日本一はどの市だ'], ['/exhibits/milk-yogurt/', '牛乳とヨーグルト、日本一はどの市だ'], ['/household/', '別館　家計の帳場']]}
/>
