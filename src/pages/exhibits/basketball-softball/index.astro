---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getActivityPair } from '../../../lib/activity-pair.js';
const data = await getActivityPair('04', '02', '0003456409');
---
<PairExhibit
  data={data} unit="pct" area="県" no={59} slug="basketball-softball"
  title="バスケットボールとソフトボール、日本一はどの県だ"
  sub="スポーツの広場｜バスケットボール、ソフトボールの行動者率"
  pageTitle="バスケットボールとソフトボールの行動者率｜Countopia Stats"
  description="都道府県別・バスケットボール、ソフトボールをした人の割合。バスケットボールとソフトボール、日本一はどの県か。"
  a={{ label: 'バスケットボールをする人', short: 'バスケットボール' }}
  b={{ label: 'ソフトボールをする人', short: 'ソフトボール' }}
  genre="チームでする球技"
  intro={[
    ['kei', '59番目の展示は「バスケットボール」です。1年のあいだに、バスケットボールをした人の割合を、県ごとに並べました。全国では{A_NAT}です。'],
    ['touko', '籠球という名前なら、YMCAで外国の先生が教えていると聞いたことがあるわ。いまの時代は、どこの人がよくするのかしら。'],
    ['kei', '高いところにある輪に、球を入れ合う球技です。いまは、学校の体育館でもよく見かけます。'],
  ]}
  secondAsk="ソフトボールというのは、野球とはちがうの？"
  notes="「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。ソフトボールは、野球よりも大きくやわらかい球を使う球技です。部活動や学校の授業として行ったものは入りません。5番目と同じ値の県があるときは、TOP5の表にいっしょに載せています。"
  cross={[['/exhibits/ball-games/', '野球とサッカー、日本一はどの県だ'], ['/exhibits/tennis-volleyball/', 'テニスとバレーボール、日本一はどの県だ'], ['/sports-fields/', '閲覧室　運動の場']]}
/>
