---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getActivityPair } from '../../../lib/activity-pair.js';
const data = await getActivityPair('05', '08');
---
<PairExhibit
  data={data} unit="pct" area="県" no={58} slug="home-movie-music"
  title="家で見る映画と音楽、日本一はどの県だ"
  sub="見る・聴く広場｜映画館以外での映画鑑賞、CD・スマートフォンなどによる音楽鑑賞の行動者率"
  pageTitle="家で見る映画と音楽の行動者率｜Countopia Stats"
  description="都道府県別・映画館以外での映画鑑賞、CD・スマートフォンなどによる音楽鑑賞をした人の割合。家で見る映画と音楽、日本一はどの県か。"
  a={{ label: '映画館以外で映画を見る人', short: '家で見る映画' }}
  b={{ label: 'CDやスマートフォンなどで音楽を聴く人', short: '音楽を聴く' }}
  genre="家で楽しむもの"
  intro={[
    ['kei', '58番目の展示は「家で見る映画」です。1年のあいだに、テレビやDVD、パソコンなど、映画館以外で趣味として映画を見た人の割合を、県ごとに並べました。全国では{A_NAT}です。'],
    ['touko', '活動写真なら、町の活動小屋で、弁士さんの語りを聞きながら見るものよ。いまの時代は、家で映画を見る人がそんなにいるのかしら。'],
    ['kei', 'テレビやインターネットの配信で見た人も入ります。映画館で見た人の割合は、33番目の展示で数えています。'],
  ]}
  secondAsk="音楽を聴くのはどうなの？　わたくしの家では、蓄音機でレコードをかけるのよ。"
  notes="「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。「映画館以外での映画鑑賞」はテレビ・DVD・パソコンなどで見たもの、「CD・スマートフォンなどによる音楽鑑賞」はコンサートなどに行かずに聴いたものです。どちらも趣味として行ったものです。5番目と同じ値の県があるときは、TOP5の表にいっしょに載せています。"
  cross={[['/exhibits/movies-art/', '映画館と美術館、日本一はどの県だ'], ['/exhibits/concert/', 'クラシックとポピュラーのコンサート、日本一はどの県だ'], ['/exhibits/karaoke/', 'カラオケと楽器、日本一はどの県だ']]}
/>
