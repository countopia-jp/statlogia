---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getKakeiPair } from '../../../lib/kakei-pair.js';
const data = await getKakeiPair('010410001', '010420020');
---
<PairExhibit
  data={data} unit="yen" area="市" no={56} slug="milk-yogurt"
  title="牛乳とヨーグルト、日本一はどの市だ"
  sub="食卓の広場｜1世帯当たりの牛乳・ヨーグルトの年間支出額"
  pageTitle="牛乳とヨーグルトにかけるお金｜Countopia Stats"
  description="都市別・1世帯当たりの牛乳・ヨーグルトの年間支出額。牛乳とヨーグルト、日本一はどの市か。"
  a={{ label: '牛乳に使うお金', short: '牛乳' }}
  b={{ label: 'ヨーグルトに使うお金', short: 'ヨーグルト' }}
  genre="乳製品"
  intro={[
    ['kei', '56番目の展示は「牛乳」です。1世帯が1年間に牛乳を買ったお金を、市ごとに並べました。全国では{A_NAT}です。'],
    ['touko', '牛乳は、毎朝、牛乳屋さんが瓶で届けてくれるのよ。いまの時代は、どこの町の人がよく飲んでいるのかしら。'],
    ['kei', '店で買った分と、配達してもらった分の数字です。この調査は、県庁所在市と政令指定都市、あわせて{N}市が対象です。'],
  ]}
  secondAsk="ヨーグルト？　はじめて聞く名前だわ。牛乳から作るものなの？"
  shareLabel="牛乳とヨーグルト、どちらにお金を使う？"
  notes="数字は総務省統計局「家計調査」の、二人以上の世帯の1世帯当たり年間支出額です。家計調査の対象は都道府県庁所在市と政令指定都市で、都道府県別の数字はありません。学校の給食で飲む牛乳は入りません。調べる世帯の数が市ごとに限られるので、1年分の数字には年ごとのゆれがあります。5番目と同じ値の市があるときは、TOP5の表にいっしょに載せています。「牛乳の割合」は、牛乳とヨーグルトの支出額を足した額に占める牛乳の割合です。"
  cross={[['/exhibits/bread-rice/', 'パンとお米、日本一はどの市だ'], ['/exhibits/natto-tofu/', '納豆と豆腐、日本一はどの市だ'], ['/household/', '別館　家計の帳場']]}
/>
