---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getActivityPair } from '../../../lib/activity-pair.js';
const data = await getActivityPair('07', '03', '0003456409');
---
<PairExhibit
  data={data} unit="pct" area="県" no={52} slug="tennis-volleyball"
  title="テニスとバレーボール、日本一はどの県だ"
  sub="スポーツの広場｜テニス、バレーボールの行動者率"
  pageTitle="テニスとバレーボールの行動者率｜Countopia Stats"
  description="都道府県別・テニス、バレーボールをした人の割合。テニスとバレーボール、日本一はどの県か。"
  a={{ label: 'テニスをする人', short: 'テニス' }}
  b={{ label: 'バレーボールをする人', short: 'バレーボール' }}
  genre="ネットをはさむ球技"
  intro={[
    ['kei', '52番目の展示は「テニス」です。1年のあいだに、テニスをした人の割合を、県ごとに並べました。全国では{A_NAT}です。'],
    ['touko', '庭球なら、女学校のお姉さまがたが、軟らかい球で打ち合っているのを見たことがあるわ。いまの時代は、どこの人がよくするのかしら。'],
    ['kei', 'いまも、軟らかい球のソフトテニスと、硬い球のテニスがあります。どちらも数に入ります。'],
  ]}
  secondAsk="バレーボールはどうなの？　排球という名前で聞いたことがあるわ。"
  notes="「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。テニスにはソフトテニスを含みます。部活動や学校の授業として行ったものは入りません。5番目と同じ値の県があるときは、TOP5の表にいっしょに載せています。"
  cross={[['/exhibits/table-tennis/', '卓球とバドミントン、日本一はどの県だ'], ['/exhibits/ball-games/', '野球とサッカー、日本一はどの県だ'], ['/sports-fields/', '閲覧室　運動の場']]}
/>
