---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { splitTitle } from '../../lib/split-title.js';
import { exhibits, PLACES } from '../../data/exhibits.js';
import fs from 'node:fs';
import path from 'node:path';
import HeroFig from '../../components/HeroFig.astro';
// 展示の扉絵の縮小版（public/images/exhibits/<slug>-thumb.webp）。置いてあればカードに出す
const thumbOf = (href) => {
  const src = `/images/exhibits/${href.split('/').filter(Boolean).pop()}-thumb.webp`;
  return fs.existsSync(path.join(process.cwd(), 'public', src)) ? src : null;
};

// 広場ごとにまとめる。PLACESの並び順がそのままページの並び順になる
const groups = Object.entries(PLACES).map(([key, name]) => ({
  key,
  name,
  items: exhibits.filter((e) => e.place === key).sort((a, b) => a.no - b.no),
})).filter((g) => g.items.length > 0);
---
<BaseLayout title="展示一覧｜Countopia" description="Countopiaの展示一覧。数字の風景を、ひとつずつ。" backHref="/" backLabel="玄関">
  <main>
    <section class="exhibits">
      <HeroFig src="/images/icon/exhibits-gallery.webp" alt="展示室の回廊で、額に入った図表を見上げる京と橙子" width={1400} height={788} eager>
        <span class="no">EXHIBITS</span>
        <h1>展示一覧</h1>
        <p class="sub">数字の風景を、広場ごとに。全{exhibits.length}展示。</p>
      </HeroFig>

      <nav class="ex-jump" aria-label="広場へ移動">
        {groups.map((g) => <a href={`#${g.key}`}>{g.name}<small>{g.items.length}</small></a>)}
      </nav>

      {groups.map((g) => (
        <section class="ex-group" id={g.key} aria-label={g.name}>
          <h2 class="ex-group-title">{g.name}</h2>
          <div class="cards">
            {g.items.map((e) => (
              <a class={`card${thumbOf(e.href) ? ' card--img' : ''}`} href={e.href}>
                {thumbOf(e.href) && <img class="card-img" src={thumbOf(e.href)} alt="" aria-hidden="true" width="560" height="315" loading="lazy" />}
                <div class="card-body">
                  <h3>{splitTitle(e.title)[1] ? <><span class="h1a">{splitTitle(e.title)[0]}</span><span class="h1b">{splitTitle(e.title)[1]}</span></> : e.title}</h3>
                  <p>{e.lead}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </section>
  </main>
</BaseLayout>
<style>
.exhibits{padding:56px 0 80px;max-width:1280px;margin:0 auto}
.sec-head .no{font-family:"IBM Plex Mono",monospace;font-size:.72rem;letter-spacing:.3em;color:var(--stamp)}
h1{font-family:"Shippori Mincho",serif;font-weight:800;font-size:clamp(1.6rem,4vw,2.4rem);margin-top:8px}
.sub{color:var(--ink-soft);font-size:.9rem;margin-top:8px;margin-bottom:28px}

/* 展示室の回廊（京と橙子） */
.ex-hero{margin:0 auto 40px;max-width:900px}
.ex-hero img{width:100%;height:auto;display:block;border-radius:10px}

.ex-jump{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 32px}
.ex-jump a{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border:1.5px solid var(--ink);border-radius:999px;background:#fffc;color:var(--ink);text-decoration:none;font-size:.85rem;font-weight:500}
.ex-jump a:hover{background:var(--ink);color:var(--paper)}
.ex-jump small{font-family:"IBM Plex Mono",monospace;font-size:.72rem;color:var(--stamp)}
.ex-jump a:hover small{color:var(--paper)}
.ex-group{margin:0 0 36px;scroll-margin-top:110px}
.ex-group-title{
  font-family:"Shippori Mincho",serif;font-size:1.15rem;
  border-left:4px solid var(--stamp);padding-left:12px;margin:0 0 16px;
}
.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;max-width:1280px;margin:0 auto}
.card{
  border:1px solid var(--line);border-radius:14px;padding:24px;background:#fff8;
  display:flex;flex-direction:column;gap:10px;text-decoration:none;color:inherit;
  transition:transform .15s,box-shadow .15s;
}
a.card:hover{transform:translateY(-3px);box-shadow:0 6px 18px #0001}
/* 閲覧室一覧と同じ仕様：左に絵38%、右に文。2列は1101px以上、600px以下は絵を上に */
.card--img{flex-direction:row;gap:20px}
.card-img{flex:0 0 38%;width:38%;height:auto;aspect-ratio:16/9;object-fit:cover;border-radius:8px;align-self:flex-start}
.card-body{display:flex;flex-direction:column;gap:10px;flex:1;min-width:0}
@media(min-width:1101px){.card{min-height:13rem}}
.card h3{font-family:"Shippori Mincho",serif;font-size:1.3rem;line-height:1.5}
.card p{font-size:1rem;color:var(--ink-soft);line-height:1.7}
@media(max-width:1100px){
  .cards{grid-template-columns:1fr}
}
@media(max-width:600px){
  .card--img{flex-direction:column}
  .card-img{width:100%;flex-basis:auto}
}
</style>