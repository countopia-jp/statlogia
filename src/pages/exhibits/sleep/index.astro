---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Talk from '../../../components/Talk.astro';
import { fetchSleepByPrefecture, fetchCommuteByPrefecture } from '../../../lib/estat.js';
import { regionsOf } from '../../../data/geo.js';

const rows = await fetchSleepByPrefecture(); // 短い順ソート済み
const shortest = rows.slice(0, 5);
const longest = rows.slice(-5).reverse();
const top = rows[0];
const bottom = rows[rows.length - 1];
const diff = bottom.minutes - top.minutes;
const yearlyHours = Math.round((diff * 365) / 60);
const yearlyDays = Math.round(yearlyHours / 24);
const fmt = (m) => `${Math.floor(m / 60)}時間${m % 60}分`;

// 同じ値の県があるときに備えて順位は値から引く（短い順）
const rankOf = (v) => rows.findIndex((r) => r.minutes === v) + 1;

// バーの幅は実データの範囲から出す（固定値だと範囲外で崩れる）
const minV = rows[0].minutes;
const maxV = rows[rows.length - 1].minutes;
const span = Math.max(maxV - minV, 1);
const barW = (v) => `${5 + ((v - minV) / span) * 95}%`;

// 眠らない上位5県がどの地方か
const shortestRegions = regionsOf(shortest.map((r) => r.pref)).join('・');

// 通勤時間との関係を実際に計算する
const commute = await fetchCommuteByPrefecture();
const cMap = new Map(commute.map((r) => [r.pref, r.minutes]));
const pairs = rows.filter((r) => cMap.has(r.pref)).map((r) => [r.minutes, cMap.get(r.pref)]);
const corr = (() => {
  const n = pairs.length;
  if (n < 10) return null;
  const mx = pairs.reduce((s, p) => s + p[0], 0) / n;
  const my = pairs.reduce((s, p) => s + p[1], 0) / n;
  let sxy = 0, sxx = 0, syy = 0;
  for (const [x, y] of pairs) {
    sxy += (x - mx) * (y - my);
    sxx += (x - mx) ** 2;
    syy += (y - my) ** 2;
  }
  if (sxx === 0 || syy === 0) return null;
  return sxy / Math.sqrt(sxx * syy);
})();
const corrLabel = corr === null ? null : corr.toFixed(2);
// 比較はここで真偽値にしておく（テンプレート内に生の < を書くとAstroが壊れる）
const corrNegative = corr !== null && corr <= -0.3;
const corrPositive = corr !== null && corr >= 0.3;
---
<BaseLayout backHref="/exhibits/" backLabel="展示一覧">
  <main>
    <section class="exhibit">
      <div class="sec-head">
        <span class="no">EXHIBIT 01</span>
        <h1>日本一「眠らない県」はどこだ</h1>
        <p class="sub">時間の広場｜睡眠時間の都道府県ランキング（2021年）</p>
      </div>

      <Talk speaker="kei">最初の展示です。日本人が1日にどれだけ眠っているか、47都道府県で比べました。</Talk>
      <Talk speaker="touko">へぇ……そんなの調べてる人がいるの？</Talk>
      <Talk speaker="kei">国が5年に1度、全国規模で調べています。社会生活基本調査という立派な統計です。</Talk>

      <div class="highlight">
        <div class="card card--hot">
          <span class="seal" aria-hidden="true"><b>最短</b></span>
          <span class="label">いちばん眠らない</span>
          <strong>{top.pref}</strong>
          <span class="num">{fmt(top.minutes)}</span>
        </div>
        <div class="card card--cool">
          <span class="seal" aria-hidden="true"><b>最長</b></span>
          <span class="label">いちばんよく眠る</span>
          <strong>{bottom.pref}</strong>
          <span class="num">{fmt(bottom.minutes)}</span>
        </div>
      </div>

      <Talk speaker="touko">その差、たった{diff}分でしょ？　大したことなくない？</Talk>
      <Talk speaker="kei">1日{diff}分でも、1年つもれば約{yearlyHours}時間。まる{yearlyDays}日ぶん、{bottom.pref}の人は{top.pref}より長く眠っている計算です。</Talk>
      <Talk speaker="touko">まる{yearlyDays}日！？　へぇ……！</Talk>

      <h2>眠らない県 TOP5</h2>
      <ol class="rank">
        {shortest.map((r) => (
          <li>
            <span class="pos">{rankOf(r.minutes)}</span>
            <span class="pref">{r.pref}</span>
            <span class="bar" style={`--w:${barW(r.minutes)}`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <h2>よく眠る県 TOP5</h2>
      <ol class="rank sleepwell">
        {longest.map((r, i) => (
          <li>
            <span class="pos">{i + 1}</span>
            <span class="pref">{r.pref}</span>
            <span class="bar" style={`--w:${barW(r.minutes)}`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <details class="all">
        <summary>47都道府県すべてを見る（眠らない順）</summary>
        <ol>
          {rows.map((r) => <li>{r.pref}　{fmt(r.minutes)}</li>)}
        </ol>
      </details>

      <Talk speaker="touko">眠らない県は、どのあたりに集まっているの？</Talk>
      {corrNegative ? (
        <Talk speaker="kei">上位5県は{shortestRegions}の県です。通勤時間の展示と並べてみると、通勤が長い県ほど睡眠が短いという関係が出ています。ふたつの数字の相関は{corrLabel}でした。</Talk>
      ) : corrPositive ? (
        <Talk speaker="kei">上位5県は{shortestRegions}の県です。通勤時間の展示と並べてみると、通勤が長い県ほど睡眠も長いという関係が出ています。相関は{corrLabel}でした。</Talk>
      ) : (
        <Talk speaker="kei">上位5県は{shortestRegions}の県です。通勤時間と並べてみても、はっきりした関係は見えませんでした。</Talk>
      )}
      <Talk speaker="touko">わたしの時代は日が暮れたら寝るしかなかったけど……今の人は忙しいのねぇ。</Talk>

      <p class="note">同じ値の県が複数あるときは、同じ順位として並べています。相関は、ふたつの数字がどれだけ同じ向きに動くかを表す目安で、原因と結果を示すものではありません。</p>

      <div class="source">
        <p>出典：総務省統計局「令和3年社会生活基本調査」（生活時間編・週全体・10歳以上・総平均時間）を加工して作成</p>
        <p>このサービスは、政府統計総合窓口(e-Stat)のAPI機能を使用していますが、サービスの内容は国によって保証されたものではありません。</p>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
.exhibit{padding:56px 0 80px;max-width:720px;margin:0 auto}
.sec-head .no{font-family:"IBM Plex Mono",monospace;font-size:.72rem;letter-spacing:.3em;color:var(--stamp)}
h1{font-family:"Shippori Mincho",serif;font-weight:800;font-size:clamp(1.5rem,4vw,2.2rem);margin-top:8px}
.sub{color:var(--ink-soft);font-size:.85rem;margin-top:6px;margin-bottom:28px}
h2{font-family:"Shippori Mincho",serif;font-size:1.15rem;margin:40px 0 16px;border-left:4px solid var(--stamp);padding-left:12px}
.highlight{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:28px 0}
@media(max-width:560px){.highlight{grid-template-columns:1fr}}
.card{position:relative;border:1px solid var(--line);border-radius:12px;padding:20px;background:#fff;display:flex;flex-direction:column;gap:4px;align-items:flex-start}
.card .label{font-size:.72rem;letter-spacing:.2em;color:var(--ink-soft)}
.card strong{font-family:"Shippori Mincho",serif;font-size:1.9rem;line-height:1.2}
.card .num{font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:1.1rem}
.card--hot .num{color:#b23a2f}
.card--cool .num{color:#2d6a4f}
/* 消印風スタンプ（最短/最長） */
.seal{
  position:absolute;top:12px;right:14px;width:48px;height:48px;
  border:2px solid currentColor;border-radius:50%;
  display:flex;align-items:center;justify-content:center;gap:1px;
  transform:rotate(-12deg);opacity:.55;
  font-family:"Shippori Mincho",serif;
}
.seal i{font-style:normal;font-size:.6rem}
.seal b{font-size:.8rem;line-height:1;letter-spacing:.06em}
.card--hot .seal{color:#b23a2f}
.card--cool .seal{color:#2d6a4f}
.rank{list-style:none;padding:0;display:flex;flex-direction:column;gap:10px}
.rank li{display:grid;grid-template-columns:2em 6.5em 1fr auto;align-items:center;gap:10px}
.rank .pos{font-family:"IBM Plex Mono",monospace;color:var(--stamp);font-weight:600}
.rank .bar{height:10px;border-radius:99px;background:var(--stamp);width:var(--w);opacity:.85;min-width:8px}
.rank.sleepwell .bar{background:#3a6b52}
.rank .min{font-family:"IBM Plex Mono",monospace;font-size:.85rem;color:var(--ink-soft)}
.all{margin:32px 0}
.all summary{cursor:pointer;color:var(--stamp);font-size:.9rem}
.all ol{columns:2;margin-top:14px;font-size:.9rem;color:var(--ink-soft)}
@media(max-width:560px){.all ol{columns:1}}
.note{margin-top:28px;font-size:.85rem;color:var(--ink-soft);line-height:1.9}
.source{margin-top:48px;padding-top:20px;border-top:1px solid var(--line);font-size:.75rem;color:var(--ink-soft);line-height:1.8}
</style>