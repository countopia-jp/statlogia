---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Talk from '../../../components/Talk.astro';
import { getSolarData } from '../../../lib/solar.js';

const data = await getSolarData();
const rows = data.rows;
const most = rows.slice(0, 5);
const least = rows.slice(-5).reverse();
const top = rows[0];
const bottom = rows[rows.length - 1];
const avg = data.national;
const maxMin = top.minutes;
const fmt = (v) => `${v.toFixed(1)}％`;
// 100軒のうち何軒か（数％の指標なので）
const per100 = (v) => Math.round(v);

const r1 = (v) => Number(v.toFixed(1));

// 同値の順位は値から引く
const rankOf = (v) => rows.findIndex((r) => r.minutes.toFixed(1) === v.toFixed(1)) + 1;
// 最多も同値の県を連名にする
const topNames = rows.filter((r) => r.minutes.toFixed(1) === top.minutes.toFixed(1)).map((r) => r.n);

// 最下位が同率で並んでいるか
const bottomVal = bottom.minutes.toFixed(1);
const bottomNames = least.filter((r) => r.minutes.toFixed(1) === bottomVal).map((r) => r.n);
// 下位側も同率を同じ順位で出す（少ない順の並びの中で最初に現れる位置）
const lowRankOf = (v) => least.findIndex((r) => r.minutes.toFixed(1) === v.toFixed(1)) + 1;
const bottomTie = bottomNames.length >= 2;

// トップの独走ぶり（2位との差。表示値の差）
const secondVal = rows[1].minutes;
const topLead = r1(top.minutes) - r1(secondVal);
const topRuns = topLead >= 0.8;
// 最多と最少の倍率（表示値で割る。最少が0なら出さない）
const topBottomRatio = r1(bottom.minutes) > 0 ? (r1(top.minutes) / r1(bottom.minutes)).toFixed(1) : null;

// 全国値の推移
const series = data.series;
const first = series[0];
const last = series[series.length - 1];
const hasTrend = series.length >= 3;
const ratio = first && first.value > 0 ? last.value / first.value : 1;
const trendWord = ratio >= 1.2 ? '増えてきました' : ratio <= 0.8 ? '減ってきました' : 'ほとんど変わっていません';
const trendTouko = ratio >= 1.2 ? '少しずつ増えているのね。' : ratio <= 0.8 ? '減ってきているのね。' : 'あまり変わらないのね。';
const seriesMax = Math.max(...series.map((s) => s.value));
---
<BaseLayout title="太陽光発電のある住宅の割合｜Countopia Stats" description="都道府県別・人の住む住宅のうち、太陽光発電機器のある家の割合。日本一「太陽光発電の家」県はどこか。" backHref="/exhibits/" backLabel="展示一覧">
  <main>
    <section class="exhibit">
      <div class="sec-head">
        <span class="no">EXHIBIT 28</span>
        <h1>日本一「太陽光発電の家」県はどこだ</h1>
        <p class="sub">住まいの広場｜太陽光発電機器のある住宅の割合（{data.year}）</p>
      </div>

      <Talk speaker="kei">28番目の展示は「太陽光発電のある家」です。人の住んでいる家のうち、太陽光で電気をつくる機器のある家がどのくらいあるか。全国では{fmt(avg)}、100軒に{per100(avg)}軒です。</Talk>
      <Talk speaker="touko">屋根で電気をつくるの？　わたくしの頃は、電燈が引かれたばかりという家も多かったのに。</Talk>
      <Talk speaker="kei">{hasTrend ? `${first.year}年の${fmt(first.value)}から${trendWord}。そして、県によってかなり開きがあります。` : '県によってかなり開きがあります。'}</Talk>

      <div class="highlight">
        <div class="card card--hot">
          <span class="seal" aria-hidden="true"><b>最多</b></span>
          <span class="label">太陽光発電のある家がいちばん多い</span>
          <strong>{topNames.join('・')}</strong>
          <span class="num">{fmt(top.minutes)}</span>
        </div>
        <div class="card card--cool">
          <span class="seal" aria-hidden="true"><b>最少</b></span>
          <span class="label">太陽光発電のある家がいちばん少ない</span>
          <strong>{bottomTie ? bottomNames.join('・') : bottom.n}</strong>
          <span class="num">{fmt(bottom.minutes)}</span>
        </div>
      </div>

      <h2>太陽光発電のある家が多い県 TOP5</h2>
      <ol class="rank">
        {most.map((r) => (
          <li>
            <span class="pos">{rankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / maxMin) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      {topRuns && (
        <Talk speaker="touko">{top.n}が頭ひとつ抜けているのねえ。</Talk>
      )}
      {topRuns && (
        <Talk speaker="kei">はい。{top.n}が{fmt(top.minutes)}で、2番目との差は{topLead.toFixed(1)}ポイントあります。</Talk>
      )}
      {!topRuns && (
        <Talk speaker="touko">{topNames.join('と')}は100軒のうち{per100(top.minutes)}軒ほどなのね。</Talk>
      )}
      {!topRuns && (
        <Talk speaker="kei">はい。上位の県は、どこも100軒に{per100(most[4].minutes)}軒から{per100(top.minutes)}軒のあいだに並んでいます。</Talk>
      )}

      <h2>太陽光発電のある家が少ない県 TOP5</h2>
      <ol class="rank low">
        {least.map((r) => (
          <li>
            <span class="pos">{lowRankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / maxMin) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <Talk speaker="touko">{bottomTie ? `いちばん少ないのは${bottomNames.join('と')}、同じ数字で並んでいるわ。` : `いちばん少ないのは${bottom.n}なのね。`}</Talk>
      <Talk speaker="kei">{fmt(bottom.minutes)}、100軒に{per100(bottom.minutes)}軒ほどです。{topBottomRatio ? `いちばん多い${topNames.join('と')}とは${topBottomRatio}倍の開きがあります。` : ''}</Talk>

      <details class="all">
        <summary>47都道府県すべてを見る（多い順）</summary>
        <ol>
          {rows.map((r) => <li>{r.n}　{fmt(r.minutes)}</li>)}
        </ol>
      </details>

      {hasTrend && (
        <h2>全国の移りかわり</h2>
      )}
      {hasTrend && (
        <ol class="rank ts">
          {series.map((s) => (
            <li>
              <span class="pos">{s.year}</span>
              <span class="pref"></span>
              <span class="bar" style={`--w:${(s.value / seriesMax) * 100}%`}></span>
              <span class="min">{fmt(s.value)}</span>
            </li>
          ))}
        </ol>
      )}
      {hasTrend && (
        <Talk speaker="touko">{trendTouko}</Talk>
      )}
      {hasTrend && (
        <Talk speaker="kei">{first.year}年に{fmt(first.value)}だったものが、{last.year}年には{fmt(last.value)}。数字はこの先、5年ごとに更新されます。</Talk>
      )}

      <p class="note">「太陽光発電のある家の割合」は、人の住んでいる住宅（居住世帯のある住宅。空き家や建築中の家は含みません）のうち、太陽光を利用した発電機器のある住宅が占める割合です。この項目は2008年の調査から数えられています。総務省統計局「住宅・土地統計調査」（5年ごと）の値で、戸数は百戸単位に丸められています。そのため、小数第1位の差は丸めの範囲と考えてください。同じ値の県が複数あるときは、同じ順位として並べています。</p>

      <p class="cross">あわせて読む：<a href="/exhibits/sunshine/">日本一「晴れる」県はどこだ</a>｜<a href="/exhibits/housing-type/">一戸建てと木の家、日本一はどの県だ</a>｜<a href="/exhibits/utility/">光熱・水道、日本一はどの県だ</a></p>

      <div class="source">
        <p>出典：{data.source}</p>
        <p>このサービスは、政府統計総合窓口(e-Stat)のAPI機能を使用していますが、サービスの内容は国によって保証されたものではありません。</p>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
.exhibit{padding:56px 0 80px;max-width:720px;margin:0 auto}
.sec-head .no{font-family:"IBM Plex Mono",monospace;font-size:.72rem;letter-spacing:.3em;color:var(--stamp)}
h1{font-family:"Shippori Mincho",serif;font-weight:800;font-size:clamp(1.5rem,4vw,2.2rem);margin-top:8px}
.sub{color:var(--ink-soft);font-size:.85rem;margin-top:6px;margin-bottom:28px}
h2{font-family:"Shippori Mincho",serif;font-size:1.15rem;margin:40px 0 16px;border-left:4px solid var(--stamp);padding-left:12px}
.highlight{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:28px 0}
@media(max-width:560px){.highlight{grid-template-columns:1fr}}
.card{position:relative;border:1px solid var(--line);border-radius:12px;padding:20px;background:#fff;display:flex;flex-direction:column;gap:4px;align-items:flex-start}
.card .label{font-size:.72rem;letter-spacing:.2em;color:var(--ink-soft)}
.card strong{font-family:"Shippori Mincho",serif;font-size:1.9rem;line-height:1.2}
.card .num{font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:1.1rem}
.card--hot .num{color:#b23a2f}
.card--cool .num{color:#2d6a4f}
.seal{
  position:absolute;top:12px;right:14px;width:48px;height:48px;
  border:2px solid currentColor;border-radius:50%;
  display:flex;align-items:center;justify-content:center;gap:1px;
  transform:rotate(-12deg);opacity:.55;
  font-family:"Shippori Mincho",serif;
}
.seal b{font-size:.8rem;line-height:1;letter-spacing:.06em}
.card--hot .seal{color:#b23a2f}
.card--cool .seal{color:#2d6a4f}
.rank{list-style:none;padding:0;display:flex;flex-direction:column;gap:10px}
.rank li{display:grid;grid-template-columns:2em 6.5em 1fr auto;align-items:center;gap:10px}
.rank .pos{font-family:"IBM Plex Mono",monospace;color:var(--stamp);font-weight:600}
.rank .bar{height:10px;border-radius:99px;background:var(--stamp);width:var(--w);opacity:.85;min-width:8px}
.rank.low .bar{background:#3a6b52}
.rank.ts li{grid-template-columns:4em 0 1fr auto}
.rank.ts .bar{background:#c99a2e}
.rank .min{font-family:"IBM Plex Mono",monospace;font-size:.85rem;color:var(--ink-soft)}
.all{margin:32px 0}
.all summary{cursor:pointer;color:var(--stamp);font-size:.9rem}
.all ol{columns:2;margin-top:14px;font-size:.9rem;color:var(--ink-soft)}
@media(max-width:560px){.all ol{columns:1}}
.note{margin-top:28px;font-size:.85rem;color:var(--ink-soft);line-height:1.9}
.cross{margin-top:36px;font-size:.9rem}
.cross a{color:var(--stamp)}
.source{margin-top:48px;padding-top:20px;border-top:1px solid var(--line);font-size:.75rem;color:var(--ink-soft);line-height:1.8}
</style>
