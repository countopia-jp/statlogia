---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getKakeiPair } from '../../../lib/kakei-pair.js';
const data = await getKakeiPair('011100010', '011100030');
---
<PairExhibit
  data={data} unit="yen" area="市" no={45} slug="sake-beer"
  title="日本酒とビール、日本一はどの市だ"
  sub="暮らしの広場｜1世帯当たりの清酒・ビールの年間支出額"
  pageTitle="日本酒とビールにかけるお金｜Countopia Stats"
  description="都市別・1世帯当たりの清酒（日本酒）とビールの年間支出額。日本酒とビール、日本一はどの市か。"
  a={{ label: '日本酒に使うお金', short: '日本酒' }}
  b={{ label: 'ビールに使うお金', short: 'ビール' }}
  genre="お酒"
  intro={[
    ['kei', '45番目の展示は「日本酒」です。1世帯が1年間に清酒（日本酒）を買ったお金を、市ごとに並べました。全国では{A_NAT}です。'],
    ['touko', 'お酒なら、お父さまが晩酌で飲んでいるわ。'],
    ['kei', '家で飲むために買った分の数字です。この調査は、県庁所在市と政令指定都市、あわせて{N}市が対象です。'],
  ]}
  secondAsk="ビールはどうなの？　ハイカラな飲みものよね。"
  shareLabel="日本酒とビール、どちらにお金を使う？"
  notes="数字は総務省統計局「家計調査」の、二人以上の世帯の1世帯当たり年間支出額です。家計調査の対象は都道府県庁所在市と政令指定都市で、都道府県別の数字はありません。店で買って家で飲む分の数字で、飲み屋や料理店で飲んだ分は入りません。「ビール」には発泡酒・ビール風アルコール飲料は含みません。調べる世帯の数が市ごとに限られるので、1年分の数字には年ごとのゆれがあります。5番目と同じ値の市があるときは、TOP5の表にいっしょに載せています。「日本酒の割合」は、日本酒とビールの支出額を足した額に占める日本酒の割合です。"
  cross={[['/exhibits/coffee-tea/', 'コーヒーと緑茶、日本一はどの市だ'], ['/exhibits/soba-ramen/', 'そば・うどんとラーメン、日本一はどの市だ'], ['/household/', '別館　家計の帳場']]}
/>
