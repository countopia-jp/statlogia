---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getKakeiPair } from '../../../lib/kakei-pair.js';
const data = await getKakeiPair('010800090', '010800130');
---
<PairExhibit
  data={data} unit="yen" area="市" no={46} slug="senbei-chocolate"
  title="せんべいとチョコレート、日本一はどの市だ"
  sub="暮らしの広場｜1世帯当たりのせんべい・チョコレートの年間支出額"
  pageTitle="せんべいとチョコレートにかけるお金｜Countopia Stats"
  description="都市別・1世帯当たりのせんべいとチョコレートの年間支出額。せんべいとチョコレート、日本一はどの市か。"
  a={{ label: 'せんべいに使うお金', short: 'せんべい' }}
  b={{ label: 'チョコレートに使うお金', short: 'チョコレート' }}
  genre="おやつ"
  intro={[
    ['kei', '46番目の展示は「せんべい」です。1世帯が1年間にせんべいへ使ったお金を、市ごとに並べました。全国では{A_NAT}です。'],
    ['touko', 'おせんべいなら、駄菓子屋さんで買うわ。'],
    ['kei', 'いまは、スーパーやコンビニで買う家がほとんどです。この調査は、県庁所在市と政令指定都市、あわせて{N}市が対象です。'],
  ]}
  secondAsk="チョコレートはどうなの？　わたくしには、まだめったに口にできないごちそうよ。"
  shareLabel="せんべいとチョコレート、どちらにお金を使う？"
  notes="数字は総務省統計局「家計調査」の、二人以上の世帯の1世帯当たり年間支出額です。家計調査の対象は都道府県庁所在市と政令指定都市で、都道府県別の数字はありません。「せんべい」には、あられ・おかきを含みます。「チョコレート」は板チョコなどで、チョコレートを使った菓子（チョコレート菓子）は別の項目です。調べる世帯の数が市ごとに限られるので、1年分の数字には年ごとのゆれがあります。5番目と同じ値の市があるときは、TOP5の表にいっしょに載せています。「せんべいの割合」は、せんべいとチョコレートの支出額を足した額に占めるせんべいの割合です。"
  cross={[['/exhibits/cake-manju/', 'ケーキとまんじゅう、日本一はどの市だ'], ['/exhibits/coffee-tea/', 'コーヒーと緑茶、日本一はどの市だ'], ['/household/', '別館　家計の帳場']]}
/>
