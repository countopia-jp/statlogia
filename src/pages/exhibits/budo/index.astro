---
import ExhibitHero from '../../../components/ExhibitHero.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Talk from '../../../components/Talk.astro';
import { getBudoData } from '../../../lib/budo.js';

const data = await getBudoData();
const rows = data.rows;
const most = rows.slice(0, 5);
const least = rows.slice(-5).reverse();
const top = rows[0];
const bottom = rows[rows.length - 1];
const avg = data.national;
const maxMin = top.minutes;
const fmt = (v) => `${v.toFixed(1)}％`;
// 1000人あたり何人か（1％未満の指標なので）
const per1000 = (v) => Math.round(v * 10);

const r1 = (v) => Number(v.toFixed(1));
const same = (a, b) => a.toFixed(1) === b.toFixed(1);

// 同値が多い指標なので順位は値から引く（下位側も同じ）
const rankOf = (v) => rows.findIndex((r) => same(r.minutes, v)) + 1;
const lowRankOf = (v) => least.findIndex((r) => same(r.minutes, v)) + 1;
// 最多・最少のカードは同値の県を連名にする
const topNames = rows.filter((r) => same(r.minutes, top.minutes)).map((r) => r.n);
const bottomNames = least.filter((r) => same(r.minutes, bottom.minutes)).map((r) => r.n);
// 2位以下が同値で並ぶ数（表には4県までしか見えない）
const secondVal = rows[1].minutes;
const secondCount = rows.filter((r) => same(r.minutes, secondVal)).length;
const secondShown = Math.min(secondCount, 4);
const topLead = (r1(top.minutes) - r1(secondVal)).toFixed(1);
const topRuns = secondCount >= 3 && Number(topLead) >= 0.3;
// 全国で1％に届くか（固定文にしない）
const judoUnder1 = avg < 1;
const bothUnder1 = avg < 1 && data.kendo.national < 1;

const kendo = data.kendo;
const kdMost = kendo.rows.slice(0, 5);
const kdLeast = kendo.rows.slice(-5).reverse();
const kdMax = kendo.rows[0].minutes;
const kdTop = kendo.rows[0];
const kdRankOf = (v) => kendo.rows.findIndex((r) => same(r.minutes, v)) + 1;
const kdLowRankOf = (v) => kdLeast.findIndex((r) => same(r.minutes, v)) + 1;
const kdTopNames = kendo.rows.filter((r) => same(r.minutes, kdTop.minutes)).map((r) => r.n);

// 相互の順位（名前から値を引き、同じ値は同じ順位にする）
const rankOfName = (list, name) => {
  const v = list.find((r) => r.n === name)?.minutes;
  return v === undefined ? 0 : list.findIndex((r) => same(r.minutes, v)) + 1;
};
const kdRankOfName = (name) => rankOfName(kendo.rows, name);
const jdRankOfName = (name) => rankOfName(rows, name);
const sameTop = topNames.length === 1 && kdTopNames.length === 1 && top.n === kdTop.n;
const topInKd = topNames.map((n) => `${n}は${kdRankOfName(n)}番目`).join('、');
const kdTopInJd = kdTopNames.map((n) => `${n}は${jdRankOfName(n)}番目`).join('、');

// 全国の差（表示値の差）
const diff = r1(avg) - r1(kendo.national);
const judoMore = diff > 0;
const sameNational = Math.abs(diff) < 0.05;

// 両方の上位5に入る県
const mostNames = most.map((r) => r.n);
const kdMostNames = kdMost.map((r) => r.n);
const bothTop = mostNames.filter((n) => kdMostNames.includes(n));
const hasBothTop = bothTop.length > 0;

// 片方では上位10、もう片方では下位10に入る「入れかわる県」（柔道上位→剣道下位を先に探し、無ければ逆）
const jdTop10 = rows.slice(0, 10).map((r) => r.n);
const jdLow10 = rows.slice(-10).map((r) => r.n);
const kdTop10 = kendo.rows.slice(0, 10).map((r) => r.n);
const kdLow10 = kendo.rows.slice(-10).map((r) => r.n);
const swapA = jdTop10.filter((n) => kdLow10.includes(n));
const swapB = kdTop10.filter((n) => jdLow10.includes(n));
const hasSwap = swapA.length > 0 || swapB.length > 0;
const swapJudoHigh = swapA.length > 0;
const swapName = swapJudoHigh ? swapA[0] : (swapB[0] || '');
const swapJdRank = hasSwap ? jdRankOfName(swapName) : 0;
const swapKdRank = hasSwap ? kdRankOfName(swapName) : 0;
// 見出しの接続詞：一番が違い、上位5の重なりが2県以下なら「ところが」、似ていれば「こんどは」
const twist = !sameTop && bothTop.length <= 2;
---
<BaseLayout title="柔道と剣道の行動者率｜Countopia Stats" description="都道府県別・柔道と剣道の行動者率。柔道と剣道、日本一はどの県か。" backHref="/exhibits/" backLabel="展示一覧">
  <main>
    <section class="exhibit">
      <ExhibitHero slug="budo">
        <span class="no">EXHIBIT 26</span>
        <h1><span class="h1a">柔道と剣道、</span><span class="h1b">日本一はどの県だ</span></h1>
        <p class="sub">スポーツの広場｜柔道・剣道の行動者率（{data.year}）</p>
      </ExhibitHero>

      <Talk speaker="kei">26番目の展示は「柔道」です。1年のあいだに柔道をした人が、どのくらいいるか。全国では{fmt(avg)}、1000人に{per1000(avg)}人ほどです。</Talk>
      <Talk speaker="touko">柔道なら、わたくしの時代には学校でも教えておりますわ。男の子たちが道場で。</Talk>
      <Talk speaker="kei">{judoUnder1 ? '今は、全国で1％に届かない数字です。それでも、県によって差があります。' : '県によって差があります。'}</Talk>

      <div class="highlight">
        <div class="card card--hot">
          <span class="seal" aria-hidden="true"><b>最多</b></span>
          <span class="label">柔道をする人がいちばん多い</span>
          <strong>{topNames.join('・')}</strong>
          <span class="num">{fmt(top.minutes)}</span>
        </div>
        <div class="card card--cool">
          <span class="seal" aria-hidden="true"><b>最少</b></span>
          <span class="label">柔道をする人がいちばん少ない</span>
          <strong>{bottomNames.join('・')}</strong>
          <span class="num">{fmt(bottom.minutes)}</span>
        </div>
      </div>

      <h2>柔道をする人が多い県 TOP5</h2>
      <ol class="rank">
        {most.map((r) => (
          <li>
            <span class="pos">{rankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / maxMin) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      {topRuns && (
        <Talk speaker="touko">{top.n}だけ、ずいぶん飛び抜けているのねえ。2番目は、同じ数字の県が並んでいるわ。</Talk>
      )}
      {topRuns && (
        <Talk speaker="kei">はい。{top.n}が{fmt(top.minutes)}で、次が{fmt(secondVal)}。差は{topLead}ポイントです。{fmt(secondVal)}の県は{secondCount}県あり、表には{secondShown}県までを載せています。</Talk>
      )}

      <h2>柔道をする人が少ない県 TOP5</h2>
      <ol class="rank low">
        {least.map((r) => (
          <li>
            <span class="pos">{lowRankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / maxMin) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <details class="all">
        <summary>47都道府県すべてを見る（多い順）</summary>
        <ol>
          {rows.map((r) => <li>{r.n}　{fmt(r.minutes)}</li>)}
        </ol>
      </details>

      <h2>{twist ? "ところが" : "こんどは"}、剣道を数えると</h2>

      <Talk speaker="touko">剣道のほうは、どうなの。</Talk>
      <Talk speaker="kei">全国で{fmt(kendo.national)}。{sameNational ? '柔道とほぼ同じ数字です。' : `柔道より${Math.abs(diff).toFixed(1)}ポイント${judoMore ? '少ない' : '多い'}数字です。`}そして、{sameTop ? 'いちばん多い県は同じでした。' : 'いちばん多い県が入れかわります。'}</Talk>

      <h2>剣道をする人が多い県 TOP5</h2>
      <ol class="rank kd">
        {kdMost.map((r) => (
          <li>
            <span class="pos">{kdRankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / kdMax) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <h2>剣道をする人が少ない県 TOP5</h2>
      <ol class="rank low">
        {kdLeast.map((r) => (
          <li>
            <span class="pos">{kdLowRankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / kdMax) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <Talk speaker="touko">柔道で一番だった{topNames.join('と')}は、剣道では何番目なの。</Talk>
      <Talk speaker="kei">{sameTop ? `${top.n}が、どちらも一番です。` : `${topInKd}です。かわりに剣道で一番なのは${kdTopNames.join('と')}で、柔道では${kdTopInJd}でした。`}</Talk>

      <details class="all">
        <summary>剣道も47都道府県すべてを見る（多い順）</summary>
        <ol>
          {kendo.rows.map((r) => <li>{r.n}　{fmt(r.minutes)}</li>)}
        </ol>
      </details>

      {hasBothTop && (
        <Talk speaker="kei">上位5県のうち、{bothTop.join('と')}は柔道と剣道の両方に入っています。</Talk>
      )}
      {hasSwap && (
        <Talk speaker="touko">あら、{swapName}は{swapJudoHigh ? `柔道では${swapJdRank}番目なのに、剣道では${swapKdRank}番目まで下がる` : `剣道では${swapKdRank}番目なのに、柔道では${swapJdRank}番目まで下がる`}のね。</Talk>
      )}
      {hasSwap && (
        <Talk speaker="kei">はい。同じ武道でも、県ごとの顔ぶれは別ものです。</Talk>
      )}

      <p class="note">「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。{bothUnder1 ? '柔道も剣道も全国で1％に届かない数字で、県ごとの差は0.1ポイント刻みのわずかな幅にあります。' : ''}同じ値の県が複数あるときは、同じ順位として並べています。</p>

      <p class="cross">あわせて読む：<a href="/exhibits/japanese-arts/">筆と花とお茶、日本一はどの県だ</a>｜<a href="/exhibits/ball-games/">野球とサッカー、日本一はどの県だ</a>｜<a href="/how-to-read/rate-and-count/">割合だけ見ると、消えるもの</a></p>

      <div class="source">
        <p>出典：{data.source}</p>
        <p>このサービスは、政府統計総合窓口(e-Stat)のAPI機能を使用していますが、サービスの内容は国によって保証されたものではありません。</p>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
.exhibit{padding:56px 0 80px;max-width:720px;margin:0 auto}
.sec-head .no{font-family:"IBM Plex Mono",monospace;font-size:.72rem;letter-spacing:.3em;color:var(--stamp)}
h1{font-family:"Shippori Mincho",serif;font-weight:800;font-size:clamp(1.5rem,4vw,2.2rem);margin-top:8px}
.sub{color:var(--ink-soft);font-size:.85rem;margin-top:6px;margin-bottom:28px}
h2{font-family:"Shippori Mincho",serif;font-size:1.15rem;margin:40px 0 16px;border-left:4px solid var(--stamp);padding-left:12px}
.highlight{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:28px 0}
@media(max-width:560px){.highlight{grid-template-columns:1fr}}
.card{position:relative;border:1px solid var(--line);border-radius:12px;padding:20px;background:#fff;display:flex;flex-direction:column;gap:4px;align-items:flex-start}
.card .label{font-size:.72rem;letter-spacing:.2em;color:var(--ink-soft)}
.card strong{font-family:"Shippori Mincho",serif;font-size:1.9rem;line-height:1.2}
.card .num{font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:1.1rem}
.card--hot .num{color:#b23a2f}
.card--cool .num{color:#2d6a4f}
.seal{
  position:absolute;top:12px;right:14px;width:48px;height:48px;
  border:2px solid currentColor;border-radius:50%;
  display:flex;align-items:center;justify-content:center;gap:1px;
  transform:rotate(-12deg);opacity:.55;
  font-family:"Shippori Mincho",serif;
}
.seal b{font-size:.8rem;line-height:1;letter-spacing:.06em}
.card--hot .seal{color:#b23a2f}
.card--cool .seal{color:#2d6a4f}
.rank{list-style:none;padding:0;display:flex;flex-direction:column;gap:10px}
.rank li{display:grid;grid-template-columns:2em 6.5em 1fr auto;align-items:center;gap:10px}
.rank .pos{font-family:"IBM Plex Mono",monospace;color:var(--stamp);font-weight:600}
.rank .bar{height:10px;border-radius:99px;background:var(--stamp);width:var(--w);opacity:.85;min-width:8px}
.rank.low .bar{background:#3a6b52}
.rank.kd .bar{background:#c08a3e}
.rank .min{font-family:"IBM Plex Mono",monospace;font-size:.85rem;color:var(--ink-soft)}
.all{margin:32px 0}
.all summary{cursor:pointer;color:var(--stamp);font-size:.9rem}
.all ol{columns:2;margin-top:14px;font-size:.9rem;color:var(--ink-soft)}
@media(max-width:560px){.all ol{columns:1}}
.note{margin-top:28px;font-size:.85rem;color:var(--ink-soft);line-height:1.9}
.cross{margin-top:36px;font-size:.9rem}
.cross a{color:var(--stamp)}
.source{margin-top:48px;padding-top:20px;border-top:1px solid var(--line);font-size:.75rem;color:var(--ink-soft);line-height:1.8}
</style>
