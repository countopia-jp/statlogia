---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getActivityPair } from '../../../lib/activity-pair.js';
const data = await getActivityPair('23', '24');
---
<PairExhibit
  data={data} unit="pct" area="県" no={44} slug="painting-pottery"
  title="絵と焼きもの、日本一はどの県だ"
  sub="つくる・遊ぶ広場｜絵画・彫刻の制作、陶芸・工芸の行動者率"
  pageTitle="絵と焼きものをつくる人の割合｜Countopia Stats"
  description="都道府県別・絵や彫刻をつくった人と、陶芸や工芸をした人の割合。絵と焼きもの、日本一はどの県か。"
  a={{ label: '絵や彫刻をつくる人', short: '絵画・彫刻' }}
  b={{ label: '陶芸や工芸をする人', short: '陶芸・工芸' }}
  genre="手でつくる趣味"
  intro={[
    ['kei', '44番目の展示は「絵画・彫刻の制作」です。1年のあいだに、絵を描いたり彫刻をつくったりした人の割合を、県ごとに並べました。全国では{A_NAT}です。'],
    ['touko', '絵なら、わたくしも学校の図画の時間に描くわ。'],
    ['kei', '趣味として描いた人の割合です。学校の授業や仕事で描いた分は入りません。'],
  ]}
  secondAsk="焼きものを、自分でつくる人もいるの？"
  notes="「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。仕事や学校の授業として行ったものは入りません。5番目と同じ値の県があるときは、TOP5の表にいっしょに載せています。"
  cross={[['/exhibits/games-crafts/', 'ゲームと編み物、日本一はどの県だ'], ['/exhibits/japanese-arts/', '筆と花とお茶、日本一はどの県だ'], ['/culture/', '閲覧室　文化施設']]}
/>
