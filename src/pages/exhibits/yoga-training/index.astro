---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getActivityPair } from '../../../lib/activity-pair.js';
const data = await getActivityPair('21', '22', '0003456409');
---
<PairExhibit
  data={data} unit="pct" area="県" no={51} slug="yoga-training"
  title="ヨガとトレーニング、日本一はどの県だ"
  sub="スポーツの広場｜ヨガ、器具を使ったトレーニングの行動者率"
  pageTitle="ヨガとトレーニングの行動者率｜Countopia Stats"
  description="都道府県別・ヨガ、器具を使ったトレーニングをした人の割合。ヨガとトレーニング、日本一はどの県か。"
  a={{ label: 'ヨガをする人', short: 'ヨガ' }}
  b={{ label: '器具を使ったトレーニングをする人', short: 'トレーニング' }}
  genre="体をととのえる運動"
  intro={[
    ['kei', '51番目の展示は「ヨガ」です。1年のあいだに、ヨガをした人の割合を、県ごとに並べました。全国では{A_NAT}です。'],
    ['touko', 'ヨガ？　わたくしの学校では、朝に体操の時間があるのよ。いまの時代の人は、どんな体操をしているのかしら。'],
    ['kei', 'インドから伝わった、呼吸と姿勢をととのえる運動です。家や教室で行った人も、数に入ります。'],
  ]}
  secondAsk="器具を使ったトレーニングというのは、鉄亜鈴のようなものを使うの？"
  notes="「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。「器具を使ったトレーニング」は、ジムのマシンやダンベルなどを使う運動です。部活動や学校の授業として行ったものは入りません。5番目と同じ値の県があるときは、TOP5の表にいっしょに載せています。"
  cross={[['/exhibits/jogging-walking/', 'ジョギングとウォーキング、日本一はどの県だ'], ['/exhibits/swim-cycling/', '水泳とサイクリング、日本一はどの県だ'], ['/sports-fields/', '閲覧室　運動の場']]}
/>
