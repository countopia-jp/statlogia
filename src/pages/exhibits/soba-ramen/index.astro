---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getKakeiPair } from '../../../lib/kakei-pair.js';
const data = await getKakeiPair('011211010', '011211020');
---
<PairExhibit
  data={data} unit="yen" area="市" no={41} slug="soba-ramen"
  title="そば・うどんとラーメン、日本一はどの市だ"
  sub="暮らしの広場｜1世帯当たりの外食の日本そば・うどん、中華そばの年間支出額"
  pageTitle="外で食べるそば・うどんとラーメン｜Countopia Stats"
  description="都市別・1世帯当たりの外食の日本そば・うどんと中華そば（ラーメン）の年間支出額。そば・うどんとラーメン、日本一はどの市か。"
  a={{ label: '外で食べるそば・うどん', short: 'そば・うどん' }}
  b={{ label: '外で食べるラーメン', short: 'ラーメン' }}
  genre="外の麺"
  intro={[
    ['kei', '41番目の展示は「そば・うどん」です。1世帯が1年間に、お店で食べる日本そば・うどんへ使ったお金を、市ごとに並べました。全国では{A_NAT}です。'],
    ['touko', 'お蕎麦屋さんなら、わたくしの町にもあるわ。'],
    ['kei', 'お店で食べた分と、出前や持ち帰りの分を数えています。この調査は、県庁所在市と政令指定都市、あわせて{N}市が対象です。'],
  ]}
  secondAsk="中華そばというのは、どれだけ食べているの？"
  shareLabel="そば・うどんとラーメン、どちらにお金を使う？"
  notes="数字は総務省統計局「家計調査」の、二人以上の世帯の1世帯当たり年間支出額です。家計調査の対象は都道府県庁所在市と政令指定都市で、都道府県別の数字はありません。どちらも外食の項目で、家で作るために買ったゆで麺や乾麺、即席めんは入りません。「ラーメン」は調査の「中華そば」の項目です。調べる世帯の数が市ごとに限られるので、1年分の数字には年ごとのゆれがあります。5番目と同じ値の市があるときは、TOP5の表にいっしょに載せています。「そば・うどんの割合」は、二つの支出額を足した額に占めるそば・うどんの割合です。"
  cross={[['/exhibits/gyoza/', '日本一「餃子が好き」な市はどこだ'], ['/exhibits/bread-rice/', 'パンとお米、日本一はどの市だ'], ['/household/', '別館　家計の帳場']]}
/>
