---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getActivityPair } from '../../../lib/activity-pair.js';
const data = await getActivityPair('10', '11');
---
<PairExhibit
  data={data} unit="pct" area="県" no={54} slug="hogaku-chorus"
  title="邦楽とコーラス、日本一はどの県だ"
  sub="見る・聴く広場｜邦楽（民謡、日本古来の音楽を含む）、コーラス・声楽の行動者率"
  pageTitle="邦楽とコーラスの行動者率｜Countopia Stats"
  description="都道府県別・邦楽（民謡、日本古来の音楽を含む）、コーラス・声楽をした人の割合。邦楽とコーラス、日本一はどの県か。"
  a={{ label: '邦楽をする人', short: '邦楽' }}
  b={{ label: 'コーラスや声楽をする人', short: 'コーラス・声楽' }}
  genre="歌と音楽"
  intro={[
    ['kei', '54番目の展示は「邦楽」です。1年のあいだに、三味線や琴、尺八、民謡などを趣味でした人の割合を、県ごとに並べました。全国では{A_NAT}です。'],
    ['touko', 'お琴なら、わたくしもお稽古に通っているのよ。いまの時代も、習っている人はいるのかしら。'],
    ['kei', '聴いただけの人ではなく、自分で演奏したり歌ったりした人の割合です。'],
  ]}
  secondAsk="コーラスというのは、唱歌をみんなで歌うようなものかしら。"
  notes="「行動者率」は、過去1年間にその活動を1回でもした人（10歳以上）の割合です。総務省統計局「社会生活基本調査」（5年ごと）の都道府県別の値で、小数第1位までの数字のため、0.1ポイントの差は調査のゆれの範囲と考えてください。「邦楽」には民謡や日本古来の音楽を含みます。聴くだけの鑑賞は入りません。仕事や学校の授業として行ったものも入りません。5番目と同じ値の県があるときは、TOP5の表にいっしょに載せています。"
  cross={[['/exhibits/karaoke/', 'カラオケと楽器、日本一はどの県だ'], ['/exhibits/concert/', 'クラシックとポピュラー、日本一はどの県だ'], ['/exhibits/odori-dance/', 'おどりと社交ダンス、日本一はどの県だ']]}
/>
