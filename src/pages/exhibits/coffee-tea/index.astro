---
import PairExhibit from '../../../components/PairExhibit.astro';
import { getKakeiPair } from '../../../lib/kakei-pair.js';
const data = await getKakeiPair('011020010', '011010010');
---
<PairExhibit
  data={data} unit="yen" area="市" no={31} slug="coffee-tea"
  title="コーヒーと緑茶、日本一はどの市だ"
  sub="暮らしの広場｜1世帯当たりのコーヒー・緑茶の年間支出額"
  pageTitle="コーヒーと緑茶にかけるお金｜Countopia Stats"
  description="都市別・1世帯当たりのコーヒーと緑茶の年間支出額。コーヒーと緑茶、日本一はどの市か。"
  a={{ label: 'コーヒーに使うお金', short: 'コーヒー' }}
  b={{ label: '緑茶に使うお金', short: '緑茶' }}
  genre="飲みもの"
  intro={[
    ['kei', '31番目の展示は「コーヒー」です。1世帯が1年間にコーヒーへ使ったお金を、市ごとに並べました。全国では{A_NAT}です。'],
    ['touko', 'コーヒーなら、銀座のカフェーで見たことがあるわ。ハイカラな飲みものだったのよ。'],
    ['kei', 'いまでは、家でもふつうに飲まれています。この調査は、県庁所在市と政令指定都市、あわせて{N}市が対象です。'],
  ]}
  secondAsk="では、お茶はどうなの？　わたくしの家では、毎日お番茶だったわ。"
  shareLabel="コーヒーとお茶、どちらにお金を使う？"
  notes="数字は総務省統計局「家計調査」の、二人以上の世帯の1世帯当たり年間支出額です。家計調査の対象は都道府県庁所在市と政令指定都市で、都道府県別の数字はありません。「コーヒー」は家でいれる豆・粉やインスタントで、缶やペットボトルのコーヒー飲料と、喫茶店で飲む分は含みません。「緑茶」は茶葉で、ペットボトルのお茶は含みません。金額は買った量と値段の両方で決まり、調べる世帯の数が市ごとに限られるので、1年分の数字には年ごとのゆれがあります。「コーヒーの割合」は、コーヒーと緑茶の支出額を足した額に占めるコーヒーの割合です。5番目と同じ値の市があるときは、TOP5の表にいっしょに載せています。"
  cross={[['/exhibits/beef-pork/', '牛肉と豚肉、日本一はどの市だ'], ['/exhibits/bread-rice/', 'パンとお米、日本一はどの市だ'], ['/exhibits/gyoza/', '日本一「餃子が好き」な市はどこだ']]}
/>
