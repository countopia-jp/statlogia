---
import ExhibitHero from '../../../components/ExhibitHero.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Talk from '../../../components/Talk.astro';
import { getPriceData } from '../../../lib/price.js';

const data = await getPriceData();
const rows = data.education.rows;
const most = rows.slice(0, 5);
const least = rows.slice(-5).reverse();
const top = rows[0];
const bottom = rows[rows.length - 1];
const maxMin = top.minutes;
const fmt = (v) => `${v.toFixed(1)}`;
const r1 = (v) => Number(v.toFixed(1));

// 同じ値の県があるときに備えて順位は値から引く
const rankOf = (v) => rows.findIndex((r) => r.minutes.toFixed(1) === v.toFixed(1)) + 1;
const lowRankOf = (v) => least.findIndex((r) => r.minutes.toFixed(1) === v.toFixed(1)) + 1;
const topNames = rows.filter((r) => r.minutes.toFixed(1) === top.minutes.toFixed(1)).map((r) => r.n);
const bottomNames = least.filter((r) => r.minutes.toFixed(1) === bottom.minutes.toFixed(1)).map((r) => r.n);
// 総合・光熱水道での順位を値から引く
const rankOfName = (list, name) => { const v = list.find((r) => r.n === name)?.minutes; return v === undefined ? 0 : list.findIndex((r) => r.minutes.toFixed(1) === v.toFixed(1)) + 1; };
const totalRank = (name) => rankOfName(data.rows, name);
const heatRank = (name) => rankOfName(data.heat.rows, name);
const topHeatRank = heatRank(top.n);
const topTotalRank = totalRank(top.n);

// 費目ごとの「上と下の開き」を表示と同じ丸めで比べる
const spreadOf = (list) => r1(list[0].minutes) - r1(list[list.length - 1].minutes);
const eduSpread = spreadOf(rows);
const totalSpread = spreadOf(data.rows);
const heatSpread = spreadOf(data.heat.rows);
const foodSpread = spreadOf(data.food.rows);
const isWidest = eduSpread >= totalSpread && eduSpread >= heatSpread && eduSpread >= foodSpread;
// 教育1位の県が光熱・水道では下位にいるか（反転ネタが成立するかの判定）
const isFlipped = topHeatRank >= 38;
---
<BaseLayout title="教育の物価が高い県｜Countopia Stats" description="都道府県別・消費者物価地域差指数（教育）。日本一「教育の値段が高い」県はどこか。" backHref="/exhibits/" backLabel="展示一覧">
  <main>
    <section class="exhibit">
      <ExhibitHero slug="education-price">
        <span class="no">EXHIBIT 16</span>
        <h1><span class="h1a">日本一「教育の値段が高い」</span><span class="h1b">県はどこだ</span></h1>
        <p class="sub">値段の広場｜消費者物価地域差指数・教育（{data.education.year}）</p>
      </ExhibitHero>

      <Talk speaker="kei">16番目の展示は「教育」です。授業料や入学金といった、学びにかかる値段の水準を県ごとに並べました。</Talk>
      <Talk speaker="touko">こちらも、全国の平均が100なのね。</Talk>
      <Talk speaker="kei">{isWidest ? 'そうです。ここまでの物価の展示のなかで、いちばん差が大きく出た費目です。' : 'そうです。同じ物価でも、費目によって差の出かたはずいぶん違います。'}</Talk>

      <div class="highlight">
        <div class="card card--hot">
          <span class="seal" aria-hidden="true"><b>最高</b></span>
          <span class="label">教育がいちばん高い</span>
          <strong>{topNames.join('・')}</strong>
          <span class="num">{fmt(top.minutes)}</span>
        </div>
        <div class="card card--cool">
          <span class="seal" aria-hidden="true"><b>最低</b></span>
          <span class="label">教育がいちばん安い</span>
          <strong>{bottomNames.join('・')}</strong>
          <span class="num">{fmt(bottom.minutes)}</span>
        </div>
      </div>

      <Talk speaker="touko">上と下で、これほど違うものなの。</Talk>
      <Talk speaker="kei">{topNames.join('と')}が{fmt(top.minutes)}、{bottomNames.join('と')}が{fmt(bottom.minutes)}で、差は{eduSpread.toFixed(1)}ポイント。総合で見たときの差は{totalSpread.toFixed(1)}ポイント、電気やガスでも{heatSpread.toFixed(1)}ポイントでした。</Talk>

      <h2>教育の物価が高い県 TOP5</h2>
      <ol class="rank">
        {most.map((r) => (
          <li>
            <span class="pos">{rankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / maxMin) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      <h2>教育の物価が低い県 TOP5</h2>
      <ol class="rank low">
        {least.map((r) => (
          <li>
            <span class="pos">{lowRankOf(r.minutes)}</span>
            <span class="pref">{r.n}</span>
            <span class="bar" style={`--w:${(r.minutes / maxMin) * 100}%`}></span>
            <span class="min">{fmt(r.minutes)}</span>
          </li>
        ))}
      </ol>

      {isFlipped ? (
        <>
          <Talk speaker="touko">この{top.n}、電気やガスの展示では、下のほうにいなかったかしら？</Talk>
          <Talk speaker="kei">よく覚えていましたね。{top.n}は光熱・水道では{topHeatRank}番目、総合では{topTotalRank}番目です。</Talk>
          <Talk speaker="touko">同じ県なのに、見るものを変えると、上のほうと下のほうを行ったり来たりするのねえ。</Talk>
        </>
      ) : (
        <>
          <Talk speaker="touko">この{top.n}は、ほかの費目ではどうだったのかしら。</Talk>
          <Talk speaker="kei">光熱・水道では{topHeatRank}番目、総合では{topTotalRank}番目です。</Talk>
          <Talk speaker="touko">同じ県でも、見るものを変えると順番が動くのねえ。</Talk>
        </>
      )}
      <Talk speaker="kei">物価というひとつの言葉でまとめてしまうと、この動きは見えなくなります。何の値段を見ているのか。それを決めてから、順番を眺めることです。</Talk>

      <details class="all">
        <summary>47都道府県すべてを見る（高い順）</summary>
        <ol>
          {rows.map((r) => <li>{r.n}　{fmt(r.minutes)}</li>)}
        </ol>
      </details>

      <p class="note">この数字は「全国平均＝100」とした指数で、教育に関わるものを買うときの値段の水準を表しています。各家庭が実際に支払った金額や、教育にかける熱心さを表すものではありません。消費者物価地域差指数は、全国平均を100としたときの「価格の水準」で、使う量や支出の額ではありません。総務省統計局「小売物価統計調査（構造編）」から毎年作られます。同じ値の県が複数あるときは、同じ順位として並べています。</p>

      <p class="cross">あわせて読む：<a href="/exhibits/utility/">日本一「電気やガスが高い」県はどこだ</a>｜<a href="/exhibits/price/">日本一「物価が高い」県はどこだ</a>｜<a href="/education-budget/">教育の帳場</a></p>

      <div class="source">
        <p>出典：{data.source}</p>
        <p>このサービスは、政府統計総合窓口(e-Stat)のAPI機能を使用していますが、サービスの内容は国によって保証されたものではありません。</p>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
.exhibit{padding:56px 0 80px;max-width:720px;margin:0 auto}
.sec-head .no{font-family:"IBM Plex Mono",monospace;font-size:.72rem;letter-spacing:.3em;color:var(--stamp)}
h1{font-family:"Shippori Mincho",serif;font-weight:800;font-size:clamp(1.5rem,4vw,2.2rem);margin-top:8px}
.sub{color:var(--ink-soft);font-size:.85rem;margin-top:6px;margin-bottom:28px}
h2{font-family:"Shippori Mincho",serif;font-size:1.15rem;margin:40px 0 16px;border-left:4px solid var(--stamp);padding-left:12px}
.highlight{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:28px 0}
@media(max-width:560px){.highlight{grid-template-columns:1fr}}
.card{position:relative;border:1px solid var(--line);border-radius:12px;padding:20px;background:#fff;display:flex;flex-direction:column;gap:4px;align-items:flex-start}
.card .label{font-size:.72rem;letter-spacing:.2em;color:var(--ink-soft)}
.card strong{font-family:"Shippori Mincho",serif;font-size:1.9rem;line-height:1.2}
.card .num{font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:1.1rem}
.card--hot .num{color:#b23a2f}
.card--cool .num{color:#2d6a4f}
.seal{
  position:absolute;top:12px;right:14px;width:48px;height:48px;
  border:2px solid currentColor;border-radius:50%;
  display:flex;align-items:center;justify-content:center;gap:1px;
  transform:rotate(-12deg);opacity:.55;
  font-family:"Shippori Mincho",serif;
}
.seal b{font-size:.8rem;line-height:1;letter-spacing:.06em}
.card--hot .seal{color:#b23a2f}
.card--cool .seal{color:#2d6a4f}
.rank{list-style:none;padding:0;display:flex;flex-direction:column;gap:10px}
.rank li{display:grid;grid-template-columns:2em 6.5em 1fr auto;align-items:center;gap:10px}
.rank .pos{font-family:"IBM Plex Mono",monospace;color:var(--stamp);font-weight:600}
.rank .bar{height:10px;border-radius:99px;background:var(--stamp);width:var(--w);opacity:.85;min-width:8px}
.rank.low .bar{background:#3a6b52}
.rank .min{font-family:"IBM Plex Mono",monospace;font-size:.85rem;color:var(--ink-soft)}
.all{margin:32px 0}
.all summary{cursor:pointer;color:var(--stamp);font-size:.9rem}
.all ol{columns:2;margin-top:14px;font-size:.9rem;color:var(--ink-soft)}
@media(max-width:560px){.all ol{columns:1}}
.note{margin-top:28px;font-size:.85rem;color:var(--ink-soft);line-height:1.9}
.cross{margin-top:36px;font-size:.9rem}
.cross a{color:var(--stamp)}
.source{margin-top:48px;padding-top:20px;border-top:1px solid var(--line);font-size:.75rem;color:var(--ink-soft);line-height:1.8}
</style>