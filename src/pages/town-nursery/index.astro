---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Talk from '../../components/Talk.astro';
import { getMuniNurseryData } from '../../lib/muni-nursery.js';
const data = await getMuniNurseryData();
---
<BaseLayout title="保育所は、近いか｜Countopia Stats" description="市区町村を選んで、最寄りの保育所まで500m未満・1000m以上の世帯の割合をご覧いただける窓口。全国ベスト5つき。" backHref="/dashboard/" backLabel="閲覧室">
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>

  <main class="tp">
    <header class="tp-hero">
    <img class="tp-hero-figure" src="/images/icon/town-nursery-large.webp" alt="親子が手をつないで保育所へ向かう住宅街の水彩画" width="1400" height="788" loading="lazy" />
      <p class="tp-kicker">閲覧室</p>
      <h1>保育所は、近いか</h1>
      <p class="tp-lead">
        市区町村を選んで、最寄りの保育所までの近さをご覧ください。<br />
        子育ての足もとを、世帯の割合という数字で。
      </p>
    </header>

    <Talk speaker="kei">
      こちらは保育所の窓口です。最寄りの保育所まで500m未満の世帯の割合で、その町の「保育所の近さ」が分かります。
    </Talk>
    <Talk speaker="touko">
      保育所というのは、小さな子を昼のあいだ預かるところなの？
    </Talk>

    <section class="tp-selector">
      <label>
        <span>都道府県</span>
        <select id="prefSelect"><option value="">選んでください</option></select>
      </label>
      <label>
        <span>市区町村</span>
        <select id="townSelect" disabled><option value="">まず都道府県を選ぶ</option></select>
      </label>
    </section>

    <section id="resultArea" class="tp-result" hidden aria-live="polite">
      <h2 id="resultTitle"></h2>
      <div id="cardArea" class="tp-cards"></div>

      <div class="tp-chart-wrap">
        <p class="tp-chart-title">保育所が近い世帯の割合の推移</p>
        <canvas id="nurseryChart" height="120"></canvas>
      </div>

      <Talk speaker="kei"><span id="keiLine"></span></Talk>
      <Talk speaker="touko"><span id="toukoLine"></span></Talk>
    </section>

    <section class="tp-ranking">
      <h2>全国ベスト5</h2>
      <div class="tp-tabs" role="tablist">
        <button class="tp-tab is-active" data-rank="near" role="tab">保育所が近い町</button>
      </div>
      <ol class="tp-rank-list" id="rankList"></ol>
      <p class="tp-note" id="rankNote"></p>
    </section>

    <p class="tp-cross">あわせて見る：<a href="/education/">学びの登記所</a>｜<a href="/town-population/">わが町の人口</a></p>

    <footer class="tp-source">
      <p>
        出典：{data.source}（{data.year}）<br />
        {data.note}<br />
        このページはe-Stat APIで取得した統計データを独自に加工して作成しています。
      </p>
    </footer>
  </main>

  <script is:inline define:vars={{ TP: data }}>
    (function () {
      const IND = TP.indicators;
      const areas = TP.areas;
      const NEAR = 1, FAR = 2; // 近い％ / 遠い％ のインデックス

      const fmt = (i, val) => {
        if (val === null || val === undefined) return '—';
        return IND[i].unit === '％' ? val.toFixed(1) + '％' : Math.round(val).toLocaleString('ja-JP') + IND[i].unit;
      };
      function rankBy(i, dir) {
        return areas.filter((a) => !a.x && a.v[i] !== null)
          .sort((x, y) => (dir === 'desc' ? y.v[i] - x.v[i] : x.v[i] - y.v[i]));
      }
      const nearRank = rankBy(NEAR, 'desc');
      const rankOfNear = Object.fromEntries(nearRank.map((a, idx) => [a.c, idx + 1]));
      const totalRank = nearRank.length;

      const prefSel = document.getElementById('prefSelect');
      const sel = document.getElementById('townSelect');
      const PREF_NAMES = {
        '01':'北海道','02':'青森県','03':'岩手県','04':'宮城県','05':'秋田県','06':'山形県','07':'福島県',
        '08':'茨城県','09':'栃木県','10':'群馬県','11':'埼玉県','12':'千葉県','13':'東京都','14':'神奈川県',
        '15':'新潟県','16':'富山県','17':'石川県','18':'福井県','19':'山梨県','20':'長野県','21':'岐阜県',
        '22':'静岡県','23':'愛知県','24':'三重県','25':'滋賀県','26':'京都府','27':'大阪府','28':'兵庫県',
        '29':'奈良県','30':'和歌山県','31':'鳥取県','32':'島根県','33':'岡山県','34':'広島県','35':'山口県',
        '36':'徳島県','37':'香川県','38':'愛媛県','39':'高知県','40':'福岡県','41':'佐賀県','42':'長崎県',
        '43':'熊本県','44':'大分県','45':'宮崎県','46':'鹿児島県','47':'沖縄県'
      };
      const byPref = {};
      for (const a of areas) { const p = a.c.slice(0, 2); (byPref[p] = byPref[p] || []).push(a); }
      Object.keys(byPref).sort().forEach((p) => {
        const o = document.createElement('option'); o.value = p; o.textContent = PREF_NAMES[p] || p; prefSel.appendChild(o);
      });
      const shortName = (a) => {
        const pref = PREF_NAMES[a.c.slice(0, 2)];
        return pref && a.n.startsWith(pref) ? a.n.slice(pref.length).trim() : a.n;
      };
      prefSel.addEventListener('change', () => {
        sel.innerHTML = '<option value="">選んでください</option>';
        const list = byPref[prefSel.value] || [];
        for (const a of list) { const o = document.createElement('option'); o.value = a.c; o.textContent = shortName(a); sel.appendChild(o); }
        sel.disabled = list.length === 0;
        document.getElementById('resultArea').hidden = true;
      });
      sel.addEventListener('change', () => { const a = areas.find((x) => x.c === sel.value); if (a) render(a); });

       let nurseryChart = null;
      function renderChart(a) {
        const wrap = document.querySelector('.tp-chart-wrap');
        if (!a.series || a.series.length < 2) {
          wrap.hidden = true;
          return;
        }
        wrap.hidden = false;
        const ctx = document.getElementById('nurseryChart');
        if (nurseryChart) nurseryChart.destroy();
        nurseryChart = new Chart(ctx, {
          type: 'line',
          data: {
            labels: a.series.map((p) => p.year),
            datasets: [{
              label: '保育所が近い世帯の割合',
              data: a.series.map((p) => p.value),
              borderColor: '#2d6a4f',
              backgroundColor: '#2d6a4f22',
              tension: 0.2,
              fill: true,
            }],
          },
          options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { ticks: { callback: (v) => v.toFixed(1) + '％' } } },
          },
        });
      }

      function render(a) {
        document.getElementById('resultArea').hidden = false;
        document.getElementById('resultTitle').textContent = a.n + 'の保育所アクセス';
        const wrap = document.getElementById('cardArea');
        wrap.innerHTML = '';
        IND.forEach((ind, i) => {
          const card = document.createElement('div');
          card.className = 'tp-card';
          let cls = '';
          if (i === NEAR) cls = ' pos';
          if (i === FAR) cls = ' neg';
          let meta = '';
          if (i === NEAR && !a.x && rankOfNear[a.c]) {
            meta = `<div class="tp-card-meta">${totalRank}市区町村中 ${rankOfNear[a.c]}位</div>`;
          }
          card.innerHTML =
            `<div class="tp-card-label">${ind.key}</div>` +
            `<div class="tp-card-num${cls}">${fmt(i, a.v[i])}</div>` + meta;
          wrap.appendChild(card);
        });
        renderChart(a);
        updateLines(a);
      }

      function updateLines(a) {
        const near = a.v[NEAR], far = a.v[FAR];
        const kei = document.getElementById('keiLine');
        const TOUKO_LINES = ["家からの道のりまで、測ってあるの？", "わたくしの頃は、子どもは家で見るものだったけれど。", "保育所までの近さを、家ごとに調べてあるのね。"];
        // 橙子の一言は順位や値を言い直さず、数字への驚きや感心を言う（値のない町の一言はそのまま）
        const touko = { set textContent(v) { const el = document.getElementById('toukoLine'); if (/値のない|定めのない|ない町|0校/.test(v)) { el.textContent = v; return; } const k = document.getElementById('keiLine').textContent || ''; let h = 0; for (const ch of k) h = (h * 31 + ch.charCodeAt(0)) >>> 0; el.textContent = TOUKO_LINES[h % TOUKO_LINES.length]; } };
        const hasNear = typeof near === 'number';
        const hasFar = typeof far === 'number';
        let k = '';
        if (hasNear) {
          k = `保育所まで500m未満の世帯は${near.toFixed(1)}％。`;
          k += near >= 40 ? ' 4割以上の世帯で、保育所が500m未満にあります。'
             : near <= 15 ? ' 500m未満の世帯は、15％以下です。'
             : '';
        } else {
          k = '保育所まで500m未満の世帯の割合は、この町の値がありません。';
        }
        if (hasFar) k += ` 1000m以上の世帯は${far.toFixed(1)}％です。`;
        else k += ' 1000m以上の世帯の割合は、この町の値がありません。';
        kei.textContent = k;
        const seed = parseInt(a.c, 10) || 0;
        touko.textContent = !hasFar
          ? '値のない欄もあるのね。'
          : far >= 50
            ? ['半分より多くの家が、千メートルより遠いのねえ。', '遠い家のほうが多いのね。'][seed % 2]
            : far >= 20
              ? ['遠い家も、少なくないのね。', '五軒に一軒より多くが、千メートルより遠いのねえ。'][seed % 2]
              : ['千メートルより遠い家は、少ないのねえ。', '近いところに、ある家が多いのね。'][seed % 2];
      }

      const RANKS = {
        near: { i: NEAR, dir: 'desc', note: '保育所まで500m未満の世帯割合が高い市区町村ベスト5。政令指定都市の行政区と、特別区部計は除いています。' },
      };
      const rankList = document.getElementById('rankList');
      const rankNote = document.getElementById('rankNote');
      function showRank(mode) {
        const cfg = RANKS[mode];
        rankList.innerHTML = '';
        rankBy(cfg.i, cfg.dir).slice(0, 5).forEach((a) => {
          const li = document.createElement('li');
          const cls = mode === 'near' ? 'pos' : 'neg';
          li.innerHTML = `<span class="tp-rank-name">${a.n}</span><span class="tp-rank-val ${cls}">${fmt(cfg.i, a.v[cfg.i])}</span>`;
          li.addEventListener('click', () => {
            prefSel.value = a.c.slice(0, 2); prefSel.dispatchEvent(new Event('change'));
            sel.value = a.c; sel.dispatchEvent(new Event('change'));
          });
          rankList.appendChild(li);
        });
        rankNote.textContent = cfg.note;
      }
      document.querySelectorAll('.tp-tab').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.tp-tab').forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          showRank(btn.dataset.rank);
        });
      });
      showRank('near');
    })();
  </script>

  <style is:global>
    .tp { max-width: 860px; margin: 0 auto; padding: 0 16px 48px; }
    .tp-hero { text-align: center; padding: 28px 0 8px; }
    .tp-hero-figure { display: block; width: 100%; max-width: 780px; height: auto; border-radius: 4px; margin: 0 auto 20px; }
    .tp-kicker { letter-spacing: .2em; font-size: .8rem; color: #2d6a4f; }
    .tp-hero h1 { margin: 4px 0 12px; font-family: "Shippori Mincho", serif; font-weight: 800; }
    .tp-lead { color: #555; line-height: 1.9; }
    .tp-selector { margin: 24px 0; display: flex; flex-direction: column; gap: 12px; align-items: center; }
    .tp-selector label { display: flex; flex-direction: column; gap: 6px; font-size: .85rem; align-items: flex-start; }
    .tp-selector select { width: 280px; max-width: 100%; padding: 10px 12px; border: 1px solid #1b4332; border-radius: 6px; background: #fff; font-size: 1rem; }
    .tp-selector select:disabled { background: #f0f0ea; color: #999; }
    .tp-result h2 { text-align: center; margin: 24px 0 16px; font-family: "Shippori Mincho", serif; }
    .tp-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    @media (max-width: 560px) { .tp-cards { grid-template-columns: 1fr; } }
    .tp-card { border: 1px solid #e0e0d8; border-radius: 8px; padding: 14px; background: #fff; text-align: center; }
    .tp-card-label { font-size: .78rem; color: #2d6a4f; letter-spacing: .06em; }
    .tp-card-num { font-family: "IBM Plex Mono", monospace; font-size: 1.35rem; font-weight: 700; margin: 6px 0 2px; color: #1b4332; }
    .tp-card-num.pos { color: #2d6a4f; }
    .tp-card-num.neg { color: #b23a2f; }
    .tp-card-meta { font-size: .72rem; color: #b23a2f; font-weight: 700; }

    .tp-chart-wrap {
      margin: 24px 0 8px; padding: 16px; border: 1px solid #e0e0d8;
      border-radius: 8px; background: #fff;
    }
    .tp-chart-title {
      font-size: 0.8rem; color: #2d6a4f; letter-spacing: 0.06em;
      margin: 0 0 10px; text-align: center;
    }

    .tp-ranking { margin-top: 44px; }
    .tp-ranking h2 { text-align: center; font-family: "Shippori Mincho", serif; }
    .tp-tabs { display: flex; gap: 8px; justify-content: center; margin: 12px 0 16px; flex-wrap: wrap; }
    .tp-tab { padding: 8px 16px; border: 1px solid #1b4332; border-radius: 999px; background: #fff; cursor: pointer; font-size: .85rem; }
    .tp-tab.is-active { background: #1b4332; color: #fff; }
    .tp-rank-list { list-style: none; counter-reset: rank; padding: 8px 20px; max-width: 560px; margin: 0 auto 8px; border: 1px solid #e0e0d8; border-radius: 8px; background: #fdfdf8; }
    .tp-rank-list li { counter-increment: rank; display: flex; justify-content: space-between; align-items: center; padding: 10px 4px; border-bottom: 1px solid #e0e0d8; cursor: pointer; }
    .tp-rank-list li:last-child { border-bottom: none; }
    .tp-rank-list li::before { content: counter(rank); font-weight: 700; color: #b23a2f; margin-right: 12px; min-width: 1.4em; text-align: center; }
    .tp-rank-list li:hover { background: #f4f7f4; }
    .tp-rank-name { flex: 1; }
    .tp-rank-val { font-weight: 700; font-family: "IBM Plex Mono", monospace; }
    .tp-rank-val.pos { color: #2d6a4f; }
    .tp-rank-val.neg { color: #b23a2f; }
    .tp-note { font-size: .8rem; color: #666; text-align: center; line-height: 1.8; }
    .tp-cross { margin-top: 36px; font-size: .9rem; text-align: center; }
    .tp-cross a { color: #b23a2f; }
    .tp-source { margin-top: 40px; font-size: .75rem; color: #888; line-height: 1.8; }
  </style>
</BaseLayout>