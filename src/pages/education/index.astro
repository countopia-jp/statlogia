---
// =====================================================
// Countopia Stats - 教育ダッシュボード「学びの登記所」
// src/pages/education/index.astro
//
// 来館者が自治体を選ぶ、Countopia初のインタラクティブ展示。
// データは /data/education.json（ビルド時生成）から取得。
// =====================================================
import BaseLayout from '../../layouts/BaseLayout.astro';
import Talk from '../../components/Talk.astro';
import { getEducationData } from '../../lib/education.js';

// ビルド時にも一度読んで、注記用の年度ラベルを静的に埋め込む
const edu = await getEducationData();
const countYears = [...new Set(
  edu.indicators.filter((i) => i.kind === 'count' && i.year).map((i) => i.year)
)];
const yearNote = countYears.join('・');
---

<BaseLayout title="教育ダッシュボード｜学びの登記所 - Countopia Stats" backHref="/dashboard/" backLabel="閲覧室">
  <main class="edu-dash">
    <header class="edu-hero">
      <img class="edu-hero-figure" src="/images/icon/school-large.webp" alt="山あいの木造校舎、校庭の一本桜" width="1400" height="781" loading="lazy" />
      <p class="edu-kicker">ダッシュボード</p>
      <h1>学びの登記所</h1>
      <p class="edu-lead">
        あなたの町に、学校はいくつあるでしょう。<br />
        全国の市区町村から選んで、幼稚園から高校までの数字を確かめられる窓口です。
      </p>
    </header>

    <Talk speaker="kei">
      当登記所には全国の市区町村の学校数が記録されています。まずは調べたい町を選んでください。
    </Talk>
    <Talk speaker="touko">
      わたしの通っていた学校も、もう数字になっているのかしら……。
    </Talk>

    <!-- ===== 都道府県タイル地図 ===== -->
    <section class="edu-map" aria-label="都道府県の地図から選ぶ">
      <div id="prefMap"></div>
      <p class="edu-map-note">地図の区画を選ぶと、その県の市区町村が下の窓口に並びます。</p>
    </section>

    <!-- ===== 自治体セレクタ ===== -->
    <section class="edu-selector" aria-label="自治体の選択">
      <div class="edu-select-row">
        <label>
          <span>都道府県</span>
          <select id="prefSelect">
            <option value="">選んでください</option>
          </select>
        </label>
        <label>
          <span>市区町村</span>
          <select id="citySelect" disabled>
            <option value="">都道府県を先に</option>
          </select>
        </label>
      </div>
    </section>

    <!-- ===== 選択結果カード ===== -->
    <section id="resultArea" class="edu-result" hidden aria-live="polite">
      <h2 id="resultTitle"></h2>
      <div class="edu-cards" id="cardGrid"></div>
      <div class="edu-chart-wrap">
        <canvas id="schoolChart" height="220"></canvas>
      </div>
      <p class="edu-note" id="perSchoolNote"></p>
      <Talk speaker="kei"><span id="keiLine">町を選ぶと、台帳を読み上げます。</span></Talk>
      <Talk speaker="touko"><span id="toukoLine">どんな町かしら。</span></Talk>
    </section>

    <!-- ===== ランキング ===== -->
    <section class="edu-ranking" aria-label="ランキング">
      <h2>全国ベスト5</h2>
      <div class="edu-tabs" role="tablist">
        <button class="edu-tab is-active" data-rank="count" role="tab">小学校の数</button>
        <button class="edu-tab" data-rank="perschool" role="tab">1校あたり児童数の少なさ</button>
      </div>
      <ol class="edu-rank-list" id="rankList"></ol>
      <p class="edu-note" id="rankNote"></p>
    </section>

    <Talk speaker="kei">
      数の多さは町の大きさを、1校あたりの少なさは学びの届き方を映します。二つの物差しで、まるで違う顔ぶれが並ぶのです。
    </Talk>

    <footer class="edu-source">
      <p>
        出典：{edu.source}（{yearNote}時点）<br />
        このページはe-Stat APIで取得した統計データを独自に加工して作成しています。
        政令指定都市の区は選択できますが、ランキング集計からは除外しています（市単位で集計）。
        地図は都道府県の位置関係を模した区画図で、実際の面積や形状を表すものではありません。
      </p>
    </footer>
  </main>

  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <script is:inline>
    (async function () {
      const res = await fetch('/data/education.json');
      const data = await res.json();
      const IND = data.indicators; // 順番はv配列と一致
      const idx = Object.fromEntries(IND.map((ind, i) => [ind.code, i]));

      const GROUPS = [
        { key: 'kindergarten', label: '幼稚園', count: 'E1101', students: 'E1501', studentLabel: '在園者' },
        { key: 'elementary', label: '小学校', count: 'E2101', teachers: 'E2401', students: 'E2501', studentLabel: '児童' },
        { key: 'junior', label: '中学校', count: 'E3101', teachers: 'E3401', students: 'E3501', studentLabel: '生徒' },
        { key: 'high', label: '高校', count: 'E4101', students: 'E4501', studentLabel: '生徒' },
      ];

      const fmt = (n) => (n === null || n === undefined) ? '—' : n.toLocaleString('ja-JP');
      const val = (area, code) => area.v[idx[code]];

      // ---- セレクタ構築 ----
      const prefSelect = document.getElementById('prefSelect');
      const citySelect = document.getElementById('citySelect');
      const prefs = [...new Set(data.areas.map((a) => a.p))];
      for (const p of prefs) {
        const opt = document.createElement('option');
        opt.value = p; opt.textContent = p;
        prefSelect.appendChild(opt);
      }

      prefSelect.addEventListener('change', () => {
        citySelect.innerHTML = '<option value="">選んでください</option>';
        const list = data.areas.filter((a) => a.p === prefSelect.value);
        for (const a of list) {
          const opt = document.createElement('option');
          opt.value = a.c;
          opt.textContent = a.n;
          citySelect.appendChild(opt);
        }
        citySelect.disabled = list.length === 0;
        highlightTile(prefSelect.value);
      });

      citySelect.addEventListener('change', () => {
        const area = data.areas.find((a) => a.c === citySelect.value);
        if (area) render(area);
      });

      // ---- 都道府県タイル地図 ----
      // [表示名, 行, 列] 日本の位置関係を模した区画配置（13列×14行）
      const TILES = [
        ['北海道', 1, 13],
        ['青森', 2, 12],
        ['秋田', 3, 11], ['岩手', 3, 12],
        ['山形', 4, 11], ['宮城', 4, 12],
        ['石川', 5, 9], ['富山', 5, 10], ['新潟', 5, 11], ['福島', 5, 12], ['茨城', 5, 13],
        ['福井', 6, 8], ['岐阜', 6, 9], ['長野', 6, 10], ['群馬', 6, 11], ['栃木', 6, 12],
        ['鳥取', 7, 6], ['兵庫', 7, 7], ['京都', 7, 8], ['滋賀', 7, 9], ['山梨', 7, 10],
        ['埼玉', 7, 11], ['東京', 7, 12], ['千葉', 7, 13],
        ['島根', 8, 5], ['岡山', 8, 6], ['大阪', 8, 7], ['奈良', 8, 8], ['愛知', 8, 9],
        ['静岡', 8, 10], ['神奈川', 8, 11],
        ['山口', 9, 4], ['広島', 9, 5], ['香川', 9, 6], ['和歌山', 9, 7], ['三重', 9, 8],
        ['福岡', 10, 3], ['大分', 10, 4], ['愛媛', 10, 5], ['徳島', 10, 6],
        ['佐賀', 11, 2], ['熊本', 11, 3], ['高知', 11, 5],
        ['長崎', 12, 2], ['宮崎', 12, 4],
        ['鹿児島', 13, 3],
        ['沖縄', 14, 1],
      ];

      const NS = 'http://www.w3.org/2000/svg';
      const CELL = 34, GAP = 3, PAD = 2, COLS = 13, ROWS = 14;
      const tileByPref = {};

      function buildMap() {
        const w = COLS * (CELL + GAP) + PAD * 2;
        const h = ROWS * (CELL + GAP) + PAD * 2;
        const svg = document.createElementNS(NS, 'svg');
        svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
        svg.setAttribute('role', 'group');
        svg.setAttribute('aria-label', '都道府県の区画図');

        for (const [base, r, c] of TILES) {
          const pref = prefs.find((p) => p.startsWith(base));
          const x = PAD + (c - 1) * (CELL + GAP);
          const y = PAD + (r - 1) * (CELL + GAP);

          const g = document.createElementNS(NS, 'g');
          g.setAttribute('class', 'tile' + (pref ? '' : ' is-empty'));
          if (pref) {
            g.setAttribute('tabindex', '0');
            g.setAttribute('role', 'button');
            g.setAttribute('aria-label', pref);
          }

          const t = document.createElementNS(NS, 'title');
          t.textContent = pref || base;
          g.appendChild(t);

          const rect = document.createElementNS(NS, 'rect');
          rect.setAttribute('x', x); rect.setAttribute('y', y);
          rect.setAttribute('width', CELL); rect.setAttribute('height', CELL);
          rect.setAttribute('rx', 3);
          g.appendChild(rect);

          const label = document.createElementNS(NS, 'text');
          label.setAttribute('x', x + CELL / 2);
          label.setAttribute('y', y + CELL / 2);
          label.setAttribute('text-anchor', 'middle');
          label.setAttribute('dominant-baseline', 'central');
          label.setAttribute('font-size', base.length >= 3 ? 8.5 : 12);
          label.textContent = base;
          g.appendChild(label);

          if (pref) {
            const pick = () => {
              prefSelect.value = pref;
              prefSelect.dispatchEvent(new Event('change'));
            };
            g.addEventListener('click', pick);
            g.addEventListener('keydown', (e) => {
              if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(); }
            });
            tileByPref[pref] = g;
          }
          svg.appendChild(g);
        }
        document.getElementById('prefMap').appendChild(svg);
      }

      function highlightTile(pref) {
        for (const g of Object.values(tileByPref)) g.classList.remove('is-active');
        if (tileByPref[pref]) tileByPref[pref].classList.add('is-active');
      }

      buildMap();

      // ---- 案内人コメント生成 ----
      // 全国の小学校1校あたり児童数の中央値（ランキング対象で算出）
      const ratios = data.areas
        .filter((a) => !a.x && val(a, 'E2101') >= 1 && val(a, 'E2501') !== null)
        .map((a) => val(a, 'E2501') / val(a, 'E2101'))
        .sort((x, y) => x - y);
      const medianRatio = ratios.length
        ? ratios[Math.floor(ratios.length / 2)]
        : null;

      function updateCharacterLines(area) {
        const keiEl = document.getElementById('keiLine');
        const toukoEl = document.getElementById('toukoLine');
        if (!keiEl || !toukoEl) return;

        const elCount = val(area, 'E2101');
        const elStudents = val(area, 'E2501');
        const hsCount = val(area, 'E4101');
        const kgCount = val(area, 'E1101');
        const seed = parseInt(area.c, 10) || 0;

        let kei = '';
        let touko = '';

        if (elCount >= 1 && elStudents !== null && medianRatio) {
          const ratio = elStudents / elCount;
          const r = Math.round(ratio);
          if (ratio < medianRatio * 0.4) {
            kei = `小学校1校あたり約${r}人。全国でも指折りの、小さな学び舎の町です。`;
            touko = ['わたしの学校も、教室はひとつきりでしたのよ。', '先生は全員の名前どころか、家の犬の名前まで覚えていそうね。'][seed % 2];
          } else if (ratio > medianRatio * 2) {
            kei = `小学校1校あたり約${r}人。中央値の倍以上、教室はさぞ賑やかでしょう。`;
            touko = ['一校にこんなに大勢……運動会は壮観でしょうねえ。', 'お昼の給食を配るだけで、ひと仕事になりそうだわ。'][seed % 2];
          } else {
            kei = `小学校1校あたり約${r}人。全国の真ん中どころ（中央値は約${Math.round(medianRatio)}人）です。`;
            touko = ['ちょうどよい賑わい、というところかしら。', '教室の窓から、どんな景色が見えるのでしょうね。'][seed % 2];
          }
        } else {
          kei = 'この町の小学校は、台帳に記載が見当たりません。';
          touko = '数字にならない学び舎も、きっとあるのだわ。';
        }

        if (hsCount === 0 || hsCount === null) {
          kei += ' 高校の記載はなく、卒業後は町の外の学校へ通うことになります。';
        }
        if (kgCount === 0) {
          touko += ' 幼稚園はないのねえ。';
        }

        keiEl.textContent = kei;
        toukoEl.textContent = touko;
      }

      // ---- カード＋グラフ描画 ----
      let chart = null;
      function render(area) {
        document.getElementById('resultArea').hidden = false;
        updateCharacterLines(area);
        document.getElementById('resultTitle').textContent = `${area.p} ${area.n}`;

        const grid = document.getElementById('cardGrid');
        grid.innerHTML = '';
        for (const g of GROUPS) {
          const count = val(area, g.count);
          const students = val(area, g.students);
          const teachers = g.teachers ? val(area, g.teachers) : null;
          const card = document.createElement('div');
          card.className = 'edu-card';
          card.innerHTML =
            `<div class="edu-card-label">${g.label}</div>` +
            `<div class="edu-card-num">${fmt(count)}<span class="edu-card-unit">${g.key === 'kindergarten' ? '園' : '校'}</span></div>` +
            `<div class="edu-card-sub">${g.studentLabel} ${fmt(students)}人${teachers !== null && teachers !== undefined ? `・教員 ${fmt(teachers)}人` : ''}</div>`;
          grid.appendChild(card);
        }

        // 1校あたり児童数（小学校）
        const elCount = val(area, 'E2101');
        const elStudents = val(area, 'E2501');
        const note = document.getElementById('perSchoolNote');
        if (elCount > 0 && elStudents !== null) {
          note.textContent = `小学校1校あたりの児童数：約${Math.round(elStudents / elCount).toLocaleString('ja-JP')}人`;
        } else {
          note.textContent = '';
        }

        const ctx = document.getElementById('schoolChart');
        const counts = GROUPS.map((g) => val(area, g.count) ?? 0);
        if (chart) chart.destroy();
        chart = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: GROUPS.map((g) => g.label),
            datasets: [{
              label: '学校数',
              data: counts,
              backgroundColor: ['#c9a227', '#1b4332', '#2d6a4f', '#b23a2f'],
              borderRadius: 4,
            }],
          },
          options: {
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
            responsive: true,
            maintainAspectRatio: false,
          },
        });
      }

      // ---- ランキング ----
      const rankList = document.getElementById('rankList');
      const rankNote = document.getElementById('rankNote');
      const rankable = data.areas.filter((a) => !a.x);

      function showRank(mode) {
        rankList.innerHTML = '';
        let rows, noteText;
        if (mode === 'count') {
          rows = rankable
            .filter((a) => val(a, 'E2101') !== null)
            .sort((a, b) => val(b, 'E2101') - val(a, 'E2101'))
            .slice(0, 5)
            .map((a) => ({ a, main: `${fmt(val(a, 'E2101'))}校` }));
          noteText = '小学校の数ベスト5。町の規模がそのまま数字に表れます。';
        } else {
          rows = rankable
            .filter((a) => val(a, 'E2101') >= 1 && val(a, 'E2501') !== null)
            .map((a) => ({ a, ratio: val(a, 'E2501') / val(a, 'E2101') }))
            .sort((x, y) => x.ratio - y.ratio)
            .slice(0, 5)
            .map((r) => ({ a: r.a, main: `1校あたり約${Math.round(r.ratio)}人` }));
          noteText = '小学校1校あたりの児童数が少ないベスト5。小さな学校を守る町の顔ぶれです。';
        }
        for (const r of rows) {
          const li = document.createElement('li');
          li.innerHTML = `<span class="edu-rank-name">${r.a.p} ${r.a.n}</span><span class="edu-rank-val">${r.main}</span>`;
          li.addEventListener('click', () => {
            prefSelect.value = r.a.p;
            prefSelect.dispatchEvent(new Event('change'));
            citySelect.value = r.a.c;
            citySelect.dispatchEvent(new Event('change'));
          });
          rankList.appendChild(li);
        }
        rankNote.textContent = noteText;
      }

      document.querySelectorAll('.edu-tab').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.edu-tab').forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          showRank(btn.dataset.rank);
        });
      });

      showRank('count');
    })();
  </script>

  <style>
    .edu-dash { max-width: 860px; margin: 0 auto; padding: 0 16px 48px; }
    .edu-hero { text-align: center; padding: 32px 0 8px; }
    .edu-hero-figure { display: block; width: 100%; max-width: 780px; height: auto; border-radius: 4px; margin: 0 auto 20px; }
    .edu-kicker { letter-spacing: 0.2em; font-size: 0.8rem; color: #2d6a4f; }
    .edu-hero h1 { margin: 4px 0 12px; }
    .edu-lead { color: #555; line-height: 1.9; }

    .edu-map { margin: 28px 0 4px; text-align: center; }
    .edu-map svg { width: 100%; max-width: 440px; height: auto; }
    .edu-map .tile rect {
      fill: #fff; stroke: #d9d9cd; stroke-width: 1;
      cursor: pointer; transition: fill .12s, stroke .12s;
    }
    .edu-map .tile text {
      font-family: "Shippori Mincho", serif; fill: #3a3a32;
      pointer-events: none; letter-spacing: .02em;
    }
    .edu-map .tile:hover rect { fill: #eef4f0; stroke: #2d6a4f; }
    .edu-map .tile:focus { outline: none; }
    .edu-map .tile:focus rect { stroke: #2d6a4f; stroke-width: 2; }
    .edu-map .tile.is-active rect { fill: #1b4332; stroke: #1b4332; }
    .edu-map .tile.is-active text { fill: #fdfdf8; }
    .edu-map .tile.is-empty rect { fill: #f4f4ee; stroke: #e8e8de; cursor: default; }
    .edu-map .tile.is-empty text { fill: #c3c3b8; }
    .edu-map-note { font-size: 0.78rem; color: #777; margin-top: 10px; }

    .edu-selector { margin: 24px 0; }
    .edu-select-row { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; }
    .edu-select-row label { display: flex; flex-direction: column; gap: 6px; font-size: 0.85rem; }
    .edu-select-row select {
      min-width: 220px; padding: 10px 12px; border: 1px solid #1b4332;
      border-radius: 6px; background: #fff; font-size: 1rem;
    }

    .edu-result h2 { text-align: center; margin: 24px 0 16px; }
    .edu-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
    .edu-card { border: 1px solid #e0e0d8; border-radius: 8px; padding: 14px; background: #fdfdf8; text-align: center; }
    .edu-card-label { font-size: 0.8rem; color: #2d6a4f; letter-spacing: 0.1em; }
    .edu-card-num { font-size: 1.9rem; font-weight: 700; margin: 4px 0; }
    .edu-card-unit { font-size: 0.9rem; margin-left: 2px; font-weight: 400; }
    .edu-card-sub { font-size: 0.75rem; color: #777; }

    .edu-chart-wrap { position: relative; height: 240px; margin: 20px 0 8px; }
    .edu-note { font-size: 0.85rem; color: #555; text-align: center; }

    .edu-ranking { margin-top: 40px; }
    .edu-ranking h2 { text-align: center; }
    .edu-tabs { display: flex; gap: 8px; justify-content: center; margin: 12px 0 16px; }
    .edu-tab {
      padding: 8px 16px; border: 1px solid #1b4332; border-radius: 999px;
      background: #fff; cursor: pointer; font-size: 0.85rem;
    }
    .edu-tab.is-active { background: #1b4332; color: #fff; }
    .edu-rank-list {
      list-style: none;
      counter-reset: rank;
      padding: 8px 20px;
      max-width: 560px;
      margin: 0 auto 8px;
      border: 1px solid #e0e0d8;
      border-radius: 8px;
      background: #fdfdf8;
    }
    .edu-rank-list li {
      counter-increment: rank;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 4px;
      border-bottom: 1px solid #e0e0d8;
      cursor: pointer;
    }
    .edu-rank-list li:last-child {
      border-bottom: none;
    }
    .edu-rank-list li::before {
      content: counter(rank); font-weight: 700; color: #b23a2f;
      margin-right: 12px; min-width: 1.4em; text-align: center;
    }
    .edu-rank-list li:hover { background: #f4f7f4; }
    .edu-rank-name { flex: 1; }
    .edu-rank-val { font-weight: 700; }

    .edu-source { margin-top: 40px; font-size: 0.75rem; color: #888; line-height: 1.8; }
  </style>
</BaseLayout>
