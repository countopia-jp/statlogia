---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Talk from '../../components/Talk.astro';
import CompareAddon from '../../components/CompareAddon.astro';
import HeroFig from '../../components/HeroFig.astro';

// 重いe-Stat取得は /data/education.json.js（ビルド時生成）に集約。
// このページはフッター表示用の定数だけ持つ（budgetページと同じ流儀）。
// yearNote は表示の初期値。データ側（/data/education.json）に年次があれば、読み込み後に書き換える。
const edu = {
  source: '政府統計の総合窓口(e-Stat) 社会・人口統計体系 市区町村データ 基礎データ（表番号0000020105）',
  note: '学校数・児童生徒数・教員数は統計表の値をそのまま使っています。「小学校1校あたりの児童数」は、児童数を学校数で割ってこちらで計算したものです。学校が1校もない町では計算していません。',
};
const yearNote = '2024年度';
import GrowthTool from '../../components/GrowthTool.astro';
---

<BaseLayout title="学びの登記所｜幼稚園から高校までの数字｜Countopia Stats" description="全国の市区町村を選んで、幼稚園から高校までの学校数・児童生徒数・教員数をご覧いただける窓口。小学校児童数の推移と全国ベスト5つき。" backHref="/dashboard/" backLabel="閲覧室">
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

  <main class="edu-dash">
    <HeroFig src="/images/icon/school-large.webp" alt="山あいの木造校舎、校庭の一本桜" width={1400} height={781}>
      <p class="edu-kicker">ダッシュボード</p>
      <h1>学びの登記所</h1>
      <p class="edu-lead">
        あなたの町に、学校はいくつあるでしょう。<br />
        全国の市区町村から選んで、幼稚園から高校までの数字を確かめられる窓口です。
      </p>
    </HeroFig>

    <Talk speaker="kei">
      当登記所には全国の市区町村の学校数が記録されています。まずは調べたい町を選んでください。
    </Talk>
    <Talk speaker="touko">
      わたくしの通っていた学校も、もう数字になっているのかしら……。
    </Talk>

    <section class="edu-selector" aria-label="自治体の選択">
      <div class="edu-select-row">
        <label>
          <span>都道府県</span>
          <select id="prefSelect"><option value="">選んでください</option></select>
        </label>
        <label>
          <span>市区町村</span>
          <select id="citySelect" disabled><option value="">都道府県を先に</option></select>
        </label>
      </div>
    </section>

    <section id="resultArea" class="edu-result" hidden aria-live="polite">
      <h2 id="resultTitle"></h2>
      <div class="edu-cards" id="cardGrid"></div>
      <div class="edu-chart-wrap">
        <canvas id="schoolChart" height="220"></canvas>
      </div>
      <p class="edu-note" id="perSchoolNote"></p>

      <div class="edu-line-wrap">
        <p class="edu-line-title">小学校児童数の推移</p>
        <canvas id="studentLineChart" data-growth="level" height="120"></canvas>
      </div>

      <Talk speaker="kei"><span id="keiLine">町を選ぶと、台帳を読み上げます。</span></Talk>
      <Talk speaker="touko"><span id="toukoLine">どんな町かしら。</span></Talk>
    </section>

    <CompareAddon level="town" selectId="citySelect" src="/data/education.json" />

    <section class="edu-ranking" aria-label="ランキング">
      <h2>全国ベスト5</h2>
      <div class="edu-tabs" role="tablist">
        <button class="edu-tab is-active" data-rank="count" role="tab">小学校の数</button>
        <button class="edu-tab" data-rank="perschool" role="tab">1校あたり児童数の少なさ</button>
        <button class="edu-tab" data-rank="kg" role="tab">幼稚園の数</button>
        <button class="edu-tab" data-rank="junior" role="tab">中学校の数</button>
        <button class="edu-tab" data-rank="high" role="tab">高校の数</button>
      </div>
      <ol class="edu-rank-list" id="rankList"></ol>
      <p class="edu-note" id="rankNote"></p>
    </section>

    <Talk speaker="kei">
      学校の数と、1校あたりの児童数。二つの物差しで、並ぶ顔ぶれは変わります。
    </Talk>

    <footer class="edu-source">
      <p>
        出典：{edu.source}（<span id="yearNote">{yearNote}</span>時点）<br />
        {edu.note}<br />
        統計表は毎年度更新されます。値のない町は「—」で示し、学校が1校もない町は0校と記しています。<br />
        このページはe-Stat APIで取得した統計データを独自に加工して作成しています。
        政令指定都市の区は選択できますが、ランキング集計からは除外しています（市単位で集計）。
      </p>
    </footer>
  </main>

  <script is:inline>
    (async function () {
      const res = await fetch('/data/education.json');
      const data = await res.json();
      const IND = data.indicators;
      const idx = Object.fromEntries(IND.map((ind, i) => [ind.code, i]));
      const val = (a, code) => a.v[idx[code]];
      const fmt = (n) => (n == null ? '—' : n.toLocaleString('ja-JP'));
      const dataYear = data.year || (IND.find((ind) => ind.year) || {}).year;
      if (dataYear) document.getElementById('yearNote').textContent = dataYear;

      const GROUPS = [
        { key: 'kindergarten', label: '幼稚園', count: 'E1101', students: 'E1501', studentLabel: '在園者' },
        { key: 'elementary', label: '小学校', count: 'E2101', teachers: 'E2401', students: 'E2501', studentLabel: '児童' },
        { key: 'junior', label: '中学校', count: 'E3101', teachers: 'E3401', students: 'E3501', studentLabel: '生徒' },
        { key: 'high', label: '高校', count: 'E4101', students: 'E4501', studentLabel: '生徒' },
      ];

      const prefSelect = document.getElementById('prefSelect');
      const citySelect = document.getElementById('citySelect');
      const prefs = [...new Set(data.areas.map((a) => a.p))];
      for (const p of prefs) {
        const o = document.createElement('option');
        o.value = p; o.textContent = p;
        prefSelect.appendChild(o);
      }
      prefSelect.addEventListener('change', () => {
        citySelect.innerHTML = '<option value="">選んでください</option>';
        const list = data.areas.filter((a) => a.p === prefSelect.value);
        for (const a of list) {
          const o = document.createElement('option');
          o.value = a.c; o.textContent = a.n;
          citySelect.appendChild(o);
        }
        citySelect.disabled = list.length === 0;
      });
      citySelect.addEventListener('change', () => {
        const area = data.areas.find((a) => a.c === citySelect.value);
        if (area) render(area);
      });

      const ratios = data.areas
        .filter((a) => !a.x && val(a, 'E2101') >= 1 && val(a, 'E2501') !== null)
        .map((a) => val(a, 'E2501') / val(a, 'E2101'))
        .sort((x, y) => x - y);
      const medianRatio = ratios.length ? ratios[Math.floor(ratios.length / 2)] : null;

      function updateCharacterLines(area) {
        const keiEl = document.getElementById('keiLine');
        const TOUKO_LINES = ["学校の数も、先生の数も、ちゃんと分かるのね。", "わたくしの学校も、教室はひとつきりですのよ。", "子どもの数まで、学校ごとに数えてあるなんて。"];
        // 橙子の一言は順位や値を言い直さず、数字への驚きや感心を言う（値のない町の一言はそのまま）
        const toukoEl = { set textContent(v) { const el = document.getElementById('toukoLine'); if (/値のない|定めのない|ない町|0校/.test(v)) { el.textContent = v; return; } const k = document.getElementById('keiLine').textContent || ''; let h = 0; for (const ch of k) h = (h * 31 + ch.charCodeAt(0)) >>> 0; el.textContent = TOUKO_LINES[h % TOUKO_LINES.length]; } };
        const elCount = val(area, 'E2101');
        const elStudents = val(area, 'E2501');
        const hsCount = val(area, 'E4101');
        const kgCount = val(area, 'E1101');
        const seed = parseInt(area.c, 10) || 0;
        let kei = '', touko = '';

        const hasEl = typeof elCount === 'number';
        const hasHs = typeof hsCount === 'number';
        const hasKg = typeof kgCount === 'number';
        if (hasEl && elCount >= 1 && typeof elStudents === 'number' && medianRatio) {
          const ratio = elStudents / elCount;
          const r = Math.round(ratio);
          if (ratio < medianRatio * 0.4) {
            kei = `小学校1校あたり約${r}人。全国の中央値（約${Math.round(medianRatio)}人）の半分より少ない町です。`;
            touko = ['わたくしの学校も、教室はひとつきりですのよ。', '先生は全員の名前どころか、家の犬の名前まで覚えていそうね。'][seed % 2];
          } else if (ratio > medianRatio * 2) {
            kei = `小学校1校あたり約${r}人。全国の中央値の2倍を超えています。`;
            touko = ['一校にこんなに大勢……運動会は壮観でしょうねえ。', 'お昼の給食を配るだけで、ひと仕事になりそうだわ。'][seed % 2];
          } else {
            kei = `小学校1校あたり約${r}人。全国の真ん中どころ（中央値は約${Math.round(medianRatio)}人）です。`;
            touko = ['ちょうど、まん中あたりなのねえ。', '教室の窓から、どんな景色が見えるのでしょうね。'][seed % 2];
          }
        } else if (hasEl && elCount === 0) {
          kei = 'この町の小学校は、0校と記されています。';
          touko = '小学校のない町もあるのね。';
        } else {
          kei = 'この町の小学校は、この町の値がありません。';
          touko = '値のない欄もあるのね。';
        }
        if (hasHs && hsCount === 0) kei += ' 高校は0校です。';
        else if (!hasHs) kei += ' 高校は、この町の値がありません。';
        if (hasKg && kgCount === 0) touko += ' 幼稚園はないのねえ。';

        keiEl.textContent = kei;
        toukoEl.textContent = touko;
      }

      let lineChart = null;
      function renderLineChart(area) {
        const wrap = document.querySelector('.edu-line-wrap');
        if (!area.series || area.series.length === 0) { wrap.hidden = true; return; }
        wrap.hidden = false;
        const ctx = document.getElementById('studentLineChart');
        if (lineChart) lineChart.destroy();
        lineChart = new Chart(ctx, {
          type: 'line',
          data: {
            labels: area.series.map((p) => p.year),
            datasets: [{
              label: '小学校児童数', data: area.series.map((p) => p.value),
              borderColor: '#1b4332', backgroundColor: '#1b433222', tension: 0.2, fill: true,
            }],
          },
          options: {
            responsive: true, plugins: { legend: { display: false } },
            scales: { y: { ticks: { callback: (v) => v.toLocaleString('ja-JP') + '人' } } },
          },
        });
      }

      let chart = null;
      function render(area) {
        document.getElementById('resultArea').hidden = false;
        updateCharacterLines(area);
        document.getElementById('resultTitle').textContent = `${area.p} ${area.n}`;

        const grid = document.getElementById('cardGrid');
        grid.innerHTML = '';
        for (const g of GROUPS) {
          const count = val(area, g.count);
          const students = val(area, g.students);
          const teachers = g.teachers ? val(area, g.teachers) : null;
          const card = document.createElement('div');
          card.className = 'edu-card';
          card.innerHTML =
            `<div class="edu-card-label">${g.label}</div>` +
            `<div class="edu-card-num">${fmt(count)}<span class="edu-card-unit">${g.key === 'kindergarten' ? '園' : '校'}</span></div>` +
            `<div class="edu-card-sub">${g.studentLabel} ${fmt(students)}人${teachers != null ? `・教員 ${fmt(teachers)}人` : ''}</div>`;
          grid.appendChild(card);
        }

        const elCount = val(area, 'E2101');
        const elStudents = val(area, 'E2501');
        const note = document.getElementById('perSchoolNote');
        note.textContent = (elCount > 0 && elStudents !== null)
          ? `小学校1校あたりの児童数：約${Math.round(elStudents / elCount).toLocaleString('ja-JP')}人`
          : '';

        const ctx = document.getElementById('schoolChart');
        const counts = GROUPS.map((g) => val(area, g.count) ?? 0);
        if (chart) chart.destroy();
        chart = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: GROUPS.map((g) => g.label),
            datasets: [{ label: '学校数', data: counts, backgroundColor: ['#c9a227', '#1b4332', '#2d6a4f', '#b23a2f'], borderRadius: 4 }],
          },
          options: {
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
            responsive: true, maintainAspectRatio: false,
          },
        });

        renderLineChart(area);
      }

      const rankList = document.getElementById('rankList');
      const rankNote = document.getElementById('rankNote');
      const rankable = data.areas.filter((a) => !a.x);
      const RANK_CONFIG = {
        count:  { code: 'E2101', label: '校', note: '小学校の数ベスト5。' },
        kg:     { code: 'E1101', label: '園', note: '幼稚園の数ベスト5。' },
        junior: { code: 'E3101', label: '校', note: '中学校の数ベスト5。' },
        high:   { code: 'E4101', label: '校', note: '高校の数ベスト5。' },
      };

      function showRank(mode) {
        rankList.innerHTML = '';
        let rows, noteText;
        if (mode === 'perschool') {
          rows = rankable
            .filter((a) => val(a, 'E2101') >= 1 && val(a, 'E2501') !== null)
            .map((a) => ({ a, ratio: val(a, 'E2501') / val(a, 'E2101') }))
            .sort((x, y) => x.ratio - y.ratio)
            .slice(0, 5)
            .map((r) => ({ a: r.a, main: `1校あたり約${Math.round(r.ratio)}人` }));
          noteText = '小学校1校あたりの児童数が少ないベスト5。';
        } else {
          const cfg = RANK_CONFIG[mode];
          rows = rankable
            .filter((a) => val(a, cfg.code) !== null)
            .sort((a, b) => val(b, cfg.code) - val(a, cfg.code))
            .slice(0, 5)
            .map((a) => ({ a, main: `${fmt(val(a, cfg.code))}${cfg.label}` }));
          noteText = cfg.note;
        }
        for (const r of rows) {
          const li = document.createElement('li');
          li.innerHTML = `<span class="edu-rank-name">${r.a.p} ${r.a.n}</span><span class="edu-rank-val">${r.main}</span>`;
          li.addEventListener('click', () => {
            prefSelect.value = r.a.p; prefSelect.dispatchEvent(new Event('change'));
            citySelect.value = r.a.c; citySelect.dispatchEvent(new Event('change'));
          });
          rankList.appendChild(li);
        }
        rankNote.textContent = noteText;
      }

      document.querySelectorAll('.edu-tab').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.edu-tab').forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          showRank(btn.dataset.rank);
        });
      });

      showRank('count');
    })();
  </script>

  <style is:global>
    .edu-dash { max-width: 860px; margin: 0 auto; padding: 0 16px 48px; }
    .edu-hero { text-align: center; padding: 32px 0 8px; }
    .edu-hero-figure { display: block; width: 100%; max-width: 780px; height: auto; border-radius: 4px; margin: 0 auto 20px; }
    .edu-kicker { letter-spacing: 0.2em; font-size: 0.8rem; color: #2d6a4f; }
    .edu-hero h1 { margin: 4px 0 12px; font-family: "Shippori Mincho", serif; font-weight: 800; }
    .edu-lead { color: #555; line-height: 1.9; }

    .edu-selector { margin: 24px 0; }
    .edu-select-row { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; }
    .edu-select-row label { display: flex; flex-direction: column; gap: 6px; font-size: 0.85rem; }
    .edu-select-row select {
      min-width: 220px; padding: 10px 12px; border: 1px solid #1b4332;
      border-radius: 6px; background: #fff; font-size: 1rem;
    }

    .edu-result h2 { text-align: center; margin: 24px 0 16px; font-family: "Shippori Mincho", serif; }
    .edu-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
    .edu-card { border: 1px solid #e0e0d8; border-radius: 8px; padding: 14px; background: #fdfdf8; text-align: center; }
    .edu-card-label { font-size: 0.8rem; color: #2d6a4f; letter-spacing: 0.1em; }
    .edu-card-num { font-size: 1.9rem; font-weight: 700; margin: 4px 0; }
    .edu-card-unit { font-size: 0.9rem; margin-left: 2px; font-weight: 400; }
    .edu-card-sub { font-size: 0.75rem; color: #777; }

    .edu-chart-wrap { position: relative; height: 240px; margin: 20px 0 8px; }
    .edu-note { font-size: 0.85rem; color: #555; text-align: center; }

    .edu-line-wrap {
      margin: 24px 0 8px; padding: 16px; border: 1px solid #e0e0d8;
      border-radius: 8px; background: #fff;
    }
    .edu-line-title {
      font-size: 0.8rem; color: #2d6a4f; letter-spacing: 0.06em;
      margin: 0 0 10px; text-align: center;
    }

    .edu-ranking { margin-top: 44px; }
    .edu-ranking h2 { text-align: center; font-family: "Shippori Mincho", serif; }
    .edu-tabs { display: flex; gap: 8px; justify-content: center; margin: 12px 0 16px; flex-wrap: wrap; }
    .edu-tab {
      padding: 8px 16px; border: 1px solid #1b4332; border-radius: 999px;
      background: #fff; cursor: pointer; font-size: 0.85rem;
    }
    .edu-tab.is-active { background: #1b4332; color: #fff; }

    .edu-rank-list { list-style: none; counter-reset: rank; padding: 8px 20px; max-width: 560px; margin: 0 auto 8px; border: 1px solid #e0e0d8; border-radius: 8px; background: #fdfdf8; }
    .edu-rank-list li { counter-increment: rank; display: flex; justify-content: space-between; align-items: center; padding: 10px 4px; border-bottom: 1px solid #e0e0d8; cursor: pointer; }
    .edu-rank-list li:last-child { border-bottom: none; }
    .edu-rank-list li::before { content: counter(rank); font-weight: 700; color: #b23a2f; margin-right: 12px; min-width: 1.4em; text-align: center; }
    .edu-rank-list li:hover { background: #f4f7f4; }
    .edu-rank-name { flex: 1; }
    .edu-rank-val { font-weight: 700; font-family: "IBM Plex Mono", monospace; }

    .edu-source { margin-top: 40px; font-size: 0.75rem; color: #888; line-height: 1.8; }
  </style>
  <GrowthTool />
</BaseLayout>