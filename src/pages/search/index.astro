---
import fs from 'node:fs';
import path from 'node:path';
// 案内所：言葉を入れると、その数字が載っている閲覧室の窓口を案内する
// 索引はビルド時に作り（src/lib/search-index.js）、検索は画面の中だけで行う（外へは何も送らない）
import BaseLayout from '../../layouts/BaseLayout.astro';
import Talk from '../../components/Talk.astro';
import HeroFig from '../../components/HeroFig.astro';
import { buildSearchIndex } from '../../lib/search-index.js';
import { SYNONYMS } from '../../data/search-words.js';
import { ROOM_COUNT } from '../../data/page-names.js';
import { INDICATOR_COUNT } from '../../lib/counts.js';

const entries = buildSearchIndex();
const duoSearch = fs.existsSync(path.join(process.cwd(), 'public/images/chara/duo-search-scene.webp')) ? '/images/chara/duo-search-scene.webp' : null;
const EXAMPLES = ['保育園', '家賃', '雪', '給料', '病院', '通勤', '空き家', '気温', '老人ホーム', '財政'];
---
<BaseLayout title="案内所｜Statlogia" description="知りたいことを言葉で入れると、その数字が載っている閲覧室の窓口をご案内します。" backHref="/dashboard/" backLabel="情報棟">
  <main class="sx">
    <HeroFig src="/images/icon/search-large.webp" alt="コンクリートの壁の受付。木のカウンターで索引を開き、呼び鈴を横に置いて顔を上げる知秋の水彩画" width={1400} height={782} eager>
      <p class="sx-kicker">案内所</p>
      <h1>どの数字を、お探しですか</h1>
      <p class="sx-lead">知りたいことを、ふだんの言葉で入れてください。<br />その数字が載っている窓口をご案内します。</p>
    </HeroFig>

    <form class="sx-form" role="search" onsubmit="return false">
      <label class="sx-label" for="sxQ">たずねる言葉</label>
      <div class="sx-row">
        <input id="sxQ" type="search" autocomplete="off" placeholder="例：保育園、家賃、雪" />
        <button type="submit" id="sxGo">たずねる</button>
      </div>
      <p class="sx-examples">
        たとえば：{EXAMPLES.map((w) => <button type="button" class="sx-chip" data-q={w}>{w}</button>)}
      </p>
    </form>

    <div class="sx-talk" id="sxTalk">
      <div class="sx-talk-in"><Talk speaker="chiaki"><span id="sxSay">言葉を入れたまえ。どの窓口に載っているか、ここで案内しよう。</span></Talk></div>
    </div>

    <ol class="sx-list" id="sxList" aria-live="polite"></ol>
    {duoSearch && (
      <div class="sx-scene" id="sxScene">
        <img class="sx-duo" src={duoSearch} width="1376" height="768" alt="指し棒で先を示す知秋と、指さして確かめる一葉。右手に三叉路の道しるべ" loading="lazy" />
        <nav class="sx-signs" aria-label="三つの棟へ">
          <a href="/dashboard/"><small>引く</small>情報棟</a>
          <a href="/analysis/"><small>考える</small>研究棟</a>
          <a href="/how-to-read/"><small>学ぶ</small>講義棟</a>
        </nav>
        <p class="sx-scene-cap" id="sxSceneCap">言葉が浮かばなければ、棟から入るのも手だ。</p>
      </div>
    )}
    <p class="sx-note" id="sxSecret" hidden><a href="/news/">掲示板（確認用）→</a></p>
    <script is:inline>
      (() => {
        const KEY = 'スタットロギア掲示板';
        const q = document.getElementById('sxQ'), box = document.getElementById('sxSecret');
        const fromHash = () => { const m = location.hash.match(/q=([^&]*)/); try { return m ? decodeURIComponent(m[1]) : ''; } catch { return ''; } };
        const check = () => { const v = (q.value || fromHash()).replace(/\s/g, ''); box.hidden = v !== KEY; };
        q.addEventListener('input', check);
        window.addEventListener('hashchange', check);
        document.getElementById('sxGo').addEventListener('click', check);
        setTimeout(check, 0);
      })();
    </script>

    <p class="sx-note">
      <a href="/sources/">{INDICATOR_COUNT.toLocaleString('ja-JP')}の指標</a>（<a href="/dashboard/">{ROOM_COUNT}の窓口</a>）から探しています。
      数字そのものは、それぞれの窓口でご覧ください。入れた言葉は、どこにも送ったり残したりしません。
    </p>
  </main>
</BaseLayout>

<script is:inline define:vars={{ entries, SYNONYMS }}>
  // ひらがな・全角半角・大文字小文字の違いを吸収する
  const norm = (s) => (s || '').normalize('NFKC').toLowerCase()
    .replace(/[ァ-ヶ]/g, (ch) => String.fromCharCode(ch.charCodeAt(0) - 0x60))
    .replace(/\s+/g, '');
  const groups = SYNONYMS.map((g) => g.map(norm).filter(Boolean));
  const docs = entries.map((e) => ({
    e,
    name: norm(e.name),
    desc: norm(e.desc),
    labels: e.labels.map((l) => ({ raw: l, n: norm(l) })),
  }));

  // 入れた言葉から「たずねる言葉の組」を作る。辞書の言葉が含まれていればその行ごと、
  // 残りは助詞などで区切って2文字以上の語をそのまま使う
  function termsOf(q) {
    const qn = norm(q);
    if (!qn) return [];
    const sets = [];
    let rest = qn;
    groups.forEach((g) => {
      const hits = g.filter((w) => w.length >= 1 && qn.includes(w));
      if (hits.length) {
        sets.push(g);
        hits.sort((a, b) => b.length - a.length).forEach((w) => { rest = rest.split(w).join(' '); });
      }
    });
    rest.split(/[\s、。・,，/／]+|が|の|を|は|で|に|と|や|へ|も|って|たい|知りたい|調べたい|どこ|多い|少ない|高い|低い|安い|県|市|町|村/)
      .map((t) => t.trim()).filter((t) => t.length >= 2)
      .forEach((t) => sets.push([t]));
    return sets;
  }

  function search(q) {
    const sets = termsOf(q);
    if (!sets.length) return { sets, hits: [] };
    const hits = [];
    for (const d of docs) {
      let matched = 0, score = 0;
      const labelHits = new Set();
      for (const g of sets) {
        let ok = false;
        if (g.some((w) => d.name.includes(w))) { ok = true; score += 3; }
        d.labels.forEach((l) => { if (g.some((w) => l.n.includes(w))) { ok = true; labelHits.add(l.raw); } });
        if (labelHits.size) score += 2;
        if (g.some((w) => d.desc.includes(w))) { ok = true; score += 1; }
        if (ok) matched++;
      }
      if (matched) hits.push({ d, matched, score, labelHits: [...labelHits] });
    }
    hits.sort((a, b) => b.matched - a.matched || b.score - a.score);
    // たずねた言葉の組をすべて満たすものがあれば、それだけを出す
    const full = hits.filter((h) => h.matched === sets.length);
    return { sets, hits: full.length ? full : hits };
  }

  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

  function render(q) {
    const list = $('sxList');
    const say = $('sxSay');
    const scene = $('sxScene'); const cap = $('sxSceneCap');
    const showScene = (on, text) => { if (scene) { scene.hidden = !on; if (cap && text) cap.textContent = text; } };
    if (!q.trim()) { list.innerHTML = ''; say.textContent = '言葉を入れたまえ。どの窓口に載っているか、ここで案内しよう。'; showScene(true, '言葉が浮かばなければ、棟から入るのも手だ。'); return; }
    const { hits } = search(q);
    if (!hits.length) {
      list.innerHTML = '';
      say.textContent = `「${q}」では見当たらぬ。別の言い方か、もっと短い言葉で試したまえ。`;
      showScene(true, 'なければ、棟を歩いて探すしかない。');
      return;
    }
    say.textContent = `「${q}」なら、窓口が${hits.length}か所ある。うむ、順に見ていきたまえ。`;
    showScene(false);
    list.innerHTML = hits.slice(0, 30).map(({ d, labelHits }) => {
      const e = d.e;
      const shown = (labelHits.length ? labelHits : e.labels).slice(0, 5);
      const more = (labelHits.length ? labelHits : e.labels).length - shown.length;
      return `<li><a class="sx-card" href="${esc(e.href)}">
        <span class="sx-kind sx-kind--room">${esc(e.kind)}${e.no ? ` ${String(e.no).padStart(2, '0')}` : ''}</span>
        <span class="sx-name">${esc(e.name)}</span>
        ${e.scopes.length ? `<span class="sx-scope">${esc(e.scopes.join('・'))}で引けます</span>` : ''}
        <span class="sx-desc">${esc(e.desc)}</span>
        <span class="sx-labels">${labelHits.length ? '当たった数字：' : '載っている数字：'}${shown.map(esc).join('／')}${more > 0 ? ` ほか${more}` : ''}</span>
      </a></li>`;
    }).join('');
  }

  const input = $('sxQ');
  let timer = null;
  const run = () => render(input.value);
  input.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(run, 150); });
  $('sxGo').addEventListener('click', run);
  document.querySelectorAll('.sx-chip').forEach((b) => b.addEventListener('click', () => { input.value = b.dataset.q; run(); input.focus(); }));
  // 閲覧室一覧の検索欄からは #q= で受け取る（アドレスの # より後ろはサーバーに送られない）
  const h = new URLSearchParams(location.hash.slice(1)).get('q');
  if (h) { input.value = h; render(h); history.replaceState(null, '', location.pathname); }
</script>

<style is:global>
.sx{max-width:820px;margin:0 auto;padding:48px 20px 72px}
.sx-kicker{ font-family: "IBM Plex Mono", monospace; font-size: .74rem; letter-spacing: .22em; font-weight: 600; color: var(--stamp); margin: 0; }
.sx-head h1{font-family:"Shippori Mincho",serif;font-weight:800;font-size:clamp(1.5rem,4vw,2.1rem);margin-top:6px}
.sx-lead{color:var(--ink-soft);margin:10px 0 24px;line-height:1.9}
.sx-form{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px 18px 12px}
.sx-label{display:block;font-size:.78rem;letter-spacing:.15em;color:var(--ink-soft);margin-bottom:8px}
.sx-row{display:flex;gap:10px}
.sx-row input{flex:1;min-width:0;font:inherit;font-size:1.05rem;padding:10px 14px;border:1px solid var(--line);border-radius:8px;background:var(--paper)}
.sx-row input:focus{outline:2px solid var(--stamp);outline-offset:1px}
.sx-row button{flex:0 0 auto;font:inherit;font-weight:700;padding:10px 18px;border:0;border-radius:8px;background:var(--ink);color:var(--paper);cursor:pointer}
.sx-examples{margin-top:12px;font-size:.82rem;color:var(--ink-soft);display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.sx-chip{font:inherit;font-size:.82rem;padding:3px 10px;border:1px solid var(--line);border-radius:99px;background:var(--paper);color:var(--ink);cursor:pointer}
.sx-chip:hover{border-color:var(--stamp);color:var(--stamp)}
.sx-talk{margin:24px 0 8px}
.sx-scene{position:relative;max-width:860px;margin:22px auto 0;container-type:inline-size}
.sx-duo{display:block;width:100%;height:auto;border-radius:6px;box-shadow:0 2px 10px rgba(31,42,68,.12)}
/* 絵の中の道しるべに、三つの棟の札を掛ける（右上の空。スマホでは絵の下に並ぶ） */
.sx-signs{position:absolute;right:5%;top:7%;display:flex;flex-direction:column;gap:8px;align-items:flex-end}
.sx-signs a{position:relative;display:inline-flex;align-items:baseline;gap:.5em;padding:.35em 1.6em .35em .9em;color:#fff8ec;text-decoration:none;font-family:"Shippori Mincho",serif;font-weight:800;font-size:clamp(.8rem,1.9cqi,1rem);letter-spacing:.06em;background:linear-gradient(180deg,#8a6a48,#6b5036);box-shadow:0 2px 4px rgba(0,0,0,.25),inset 0 1px 0 rgba(255,255,255,.18);clip-path:polygon(0 0,calc(100% - .9em) 0,100% 50%,calc(100% - .9em) 100%,0 100%);transform:rotate(-1.5deg);transition:transform .2s,filter .2s}
.sx-signs a:nth-child(2){transform:rotate(1deg)}
.sx-signs a:nth-child(3){transform:rotate(-.5deg)}
.sx-signs a small{font-family:"IBM Plex Mono",monospace;font-size:.62em;letter-spacing:.14em;opacity:.8;font-weight:400}
.sx-signs a:hover,.sx-signs a:focus-visible{transform:rotate(0) translateX(4px);filter:brightness(1.08)}
.sx-scene-cap{position:absolute;left:14px;bottom:10px;margin:0;font-size:.78rem;padding:.25em .8em;background:rgba(255,253,248,.92);border-radius:4px;color:var(--ink)}
@media(max-width:600px){
  .sx-signs{position:static;flex-direction:row;flex-wrap:wrap;justify-content:center;gap:8px;margin:10px 0 0}
  .sx-signs a{transform:none}
  .sx-scene-cap{position:static;margin:8px 0 0;text-align:center;background:none;padding:0}
}
.sx-list{list-style:none;padding:0;display:flex;flex-direction:column;gap:12px}
.sx-card{display:flex;flex-direction:column;gap:4px;padding:16px 18px;background:#fff;border:1px solid var(--line);border-radius:12px;color:var(--ink);text-decoration:none}
.sx-card:hover{border-color:var(--stamp)}
.sx-kind{align-self:flex-start;font-size:.7rem;letter-spacing:.12em;padding:2px 8px;border-radius:4px;color:#fff;background:#4B5570}
.sx-name{font-family:"Shippori Mincho",serif;font-weight:800;font-size:1.15rem}
.sx-scope{font-size:.75rem;color:var(--ink-soft)}
.sx-desc{font-size:.88rem;color:var(--ink-soft);line-height:1.7}
.sx-labels{font-size:.8rem;color:#4B5570;line-height:1.6}
.sx-note{margin-top:32px;font-size:.8rem;color:var(--ink-soft);line-height:1.8}
@media(max-width:560px){.sx-row{flex-direction:column}.sx-row button{width:100%}}
</style>
