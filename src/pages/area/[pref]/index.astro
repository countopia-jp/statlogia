---
// 県の台帳：1つの都道府県について、閲覧室のいろいろな数字を一覧で（47ページをビルド時に作る）
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Talk from '../../../components/Talk.astro';
import AreaLedgerStyle from '../../../components/AreaLedgerStyle.astro';
import { getPrefLedger, prefRows } from '../../../lib/area-ledger.js';

export async function getStaticPaths() {
  const ledger = await getPrefLedger();
  return ledger.prefs.map((p) => ({ params: { pref: p.c.slice(0, 2) }, props: { code: p.c, name: p.n } }));
}
const { code, name } = Astro.props;
const ledger = await getPrefLedger();
const groups = prefRows(ledger, code);
const fmt = (v, d) => (typeof v === 'number' && Number.isFinite(v) ? v.toLocaleString('ja-JP', { minimumFractionDigits: d, maximumFractionDigits: d }) : null);
const total = groups.reduce((n, g) => n + g.rows.length, 0);
const prefNo = code.slice(0, 2);
---
<BaseLayout title={`${name}の台帳｜Countopia Stats`} description={`${name}の人口・気候・物価・給与・県のお金・観光・文化施設など${total}の数字を一覧で。それぞれの数字の年と、47都道府県の中の順位、くわしく見られる窓口つき。`} backHref="/area/" backLabel="地域の台帳">
  <AreaLedgerStyle />
  <main class="al">
    <header class="al-head">
      <p class="al-kicker">地域の台帳｜都道府県</p>
      <h1>{name}の台帳</h1>
      <p class="al-lead">閲覧室と別館の窓口から、{name}の数字を{total}項目、一枚に写しました。<br />項目の名前を押すと、その数字の窓口でくわしく見られます。</p>
    </header>
    <div class="al-talk">
      <Talk speaker="kei">{name}の数字を、分野ごとに並べました。順位は、数字の大きいほうから数えたもので、良し悪しを表すものではありません。</Talk>
      <Talk speaker="touko">ひとつの県のことが、帳面一枚にまとまっているのね。</Talk>
    </div>
    <p class="al-jump">
      <label for="alPref">ほかの都道府県：</label>
      <select id="alPref" onchange="if(this.value)location.href='/area/'+this.value+'/'">
        {ledger.prefs.map((p) => <option value={p.c.slice(0, 2)} selected={p.c === code}>{p.n}</option>)}
      </select>
      <a href={`/area/town/${prefNo}/`}>{name}の市区町村の台帳 →</a>
    </p>
    {groups.map((g) => (
      <section class="al-group">
        <h2>{g.title}</h2>
        <table class="al-table">
          <thead><tr><th>項目</th><th>{name}</th><th>年</th><th>全国</th><th>47都道府県の中で</th></tr></thead>
          <tbody>
            {g.rows.map((r) => (
              <tr>
                <td class="al-label"><a href={r.href}>{r.label}</a><span class="al-room">{r.room}</span></td>
                <td class="al-val">{fmt(r.v, r.decimals) !== null ? <>{fmt(r.v, r.decimals)}<small>{r.unit}</small></> : <span class="al-none">値なし</span>}</td>
                <td class="al-year" data-h="年">{r.year}</td>
                <td class="al-cmp" data-h={r.compare ? r.compare.label : '全国'}>{r.compare && fmt(r.compare.v, r.decimals) !== null ? `${r.compare.label === '全国' ? '' : '平均 '}${fmt(r.compare.v, r.decimals)}${r.unit}` : '—'}</td>
                <td class="al-rank" data-h="47都道府県の中で">{r.rank ? <><b>{r.rank}</b>位（{r.rankWord}）</> : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}
    <p class="al-note">
      数字はすべて、政府統計の総合窓口（e-Stat）から取ったもので、項目ごとに調べた年が違います。全国の欄は全国の値で、全国の値がない項目や、全国の値が合計になる項目は「平均」と書いて47都道府県の平均を出しています。家計の数字は、県庁所在市の二人以上の世帯の値です。同じ値の県は同じ順位にしています。くわしい定義と注意は、それぞれの窓口の注記をご覧ください。
    </p>
  </main>
</BaseLayout>
