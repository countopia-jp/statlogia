---
// 地域の台帳の入口：都道府県の台帳（47）と、市区町村の台帳（県ごと）へ
import BaseLayout from '../../layouts/BaseLayout.astro';
import Talk from '../../components/Talk.astro';
import AreaLedgerStyle from '../../components/AreaLedgerStyle.astro';
import { getPrefLedger } from '../../lib/area-ledger.js';
const pl = await getPrefLedger();
const REGIONS = [
  ['北海道・東北', 1, 7], ['関東', 8, 14], ['中部', 15, 23], ['近畿', 24, 30], ['中国', 31, 35], ['四国', 36, 39], ['九州・沖縄', 40, 47],
];
const inRegion = (from, to) => pl.prefs.filter((p) => { const n = Number(p.c.slice(0, 2)); return n >= from && n <= to; });
---
<BaseLayout title="地域の台帳｜Countopia Stats" description="都道府県や市区町村を1つ選んで、人口・気候・物価・給与・住まい・施設など、閲覧室のいろいろな数字を一覧で見られる台帳。" backHref="/dashboard/" backLabel="閲覧室">
  <AreaLedgerStyle />
  <main class="al">
    <header class="al-head">
      <p class="al-kicker">地域の台帳</p>
      <h1>ひとつの土地の数字を、一枚に</h1>
      <p class="al-lead">閲覧室は「数字を選んで、土地を見る」窓口です。<br />こちらは逆に「土地を選んで、いろいろな数字を見る」台帳です。</p>
    </header>
    <div class="al-talk">
      <Talk speaker="kei">都道府県か市区町村を選んでください。閲覧室と別館の窓口から、その土地の数字を写した台帳をお出しします。</Talk>
      <Talk speaker="touko">知っている町の名前を、探してみたくなるわ。</Talk>
    </div>
    <section class="al-group">
      <h2>都道府県の台帳</h2>
      {REGIONS.map(([r, a, b]) => (<>
        <p class="al-region">{r}</p>
        <div class="al-list">{inRegion(a, b).map((p) => <a href={`/area/${p.c.slice(0, 2)}/`}>{p.n}</a>)}</div>
      </>))}
    </section>
    <section class="al-group">
      <h2>市区町村の台帳</h2>
      <p class="al-lead">都道府県を選ぶと、その中の市区町村を選べるページへ進みます。</p>
      {REGIONS.map(([r, a, b]) => (<>
        <p class="al-region">{r}</p>
        <div class="al-list">{inRegion(a, b).map((p) => <a href={`/area/town/${p.c.slice(0, 2)}/`}>{p.n}</a>)}</div>
      </>))}
    </section>
  </main>
</BaseLayout>
