---
// =====================================================
// Statlogia - 検証室（言い伝え・都市伝説・俗説を、数字で確かめる部屋）の入口
// src/pages/verify/index.astro
// =====================================================
import BaseLayout from '../../layouts/BaseLayout.astro';
import Talk from '../../components/Talk.astro';
import HeroFig from '../../components/HeroFig.astro';
import { CASES, VERDICT } from '../../data/verify.js';
import fs from 'node:fs';
import path from 'node:path';
const thumbOf = (id) => (fs.existsSync(path.join(process.cwd(), 'public/images/icon', `verify-${id}-thumb.webp`)) ? `/images/icon/verify-${id}-thumb.webp` : null);
const hero = fs.existsSync(path.join(process.cwd(), 'public/images/icon/verify-large.webp')) ? '/images/icon/verify-large.webp' : null;
---
<BaseLayout title="検証室｜言い伝えを数字で確かめる｜Statlogia" description="都市伝説・俗説・言い伝えを、公的統計で確かめる部屋。本当か、半分本当か、数字では分からないか。三段階で判定します。" backHref="/analysis/" backLabel="研究棟">
  <main class="vf">
    {hero ? (
      <HeroFig src={hero} alt="コンクリートの壁の部屋。机の紙に判を押そうとする知秋と、横からのぞき込む一葉。壁にはメモを留めたコルクボード" width={1400} height={788}>
        <p class="vf-kicker">研究棟 別室</p>
        <h1>検証室｜俗説を、数字で確かめる</h1>
        <p class="vf-lead"><span class="nw">昔から言われていることを、</span><span class="nw">数字で確かめる部屋です。</span><br /><span class="nw">本当か、半分本当か、</span><span class="nw">数字では分からないか。</span></p>
      </HeroFig>
    ) : (
      <header class="vf-hero">
        <p class="vf-kicker">研究棟 別室</p>
        <h1>検証室｜俗説を、数字で確かめる</h1>
        <p class="vf-lead">昔から言われていることを、数字で確かめる部屋です。<br />本当か、半分本当か、数字では分からないか。</p>
      </header>
    )}

    <Talk speaker="chiaki-work">言い伝えには、数字に直せるものと直せないものがある。直せるものだけをここで扱う。直せないものは「分からない」と言う。それもまた結論だ。</Talk>
    <Talk speaker="hitoha">「分からない」が結論でいいんですか。</Talk>
    <Talk speaker="chiaki-work">分からないことを分かったと言うより、ずっとよい。</Talk>

    <section class="vf-legend" aria-label="判定の三段階">
      {Object.entries(VERDICT).map(([k, v]) => (
        <div class={`vf-badge vf-badge--${k}`}><b>{v.label}</b><span>{v.note}</span></div>
      ))}
    </section>

    <section class="vf-cases" aria-label="検証した言い伝え">
      {CASES.map((c) => (
        <a class="vf-card" href={`/verify/${c.id}/`}>
          {thumbOf(c.id) && <img class="vf-card-img" src={thumbOf(c.id)} alt="" aria-hidden="true" width="560" height="313" loading="lazy" />}
          <span class="vf-card-k">{c.kicker}</span>
          <span class="vf-card-t">{c.title}</span>
          <span class="vf-card-l">{c.lore}</span>
          <span class="vf-card-q">数字にすると：{c.restate}</span>
          <span class="vf-card-v">数字で確かめる →</span>
        </a>
      ))}
    </section>

    <p class="tab-links">
      <a class="tab-link" href="/analysis/">読み解きの間へ</a>
      <a class="tab-link" href="/compare/">見くらべの間へ</a>
    </p>
  </main>
  <style>
    .vf { max-width: 980px; margin: 0 auto; padding: 0 16px 56px; }
    .vf-hero { text-align: center; padding: 32px 0 8px; }
    .vf-kicker { font-family: "IBM Plex Mono", monospace; font-size: .74rem; letter-spacing: .22em; font-weight: 600; color: var(--stamp); margin: 0; }
    .vf-hero h1 { font-family: "Shippori Mincho", serif; font-weight: 800; font-size: clamp(1.5rem, 4vw, 2.1rem); margin: 6px 0 10px; }
    .vf-lead { color: var(--ink-soft); line-height: 1.95; margin: 0; }
    .vf-legend { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 24px 0 8px; }
    .vf-badge { padding: 10px 14px 11px; border-radius: 8px; border: 1px solid var(--line); border-left-width: 5px; background: #fffdf7; font-size: .82rem; line-height: 1.6; color: #444; }
    .vf-badge b { display: block; font-family: "Shippori Mincho", serif; font-size: 1rem; margin-bottom: 2px; }
    /* 判定の色：本当＝緑、半分本当＝山吹、数字では分からない＝紫 */
    .vf-badge--true { border-color: #9cc3ae; border-left-color: #2d6a4f; background: #f6fbf8; }
    .vf-badge--true b { color: #2d6a4f; }
    .vf-badge--half { border-color: #e0c489; border-left-color: #b8862a; background: #fffaf0; }
    .vf-badge--half b { color: #b8862a; }
    .vf-badge--unknown { border-color: #bdb2d6; border-left-color: #6b4fa0; background: #f8f6fd; }
    .vf-badge--unknown b { color: #6b4fa0; }
    .vf-cases { display: grid; gap: 14px; margin-top: 18px; }
    .vf-card { display: grid; grid-template-columns: minmax(0, 38%) minmax(0, 1fr); grid-template-rows: auto auto auto 1fr auto; column-gap: 24px; row-gap: 6px; padding: 18px 22px 18px 0; align-items: start; border: 1px solid var(--line); border-left: 5px solid var(--stamp); border-radius: 10px; background: #fffdf7; color: inherit; text-decoration: none; overflow: hidden; transition: transform .15s, box-shadow .15s; }
    .vf-card:hover, .vf-card:focus-visible { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(30,40,30,.1); }
    .vf-card-img { grid-column: 1; grid-row: 1 / -1; display: block; width: 100%; height: 100%; min-height: 200px; object-fit: cover; margin: -18px 0; align-self: stretch; transition: transform .5s cubic-bezier(.2,.8,.2,1); }
    .vf-card:hover .vf-card-img { transform: scale(1.05); }
    .vf-card-k, .vf-card-t, .vf-card-q, .vf-card-l, .vf-card-v { grid-column: 2; }
    .vf-card-k { font-family: "IBM Plex Mono", monospace; font-size: .7rem; letter-spacing: .24em; color: var(--stamp); }
    .vf-card-t { font-family: "Shippori Mincho", serif; font-weight: 800; font-size: 1.25rem; color: var(--ink); }
    .vf-card-q { font-size: .86rem; color: var(--ink); line-height: 1.7; }
    .vf-card-l { font-size: .84rem; color: #555; line-height: 1.8; }
    .vf-card-v { align-self: end; justify-self: start; font-size: .8rem; font-weight: 600; color: var(--stamp); padding: 3px 12px; border-radius: 999px; border: 1.5px dashed var(--stamp); transition: background .2s, color .2s; }
    .vf-card:hover .vf-card-v, .vf-card:focus-visible .vf-card-v { background: var(--stamp); color: #fff; border-style: solid; }
    .vf-card-v.vf-badge--true { color: #2d6a4f; } .vf-card-v.vf-badge--half { color: #b8862a; } .vf-card-v.vf-badge--unknown { color: #6b4fa0; }
    @media (max-width: 720px) {
      .vf-legend { grid-template-columns: 1fr; }
      .vf-card { grid-template-columns: 1fr; grid-template-rows: auto; padding: 0 18px 16px; }
      .vf-card-img { grid-column: 1; grid-row: auto; height: auto; min-height: 0; aspect-ratio: 16 / 9; width: calc(100% + 36px); max-width: none; margin: 0 -18px 8px; }
      .vf-card-k, .vf-card-t, .vf-card-q, .vf-card-l, .vf-card-v { grid-column: 1; }
    }
  </style>
</BaseLayout>
